@page "/library"
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject ILibraryScanner Scanner
@inject SettingsStore Settings

<PageTitle>Library</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Your music</span>
        <h1>Library</h1>
        <p>The files MelodyBridge found in your scan folders. Downloads live on
            their playlist pages; this list is your own music collection. Add a
            folder below and MelodyBridge matches files to your playlists by
            their embedded ID tag.</p>
    </div>
    <div class="topbar-actions">
        <button class="btn-modern primary" @onclick="RunScan" disabled="@scanning">
            @(scanning ? "Scanning..." : "Run scan")
        </button>
        <button class="btn-modern secondary" @onclick="ShowAddLocation">Add location</button>
    </div>
</section>

@if (scanResult != null)
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Last scan</span>
                <h2>Result</h2>
            </div>
            <span class="pill @(scanResultOk ? "ok" : "warn")">@(scanResultOk ? "Success" : "Issues")</span>
        </div>
        <pre class="result-box">@scanResult</pre>
    </section>
}

<section class="panel-card">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Files</span>
            <h2>Tracks (@shownTracks.Count()@(filter.Length > 0 ? $" of {tracks.Count}" : ""))</h2>
        </div>
        <input class="search-input" placeholder="Search title or artist…"
               value="@filter" @oninput="OnFilterChanged" />
    </div>
    @if (tracks.Count == 0)
    {
        <div class="empty-state">
            No files yet. Download a playlist or scan a folder with your existing music.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Artist</th>
                        <th>Quality</th>
                        <th>Size</th>
                        <th>Folder</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in shownTracks.Take(300))
                    {
                        <tr>
                            <td>
                                <strong>@(t.Title ?? "Unknown")</strong>
                                @if (showFilenameColumn)
                                {
                                    <span class="text-muted file-path" title="@t.CurrentPath">
                                        @(t.CurrentPath is null ? "" : Path.GetFileName(t.CurrentPath))
                                    </span>
                                }
                            </td>
                            <td>@(t.Artist ?? "Unknown artist")</td>
                            <td class="text-muted">@TrackDisplay.Quality(t.Bitrate, t.SampleRateHz, t.MediaType)</td>
                            <td class="text-muted" title="@(t.FileSizeBytes?.ToString("N0") + " bytes")">@TrackDisplay.Size(t.FileSizeBytes)</td>
                            <td>
                                @if (t.CurrentPath is { } path)
                                {
                                    <span class="text-muted file-path" title="@path">
                                        @(Path.GetDirectoryName(path) is { } dir ? Path.GetFileName(dir) : path)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (tracks.Count > 300)
        {
            <div class="hint-box">Showing the first 300 tracks. Narrow the search to see the rest.</div>
        }
    }
</section>

<section class="content-grid two">
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Folders</span>
                <h2>Music folders (@locations.Count)</h2>
            </div>
        </div>
        @if (locations.Count == 0)
        {
            <div class="empty-state">No scan locations configured. Add one to start scanning.</div>
        }
        <div class="path-list">
            @foreach (var loc in locations)
            {
                <div>
                    <strong>@loc.Path</strong>
                    <small>@(loc.ScanIntervalHours.HasValue ? $"Every {loc.ScanIntervalHours}h" : "Manual only")</small>
                    <button class="btn-modern ghost" @onclick="() => DeleteLocation(loc.Id)"
                            style="margin-left:auto;">Remove</button>
                </div>
            }
        </div>
    </div>
    <div class="panel-card">
        <div class="panel-header">
            <div><span class="eyebrow">How matching works</span>
                <h2>Track identity</h2>
            </div>
        </div>
        <div class="health-list">
            <div><span class="status-dot online"></span><strong>MELODY_ID</strong><small>ID3v2 TXXX frame</small></div>
            <div><span class="status-dot online"></span><strong>Fallback</strong><small>Comment-based marker</small>
            </div>
            <div><span class="status-dot online"></span><strong>Database</strong><small>@tracksCount files in
                library</small></div>
        </div>
    </div>
</section>

@if (showForm)
{
    <div class="wizard-overlay">
        <div class="wizard-modal" style="max-width:480px;">
            <div class="wizard-header">
                <span class="eyebrow">New location</span>
                <h2>Add scan location</h2>
                <button class="icon-button" @onclick="() => showForm = false">&times;</button>
            </div>
            <div class="wizard-body">
                <div class="form-grid single">
                    <label>
                        Directory path
                        <input @bind="newPath" placeholder="/music" />
                    </label>
                    <label>
                        Scan interval (minutes, 0 = manual)
                        <input @bind="newInterval" type="number" min="0" step="5" />
                    </label>
                    <label class="toggle-switch wide">
                        <input type="checkbox" @bind="liveMonitoring" />
                        <span class="toggle-slider"></span>
                        Live monitoring
                    </label>
                </div>
            </div>
            <div class="wizard-footer">
                <button class="btn-modern" @onclick="() => showForm = false">Cancel</button>
                <button class="btn-modern primary" @onclick="SaveLocation">Add location</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record LibraryRow(
        string? Title, string? Artist, string? CurrentPath,
        int? Bitrate, int? SampleRateHz, string? MediaType, long? FileSizeBytes);

    private List<ScanLocationEntity> locations = new();
    private List<LibraryRow> tracks = new();
    private string filter = string.Empty;
    private bool showFilenameColumn;
    private int tracksCount;
    private bool scanning;
    private string? scanResult;
    private bool scanResultOk;
    private bool showForm;
    private string newPath = "/music";
    private int newInterval = 0;
    private bool liveMonitoring = true;

    private IEnumerable<LibraryRow> shownTracks => string.IsNullOrWhiteSpace(filter)
        ? tracks
        : tracks.Where(t =>
            (t.Title ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase) ||
            (t.Artist ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        locations = await db.ScanLocations.ToListAsync();
        showFilenameColumn = await Settings.GetBoolAsync("show_filename", fallback: false);

        // Library shows only the files found in the scan folders.
        // Playlist downloads have their own home on the playlist page;
        // merging them here made the list look like random playlist songs.
        tracks = await db.Tracks
            .Where(t => t.CurrentPath != null
                && !db.Playlists.Any(p => p.Tracks.Any(pt => pt.MelodyId == t.MelodyId)))
            .OrderByDescending(t => t.Id)
            .Select(t => new LibraryRow(
                t.Title, t.Artist, t.CurrentPath, t.Bitrate, t.SampleRateHz,
                t.MediaType, t.FileSizeBytes))
            .ToListAsync();
        tracksCount = tracks.Count;
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        filter = e.Value?.ToString() ?? string.Empty;
    }

    private async Task RunScan()
    {
        scanning = true;
        scanResult = null;
        try
        {
            var scanLocations = locations.Select(l => new ScanLocation(l.Path ?? "")).ToArray();

            if (scanLocations.Length == 0)
            {
                scanResult = "No scan locations configured.";
                scanResultOk = false;
                return;
            }

            await Scanner.ScanAsync(scanLocations);
            scanResult = $"Scanned {scanLocations.Length} location(s) successfully.";
            scanResultOk = true;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            scanResult = ex.ToString();
            scanResultOk = false;
        }
        finally { scanning = false; }
    }

    private void ShowAddLocation()
    {
        showForm = true;
        newPath = "/music";
        newInterval = 0;
        liveMonitoring = true;
    }

    private async Task SaveLocation()
    {
        var path = newPath.Trim();
        if (path.Length == 0) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.ScanLocations.Add(new ScanLocationEntity
        {
            Path = path,
            ScanIntervalHours = newInterval > 0 ? newInterval : null,
        });
        await db.SaveChangesAsync();

        showForm = false;
        await LoadDataAsync();
    }

    private async Task DeleteLocation(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var loc = await db.ScanLocations.FindAsync(id);
        if (loc != null)
        {
            db.ScanLocations.Remove(loc);
            await db.SaveChangesAsync();
        }
        await LoadDataAsync();
    }
}
