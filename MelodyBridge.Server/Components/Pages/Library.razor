@page "/library"
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject ILibraryScanner Scanner
@inject NotificationService Notifications
@implements IDisposable

<PageTitle>Library - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Your music</span>
        <div class="title-with-help">
            <h1>Library</h1>
            <HelpTip Path="concepts#track-identity" Text="The scanner reads tags, not filenames, and matches files to playlist tracks by their MELODY_ID tag." />
        </div>
        <p>Scan folders with music you already own. MelodyBridge reads the
            tags of every file, adds them to the library database, and
            matches them to your playlist tracks by their embedded ID tag,
            so a song you already have is never downloaded again. Folders
            that hold your downloads are added here automatically.</p>
    </div>
    <div class="topbar-actions">
        <button class="btn-modern primary" @onclick="RunScan" disabled="@scanning">
            <Icon Name="refresh" Size="16" />
            @(scanning ? "Scanning..." : "Run scan")
        </button>
        <button class="btn-modern secondary" @onclick="ShowAddLocation"><Icon Name="plus" Size="16" /> Add location</button>
    </div>
</section>

<section class="stat-grid">
    <StatCard IconName="library" Label="Library files" Value="@footprint.Files.ToString()"
              Caption="Files with a MELODY_ID tag" />
    <StatCard IconName="hard-drive" Label="Library size" Value="@SizeText(footprint.Bytes)"
              Caption="@(measuring ? "Measuring the files without a size" : "Main files and archive copies")" />
    <StatCard IconName="archive" Label="Archive copies" Value="@footprint.ArchiveFiles.ToString()"
              Caption="@($"{SizeText(footprint.ArchiveBytes)} in extra copies")" />
    <StatCard IconName="folder" Label="Scan folders" Value="@locations.Count.ToString()"
              Caption="@ArchiveLocationsCaption" />
</section>

@if (scanResult != null)
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Last scan</span>
                <h2>Result</h2>
            </div>
            <StatusPill Variant="@(scanResultOk ? "ok" : "warn")">@(scanResultOk ? "Success" : "Issues")</StatusPill>
        </div>
        <pre class="result-box">@scanResult</pre>
    </section>
}

<section class="content-grid two">
    <div class="settings-card">
        <div class="settings-head">
            <div>
                <span class="eyebrow">Folders</span>
                <h2>Music folders (@locations.Count)</h2>
            </div>
        </div>
        @if (locations.Count == 0)
        {
            <EmptyState IconName="folder" Title="No scan locations">No scan locations configured. Add one to start scanning.</EmptyState>
        }
        <div class="path-list">
            @foreach (var loc in locations)
            {
                <LibraryLocationCard Location="loc"
                                     FileCount="@FileCount(loc)"
                                     FolderSize="@FolderSizeText(loc)"
                                     IsArchive="@IsArchivePath(loc)"
                                     Schedule="@LocationSchedule.Of(loc)"
                                     OnEdit="ShowEditLocation"
                                     OnRemove="AskRemoveLocation" />
            }
        </div>
    </div>
    <LibraryIdentityPanel />
</section>

@if (showForm)
{
    <div class="wizard-overlay" @onclick="CloseForm">
        <div class="wizard-modal narrow" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <span class="eyebrow">@(editingId is null ? "New location" : $"Editing: {newPath}")</span>
                <h2>@(editingId is null ? "Add scan location" : "Edit scan location")</h2>
                <button class="icon-button" title="Close" @onclick="CloseForm"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                <div class="form-grid single">
                    <label>
                        Directory path
                        <input @bind="newPath" placeholder="/music" />
                    </label>
                </div>
                <div class="form-grid single">
                    <SchedulePicker @bind-Value="newSchedule" />
                </div>
                <label class="toggle-switch wide">
                    <input type="checkbox" @bind="liveMonitoring" />
                    <span class="toggle-slider"></span>
                    <span>Live monitoring: rescan this folder whenever files change</span>
                </label>
                @if (formError is { } error)
                {
                    <div class="hint-box danger form-error">@error</div>
                }
                <MountWarning />
            </div>
            <div class="wizard-footer">
                <button class="btn-modern secondary" @onclick="CloseForm">Cancel</button>
                <button class="btn-modern primary" @onclick="SaveLocation">
                    @(editingId is null ? "Add location" : "Save changes")
                </button>
            </div>
        </div>
    </div>
}

@if (removeLocationId is { } doomedId)
{
    <ConfirmDialog Show="true"
                   Eyebrow="Remove folder"
                   Title=@($"Remove '{removeLocationPath}'?")
                   Message="The folder stops being scanned and watched. The music files inside it are not deleted."
                   ConfirmLabel="Remove folder"
                   OnConfirm=@(() => DeleteLocation(doomedId))
                   OnCancel="CancelRemoveLocation" />
}

@code {
    private List<ScanLocationEntity> locations = new();
    /// <summary>Archive roots (global plus per playlist) for the folder badge.</summary>
    private List<string> archiveRoots = new();
    /// <summary>Files and bytes per scan location, current files plus archive copies.</summary>
    private Dictionary<int, LocationFootprint> footprints = new();
    private LibraryFootprint footprint = new(0, 0, 0, 0);
    private bool scanning;
    private string? scanResult;
    private bool scanResultOk;
    private bool showForm;
    private int? editingId; // null = add, otherwise the row being edited
    private string newPath = "";
    private ScanSchedule newSchedule = ScanSchedule.Manual;
    private bool liveMonitoring = true;
    private string? formError;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        locations = await db.ScanLocations.ToListAsync();

        // Archive roots mark folders whose files are copies, not tracks.
        var playlistArchiveDirs = await db.Playlists.AsNoTracking()
            .Where(p => p.ArchiveDirectory != null && p.ArchiveDirectory != "")
            .Select(p => p.ArchiveDirectory!)
            .ToListAsync();
        var globalArchive = await db.DownloaderSettings.AsNoTracking()
            .Where(s => s.Key == "archive_path")
            .Select(s => s.Value)
            .FirstOrDefaultAsync();
        archiveRoots = playlistArchiveDirs;
        if (!string.IsNullOrWhiteSpace(globalArchive)) archiveRoots.Add(globalArchive);

        // Files with a MELODY_ID per location: a track belongs to the folder
        // its current path lives under, and its archive copy belongs to the
        // archive folder. ArchivePath is a second real file on disk, so it is
        // counted where it lives instead of being folded into the main row.
        var tracks = await db.Tracks.AsNoTracking()
            .Where(t => t.MelodyId != null
                        && (t.CurrentPath != null || t.ArchivePath != null))
            .Select(t => new { t.Id, t.CurrentPath, t.ArchivePath, t.FileSizeBytes, t.ArchiveSizeBytes })
            .ToListAsync();

        // One entry per file path: two rows can share a path (dedup
        // hardlinks) and must not count twice. The download row knows its
        // current file size, and the archive copy's size is in the row too:
        // the app wrote that file, so the page never has to stat it. An
        // archive copy from before that was known is measured in the
        // background, once, and the answer is stored.
        var byPath = new Dictionary<string, long?>(StringComparer.OrdinalIgnoreCase);
        var unmeasured = new List<(int TrackId, string Path, bool Archive)>();
        foreach (var track in tracks)
        {
            if (!string.IsNullOrWhiteSpace(track.CurrentPath))
            {
                byPath.TryAdd(track.CurrentPath!, track.FileSizeBytes);
                if (track.FileSizeBytes is not > 0)
                    unmeasured.Add((track.Id, track.CurrentPath!, Archive: false));
            }
            if (!string.IsNullOrWhiteSpace(track.ArchivePath))
            {
                if (track.ArchiveSizeBytes is > 0)
                {
                    byPath.TryAdd(track.ArchivePath!, track.ArchiveSizeBytes);
                }
                else
                {
                    byPath.TryAdd(track.ArchivePath!, null);
                    unmeasured.Add((track.Id, track.ArchivePath!, Archive: true));
                }
            }
        }
        files = byPath
            .Select(file => (file.Key, Bytes: file.Value ?? 0))
            .ToList();
        ApplyFootprint();

        // Files the database has no size for are measured in the
        // background: the page shows what it knows right away, and the
        // answer is stored so the next visit does not measure again.
        if (unmeasured.Count > 0)
        {
            measuring = true;
            _ = Task.Run(() => MeasureMissingSizesAsync(unmeasured));
        }
    }

    /// <summary>One file of the library: its path and its size.</summary>
    private List<(string Key, long Bytes)> files = new();

    /// <summary>True while the page is still measuring files it had no size for.</summary>
    private bool measuring;

    /// <summary>The summary tiles from the files the page knows.</summary>
    private void ApplyFootprint()
    {
        var archiveFiles = files.Where(file => IsArchiveFile(file.Key)).ToList();
        footprint = new LibraryFootprint(
            files.Count,
            files.Sum(file => file.Bytes),
            archiveFiles.Count,
            archiveFiles.Sum(file => file.Bytes));
        footprints = locations.ToDictionary(
            location => location.Id,
            location =>
            {
                var matched = files
                    .Where(file => LocationContains(location.Path, file.Key))
                    .ToList();
                return new LocationFootprint(matched.Count, matched.Sum(file => file.Bytes));
            });
    }

    /// <summary>
    /// Measures the files the database has no size for, off the render
    /// path, and stores the answer: the app knows the size of a file it
    /// wrote, so the next visit does not have to ask the disk again.
    /// </summary>
    private async Task MeasureMissingSizesAsync(List<(int TrackId, string Path, bool Archive)> unmeasured)
    {
        try
        {
            var measured = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            foreach (var (_, path, _) in unmeasured)
            {
                var bytes = FileBytes(path, null);
                if (bytes > 0) measured[path] = bytes;
            }
            if (measured.Count > 0)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                foreach (var (trackId, path, archive) in unmeasured)
                {
                    if (!measured.TryGetValue(path, out var bytes)) continue;
                    if (archive)
                        await db.Tracks.Where(t => t.Id == trackId)
                            .ExecuteUpdateAsync(s => s.SetProperty(t => t.ArchiveSizeBytes, bytes));
                    else
                        await db.Tracks.Where(t => t.Id == trackId)
                            .ExecuteUpdateAsync(s => s.SetProperty(t => t.FileSizeBytes, bytes));
                }
            }

            await InvokeAsync(() =>
            {
                if (disposed) return;
                files = files
                    .Select(file => measured.TryGetValue(file.Key, out var bytes)
                        ? (file.Key, Bytes: bytes)
                        : file)
                    .ToList();
                ApplyFootprint();
                measuring = false;
                StateHasChanged();
            });
        }
        catch
        {
            await InvokeAsync(() => measuring = false);
        }
    }

    private sealed record LocationFootprint(int Files, long Bytes);

    private sealed record LibraryFootprint(int Files, long Bytes, int ArchiveFiles, long ArchiveBytes);

    /// <summary>Known row size first (downloads and scans store it), otherwise
    /// one stat for files the database has no size for, archive copies above
    /// all. A missing file reads as zero, never as an error on the page.</summary>
    private static long FileBytes(string path, long? known)
    {
        if (known is > 0) return known.Value;
        try
        {
            var info = new FileInfo(path);
            return info.Exists ? info.Length : 0;
        }
        catch
        {
            return 0;
        }
    }

    private static string SizeText(long bytes)
        => TrackDisplay.Size(bytes) is { Length: > 0 } text ? text : "0 B";

    private static bool LocationContains(string locationPath, string filePath)
        => filePath.StartsWith(locationPath, StringComparison.OrdinalIgnoreCase)
           && (filePath.Length == locationPath.Length
               || filePath[locationPath.Length] == Path.DirectorySeparatorChar
               || filePath[locationPath.Length] == Path.AltDirectorySeparatorChar);

    private int FileCount(ScanLocationEntity loc)
        => footprints.TryGetValue(loc.Id, out var fp) ? fp.Files : 0;

    private string FolderSizeText(ScanLocationEntity loc)
        => footprints.TryGetValue(loc.Id, out var fp) ? SizeText(fp.Bytes) : "0 B";

    private string ArchiveLocationsCaption
    {
        get
        {
            var count = locations.Count(IsArchivePath);
            return count == 1 ? "1 archive folder" : $"{count} archive folders";
        }
    }

    /// <summary>True when a file lives under one of the archive roots.</summary>
    private bool IsArchiveFile(string filePath)
        => archiveRoots.Any(root => LocationContains(root, filePath));

    /// <summary>A scan location inside an archive root: its files are copies,
    /// never adopted as a track's main file.</summary>
    private bool IsArchivePath(ScanLocationEntity loc)
        => loc.Path is { Length: > 0 } path
           && archiveRoots.Any(root =>
               LocationContains(root, path)
               || string.Equals(path.TrimEnd('/', '\\'), root.TrimEnd('/', '\\'),
                   StringComparison.OrdinalIgnoreCase));

    private async Task RunScan()
    {
        scanning = true;
        scanResult = null;
        try
        {
            var scanLocations = locations.Select(l => new ScanLocation(l.Path ?? "")).ToArray();

            if (scanLocations.Length == 0)
            {
                scanResult = "No scan locations configured.";
                scanResultOk = false;
                return;
            }

            var report = await Scanner.ScanAsync(scanLocations);

            // Stamp every scanned location so the cards show a real last-scan time.
            await using var db = await DbFactory.CreateDbContextAsync();
            var scannedIds = locations.Select(l => l.Id).ToList();
            foreach (var loc in db.ScanLocations.Where(l => scannedIds.Contains(l.Id)).ToList())
                loc.LastScannedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();

            scanResult = report.MissingPaths.Count > 0
                ? $"Scanned {report.Locations} location(s): {report.TaggedFiles} files with MELODY_ID, "
                  + $"{report.UntaggedFiles} without. Path not found: {string.Join(", ", report.MissingPaths)}. "
                  + "Edit or remove that folder in the list."
                : $"Scanned {report.Locations} location(s): {report.TaggedFiles} files with MELODY_ID, {report.UntaggedFiles} without.";
            scanResultOk = report.MissingPaths.Count == 0;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            scanResult = ex.ToString();
            scanResultOk = false;
        }
        finally { scanning = false; }
    }

    private void ShowAddLocation()
    {
        editingId = null;
        showForm = true;
        // No prefill: the old default was /music, the one path the page
        // already flags as missing on a host install.
        newPath = "";
        newSchedule = ScanSchedule.Manual;
        liveMonitoring = true;
        formError = null;
    }

    private void ShowEditLocation(ScanLocationEntity loc)
    {
        editingId = loc.Id;
        showForm = true;
        newPath = loc.Path;
        newSchedule = LocationSchedule.Of(loc);
        liveMonitoring = loc.LiveMonitoring;
        formError = null;
    }

    // Remove flow: ask first, the files stay.
    private int? removeLocationId;
    private string removeLocationPath = "";

    private void AskRemoveLocation(ScanLocationEntity loc)
    {
        removeLocationId = loc.Id;
        removeLocationPath = loc.Path;
    }

    private void CancelRemoveLocation()
    {
        removeLocationId = null;
        StateHasChanged();
    }

    private void CloseForm()
    {
        showForm = false;
        formError = null;
    }

    private async Task SaveLocation()
    {
        formError = null;
        var path = newPath.Trim();
        if (path.Length == 0)
        {
            formError = "Enter a directory path.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Duplicate check in memory: the location list is tiny, and SQL
        // string comparison is case-sensitive on some providers.
        var others = await db.ScanLocations.Select(l => new { l.Id, l.Path }).ToListAsync();
        if (others.Any(o => o.Id != editingId
                            && string.Equals(o.Path, path, StringComparison.OrdinalIgnoreCase)))
        {
            formError = "That path is already configured.";
            return;
        }

        if (!Directory.Exists(path))
        {
            formError = "That folder does not exist from the app's point of view. "
                + "In Docker, type the container path (the right side of the volume mapping), not the host path.";
            return;
        }

        if (editingId is { } id)
        {
            var loc = await db.ScanLocations.FindAsync(id);
            if (loc == null)
            {
                showForm = false;
                return;
            }
            loc.Path = path;
            loc.ScheduleCron = newSchedule.ToString();
            // Clear the legacy column so a manual choice is not overridden
            // by the ScanIntervalHours fallback in LocationSchedule.Of.
            loc.ScanIntervalHours = null;
            loc.LiveMonitoring = liveMonitoring;
            await db.SaveChangesAsync();
            Notifications.Success("Scan location updated.");
        }
        else
        {
            db.ScanLocations.Add(new ScanLocationEntity
            {
                Path = path,
                ScheduleCron = newSchedule.ToString(),
                LiveMonitoring = liveMonitoring,
            });
            await db.SaveChangesAsync();
            Notifications.Success("Scan location added.");
        }

        showForm = false;
        await LoadDataAsync();
    }

    private async Task DeleteLocation(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var loc = await db.ScanLocations.FindAsync(id);
        if (loc != null)
        {
            db.ScanLocations.Remove(loc);
            await db.SaveChangesAsync();
        }
        removeLocationId = null;
        await LoadDataAsync();
    }

    /// <summary>True once the page is gone: the background measurement must
    /// not touch a disposed component.</summary>
    private bool disposed;

    public void Dispose() => disposed = true;
}