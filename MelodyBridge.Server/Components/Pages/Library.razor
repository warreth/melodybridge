@page "/library"
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject ILibraryScanner Scanner

<PageTitle>Library</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Your music</span>
        <h1>Library</h1>
        <p>Scan folders with music you already own. MelodyBridge reads the
            tags of every file, adds them to the library database, and
            matches them to your playlist tracks by their embedded ID tag —
            so a song you already have is never downloaded again. Folders
            that hold your downloads are added here automatically.</p>
    </div>
    <div class="topbar-actions">
        <button class="btn-modern primary" @onclick="RunScan" disabled="@scanning">
            @(scanning ? "Scanning..." : "Run scan")
        </button>
        <button class="btn-modern secondary" @onclick="ShowAddLocation">Add location</button>
    </div>
</section>

@if (scanResult != null)
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Last scan</span>
                <h2>Result</h2>
            </div>
            <span class="pill @(scanResultOk ? "ok" : "warn")">@(scanResultOk ? "Success" : "Issues")</span>
        </div>
        <pre class="result-box">@scanResult</pre>
    </section>
}

<section class="content-grid two">
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Folders</span>
                <h2>Music folders (@locations.Count)</h2>
            </div>
        </div>
        @if (locations.Count == 0)
        {
            <div class="empty-state">No scan locations configured. Add one to start scanning.</div>
        }
        <div class="path-list">
            @foreach (var loc in locations)
            {
                <div class="location-card">
                    <strong>@loc.Path</strong>
                    <small>
                        @(FileCount(loc)) files with MELODY_ID ·
                        @(LocationSchedule.Of(loc) is { Mode: ScanScheduleMode.Manual } ? "manual" : DescribeSchedule(LocationSchedule.Of(loc))) ·
                        last scan @(loc.LastScannedAt is { } scanned ? scanned.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never")
                    </small>
                    @if (loc.LiveMonitoring)
                    {
                        <span class="pill neutral">live</span>
                    }
                    <button class="btn-modern ghost" @onclick="() => DeleteLocation(loc.Id)"
                            style="margin-left:auto;">Remove</button>
                </div>
            }
        </div>
    </div>
    <div class="panel-card">
        <div class="panel-header">
            <div><span class="eyebrow">How matching works</span>
                <h2>Track identity</h2>
            </div>
        </div>
        <div class="health-list">
            <div><span class="status-dot online"></span><strong>MELODY_ID</strong><small>ID3v2 TXXX frame</small></div>
            <div><span class="status-dot online"></span><strong>Fallback</strong><small>Comment-based marker</small>
            </div>
            <div><span class="status-dot online"></span><strong>Matched</strong><small>playlists link to
                files by ID tag</small></div>
        </div>
    </div>
</section>

@if (showForm)
{
    <div class="wizard-overlay">
        <div class="wizard-modal" style="max-width:480px;">
            <div class="wizard-header">
                <span class="eyebrow">New location</span>
                <h2>Add scan location</h2>
                <button class="icon-button" @onclick="() => showForm = false">&times;</button>
            </div>
            <div class="wizard-body">
                <div class="form-grid single">
                    <label>
                        Directory path
                        <input @bind="newPath" placeholder="/music" />
                    </label>
                </div>
                <div class="form-grid single">
                    <SchedulePicker @bind-Value="newSchedule" />
                </div>
                <label class="toggle-switch wide">
                    <input type="checkbox" @bind="liveMonitoring" />
                    <span class="toggle-slider"></span>
                    <span>Live monitoring — rescan this folder whenever files change</span>
                </label>
                <div class="hint-box">
                    Enter the path as the server sees it. Inside Docker that is
                    the container path (for example <code>/music</code>), not the
                    path on your host — check what the volume is mounted as in
                    your <code>compose.yml</code>.
                </div>
            </div>
            <div class="wizard-footer">
                <button class="btn-modern" @onclick="() => showForm = false">Cancel</button>
                <button class="btn-modern primary" @onclick="SaveLocation">Add location</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ScanLocationEntity> locations = new();
    private Dictionary<int, int> filesPerLocation = new();
    private bool scanning;
    private string? scanResult;
    private bool scanResultOk;
    private bool showForm;
    private string newPath = "/music";
    private ScanSchedule newSchedule = ScanSchedule.Manual;
    private bool liveMonitoring = true;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        locations = await db.ScanLocations.ToListAsync();

        // Files with a MELODY_ID per location: a track belongs to the folder
        // its current path lives under. Counted in memory — location paths are
        // prefixes and SQL LIKE with a leading wildcard would not use an index.
        var withIds = await db.Tracks
            .Where(t => t.MelodyId != null && t.CurrentPath != null)
            .Select(t => new { t.MelodyId, t.CurrentPath })
            .ToListAsync();
        filesPerLocation = locations.ToDictionary(
            l => l.Id,
            l => withIds.Count(t => LocationContains(l.Path, t.CurrentPath!)));
    }

    private static bool LocationContains(string locationPath, string filePath)
        => filePath.StartsWith(locationPath, StringComparison.OrdinalIgnoreCase)
           && (filePath.Length == locationPath.Length
               || filePath[locationPath.Length] == Path.DirectorySeparatorChar
               || filePath[locationPath.Length] == Path.AltDirectorySeparatorChar);

    private int FileCount(ScanLocationEntity loc)
        => filesPerLocation.TryGetValue(loc.Id, out var n) ? n : 0;

    private static string DescribeSchedule(ScanSchedule s) => s.Mode switch
    {
        ScanScheduleMode.Interval => $"every {s.IntervalMinutes} min",
        ScanScheduleMode.Cron => $"cron {s.Cron}",
        _ => "manual",
    };

    private async Task RunScan()
    {
        scanning = true;
        scanResult = null;
        try
        {
            var scanLocations = locations.Select(l => new ScanLocation(l.Path ?? "")).ToArray();

            if (scanLocations.Length == 0)
            {
                scanResult = "No scan locations configured.";
                scanResultOk = false;
                return;
            }

            await Scanner.ScanAsync(scanLocations);

            // Stamp every scanned location so the cards show a real last-scan time.
            await using var db = await DbFactory.CreateDbContextAsync();
            var scannedIds = locations.Select(l => l.Id).ToList();
            foreach (var loc in db.ScanLocations.Where(l => scannedIds.Contains(l.Id)).ToList())
                loc.LastScannedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();

            scanResult = $"Scanned {scanLocations.Length} location(s) successfully.";
            scanResultOk = true;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            scanResult = ex.ToString();
            scanResultOk = false;
        }
        finally { scanning = false; }
    }

    private void ShowAddLocation()
    {
        showForm = true;
        newPath = "/music";
        newSchedule = ScanSchedule.Manual;
        liveMonitoring = true;
    }

    private async Task SaveLocation()
    {
        var path = newPath.Trim();
        if (path.Length == 0) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.ScanLocations.Add(new ScanLocationEntity
        {
            Path = path,
            ScheduleCron = newSchedule.ToString(),
            LiveMonitoring = liveMonitoring,
        });
        await db.SaveChangesAsync();

        showForm = false;
        await LoadDataAsync();
    }

    private async Task DeleteLocation(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var loc = await db.ScanLocations.FindAsync(id);
        if (loc != null)
        {
            db.ScanLocations.Remove(loc);
            await db.SaveChangesAsync();
        }
        await LoadDataAsync();
    }
}
