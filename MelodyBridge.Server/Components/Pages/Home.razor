    private async Task ChooseModeAsync(bool advanced)
    {
        if (_mode is null) return;
        await _mode.SetAsync(advanced);
        showModeChoice = false;
        StateHasChanged();
    }

    internal async Task RefreshStats(bool force = false)
    {
        // The timer ticks every 5 seconds. The free reads (registry
        // counts, auth snapshot) run on every tick; the database queries
        // wait for a reason: the store stamp moved, a minute passed
        // (bounds the staleness of writes the scan's savers do without a
        // bump), or the page has not read anything yet. A manual Refresh
        // always reads: a button that cannot change numbers is a lie.
        authIssues = AuthMonitor.Snapshot();
        var coordinator = Services.GetService<IDownloadCoordinator>();
        var runs = coordinator?.Snapshot() ?? Array.Empty<DownloadRun>();
        downloadSummary = DownloadActivitySummary.From(runs);
        activeRuns = runs
            .Where(run => run.State is DownloadRunState.Running
                or DownloadRunState.Paused or DownloadRunState.Cancelling)
            .Take(3)
            .ToList();
        var stamp = ChangeTracker.Version;
        var logStamp = LogCollector.Version;
        var due = force
            || _statsPending
            || stamp != _observedVersion
            || logStamp != _observedLogVersion
            || _idleTicks >= StatsRefreshIdleTicks;
        _statsPending = false;
        _observedVersion = stamp;
        _observedLogVersion = logStamp;
        if (!due)
        {
            _idleTicks++;
            return;
        }

        // A working tick also keeps the last-updated marker current.
        _idleTicks = 0;
        _lastUpdated = DateTime.Now;
        await RefreshStatsFromDbAsync();
    }

    private async Task RefreshStatsFromDbAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        playlistsCount = await db.Playlists.CountAsync();
        downloadedCount = await db.Tracks.CountAsync(t => t.DownloadStatus == "downloaded");
        jobsCount = await db.SyncJobs.CountAsync();
        partialCount = await db.Playlists.CountAsync(p => p.SyncWarning != null && p.SyncWarning != "");
        failedJobs = await db.SyncJobs.CountAsync(j =>
            j.LastRunStatus != null && j.LastRunStatus != "Completed");

        // One row per distinct file, not per playlist row: a track shared
        // by three playlists is still one file on disk.
        var files = await db.Tracks.AsNoTracking()
            .Where(t => t.CurrentPath != null && t.CurrentPath != "")
            .GroupBy(t => t.CurrentPath!)
            .Select(g => new
            {
                Path = g.Key,
                Size = g.Max(t => t.FileSizeBytes ?? 0),
            })
            .ToListAsync();
        libraryFileCount = files.Count;
        libraryBytes = files.Sum(file => file.Size);
        librarySizeText = libraryBytes > 0 ? TrackDisplay.Size(libraryBytes) : "0 MB";

        playlistStats = (await db.Tracks.AsNoTracking()
                .GroupBy(t => t.PlaylistEntityId)
                .Select(g => new
                {
                    Id = g.Key,
                    Downloaded = g.Count(t => t.DownloadStatus == "downloaded"),
                    Failed = g.Count(t => t.DownloadStatus == "failed"),
                    Total = g.Count(),
                    SizeBytes = g.Where(t => t.DownloadStatus == "downloaded")
                        .Sum(t => t.FileSizeBytes ?? 0),
                    Attention = g.Count(t => t.DownloadStatus == "failed"
                        || t.DownloadStatus == "needs-review"
                        || (t.DownloadStatus == "downloaded" && t.ReviewKind != null)),
                })
                .ToListAsync())
            .Where(row => row.Id is not null)
            .ToDictionary(row => row.Id!,
                row => (row.Downloaded, row.Failed, row.Total, row.SizeBytes, row.Attention));
        failedCount = playlistStats.Values.Sum(stats => stats.failed);
        var attentionTracks = playlistStats.Values.Sum(stats => stats.attention);
        dedupCount = await db.Tracks.CountAsync(t => t.DownloadStatus == "needs-review");
        reviewCount = Math.Max(0, attentionTracks - failedCount - dedupCount);
        archiveIssueCount = await db.Tracks.CountAsync(t =>
            t.DownloadStatus == "downloaded"
            && t.Warning != null
            && (t.Warning.Contains("archive copy failed")
                || t.Warning.Contains("already owns the archive file")
                || t.Warning.Contains("file lived in the archive folder")
                || t.Warning.Contains("could not verify the download")));

        // The intro hands over to the dashboard the moment setup is
        // complete; a checklist reopened from Settings keeps showing until
        // the user skips it.
        if (showIntro && doneSteps == stepCount && !_introRestarted)
        {
            await Settings.SetAsync("intro_dismissed", "true");
            showIntro = false;
        }

        // Dashboard-only facts: keep the intro queries light.
        if (!showIntro)
        {
            // The account and media-server checks talk to other processes
            // and hosts. Start them before the database reads so the page
            // waits for the slower of the two, not their sum.
            var spotifyTask = SpotifyAccount.IsConnectedAsync();
            var spotifyWebTask = Services.GetService<SpotifyUnofficialAccountProvider>()?
                .IsConnectedAsync() ?? Task.FromResult(false);
            var youtubeTask = YouTubeAccount.IsConnectedAsync();
            var mediaTask = MediaProbe.CurrentAsync();
            flareSolverrUrl = FlareSolverrSolver.Url ?? string.Empty;

            // One pass over the buffer, not two: it grows while we read.
            var problems = LogCollector.GetEntries()
                .Where(e => e.Level is LogLevel.Error or LogLevel.Critical)
                .ToList();
            errorCount = problems.Count;
            recentErrors = problems.Take(3).ToList();

            playlists = await db.Playlists
                .OrderByDescending(p => p.LastSyncAt ?? DateTime.MinValue)
                .Take(6)
                .ToListAsync();
            recentRuns = (await db.SyncJobRuns
                .OrderByDescending(r => r.Timestamp)
                .Take(5)
                .Join(db.SyncJobs,
                    r => r.SyncJobId,
                    j => j.Id,
                    (r, j) => new
                    {
                        r.Timestamp,
                        r.Status,
                        r.Message,
                        JobName = j.Name,
                        r.ResolvedTracks,
                        r.TotalTracks,
                    })
                .ToListAsync())
                .Select(x => (x.JobName, x.Timestamp, x.Status, x.Message ?? "",
                    x.ResolvedTracks, x.TotalTracks))
                .ToList();

            await Task.WhenAll(spotifyTask, spotifyWebTask, youtubeTask, mediaTask);
            spotifyConnected = await spotifyTask;
            spotifyWebConnected = await spotifyWebTask;
            youtubeConnected = await youtubeTask;
            mediaServers = await mediaTask;
        }

        // The checklist also shows the last-run date, so this one small
        // query runs in both modes.
        lastRunAt = await db.SyncJobRuns
            .OrderByDescending(r => r.Timestamp)
            .Select(r => (DateTime?)r.Timestamp)
            .FirstOrDefaultAsync();

        _lastUpdated = DateTime.Now;
    }

    /// <summary>True once the page is gone: a late verdict must not touch
    /// a disposed component.</summary>
    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        MediaProbe.Changed -= OnMediaStatusChanged;
        if (_mode is not null) _mode.Changed -= OnModeChanged;
        _timer?.Dispose();
    }
