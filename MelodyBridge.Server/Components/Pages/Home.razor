@page "/"
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject IDownloaderRegistry DownloaderRegistry
@inject MelodyBridge.Infrastructure.Services.PluginAuthMonitor AuthMonitor
@inject SettingsStore Settings
@inject ILogCollector LogCollector
@inject SpotifyAccountProvider SpotifyAccount
@inject YouTubeAccountProvider YouTubeAccount
@inject IMediaServerStatusProbe MediaProbe
@inject MelodyBridge.Infrastructure.Services.DataChangeTracker Changes
@implements IDisposable

<PageTitle>@(showIntro ? "Welcome - MelodyBridge" : "Dashboard - MelodyBridge")</PageTitle>

@if (!showIntro)
{
    <GuidedTour Steps="DashboardTour" PersistenceKey="tour_dismissed" />
}

@if (showIntro)
{
    <section class="hero-panel">
        <div>
            <span class="eyebrow">Welcome to MelodyBridge</span>
            <h1>Three steps, from playlist link to your own music library.</h1>
            <p>MelodyBridge saves the tracks of a Spotify or YouTube playlist locally, downloads the
                music through a plugin waterfall, and publishes the result to Jellyfin, Plex or a Subsonic server
                or an M3U file.
                @(doneSteps == 3
                    ? "Everything is set up already. Skip this, or keep it as a reference for what lives where."
                    : "Work through the checklist below. It disappears once everything is set up.")</p>
            <div class="hero-actions">
                <a class="btn-modern primary" href="/playlists">Start with a playlist</a>
                <button class="btn-modern ghost" @onclick="SkipIntro">Skip intro</button>
            </div>
        </div>
        <div class="hero-card">
            <span class="status-dot online"></span>
            <strong>MelodyBridge is running</strong>
            <p>Nothing is lost by skipping. Bring this checklist back any time from Settings, About.</p>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Setup</span>
                <h2>Get everything running (@doneSteps of 3)</h2>
            </div>
            <button class="btn-modern ghost small" @onclick="RefreshNowAsync">Refresh</button>
        </div>
        <MountWarning />
        <div class="workflow-list">
            <a class="workflow-step @(step1Done ? "done" : "todo")" href="/playlists">
                <span class="workflow-number">
                    @if (step1Done)
                    {
                        <Icon Name="check" Size="14" Class="workflow-check" />
                    }
                    else
                    {
                        @:1
                    }
                </span>
                <div>
                    <strong>Add a playlist</strong>
                    <p>Paste a public Spotify or YouTube playlist link on the Playlists page.
                        MelodyBridge saves every track. With an account login you can also import
                        private playlists and liked songs.</p>
                    <small>@(step1Done ? $"{playlistsCount} playlist{(playlistsCount == 1 ? "" : "s")} saved" : "Not done yet")</small>
                </div>
                <span class="workflow-arrow"><Icon Name="chevron-right" Size="16" /></span>
            </a>
            <a class="workflow-step @(step2Done ? "done" : "todo")" href="/playlists">
                <span class="workflow-number">
                    @if (step2Done)
                    {
                        <Icon Name="check" Size="14" Class="workflow-check" />
                    }
                    else
                    {
                        @:2
                    }
                </span>
                <div>
                    <strong>Download the music</strong>
                    <p>Open the playlist and click Download missing. Each track is fetched by the
                        plugin waterfall and quality-checked before it lands on your disk.</p>
                    <small>@(step2Done ? $"{downloadedCount} track{(downloadedCount == 1 ? "" : "s")} downloaded" : "Nothing downloaded yet")</small>
                </div>
                <span class="workflow-arrow"><Icon Name="chevron-right" Size="16" /></span>
            </a>
            <a class="workflow-step @(step3Done ? "done" : "todo")" href="/sync-jobs">
                <span class="workflow-number">
                    @if (step3Done)
                    {
                        <Icon Name="check" Size="14" Class="workflow-check" />
                    }
                    else
                    {
                        @:3
                    }
                </span>
                <div>
                    <strong>Publish it</strong>
                    <p>Create a sync job that writes an M3U file or pushes the playlist to your
                        Jellyfin, Plex or Subsonic server. Jobs can run automatically on a schedule.</p>
                    <small>@(step3Done ? $"{jobsCount} job{(jobsCount == 1 ? "" : "s")} configured, last run {lastRunText}" : "No sync job yet")</small>
                </div>
            </a>
        </div>
        @if (doneSteps == 3)
        {
            <div class="result-box ok">
                Everything is set up. The dashboard replaces this page from now on.
            </div>
        }
    </section>

    <section class="panel-card lossless-setup">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Lossless</span>
                <h2>Connect a lossless source</h2>
            </div>
            <a class="btn-modern ghost small" href="/plugins">Open plugins</a>
        </div>
        <p class="panel-description">
            Qobuz and Tidal take a token, Deezer takes an ARL. Jumo and
            Monochrome need no account at all. Optional: any enabled source
            can carry a lossless playlist.
        </p>
        <div class="lossless-links">
            <a href="/plugins#plugin-qobuz">
                <strong>Qobuz</strong><span>Paste the X-User-Auth-Token</span>
            </a>
            <a href="/plugins#plugin-deemix">
                <strong>Deezer</strong><span>Paste the arl cookie</span>
            </a>
            <a href="/plugins#plugin-tidal">
                <strong>Tidal</strong><span>Paste a token or auth.json</span>
            </a>
            <a href="/plugins#plugin-jumo">
                <strong>Jumo</strong><span>No account needed</span>
            </a>
            <a href="/plugins#plugin-monochrome">
                <strong>Monochrome</strong><span>No account needed</span>
            </a>
        </div>
        <div class="lossless-guides">
            <a href="https://docs.melodybridge.app/qobuz" target="_blank" rel="noopener">Qobuz guide <Icon Name="external" Size="11" /></a>
            <a href="https://docs.melodybridge.app/deemix" target="_blank" rel="noopener">Deezer guide <Icon Name="external" Size="11" /></a>
            <a href="https://docs.melodybridge.app/tidal" target="_blank" rel="noopener">Tidal guide <Icon Name="external" Size="11" /></a>
        </div>
    </section>
}
else
{
    <section class="page-title">
        <div>
            <span class="eyebrow">Overview</span>
            <h1>Dashboard</h1>
            <p>Playlists, downloads, connections and errors at a glance.</p>
        </div>
        <div class="topbar-actions">
            <small class="text-muted updated-note">Updated @_lastUpdated.ToString("HH:mm:ss")</small>
            <button class="btn-modern ghost" @onclick="RefreshNowAsync">Refresh</button>
        </div>
    </section>

    <section class="stat-grid">
        <StatCard IconName="list-music" Label="Playlists" Value="@playlistsCount.ToString()" Caption="Saved from Spotify or YouTube" />
        <StatCard IconName="download" Label="Downloaded tracks" Value="@downloadedCount.ToString()" Caption="Files on your disk" />
        <StatCard IconName="library" Label="Library" Value="@libraryCount.ToString()" Caption="Files found by the scanner" />
        <StatCard IconName="package" Label="Plugins" Value="@($"{enabledPlugins} / {totalPlugins}")" Caption="Enabled in the waterfall" />
    </section>

    <section class="content-grid two dashboard-grid">
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Media servers and accounts</span>
                    <h2>Connections</h2>
                </div>
                <a class="btn-modern ghost small" href="/settings#media-servers">Manage</a>
            </div>
            <div class="provider-list">
                <ConnectionRow IconName="spotify" Title="Spotify"
                               Detail="@(spotifyConnected ? "account connected" : "public playlists only")"
                               PillVariant="@(spotifyConnected ? "connected" : "guest")"
                               PillText="@(spotifyConnected ? "connected" : "guest")"
                               Enabled="spotifyConnected" />
                <ConnectionRow IconName="youtube" Title="YouTube"
                               Detail="@(youtubeConnected ? "account connected" : "public playlists only")"
                               PillVariant="@(youtubeConnected ? "connected" : "guest")"
                               PillText="@(youtubeConnected ? "connected" : "guest")"
                               Enabled="youtubeConnected" />
                @foreach (var server in mediaServers)
                {
                    <ConnectionRow IconName="@ServerIcon(server.Kind)"
                                   Title="@ServerTitle(server)"
                                   Detail="@ServerDetail(server)"
                                   PillVariant="@ServerPillVariant(server)"
                                   PillText="@ServerPillText(server)"
                                   Enabled="@(server.State == MediaServerConnectionState.Connected)" />
                }
                <ConnectionRow IconName="flaresolverr" Title="FlareSolverr"
                               Detail="@(flareSolverrOn ? flareSolverrUrlText : "Cloudflare bypass off")"
                               PillVariant="@(flareSolverrOn ? "ok" : "neutral")"
                               PillText="@(flareSolverrOn ? "on" : "off")"
                               Enabled="flareSolverrOn" />
            </div>
        </div>
        <div class="grid-stack">
            <div class="panel-card">
                <div class="panel-header">
                    <div>
                        <span class="eyebrow">Waterfall</span>
                        <h2>Plugin logins</h2>
                    </div>
                    <a class="btn-modern ghost small" href="/plugins">Plugins</a>
                </div>
                @if (authIssues.Count == 0)
                {
                    <EmptyState IconName="check-circle" Title="No login problems found">
                        Every enabled plugin's stored login looks usable.
                    </EmptyState>
                }
                else
                {
                    <div class="login-issue-list">
                        @foreach (var issue in authIssues)
                        {
                            <div class="login-issue">
                                <Icon Name="alert" Size="15" />
                                <div>
                                    <strong>@issue.PluginName</strong>
                                    <span>@issue.Message</span>
                                </div>
                                <a class="btn-modern small ghost" href="/plugins#plugin-@issue.PluginId">Fix</a>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="panel-card">
                <div class="panel-header">
                    <div>
                        <span class="eyebrow">Attention</span>
                        <h2>Recent errors (@errorCount)</h2>
                    </div>
                    <a class="btn-modern ghost small" href="/logs">Logs</a>
                </div>
                @if (recentErrors.Count == 0)
                {
                    <EmptyState IconName="check-circle" Title="No errors">Everything ran clean.</EmptyState>
                }
                else
                {
                    <div class="logs-list">
                        @foreach (var entry in recentErrors)
                        {
                            <a class="log-row err clickable" href="/logs">
                                <span class="log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                <span class="log-category">@LogAreas.FromCategory(entry.Category)</span>
                                <span class="log-message">@entry.Message</span>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="panel-card">
                <div class="panel-header">
                    <div>
                        <span class="eyebrow">Sync activity</span>
                        <h2>Recent sync runs (@recentRuns.Count)</h2>
                    </div>
                    <a class="btn-modern ghost small" href="/sync-jobs">Sync jobs</a>
                </div>
                @if (recentRuns.Count == 0)
                {
                    <EmptyState IconName="clock" Title="No sync runs yet">No sync job has run yet.</EmptyState>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="modern-table compact">
                            <thead>
                                <tr>
                                    <th>Job</th>
                                    <th class="col-when">When</th>
                                    <th>Result</th>
                                    <th>Summary</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var run in recentRuns)
                                {
                                    <tr>
                                        <td><strong>@run.JobName</strong></td>
                                        <td class="text-muted nowrap col-when">@run.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <StatusPill Variant="@(run.Status == "Completed" ? "ok" : "err")">@run.Status</StatusPill>
                                        </td>
                                        <td class="text-muted">@run.Message</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Your music</span>
                <h2>Playlists (@playlists.Count)</h2>
            </div>
            <a class="btn-modern ghost small" href="/playlists">All playlists</a>
        </div>
        @if (partialPlaylists.Count > 0)
        {
            <div class="hint-box danger">
                <strong>Some playlists did not sync completely.</strong>
                @foreach (var p in partialPlaylists)
                {
                    <div>
                        @p.Name: @p.SyncWarning. Re-sync from the playlist page to fetch the rest.
                    </div>
                }
            </div>
        }
        @if (playlists.Count == 0)
        {
            <EmptyState IconName="list-music" Title="No playlists yet">Add one on the Playlists page.</EmptyState>
        }
        else
        {
            <div class="playlist-grid">
                @foreach (var playlist in playlists)
                {
                    var (downloaded, total) = playlistCounts.GetValueOrDefault(playlist.Id, (0, 0));
                    <div class="panel-card playlist-card">
                        <a class="playlist-cover" href="/playlists/@playlist.Id" title="Open @playlist.Name">
                            @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                            {
                                <img src="@playlist.CoverImageUrl" alt="@playlist.Name" loading="lazy" />
                            }
                            else
                            {
                                <span class="playlist-cover-placeholder"><Icon Name="music" Size="28" Class="cover-placeholder-icon" /></span>
                            }
                            @if (downloaded == total && total > 0)
                            {
                                <span class="cover-badge complete" title="All tracks downloaded"><Icon Name="check-circle" Size="12" /> complete</span>
                            }
                            else if (downloaded > 0)
                            {
                                <span class="cover-badge partial" title="@downloaded of @total downloaded">@downloaded/@total</span>
                            }
                        </a>
                        <div>
                            <span class="eyebrow">@(playlist.IsManualImport ? "Imported" : playlist.SourcePlatform.ToString())</span>
                            <StatusPill Variant="@(playlist.LastSyncStatus == SyncStatus.Failed ? "err" : playlist.SyncWarning is { Length: > 0 } ? "warn" : "neutral")">
                                @(playlist.SyncWarning is { Length: > 0 } ? "partial" : playlist.LastSyncStatus.ToString().ToLowerInvariant())
                            </StatusPill>
                            <h2><a href="/playlists/@playlist.Id">@playlist.Name</a></h2>
                            <p class="panel-description">
                                @total track@(total == 1 ? "" : "s") · @downloaded downloaded
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private bool showIntro;
    private int playlistsCount;
    private int downloadedCount;
    private int libraryCount;
    private int jobsCount;
    private int enabledPlugins;
    private int totalPlugins;
    private int errorCount;
    private bool spotifyConnected;
    private bool youtubeConnected;
    private IReadOnlyList<MediaServerConnectionStatus> mediaServers =
        Array.Empty<MediaServerConnectionStatus>();
    private string flareSolverrUrl = string.Empty;
    private List<PlaylistEntity> playlists = new();
    private List<PlaylistEntity> partialPlaylists = new();
    private Dictionary<string, (int downloaded, int total)> playlistCounts = new();
    private List<LogEntry> recentErrors = new();
    private List<(string JobName, DateTime Timestamp, string Status, string Message)> recentRuns = new();
    private IReadOnlyList<PluginAuthIssue> authIssues = Array.Empty<PluginAuthIssue>();
    private DateTime? lastRunAt;
    private DateTime _lastUpdated = DateTime.Now;
    /// <summary>True when Settings explicitly reopened the checklist: it then
    /// stays visible even though every step is already done.</summary>
    private bool _introRestarted;
    private Timer? _timer;
    private long observedVersion = -1;
    private long observedLogVersion = -1;
    private DateTime lastStoredRefresh = DateTime.MinValue;
    private int refreshGate;

    private bool step1Done => playlistsCount > 0;
    private bool step2Done => downloadedCount > 0;
    private bool step3Done => jobsCount > 0;
    private int doneSteps => (step1Done ? 1 : 0) + (step2Done ? 1 : 0) + (step3Done ? 1 : 0);
    private string lastRunText => lastRunAt.HasValue
        ? lastRunAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        : "never";
    private bool flareSolverrOn => !string.IsNullOrWhiteSpace(flareSolverrUrl)
        && !flareSolverrUrl.Equals("off", StringComparison.OrdinalIgnoreCase);

    /// <summary>Brand key for a server kind; the same icons the wizard uses.</summary>
    private static string ServerIcon(string kind) => MediaServerKinds.Canonical(kind) switch
    {
        MediaServerKinds.Plex => "plex",
        MediaServerKinds.Subsonic => "navidrome",
        _ => "jellyfin",
    };

    private static string ServerTitle(MediaServerConnectionStatus server)
        => string.IsNullOrWhiteSpace(server.Name)
           || string.Equals(server.Name, server.Kind, StringComparison.OrdinalIgnoreCase)
            ? (MediaServerKinds.Canonical(server.Kind) is { Length: > 0 } kind ? kind : "Media server")
            : server.Name;

    /// <summary>"admin on jellyfin.wath.dev", "not configured", or why it
    /// did not answer. The pill carries the state word, this carries who and
    /// where, so a connected row never just says "ready".</summary>
    private static string ServerDetail(MediaServerConnectionStatus server)
    {
        var where = !string.IsNullOrWhiteSpace(server.ServerName)
            ? server.ServerName!
            : HostOf(server.BaseUrl) ?? MediaServerKinds.Canonical(server.Kind);
        return server.State switch
        {
            MediaServerConnectionState.Connected => string.IsNullOrWhiteSpace(server.AccountName)
                ? $"connected to {where}"
                : $"{server.AccountName} on {where}",
            MediaServerConnectionState.Unreachable =>
                $"{HostOf(server.BaseUrl) ?? "server"}: "
                + (string.IsNullOrWhiteSpace(server.Reason) ? "unreachable" : server.Reason),
            MediaServerConnectionState.Checking => $"checking {where}",
            _ => "not configured",
        };
    }

    private static string ServerPillVariant(MediaServerConnectionStatus server)
        => server.State switch
        {
            MediaServerConnectionState.Connected => "connected",
            MediaServerConnectionState.Unreachable => "warn",
            _ => "neutral",
        };

    private static string ServerPillText(MediaServerConnectionStatus server)
        => server.State switch
        {
            MediaServerConnectionState.Connected => "connected",
            MediaServerConnectionState.Unreachable => "unreachable",
            MediaServerConnectionState.Checking => "checking…",
            _ => "off",
        };

    private static string? HostOf(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        var candidate = url.Contains("://", StringComparison.Ordinal) ? url : "http://" + url;
        return Uri.TryCreate(candidate, UriKind.Absolute, out var uri) && uri.Host.Length > 0
            ? (uri.IsDefaultPort ? uri.Host : $"{uri.Host}:{uri.Port}")
            : url.Trim();
    }

    /// <summary>"auto" hides the raw value: the row then says what auto
    /// does instead of showing the word the user never typed.</summary>
    private string flareSolverrUrlText =>
        flareSolverrUrl.Equals("auto", StringComparison.OrdinalIgnoreCase)
            ? "auto: looks for the container"
            : flareSolverrUrl;

    protected override async Task OnInitializedAsync()
    {
        // An explicit restart (Settings, About) reopens the checklist even
        // on a finished install; the normal path only shows it while setup
        // is incomplete.
        var dismissed = await Settings.GetBoolAsync("intro_dismissed", fallback: false);
        var restarted = await Settings.GetBoolAsync("intro_restarted", fallback: false);
        _introRestarted = restarted;
        showIntro = !dismissed || restarted;
        // The connection rows show the last answer and redraw themselves
        // when the probe has a new one: the page never waits for a media
        // server that does not answer.
        MediaProbe.Changed += OnMediaStatusChanged;
        await RefreshStats();
        MarkRefreshed();

        // Keep the dashboard current without a manual refresh.
        if (!showIntro) StartRefreshTimer();
    }

    /// <summary>A new media server verdict: the rows show it right away.</summary>
    private void OnMediaStatusChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            mediaServers = await MediaProbe.CurrentAsync();
            StateHasChanged();
        });
    }

    private async Task SkipIntro()
    {
        await Settings.SetAsync("intro_dismissed", "true");
        await Settings.SetAsync("intro_restarted", "false");
        showIntro = false;
        await RefreshStats();
        MarkRefreshed();
        StartRefreshTimer();
    }

    private void StartRefreshTimer()
    {
        _timer?.Dispose();
        _timer = new Timer(_ => InvokeAsync(RefreshForTimerAsync), null, 5000, 5000);
    }

    private void MarkRefreshed()
    {
        observedVersion = Changes.Version;
        observedLogVersion = LogCollector.Version;
        lastStoredRefresh = DateTime.UtcNow;
    }

    /// <summary>
    /// The five-second tick used to re-run ten queries and two account
    /// reads even when nothing had happened. Now it redraws only when the
    /// store or the log buffer moved; a slower fallback catches changes
    /// that do not bump either stamp, such as a sync-job run or a media
    /// server coming back.
    /// </summary>
    internal async Task RefreshForTimerAsync()
    {
        if (Interlocked.CompareExchange(ref refreshGate, 1, 0) == 1) return;
        try
        {
            var version = Changes.Version;
            var logVersion = LogCollector.Version;
            var due = DateTime.UtcNow - lastStoredRefresh >= TimeSpan.FromSeconds(30);
            if (!due && version == observedVersion && logVersion == observedLogVersion)
                return;

            await RefreshStats();
            MarkRefreshed();
            StateHasChanged();
        }
        finally
        {
            Interlocked.Exchange(ref refreshGate, 0);
        }
    }

    /// <summary>The Refresh button: always re-reads, even when no stamp moved.</summary>
    private async Task RefreshNowAsync()
    {
        if (Interlocked.CompareExchange(ref refreshGate, 1, 0) == 1) return;
        try
        {
            await RefreshStats();
            MarkRefreshed();
            // The intro can hand over to the dashboard here, so the timer
            // that keeps the dashboard current has to start now.
            if (!showIntro && _timer is null) StartRefreshTimer();
            StateHasChanged();
        }
        finally
        {
            Interlocked.Exchange(ref refreshGate, 0);
        }
    }

    /// <summary>
    /// The post-setup tour: four short stops over the dashboard's own
    /// tiles, so it works on a fresh install without any data.
    /// </summary>
    private static readonly Shared.GuidedTour.TourStep[] DashboardTour =
    [
        new("This is your dashboard",
            "Every tile refreshes itself: playlists saved, tracks downloaded, library files and sync jobs all at a glance.",
            ".stat-grid"),
        new("Plugins decide the download order",
            "yt-dlp, SoundCloud, Archive.org and Lucida try in order. The first one that delivers within your quality settings wins.",
            ".stat-grid .stat-card:last-child"),
        new("Your connections",
            "Spotify and YouTube logins plus your media servers show their status here. Connect or change them on the Settings page.",
            ".provider-list"),
        new("Publish when the music is in",
            "A sync job turns a playlist into a Jellyfin playlist or an M3U file. Checklists and tours can be restarted from Settings - About.",
            "a[href='/sync-jobs']"),
    ];

    private async Task RefreshStats()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        playlistsCount = await db.Playlists.CountAsync();
        downloadedCount = await db.Tracks.CountAsync(t => t.DownloadStatus == "downloaded");
        libraryCount = await db.Tracks.CountAsync(t => t.CurrentPath != null && t.PlaylistSnapshotId == null);
        jobsCount = await db.SyncJobs.CountAsync();

        // The intro hands over to the dashboard the moment setup is
        // complete; a checklist reopened from Settings keeps showing until
        // the user skips it.
        if (showIntro && doneSteps == 3 && !_introRestarted)
        {
            await Settings.SetAsync("intro_dismissed", "true");
            showIntro = false;
        }

        var plugins = DownloaderRegistry.GetAll();
        totalPlugins = plugins.Count;
        enabledPlugins = plugins.Count(p => DownloaderRegistry.IsEnabled(p.Id));
        authIssues = AuthMonitor.Snapshot();

        // Dashboard-only facts: keep the intro queries light.
        if (!showIntro)
        {
            // The account and media-server checks talk to other processes
            // and hosts. Start them before the database reads so the page
            // waits for the slower of the two, not their sum.
            var spotifyTask = SpotifyAccount.IsConnectedAsync();
            var youtubeTask = YouTubeAccount.IsConnectedAsync();
            var mediaTask = MediaProbe.CurrentAsync();
            flareSolverrUrl = FlareSolverrSolver.Url ?? string.Empty;

            // One pass over the buffer, not two: it grows while we read.
            var all = LogCollector.GetEntries();
            var problems = all.Where(e => e.Level is LogLevel.Error or LogLevel.Critical).ToList();
            recentErrors = problems.Take(5).ToList();
            errorCount = problems.Count;

            playlists = await db.Playlists
                .OrderByDescending(p => p.LastSyncAt ?? DateTime.MinValue)
                .Take(6)
                .ToListAsync();
            // Incomplete syncs (rate limiting, failed pages) surface here:
            // the banner names them, the cards show the partial pill.
            partialPlaylists = await db.Playlists
                .Where(p => p.SyncWarning != null && p.SyncWarning != "")
                .OrderByDescending(p => p.LastSyncAt ?? DateTime.MinValue)
                .Take(5)
                .ToListAsync();
            playlistCounts = await db.Tracks
                .GroupBy(t => t.PlaylistEntityId)
                .Select(g => new { Id = g.Key, Total = g.Count(), Done = g.Count(t => t.DownloadStatus == "downloaded") })
                .ToDictionaryAsync(x => x.Id ?? "", x => (x.Done, x.Total));

            recentRuns = (await db.SyncJobRuns
                .OrderByDescending(r => r.Timestamp)
                .Take(5)
                .Join(db.SyncJobs,
                    r => r.SyncJobId,
                    j => j.Id,
                    (r, j) => new { r.Timestamp, r.Status, r.Message, JobName = j.Name })
                .ToListAsync())
                .Select(x => (x.JobName, x.Timestamp, x.Status, x.Message ?? ""))
                .ToList();

            await Task.WhenAll(spotifyTask, youtubeTask, mediaTask);
            spotifyConnected = await spotifyTask;
            youtubeConnected = await youtubeTask;
            mediaServers = await mediaTask;
        }

        // The checklist also shows the last-run date, so this one small
        // query runs in both modes.
        lastRunAt = await db.SyncJobRuns
            .OrderByDescending(r => r.Timestamp)
            .Select(r => (DateTime?)r.Timestamp)
            .FirstOrDefaultAsync();

        _lastUpdated = DateTime.Now;
    }

    /// <summary>True once the page is gone: a late verdict must not touch
    /// a disposed component.</summary>
    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        MediaProbe.Changed -= OnMediaStatusChanged;
        _timer?.Dispose();
    }
}
