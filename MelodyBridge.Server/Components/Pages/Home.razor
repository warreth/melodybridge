@page "/"
@using MelodyBridge.Application.Services
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject IDownloaderRegistry DownloaderRegistry
@inject MelodyBridge.Infrastructure.Services.PluginAuthMonitor AuthMonitor
@inject MelodyBridge.Infrastructure.Services.DataChangeTracker ChangeTracker
@inject SettingsStore Settings
@inject ILogCollector LogCollector
@inject SpotifyAccountProvider SpotifyAccount
@inject YouTubeAccountProvider YouTubeAccount
@inject IMediaServerStatusProbe MediaProbe
@implements IDisposable

<PageTitle>@(showIntro ? "Welcome - MelodyBridge" : "Dashboard - MelodyBridge")</PageTitle>

@* The tour runs before the checklist: it spotlights the tabs a new user
   needs, and its last stop points at the checklist right below. *@
@if (!showModeChoice)
{
    <GuidedTour Steps="TourSteps" PersistenceKey="tour_dismissed" />
}

@if (showModeChoice)
{
    <section class="panel-card mode-choice" aria-labelledby="mode-choice-title">
        <span class="eyebrow">Welcome</span>
        <h1 id="mode-choice-title">How do you want to use MelodyBridge?</h1>
        <p>
            Pick a starting point. Simple keeps the app focused on playlists
            and downloads. Advanced shows every tool, including the library,
            sync jobs and diagnostics. You can switch any time in the sidebar.
        </p>
        <div class="mode-choice-grid">
            <button type="button" class="mode-choice-option" @onclick="() => ChooseModeAsync(false)">
                <span class="mode-choice-icon"><Icon Name="download" Size="22" /></span>
                <strong>Simple</strong>
                <span>Add a playlist, download it, and keep an eye on problems. The shortest path to music.</span>
                <small>Recommended for a few playlists</small>
            </button>
            <button type="button" class="mode-choice-option" @onclick="() => ChooseModeAsync(true)">
                <span class="mode-choice-icon"><Icon Name="sliders" Size="22" /></span>
                <strong>Advanced</strong>
                <span>Everything is visible: library tools, sync jobs, diagnostics and all settings.</span>
                <small>For power users and media-server setups</small>
            </button>
        </div>
    </section>
}
else if (showIntro)
{
    <section class="hero-panel">
        <div>
            <span class="eyebrow">Welcome to MelodyBridge</span>
            <h1>@(IsSimple
                ? "Two steps, from playlist link to your own music library."
                : "Three steps, from playlist link to your own music library.")</h1>
            <p>MelodyBridge saves a playlist from Spotify, YouTube, Deezer, SoundCloud or
                ListenBrainz locally and downloads the music through a plugin waterfall.
                @(IsSimple
                    ? "Publishing to a media server is optional; switch to Advanced mode when you need it. "
                    : "It can then publish the result to Jellyfin, Plex, a Subsonic server or an M3U file. ")
                @(doneSteps == stepCount
                    ? "Everything is set up already. Skip this, or keep it as a reference for what lives where."
                    : "Work through the checklist below. It disappears once everything is set up.")</p>
            <div class="hero-actions">
                <a class="btn-modern primary" href="/playlists">Start with a playlist</a>
            </div>
        </div>
        <div class="hero-card">
            <span class="status-dot online"></span>
            <strong>MelodyBridge is running</strong>
            <p>Nothing is lost by skipping. Bring this checklist back any time from Settings, About.</p>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Setup</span>
                <h2>Get everything running (@doneSteps of @stepCount)</h2>
            </div>
            <div class="flex-actions">
                <button class="btn-modern ghost small" @onclick="SkipIntro">Skip checklist</button>
                <button class="btn-modern ghost small" @onclick="@(() => RefreshStats(force: true))">Refresh</button>
            </div>
        </div>
        <div class="workflow-list">
            <a class="workflow-step @(step1Done ? "done" : "todo")" href="/playlists">
                <span class="workflow-number">
                    @if (step1Done)
                    {
                        <Icon Name="check" Size="14" Class="workflow-check" />
                    }
                    else
                    {
                        @:1
                    }
                </span>
                <div>
                    <strong>Add a playlist</strong>
                    <p>Paste a public playlist link on the Playlists page. MelodyBridge saves
                        every track. With an account login you can also import private playlists
                        and liked songs.</p>
                    <small>@(step1Done ? $"{playlistsCount} playlist{(playlistsCount == 1 ? "" : "s")} saved" : "Not done yet")</small>
                </div>
                <span class="workflow-arrow"><Icon Name="chevron-right" Size="16" /></span>
            </a>
            <a class="workflow-step @(step2Done ? "done" : "todo")" href="/playlists">
                <span class="workflow-number">
                    @if (step2Done)
                    {
                        <Icon Name="check" Size="14" Class="workflow-check" />
                    }
                    else
                    {
                        @:2
                    }
                </span>
                <div>
                    <strong>Download the music</strong>
                    <p>Open the playlist and click Download missing. Each track is fetched by the
                        plugin waterfall and quality-checked before it lands on your disk.</p>
                    <small>@(step2Done ? $"{downloadedCount} track{(downloadedCount == 1 ? "" : "s")} downloaded" : "Nothing downloaded yet")</small>
                </div>
                <span class="workflow-arrow"><Icon Name="chevron-right" Size="16" /></span>
            </a>
            @if (!IsSimple)
            {
            <a class="workflow-step @(step3Done ? "done" : "todo")" href="/sync-jobs">
                <span class="workflow-number">
                    @if (step3Done)
                    {
                        <Icon Name="check" Size="14" Class="workflow-check" />
                    }
                    else
                    {
                        @:3
                    }
                </span>
                <div>
                    <strong>Publish it</strong>
                    <p>Create a sync job that writes an M3U file or pushes the playlist to your
                        Jellyfin, Plex or Subsonic server. Jobs can run automatically on a schedule.</p>
                    <small>@(step3Done ? $"{jobsCount} job{(jobsCount == 1 ? "" : "s")} configured, last run {lastRunText}" : "No sync job yet")</small>
                </div>
            </a>
            }
        </div>
        <MountWarning />
        @if (doneSteps == stepCount)
        {
            <div class="result-box ok">
                Everything is set up. The dashboard replaces this page from now on.
            </div>
        }
    </section>

    @if (!IsSimple)
    {
    <section class="panel-card lossless-setup">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Lossless</span>
                <h2>Connect a lossless source</h2>
            </div>
            <a class="btn-modern ghost small" href="/plugins">Open plugins</a>
        </div>
        <p class="panel-description">
            Qobuz and Tidal take a token, Deezer takes an ARL. Jumo and
            Monochrome need no account at all. Optional: any enabled source
            can carry a lossless playlist.
        </p>
        <div class="lossless-links">
            <a href="/plugins#plugin-qobuz">
                <strong>Qobuz</strong><span>Paste the X-User-Auth-Token</span>
            </a>
            <a href="/plugins#plugin-deemix">
                <strong>Deezer</strong><span>Paste the arl cookie</span>
            </a>
            <a href="/plugins#plugin-tidal">
                <strong>Tidal</strong><span>Paste a token or auth.json</span>
            </a>
            <a href="/plugins#plugin-jumo">
                <strong>Jumo</strong><span>No account needed</span>
            </a>
            <a href="/plugins#plugin-monochrome">
                <strong>Monochrome</strong><span>No account needed</span>
            </a>
        </div>
        <div class="lossless-guides">
            <a href="https://docs.melodybridge.app/qobuz" target="_blank" rel="noopener">Qobuz guide <Icon Name="external" Size="11" /></a>
            <a href="https://docs.melodybridge.app/deemix" target="_blank" rel="noopener">Deezer guide <Icon Name="external" Size="11" /></a>
            <a href="https://docs.melodybridge.app/tidal" target="_blank" rel="noopener">Tidal guide <Icon Name="external" Size="11" /></a>
        </div>
    </section>
    }
}
else
{
    <section class="page-title">
        <div>
            <span class="eyebrow">Overview</span>
            <h1>Dashboard</h1>
            <p>@(IsSimple
                ? "Your music and the things that need a quick fix."
                : "Your music, the queue and everything that needs a decision.")</p>
        </div>
        <div class="topbar-actions dashboard-actions">
            <span class="dashboard-live" title="Refreshes every 5 seconds">
                <span class="status-dot online"></span> Live
            </span>
            <small class="text-muted updated-note">Updated @_lastUpdated.ToString("HH:mm:ss")</small>
            <button class="btn-modern ghost small" @onclick="@(() => RefreshStats(force: true))" title="Refresh now">
                <Icon Name="refresh" Size="14" /> Refresh
            </button>
            <a class="btn-modern primary" href="/playlists"><Icon Name="plus" Size="15" /> Add playlist</a>
        </div>
    </section>

    @if (playlistsCount == 0)
    {
        <section class="panel-card setup-resume">
            <div>
                <span class="eyebrow">First run</span>
                <h2>Start with a playlist</h2>
                <p>
                    Add a public playlist link, download its tracks, then publish
                    it to your player or media server. The setup guide walks through
                    the same three steps.
                </p>
            </div>
            <div class="flex-actions">
                <a class="btn-modern primary" href="/playlists">Add a playlist</a>
                <button class="btn-modern ghost" @onclick="ResumeIntro">Open the setup guide</button>
            </div>
        </section>
    }

    @if (attentionTotal > 0)
    {
        <section class="panel-card dashboard-attention">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Attention</span>
                    <h2>@attentionTotal item@(attentionTotal == 1 ? "" : "s") need@(attentionTotal == 1 ? "s" : "") a look</h2>
                </div>
                <a class="btn-modern ghost small" href="/attention">Review all</a>
            </div>
            <div class="attention-grid">
                @if (failedCount > 0)
                {
                    <a class="attention-item danger" href="/attention?kind=failed">
                        <span class="attention-count">@failedCount</span>
                        <span class="attention-copy">
                            <strong>Failed download@(failedCount == 1 ? "" : "s")</strong>
                            <small>No source, quality filter, corrupt file or timeout</small>
                        </span>
                        <Icon Name="chevron-right" Size="15" Class="attention-arrow" />
                    </a>
                }
                @if (!IsSimple && dedupCount > 0)
                {
                    <a class="attention-item warning" href="/attention?kind=dedup">
                        <span class="attention-count">@dedupCount</span>
                        <span class="attention-copy">
                            <strong>Hardlink decision@(dedupCount == 1 ? "" : "s")</strong>
                            <small>The track exists, but at another quality</small>
                        </span>
                        <Icon Name="chevron-right" Size="15" Class="attention-arrow" />
                    </a>
                }
                @if (!IsSimple && reviewCount > 0)
                {
                    <a class="attention-item warning" href="/attention?kind=review">
                        <span class="attention-count">@reviewCount</span>
                        <span class="attention-copy">
                            <strong>Quality review@(reviewCount == 1 ? "" : "s")</strong>
                            <small>The spectrum or length check wants a decision</small>
                        </span>
                        <Icon Name="chevron-right" Size="15" Class="attention-arrow" />
                    </a>
                }
                @if (!IsSimple && archiveIssueCount > 0)
                {
                    <a class="attention-item warning" href="/attention?kind=archive">
                        <span class="attention-count">@archiveIssueCount</span>
                        <span class="attention-copy">
                            <strong>Archive cop@(archiveIssueCount == 1 ? "y" : "ies")</strong>
                            <small>A profile copy failed or its target name is taken</small>
                        </span>
                        <Icon Name="chevron-right" Size="15" Class="attention-arrow" />
                    </a>
                }
                @if (authIssues.Count > 0)
                {
                    <a class="attention-item danger" href="/plugins">
                        <span class="attention-count">@authIssues.Count</span>
                        <span class="attention-copy">
                            <strong>Plugin login@(authIssues.Count == 1 ? "" : "s")</strong>
                            <small>A stored Qobuz, Deezer or Tidal login stopped working</small>
                        </span>
                        <Icon Name="chevron-right" Size="15" Class="attention-arrow" />
                    </a>
                }
                @if (!IsSimple && failedJobs > 0)
                {
                    <a class="attention-item danger" href="/sync-jobs">
                        <span class="attention-count">@failedJobs</span>
                        <span class="attention-copy">
                            <strong>Failed sync job@(failedJobs == 1 ? "" : "s")</strong>
                            <small>The last run did not publish the playlist</small>
                        </span>
                        <Icon Name="chevron-right" Size="15" Class="attention-arrow" />
                    </a>
                }
                @if (partialCount > 0)
                {
                    <a class="attention-item warning" href="/playlists?filter=attention">
                        <span class="attention-count">@partialCount</span>
                        <span class="attention-copy">
                            <strong>Partial sync@(partialCount == 1 ? "" : "s")</strong>
                            <small>One or more playlists could not fetch every track</small>
                        </span>
                        <Icon Name="chevron-right" Size="15" Class="attention-arrow" />
                    </a>
                }
                @if (!IsSimple && errorCount > 0)
                {
                    <a class="attention-item neutral" href="/logs">
                        <span class="attention-count">@errorCount</span>
                        <span class="attention-copy">
                            <strong>Error@(errorCount == 1 ? "" : "s") in the log</strong>
                            <small>Open the log stream for the full context</small>
                        </span>
                        <Icon Name="chevron-right" Size="15" Class="attention-arrow" />
                    </a>
                }
            </div>
            @if (!IsSimple && authIssues.Count > 0)
            {
                <div class="attention-detail">
                    <span class="eyebrow">Plugin logins</span>
                    <div class="login-issue-list">
                        @foreach (var issue in authIssues)
                        {
                            <div class="login-issue">
                                <Icon Name="alert" Size="15" />
                                <div>
                                    <strong>@issue.PluginName</strong>
                                    <span>@issue.Message</span>
                                </div>
                                <a class="btn-modern small ghost" href="/plugins#plugin-@issue.PluginId">Fix</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
    }
    else
    {
        <div class="dashboard-clear dashboard-clear-wide">
            <span class="dashboard-clear-icon"><Icon Name="check-circle" Size="20" /></span>
            <div>
                <strong>Everything looks healthy</strong>
                <span>@(errorCount == 0 ? "No errors, failed downloads, open reviews or login problems." : "No failed downloads, open reviews or login problems.")</span>
            </div>
            <a class="btn-modern ghost small" href="/attention">Open the review page</a>
        </div>
    }

    @if (!IsSimple && recentErrors.Count > 0)
    {
        <section class="panel-card dashboard-errors">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Log</span>
                    <h2>Recent errors (@errorCount)</h2>
                </div>
                <a class="btn-modern ghost small" href="/logs">Open log</a>
            </div>
            <div class="attention-error-list">
                @foreach (var entry in recentErrors)
                {
                    <a class="attention-error" href="/logs">
                        <span class="attention-error-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                        <span class="attention-error-area">@entry.Area</span>
                        <span class="attention-error-message">@LogRedactor.Redact(entry.Message)</span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="stat-grid dashboard-stats">
        <StatCard IconName="list-music" Label="Playlists" Value="@playlistsCount.ToString()"
                  Caption="Linked or imported sources" Href="/playlists" />
        <StatCard IconName="download" Label="Downloaded" Value="@downloadedCount.ToString()"
                  Caption="Ready to play" Href="/downloads" />
        <StatCard IconName="hard-drive" Label="Library size" Value="@librarySizeText"
                  Caption="@($"{libraryFileCount} file{(libraryFileCount == 1 ? "" : "s")}")"
                  Href="@(IsSimple ? null : "/library")" />
        <StatCard IconName="alert" Label="Needs attention" Value="@attentionTotal.ToString()"
                  Caption="@(attentionTotal == 0 ? "Nothing waiting" : "Open issues across the app")"
                  Href="/attention" Tone="@(attentionTotal > 0 ? "danger" : "success")" />
    </section>

    @if (!IsSimple)
    {
    <section class="content-grid two dashboard-grid">
        <div class="panel-card dashboard-activity">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Activity</span>
                    <h2>Downloads and sync runs</h2>
                </div>
                <a class="btn-modern ghost small" href="/downloads">Download queue</a>
            </div>

            @if (downloadSummary.Runs > 0)
            {
                <div class="activity-live">
                    <div class="activity-live-head">
                        <span class="status-dot online"></span>
                        <strong>@downloadSummary.Headline</strong>
                        <span class="text-muted">@downloadSummary.Detail</span>
                        <a class="btn-modern ghost small" href="/downloads">Open</a>
                    </div>
                    <div class="progress-track" aria-hidden="true">
                        <span style="width:@downloadSummary.Percent%"></span>
                    </div>
                    @foreach (var run in activeRuns)
                    {
                        <div class="active-run-row">
                            <span class="active-run-name">@run.PlaylistName</span>
                            <small>@(string.IsNullOrWhiteSpace(run.CurrentTrack) ? "waiting for the next track" : run.CurrentTrack)</small>
                            <span class="active-run-count">@run.Done/@run.Total</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="activity-idle">
                    <Icon Name="clock" Size="16" />
                    <span>No active downloads. The queue is empty.</span>
                </div>
            }

            <div class="activity-section-head">
                <span class="eyebrow">Recent sync runs</span>
                <a class="text-link" href="/sync-jobs">All jobs</a>
            </div>
            @if (recentRuns.Count == 0)
            {
                <EmptyState IconName="clock" Title="No sync runs yet">No sync job has run yet.</EmptyState>
            }
            else
            {
                <div class="run-feed">
                    @foreach (var run in recentRuns)
                    {
                        <div class="run-row">
                            <span class="run-dot @(RunVariant(run.Status) == "err" ? "err" : RunVariant(run.Status) == "warn" ? "warn" : "ok")" aria-hidden="true"></span>
                            <div class="run-copy">
                                <strong>@run.JobName</strong>
                                <small>@run.Message</small>
                                @if (run.TotalTracks > 0)
                                {
                                    <small class="run-tracks">@run.ResolvedTracks of @run.TotalTracks tracks resolved</small>
                                }
                            </div>
                            <div class="run-side">
                                <StatusPill Variant="@RunVariant(run.Status)">@run.Status</StatusPill>
                                <small>@run.Timestamp.ToLocalTime().ToString("MMM d, HH:mm")</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="panel-card dashboard-connections">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Connections</span>
                    <h2>Accounts and servers</h2>
                </div>
                <a class="btn-modern ghost small" href="/settings#accounts">Manage</a>
            </div>
            <div class="connection-groups">
                <div class="connection-group">
                    <span class="connection-group-label">Accounts</span>
                    <ConnectionRow IconName="spotify" Title="Spotify"
                                   Detail="@SpotifyDetail"
                                   PillVariant="@SpotifyPillVariant"
                                   PillText="@SpotifyPillText"
                                   Enabled="@(spotifyConnected || spotifyWebConnected)" />
                    <ConnectionRow IconName="youtube" Title="YouTube"
                                   Detail="@(youtubeConnected ? "account connected" : "public playlists only")"
                                   PillVariant="@(youtubeConnected ? "connected" : "guest")"
                                   PillText="@(youtubeConnected ? "connected" : "guest")"
                                   Enabled="youtubeConnected" />
                </div>
                <div class="connection-group">
                    <span class="connection-group-label">Media servers</span>
                    @if (mediaServers.Count == 0)
                    {
                        <a class="connection-empty" href="/settings#media-servers">
                            No media server yet. Add Jellyfin, Plex or Navidrome.
                        </a>
                    }
                    else
                    {
                        @foreach (var server in mediaServers)
                        {
                            <ConnectionRow IconName="@ServerIcon(server.Kind)"
                                           Title="@ServerTitle(server)"
                                           Detail="@ServerDetail(server)"
                                           PillVariant="@ServerPillVariant(server)"
                                           PillText="@ServerPillText(server)"
                                           Enabled="@(server.State == MediaServerConnectionState.Connected)" />
                        }
                    }
                </div>
                <div class="connection-group">
                    <span class="connection-group-label">Cloudflare</span>
                    <ConnectionRow IconName="flaresolverr" Title="FlareSolverr"
                                   Detail="@(flareSolverrOn ? $"{flareSolverrUrlText}, checked by Lucida per track" : "Off: the Lucida plugin stays unavailable")"
                                   PillVariant="@(flareSolverrOn ? "ok" : "neutral")"
                                   PillText="@(flareSolverrOn ? "on" : "off")"
                                   Enabled="flareSolverrOn" />
                </div>
            </div>
        </div>
    </section>
    }

    <section class="panel-card dashboard-playlists-section">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Your music</span>
                <h2>Playlists (@playlists.Count)</h2>
            </div>
            <a class="btn-modern ghost small" href="/playlists">All playlists</a>
        </div>
        @if (partialCount > 0)
        {
            <a class="dashboard-partial" href="/playlists?filter=attention">
                <Icon Name="alert" Size="15" />
                <span>@partialCount playlist@(partialCount == 1 ? "" : "s") did not sync completely. Review the missing tracks.</span>
                <Icon Name="chevron-right" Size="15" />
            </a>
        }
        @if (playlists.Count == 0)
        {
            <EmptyState IconName="list-music" Title="No playlists yet">Add one on the Playlists page.</EmptyState>
        }
        else
        {
            <div class="playlist-grid dashboard-playlists">
                @foreach (var playlist in playlists)
                {
                    var stats = playlistStats.GetValueOrDefault(playlist.Id);
                    var percent = stats.total > 0 ? 100 * stats.downloaded / stats.total : 0;
                    <div class="panel-card playlist-card dashboard-playlist">
                        <a class="playlist-cover dashboard-cover" href="/playlists/@playlist.Id" title="Open @playlist.Name">
                            @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                            {
                                <img src="@playlist.CoverImageUrl" alt="@playlist.Name" loading="lazy" />
                            }
                            else
                            {
                                <span class="playlist-cover-placeholder"><Icon Name="music" Size="24" Class="cover-placeholder-icon" /></span>
                            }
                            @if (stats.total > 0 && stats.downloaded == stats.total)
                            {
                                <span class="cover-badge complete" title="All tracks downloaded"><Icon Name="check-circle" Size="12" /> complete</span>
                            }
                            else if (stats.downloaded > 0)
                            {
                                <span class="cover-badge partial" title="@stats.downloaded of @stats.total downloaded">@stats.downloaded/@stats.total</span>
                            }
                        </a>
                        <div class="dashboard-playlist-copy">
                            <div class="dashboard-playlist-top">
                                <span class="eyebrow">@(playlist.IsManualImport ? "Imported" : playlist.SourcePlatform.ToString())</span>
                                @if (stats.attention > 0)
                                {
                                    <StatusPill Variant="err">@stats.attention</StatusPill>
                                }
                                else if (playlist.SyncWarning is { Length: > 0 })
                                {
                                    <StatusPill Variant="warn">partial</StatusPill>
                                }
                            </div>
                            <h3><a href="/playlists/@playlist.Id">@playlist.Name</a></h3>
                            <small>@stats.downloaded of @stats.total downloaded</small>
                            <div class="mini-progress" aria-hidden="true">
                                <span style="width:@percent%"></span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private bool showIntro;
    private bool showModeChoice;
    private UiModeService? _mode;
    private InstallState? _install;
    private int playlistsCount;
    private int downloadedCount;
    private int libraryFileCount;
    private long libraryBytes;
    private string librarySizeText = "0 MB";
    private int jobsCount;
    private int failedCount;
    private int dedupCount;
    private int reviewCount;
    private int partialCount;
    private int failedJobs;
    private int archiveIssueCount;
    private int errorCount;
    private List<LogEntry> recentErrors = new();
    private bool spotifyConnected;
    private bool spotifyWebConnected;
    private bool youtubeConnected;
    private DownloadActivitySummary downloadSummary =
        DownloadActivitySummary.From(Array.Empty<DownloadRun>());
    private List<DownloadRun> activeRuns = new();
    [Inject] private IServiceProvider Services { get; set; } = default!;
