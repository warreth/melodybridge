    private long _observedVersion = -1;
    /// <summary>Ticks since the last full read: a minute bounds the
    /// staleness of numbers whose writes do not carry the stamp (the scan's
    /// own savers).</summary>
    private int _idleTicks;
    private const int StatsRefreshIdleTicks = 18;
    /// <summary>Nothing read yet; the first tick always reads.</summary>
    private bool _statsPending = true;
    /// <summary>True when Settings explicitly reopened the checklist: it then
    /// stays visible even though every step is already done.</summary>
    private bool _introRestarted;
    private Timer? _timer;
    /// <summary>The observed log stamp: a new line redraws the recent
    /// errors panel without waiting for the idle fallback.</summary>
    private long _observedLogVersion = -1;

    private bool IsSimple => _mode is { IsAdvanced: false };
    private int stepCount => IsSimple ? 2 : 3;
    private bool step1Done => playlistsCount > 0;
    private bool step2Done => downloadedCount > 0;
    private bool step3Done => jobsCount > 0;
    private int doneSteps => (step1Done ? 1 : 0) + (step2Done ? 1 : 0)
        + (!IsSimple && step3Done ? 1 : 0);
    private string lastRunText => lastRunAt.HasValue
        ? lastRunAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        : "never";
    private bool flareSolverrOn => !string.IsNullOrWhiteSpace(flareSolverrUrl)
        && !flareSolverrUrl.Equals("off", StringComparison.OrdinalIgnoreCase);

    private int attentionTotal =>
        failedCount + dedupCount + reviewCount + archiveIssueCount
        + authIssues.Count + failedJobs + partialCount;

    private string SpotifyDetail => spotifyConnected
        ? "official account connected"
        : spotifyWebConnected
            ? "free web session connected"
            : "public playlists only";

    private string SpotifyPillText => spotifyConnected
        ? "connected"
        : spotifyWebConnected ? "web session" : "guest";

    private string SpotifyPillVariant => spotifyConnected
        ? "connected"
        : spotifyWebConnected ? "ok" : "guest";

    private static string RunVariant(string status) => status switch
    {
        "Completed" => "ok",
        "CompletedWithWarning" or "Warning" => "warn",
        _ => "err",
    };

    /// <summary>Brand key for a server kind; the same icons the wizard uses.</summary>
    private static string ServerIcon(string kind) => MediaServerKinds.Canonical(kind) switch
    {
        MediaServerKinds.Plex => "plex",
        MediaServerKinds.Subsonic => "navidrome",
        _ => "jellyfin",
    };

    private static string ServerTitle(MediaServerConnectionStatus server)
        => string.IsNullOrWhiteSpace(server.Name)
           || string.Equals(server.Name, server.Kind, StringComparison.OrdinalIgnoreCase)
            ? (MediaServerKinds.Canonical(server.Kind) is { Length: > 0 } kind ? kind : "Media server")
            : server.Name;

    /// <summary>"admin on jellyfin.wath.dev", "not configured", or why it
    /// did not answer. The pill carries the state word, this carries who and
    /// where, so a connected row never just says "ready".</summary>
    private static string ServerDetail(MediaServerConnectionStatus server)
    {
        var where = !string.IsNullOrWhiteSpace(server.ServerName)
            ? server.ServerName!
            : HostOf(server.BaseUrl) ?? MediaServerKinds.Canonical(server.Kind);
        return server.State switch
        {
            MediaServerConnectionState.Connected => string.IsNullOrWhiteSpace(server.AccountName)
                ? $"connected to {where}"
                : $"{server.AccountName} on {where}",
            MediaServerConnectionState.Unreachable =>
                $"{HostOf(server.BaseUrl) ?? "server"}: "
                + (string.IsNullOrWhiteSpace(server.Reason) ? "unreachable" : server.Reason),
            MediaServerConnectionState.Checking => $"checking {where}",
            _ => "not configured",
        };
    }

    private static string ServerPillVariant(MediaServerConnectionStatus server)
        => server.State switch
        {
            MediaServerConnectionState.Connected => "connected",
            MediaServerConnectionState.Unreachable => "warn",
            _ => "neutral",
        };

    private static string ServerPillText(MediaServerConnectionStatus server)
        => server.State switch
        {
            MediaServerConnectionState.Connected => "connected",
            MediaServerConnectionState.Unreachable => "unreachable",
            MediaServerConnectionState.Checking => "checking…",
            _ => "off",
        };

    private static string? HostOf(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        var candidate = url.Contains("://", StringComparison.Ordinal) ? url : "http://" + url;
        return Uri.TryCreate(candidate, UriKind.Absolute, out var uri) && uri.Host.Length > 0
            ? (uri.IsDefaultPort ? uri.Host : $"{uri.Host}:{uri.Port}")
            : url.Trim();
    }

    /// <summary>"auto" hides the raw value: the row then says what auto
    /// does instead of showing the word the user never typed.</summary>
    private string flareSolverrUrlText =>
        flareSolverrUrl.Equals("auto", StringComparison.OrdinalIgnoreCase)
            ? "auto: looks for the container"
            : flareSolverrUrl;

    protected override async Task OnInitializedAsync()
    {
        // An explicit restart (Settings, About) reopens the checklist even
        // on a finished install; the normal path only shows it while setup
        // is incomplete.
        var dismissed = await Settings.GetBoolAsync("intro_dismissed", fallback: false);
        var restarted = await Settings.GetBoolAsync("intro_restarted", fallback: false);
        _introRestarted = restarted;
        showIntro = !dismissed || restarted;
        // The connection rows show the last answer and redraw themselves
        // when the probe has a new one: the page never waits for a media
        // server that does not answer.
        MediaProbe.Changed += OnMediaStatusChanged;

        // Load the mode before the checklist check: stepCount depends on it.
        _mode = Services.GetService<UiModeService>();
        _install = Services.GetService<InstallState>();
        if (_mode is not null)
        {
            await _mode.EnsureLoadedAsync();
            _mode.Changed += OnModeChanged;
            showModeChoice = _install is not null && !_install.DatabaseExistedAtStartup && !_mode.HasChosen;
        }

        await RefreshStats();

        // Keep the dashboard current without a manual refresh.
        if (!showIntro) StartRefreshTimer();
    }

    /// <summary>A new media server verdict: the rows show it right away.</summary>
    private void OnModeChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        if (_mode is { HasChosen: true }) showModeChoice = false;
        await RefreshStats(force: true);
        if (!showIntro) StartRefreshTimer();
        StateHasChanged();
    });

    private void OnMediaStatusChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            mediaServers = await MediaProbe.CurrentAsync();
            StateHasChanged();
        });
    }

    private async Task SkipIntro()
    {
        await Settings.SetAsync("intro_dismissed", "true");
        await Settings.SetAsync("intro_restarted", "false");
        showIntro = false;
        // The intro hid the dashboard facts (media servers, playlists);
        // the hand-over must read them once, whatever the idle gate says.
        await RefreshStats(force: true);
        StartRefreshTimer();
    }

    /// <summary>Brings the setup guide back from the empty dashboard.</summary>
    private async Task ResumeIntro()
    {
        await Settings.SetAsync("intro_restarted", "true");
        await Settings.SetAsync("intro_dismissed", "false");
        _timer?.Dispose();
        showIntro = true;
        StateHasChanged();
    }

    private void StartRefreshTimer()
    {
        _timer?.Dispose();
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            await RefreshStats();
            StateHasChanged();
        }), null, 5000, 5000);
    }

