    private static string PreviewMappedPath(
        string source, Dictionary<string, string> pathRules, Dictionary<string, string> extRules)
    {
        var options = new PlaylistOutputOptions(
            "", false, pathRules, ExtensionRemap: extRules);
        return PlaylistPathMapper.Apply(source, options) ?? source;
    }

    private static string PreviewM3uEntry(
        string mappedPath, string outputPath, bool relative, bool backslashes)
    {
        if (!relative || string.IsNullOrWhiteSpace(outputPath)) return mappedPath;
        try
        {
            var folder = Path.GetDirectoryName(outputPath) ?? ".";
            var relativePath = Path.GetRelativePath(folder, mappedPath);
            return backslashes
                ? relativePath.Replace('/', '\\')
                : relativePath.Replace('\\', '/');
        }
        catch
        {
            return mappedPath;
        }
    }

