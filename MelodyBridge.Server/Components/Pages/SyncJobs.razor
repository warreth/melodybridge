    /// <summary>
    /// Runs every job once, one after the other, keeping the page's live
    /// state per card. Sequential on purpose: the jobs share the database
    /// and the media servers, and a parallel sweep would only pile load on
    /// both. A job that fails does not stop the rest; the toast sums up.
    /// </summary>
    private async Task RunAllNow()
    {
        if (runningAll || jobs.Count == 0) return;
        runningAll = true;
        runAllDone = 0;
        runAllTotal = jobs.Count;
        var failed = 0;
        StateHasChanged();
        try
        {
            foreach (var job in jobs.ToList())
            {
                runningJobs.Add(job.Id);
                StateHasChanged();
                try
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    var entity = await db.SyncJobs.FindAsync(job.Id);
                    if (entity is null) continue;
                    var log = await JobRunner.RunJobAsync(SyncJobMapping.MapToDomain(entity));
                    if (log is { Status: MelodyBridge.Core.SyncStatus.Failed }) failed++;
                }
                catch (Exception)
                {
                    // RunJobAsync records its own failures; anything thrown
                    // past it still only costs this one job.
                    failed++;
                }
                finally
                {
                    runningJobs.Remove(job.Id);
                    runAllDone++;
                    StateHasChanged();
                }
            }
            await LoadDataAsync(preserveOrder: true);
        }
        finally
        {
            runningAll = false;
            StateHasChanged();
        }

        if (failed > 0)
            Notifications.Warn($"Ran {runAllDone} sync job{(runAllDone == 1 ? "" : "s")}; {failed} failed. Open a job's Log for the details.");
        else
            Notifications.Success($"Ran {runAllDone} sync job{(runAllDone == 1 ? "" : "s")}; every one completed.");
    }

