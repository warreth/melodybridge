    private async Task ConvertLegacyTarget(SyncTarget target)
    {
        var m3uFolder = defaultM3uFolder;
        var m3uPattern = "{job}.m3u8";
        if (target.Kind == OutputTargetType.M3uFile && target.M3uPath is { Length: > 0 } path)
        {
            m3uFolder = Path.GetDirectoryName(path) ?? defaultM3uFolder;
            m3uPattern = Path.GetFileName(path);
        }

        var profile = new SyncRuleProfile
        {
            Id = Guid.NewGuid().ToString(),
            Name = $"{TargetLabel(target.Kind)} · {draft.Name}",
            Kind = target.Kind,
            MediaServerProfileId = target.ProfileId,
            PlaylistNamePattern = target.PlaylistName ?? "{job}",
            SourceArchiveProfileId = target.SourceArchiveProfileId,
            M3uOutputFolder = m3uFolder,
            M3uFileNamePattern = m3uPattern,
            M3uRelativePaths = target.M3uRelativePaths || draft.M3uRelativePaths,
            M3uCrlf = target.M3uCrlf || draft.M3uCrlf,
            M3uBackslashes = target.M3uBackslashes || draft.M3uBackslashes,
            M3uBom = target.M3uBom || draft.M3uBom,
            PathRemapRules = target.PathRemapRules ?? RulesToDictionary(pathRules),
            ExtensionRemapRules = target.ExtensionRemapRules ?? RulesToDictionary(extRules),
        };
        await RuleProfiles.SaveAsync(profile);
        ruleProfiles = await RuleProfiles.GetAllAsync();
        if (profile.Kind == OutputTargetType.M3uFile)
        {
            draftM3uEnabled = true;
            draft.RuleProfileId = profile.Id;
        }
        else if (!selectedProfileIds.Contains(profile.Id))
        {
            selectedProfileIds.Add(profile.Id);
        }

        legacyTargets.RemoveAll(t => t.Kind == target.Kind
            && string.Equals(t.ProfileId, target.ProfileId, StringComparison.Ordinal)
            && string.Equals(t.M3uPath, target.M3uPath, StringComparison.Ordinal));
        await LoadDataAsync();
        StateHasChanged();
    }

