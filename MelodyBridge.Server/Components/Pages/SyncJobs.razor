    private string? EffectiveM3uPath(SyncJobEntity job)
    {
        var target = SyncJobMapping.TargetsOf(job)
            .FirstOrDefault(t => t.Kind == OutputTargetType.M3uFile);
        if (target?.RuleProfileId is { Length: > 0 } id
            && ruleProfiles.FirstOrDefault(p => p.Id == id) is { } profile)
        {
            return SyncRuleProfileStore.ResolveM3uPath(
                profile, job.Name, target.M3uFileNameOverride);
        }
        // A legacy job-level profile still owns its M3U target.
        if (RuleProfileOf(job) is { } legacyProfile)
            return SyncRuleProfileStore.ResolveOutputPath(legacyProfile, job.Name);
        return target?.M3uPath;
    }

