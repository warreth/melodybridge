    private void PrefillM3uPath()
    {
        if (!draftM3uEnabled) return;
        if (!string.IsNullOrWhiteSpace(draft.M3uOutputPath)) return;
        if (string.IsNullOrWhiteSpace(defaultM3uFolder)) return;

        var name = string.IsNullOrWhiteSpace(draft.Name) ? "playlist" : draft.Name.Trim();
        var used = jobs
            .SelectMany(SyncJobMapping.TargetsOf)
            .Where(t => t.Kind == OutputTargetType.M3uFile && !string.IsNullOrWhiteSpace(t.M3uPath))
            .Select(t => t.M3uPath!)
            .ToList();
        draft.M3uOutputPath = SafeFileNames.UniqueFile(
            defaultM3uFolder, name, ".m3u8", used);
