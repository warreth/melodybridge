    private async Task SaveQuickJob()
    {
        quickError = null;
        if (string.IsNullOrWhiteSpace(draft.Name))
            draft.Name = SuggestedJobName();

        // Validate every rule before saving. The checks stay separate
        // because the M3U check has a side effect (it prefills the path),
        // and an else-if chain would skip the cron check behind it.
        if (sourceType == "playlist" && string.IsNullOrWhiteSpace(selectedSourceId))
            quickError = "Choose a playlist first.";
        else if (sourceType == "folder" && string.IsNullOrWhiteSpace(selectedFolder))
            quickError = "Choose a folder first.";
        else if (!HasAnyTarget)
            quickError = "Pick at least one target: an M3U file or a media server.";

        if (quickError is null && draftM3uEnabled && QuickProfile is null
            && string.IsNullOrWhiteSpace(draft.M3uOutputPath))
        {
            PrefillM3uPath();
            if (string.IsNullOrWhiteSpace(draft.M3uOutputPath))
                quickError = "Enter the M3U output path, or choose a rule profile.";
        }
        if (quickError is null && draftM3uEnabled
            && !string.IsNullOrWhiteSpace(draft.RuleProfileId) && QuickProfile is null)
            quickError = "That rule profile no longer exists. Pick another one.";
        if (quickError is null && draft.Schedule == SyncJobSchedule.Cron
            && !ScanSchedule.TryParse(draft.CronExpression ?? "", out _))
            quickError = "Enter a valid five-field cron expression.";
        if (quickError is not null) return;
        await SaveJob();
    }

