    private async Task ApplyBulkProfile()
    {
        if (string.IsNullOrWhiteSpace(bulkRuleProfileId)) return;
        var profile = ruleProfiles.FirstOrDefault(p => p.Id == bulkRuleProfileId);
        if (profile is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var selected = selectedJobIds.ToList();
        var rows = await db.SyncJobs.Where(j => selected.Contains(j.Id)).ToListAsync();
        foreach (var entity in rows)
        {
            entity.RuleProfileId = profile.Id;
            var path = SyncRuleProfileStore.ResolveOutputPath(profile, entity.Name);
            var targets = SyncJobMapping.TargetsOf(entity)
                .Select(t => t.Kind == OutputTargetType.M3uFile ? t with { M3uPath = path } : t)
                .ToList();
            if (targets.Any(t => t.Kind == OutputTargetType.M3uFile))
                SyncJobMapping.ApplyTargets(entity, targets);
        }
        await db.SaveChangesAsync();
        await LoadDataAsync(preserveOrder: true);
        Notifications.Success($"Applied '{profile.Name}' to {rows.Count} sync job{(rows.Count == 1 ? "" : "s")}.");
    }

    private async Task ApplyBulkSchedule()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var selected = selectedJobIds.ToList();
        await db.SyncJobs.Where(j => selected.Contains(j.Id))
            .ExecuteUpdateAsync(s => s
                .SetProperty(j => j.Schedule, bulkSchedule.ToString())
                .SetProperty(j => j.CronExpression, (string?)null));
        await LoadDataAsync(preserveOrder: true);
        Notifications.Success($"Set the schedule to {bulkSchedule} for {selected.Count} job{(selected.Count == 1 ? "" : "s")}.");
    }

    private async Task ApplyBulkM3uFolder()
    {
        if (string.IsNullOrWhiteSpace(bulkM3uFolder)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var selected = selectedJobIds.ToList();
        var used = (await db.SyncJobs.AsNoTracking().ToListAsync())
            .SelectMany(SyncJobMapping.TargetsOf)
            .Where(t => t.Kind == OutputTargetType.M3uFile && !string.IsNullOrWhiteSpace(t.M3uPath))
            .Select(t => SafeFileNames.PathKey(t.M3uPath!))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var changed = 0;
        foreach (var entity in await db.SyncJobs.Where(j => selected.Contains(j.Id)).ToListAsync())
        {
            var path = SafeFileNames.UniqueFile(
                bulkM3uFolder, entity.Name, ".m3u8", used);
            used.Add(SafeFileNames.PathKey(path));
            entity.RuleProfileId = null;
            var targets = SyncJobMapping.TargetsOf(entity)
                .Where(t => t.Kind != OutputTargetType.M3uFile).ToList();
            targets.Insert(0, new SyncTarget(OutputTargetType.M3uFile, M3uPath: path));
            SyncJobMapping.ApplyTargets(entity, targets);
            changed++;
        }
        await db.SaveChangesAsync();
        await LoadDataAsync(preserveOrder: true);
        Notifications.Success($"Set a custom M3U path in '{bulkM3uFolder}' for {changed} job{(changed == 1 ? "" : "s")}.");
    }

    private async Task AddBulkServer()
    {
        if (string.IsNullOrWhiteSpace(bulkServerProfileId)) return;
        var profile = mediaServerProfiles.FirstOrDefault(p => p.Id == bulkServerProfileId);
        if (profile is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var selected = selectedJobIds.ToList();
        var changed = 0;
        foreach (var entity in await db.SyncJobs.Where(j => selected.Contains(j.Id)).ToListAsync())
        {
            var targets = SyncJobMapping.TargetsOf(entity).ToList();
            if (targets.Any(t => t.Kind != OutputTargetType.M3uFile
                    && t.ProfileId == profile.Id)) continue;
            targets.Add(new SyncTarget(KindOf(profile.Kind), ProfileId: profile.Id));
            SyncJobMapping.ApplyTargets(entity, targets);
            changed++;
        }
        await db.SaveChangesAsync();
        await LoadDataAsync(preserveOrder: true);
        Notifications.Success($"Added {profile.Name} to {changed} job{(changed == 1 ? "" : "s")}.");
    }

