    /// and jobs whose source playlist was removed have no cover.
    /// </summary>
    private PlaylistEntity? SourcePlaylist(SyncJobEntity job)
        => !string.IsNullOrWhiteSpace(job.SourceId)
            && sourceById.TryGetValue(job.SourceId, out var source) ? source : null;

    /// <summary>
    /// The M3U path starts from the Playlist output folder setting plus the
    /// job name, so the folder from Settings really is where files land.
    /// Only fills an empty field; anything typed or stored stays.
    /// </summary>
    private void PrefillM3uPath()
    {
        if (!draftM3uEnabled) return;
        if (!string.IsNullOrWhiteSpace(draft.M3uOutputPath)) return;
        if (string.IsNullOrWhiteSpace(defaultM3uFolder)) return;

        var name = string.IsNullOrWhiteSpace(draft.Name) ? "playlist" : draft.Name.Trim();
        var used = jobs
            .SelectMany(SyncJobMapping.TargetsOf)
            .Where(t => t.Kind == OutputTargetType.M3uFile && !string.IsNullOrWhiteSpace(t.M3uPath))
            .Select(t => t.M3uPath!)
            .ToList();
        draft.M3uOutputPath = SafeFileNames.UniqueFile(
            defaultM3uFolder, name, ".m3u8", used);
    }

    private async Task ReloadProfiles()
    {
        mediaServerProfiles = (await ServerProfiles.GetAllAsync()).ToList();
        PruneMissingProfiles();
    }

    /// <summary>
    /// Drops ticked profile ids that no longer exist (deleted under
    /// Settings since the job was saved) and flags the hint. A stale id has
    /// no checkbox to untick and saving filters it out, so keeping it would
    /// only block the wizard.
    /// </summary>
    private void PruneMissingProfiles()
    {
        if (selectedProfileIds.Count == 0) return;
        var existing = selectedProfileIds
            .Where(id => mediaServerProfiles.Any(p => p.Id == id))
            .ToList();
        if (existing.Count == selectedProfileIds.Count) return;
        selectedProfileIds = existing;
        droppedMissingTargets = true;
    }

    private async Task LoadDataAsync(bool preserveOrder = false)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var loaded = await db.SyncJobs.OrderByDescending(j => j.LastRunAt).ToListAsync();
        if (preserveOrder && jobOrder is { Count: > 0 })
        {
            // Running a job must not teleport its card while the user looks
            // at it: keep the order the page had.
            loaded = loaded
                .OrderBy(j => jobOrder.IndexOf(j.Id) is var i && i >= 0 ? i : int.MaxValue)
                .ThenBy(j => j.Name)
                .ToList();
        }
        else
        {
            loaded = SortJobs(loaded);
        }
        jobs = loaded;
        jobOrder = jobs.Select(j => j.Id).ToList();
        nextRunLabels = jobs.ToDictionary(j => j.Id, NextRunSuffix);
        sources = await db.Playlists.ToListAsync();
        sourceById = sources.ToDictionary(s => s.Id);
        scanFolders = await db.ScanLocations.Select(l => l.Path).ToListAsync();
        ruleProfiles = await RuleProfiles.GetAllAsync();
    }

