    private SyncJobSchedule bulkSchedule = SyncJobSchedule.Manual;
    private string bulkM3uFolder = "";
    private string bulkServerProfileId = "";
    private string previewSourcePath = "/music/Artist/Album/Song.flac";
    /// <summary>True while the M3U path follows the job name; editing the
    /// path by hand turns the auto-fill off.</summary>
    private bool m3uPathAuto;
