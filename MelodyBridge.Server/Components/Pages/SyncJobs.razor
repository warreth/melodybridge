    /// <summary>
    /// Applies a named compatibility profile to the draft. Custom keeps
    /// whatever the switches currently say.
    /// </summary>
    private void ApplyM3uPreset(string preset)
    {
        m3uPreset = preset;
        switch (preset)
        {
            case M3uPresetWidest:
                draft.M3uCrlf = true;
                draft.M3uBackslashes = false;
                draft.M3uBom = true;
                break;
            case M3uPresetCar:
                draft.M3uCrlf = true;
                draft.M3uBackslashes = true;
                draft.M3uBom = true;
                break;
            case M3uPresetPlain:
                draft.M3uCrlf = false;
                draft.M3uBackslashes = false;
                draft.M3uBom = false;
                break;
        }
    }

    private static string DetectM3uPreset(SyncJob job)
    {
        if (job.M3uCrlf && job.M3uBom && !job.M3uBackslashes) return M3uPresetWidest;
        if (job.M3uCrlf && job.M3uBom && job.M3uBackslashes) return M3uPresetCar;
        if (!job.M3uCrlf && !job.M3uBom && !job.M3uBackslashes) return M3uPresetPlain;
        return M3uPresetCustom;
    }

