    private List<RemapRule> profileExtRules = new();
    private string profilePreviewJobName = "My playlist";
    private string profilePreviewSource = "/music/Artist/Album/Song.flac";
    private string? deleteProfileId;
    private string deleteProfileName = "";
    private bool showLog;
    private string logJobName = "";
    private List<SyncJobRunEntity> logEntries = new();
    private ElementReference _logCloseButton;
    private bool _focusLog;
    private bool suppressMenuFocus;
    private HashSet<string> runningJobs = new();
    /// <summary>True while "Run all now" walks every job; the buttons and
    /// the header label read it.</summary>
    private bool runningAll;
    private int runAllDone;
    private int runAllTotal;
    /// <summary>Card grid or compact rows, kept in settings across visits.</summary>
    private string syncJobsView = "cards";
    /// <summary>Job order: last run, next run or status, kept in settings.</summary>
    private string syncJobsSort = "last-run";
    /// <summary>Small, medium or large cards, kept in settings.</summary>
    private string syncJobsCardSize = "medium";
    /// <summary>" · next run ..." per job, computed once per load (the cron
    /// walk is not free and the card re-renders often).</summary>
    private Dictionary<string, string> nextRunLabels = new();
    private bool isEditing;

    private SyncJob draft = new();
    private string sourceType = "playlist";
    private string selectedSourceId = "";
    private string selectedFolder = "";
    private HashSet<string> selectedFolders = new();
    private List<RemapRule> pathRules = new();
    private List<RemapRule> extRules = new();
    /// <summary>Media server profiles the wizard can pick from (Settings, Media servers).</summary>
    private List<MediaServerProfile> mediaServerProfiles = new();
    /// <summary>Wizard target state: the M3U switch, the ticked profiles and
    /// a legacy job's saved connection.</summary>
    private bool draftM3uEnabled;
    private const string M3uPresetWidest = "widest";
    private const string M3uPresetCar = "car";
    private const string M3uPresetPlain = "plain";
    private const string M3uPresetCustom = "custom";
    /// <summary>The M3U text preset the wizard shows; Custom reveals the
    /// three switches.</summary>
    private string m3uPreset = M3uPresetWidest;
    private List<string> selectedProfileIds = new();
    /// <summary>True when opening or reloading a job dropped a target whose
    /// profile no longer exists; the output step offers a replacement.</summary>
    private bool droppedMissingTargets;
    private bool keepLegacyConnection;
    private OutputTargetType legacyConnectionKind = OutputTargetType.JellyfinApi;
    /// <summary>The Playlist output folder setting: the M3U path prefill.</summary>
    private string defaultM3uFolder = "/app/playlists";

    protected override async Task OnInitializedAsync()
    {
        defaultM3uFolder = await Settings.GetAsync("playlist_path", "/app/playlists");
        syncJobsView = await Settings.GetAsync("syncjobs_view", "cards");
        if (syncJobsView is not ("cards" or "rows")) syncJobsView = "cards";
        syncJobsSort = await Settings.GetAsync("syncjobs_sort", "last-run");
        if (syncJobsSort is not ("last-run" or "next-run" or "status")) syncJobsSort = "last-run";
        syncJobsCardSize = await Settings.GetAsync("syncjobs_card_size", "medium");
        if (syncJobsCardSize is not ("small" or "medium" or "large")) syncJobsCardSize = "medium";
        await LoadDataAsync();
        await ReloadProfiles();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLog && showLog)
        {
            _focusLog = false;
            try
            {
                await _logCloseButton.FocusAsync();
            }
            catch
            {
                // Interop is unavailable during prerender and in some tests.
            }
        }
    }

    private async Task OnSyncJobsCardSizeChanged(ChangeEventArgs e)
    {
        var size = e.Value?.ToString() ?? "medium";
        if (size is not ("small" or "medium" or "large")) size = "medium";
        syncJobsCardSize = size;
        await Settings.SetAsync("syncjobs_card_size", size);
    }

    private async Task SetSyncJobsView(string view)
    {
        if (syncJobsView == view) return;
        syncJobsView = view;
        await Settings.SetAsync("syncjobs_view", view);
    }

    private async Task OnSyncJobsSortChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "last-run";
        syncJobsSort = value is "next-run" or "status" ? value : "last-run";
        jobs = SortJobs(jobs);
        jobOrder = jobs.Select(j => j.Id).ToList();
        await Settings.SetAsync("syncjobs_sort", syncJobsSort);
    }

    /// <summary>
    /// The list order. Last run is the default and puts never-run jobs
    /// last; next run puts manual jobs after every scheduled one; status
    /// puts failures first, then jobs that never ran, then completed runs.
    /// </summary>
    private List<SyncJobEntity> SortJobs(IEnumerable<SyncJobEntity> source)
        => syncJobsSort switch
        {
            "next-run" => source
                .OrderBy(j => NextRunOf(j) ?? DateTimeOffset.MaxValue)
                .ThenBy(j => j.Name)
                .ToList(),
            "status" => source
                .OrderBy(StatusRank)
                .ThenBy(j => j.Name)
                .ToList(),
            _ => source
                .OrderByDescending(j => j.LastRunAt ?? DateTime.MinValue)
                .ThenBy(j => j.Name)
                .ToList(),
        };

    private int StatusRank(SyncJobEntity job)
    {
        if (runningJobs.Contains(job.Id)) return 0;
        if (string.Equals(job.LastRunStatus, "Failed", StringComparison.OrdinalIgnoreCase)) return 1;
        if (string.IsNullOrWhiteSpace(job.LastRunStatus)
            || string.Equals(job.LastRunStatus, "Pending", StringComparison.OrdinalIgnoreCase)) return 2;
        if (string.Equals(job.LastRunStatus, "Completed", StringComparison.OrdinalIgnoreCase)
            && job.LastRunTotalTracks > 0 && job.LastRunResolvedTracks == 0) return 3;
        if (string.Equals(job.LastRunStatus, "Completed", StringComparison.OrdinalIgnoreCase)) return 4;
        return 5;
    }

    /// <summary>The card pill: running wins over the last recorded run.</summary>
    private string StatusLabel(SyncJobEntity job)
    {
        if (runningJobs.Contains(job.Id)) return "running";
        if (string.IsNullOrWhiteSpace(job.LastRunStatus)
            || string.Equals(job.LastRunStatus, "Pending", StringComparison.OrdinalIgnoreCase))
            return "not run yet";
        return job.LastRunStatus;
    }

    /// <summary>
    /// The pill variant. A "Completed" run that resolved nothing is not the
    /// same story as one that delivered, so it reads amber; a live run is
    /// amber too.
    /// </summary>
    private string StatusVariant(SyncJobEntity job)
    {
        if (runningJobs.Contains(job.Id)) return "warn";
        if (job.LastRunStatus == "Completed")
        {
            var barren = job.LastRunTotalTracks > 0 && job.LastRunResolvedTracks == 0;
            return barren ? "warn" : "ok";
        }
        return job.LastRunStatus == "Failed" ? "err" : "neutral";
    }

    /// <summary>The card and row menu: run history, editing and removal.</summary>
    private RenderFragment JobMenu(SyncJobEntity job) => @<text>
        <button title="Edit this job" @onclick="() => StartEditJob(job)">
            <Icon Name="pencil" Size="14" /> Edit
        </button>
        <button title="Run history" @onclick="() => ViewJobLog(job)">
            <Icon Name="terminal" Size="14" /> Log
        </button>
        <div class="card-menu-sep"></div>
        <button class="danger" title="Delete this job"
                disabled="@(runningAll || runningJobs.Contains(job.Id))"
                @onclick="() => AskDeleteJob(job)">
            <Icon Name="trash" Size="14" /> Delete
        </button>
    </text>;

    /// <summary>The playlist or folder a job publishes, for the card subtitle.</summary>
    private string SourceLabel(SyncJobEntity job)
    {
        if (job.SourceId is { Length: > 0 } sourceId
            && sources.FirstOrDefault(s => s.Id == sourceId) is { } playlist)
        {
            return playlist.Name;
        }
        if (job.SourceId is null && !string.IsNullOrWhiteSpace(job.SearchLocationPaths))
        {
            try
            {
                var paths = JsonSerializer.Deserialize<List<string>>(job.SearchLocationPaths);
                if (paths?.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p)) is { } path)
                {
                    var trimmed = path.TrimEnd('/', '\\');
                    var name = Path.GetFileName(trimmed);
                    return string.IsNullOrWhiteSpace(name) ? trimmed : name;
                }
            }
            catch (JsonException)
            {
                // A damaged row keeps a plain label instead of breaking the page.
            }
        }
        return "No source";
    }

    /// <summary>A saved playlist gets a link to its page; a folder has none.</summary>
    private string? SourceHref(SyncJobEntity job)
        => job.SourceId is { Length: > 0 } id && sources.Any(s => s.Id == id)
            ? $"/playlists/{id}"
            : null;

    /// <summary>The job name usually equals the playlist name: do not repeat it.</summary>
    private bool ShowSource(SyncJobEntity job)
        => !string.Equals(SourceLabel(job), job.Name, StringComparison.Ordinal);

    /// <summary>One compact chip per target: M3U or a media server profile.</summary>
    private List<(string Icon, string Label)> TargetChipsOf(SyncJobEntity job)
        => SyncJobMapping.TargetsOf(job).Select(target =>
        {
            if (target.Kind == OutputTargetType.M3uFile)
            {
                var ruleProfile = RuleProfileOf(job);
                return ("list-music", ruleProfile is null ? "M3U file" : $"M3U · {ruleProfile.Name}");
            }
            var profile = mediaServerProfiles.FirstOrDefault(p => p.Id == target.ProfileId);
            return (TargetIcon(profile?.Kind ?? target.Kind.ToString()),
                profile?.Name ?? TargetLabel(target.Kind));
        }).ToList();

    private static string JobSummary(SyncJobEntity job)
        => string.IsNullOrWhiteSpace(job.LastRunSummary)
            ? job.LastRunAt is null ? "This job has not run yet." : "No run summary recorded."
            : job.LastRunSummary;

    private static int JobProgressPercent(SyncJobEntity job)
        => job.LastRunTotalTracks <= 0
            ? 0
            : Math.Clamp(job.LastRunResolvedTracks * 100 / job.LastRunTotalTracks, 0, 100);

    private static string LastRunLabel(SyncJobEntity job)
        => $"Last run: {(job.LastRunAt?.ToLocalTime().ToString("g") ?? "never")}";

    private string ScheduleLabel(SyncJobEntity job)
        => $"Schedule: {job.Schedule}{nextRunLabels.GetValueOrDefault(job.Id, "")}";

    /// <summary>
    /// Runs every job once, one after the other, keeping the page's live
    /// state per card. Sequential on purpose: the jobs share the database
    /// and the media servers, and a parallel sweep would only pile load on
    /// both. A job that fails does not stop the rest; the toast sums up.
    /// </summary>
    private async Task RunAllNow()
    {
        if (runningAll || jobs.Count == 0) return;
        runningAll = true;
        runAllDone = 0;
        runAllTotal = jobs.Count;
        var failed = 0;
        StateHasChanged();
        try
        {
            foreach (var job in jobs.ToList())
            {
                runningJobs.Add(job.Id);
                StateHasChanged();
                try
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    var entity = await db.SyncJobs.FindAsync(job.Id);
                    if (entity is null) continue;
                    var log = await JobRunner.RunJobAsync(
                        SyncJobMapping.MapToDomain(entity, RuleProfileOf(entity)));
                    if (log is { Status: MelodyBridge.Core.SyncStatus.Failed }) failed++;
                }
                catch (Exception)
                {
                    // RunJobAsync records its own failures; anything thrown
                    // past it still only costs this one job.
                    failed++;
                }
                finally
                {
                    runningJobs.Remove(job.Id);
                    runAllDone++;
                    StateHasChanged();
                }
            }
            await LoadDataAsync(preserveOrder: true);
        }
        finally
        {
            runningAll = false;
            StateHasChanged();
        }

        if (failed > 0)
            Notifications.Warn($"Ran {runAllDone} sync job{(runAllDone == 1 ? "" : "s")}; {failed} failed. Open a job's Log for the details.");
        else
            Notifications.Success($"Ran {runAllDone} sync job{(runAllDone == 1 ? "" : "s")}; every one completed.");
    }

    /// <summary>The profiles the wizard currently has ticked, in profile-list order.</summary>
    private List<MediaServerProfile> SelectedProfiles
        => mediaServerProfiles.Where(p => selectedProfileIds.Contains(p.Id)).ToList();

    /// <summary>True when at least one target is chosen.</summary>
    private bool HasAnyTarget
        => draftM3uEnabled || selectedProfileIds.Count > 0 || keepLegacyConnection;

    private void ToggleProfile(string profileId, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            if (!selectedProfileIds.Contains(profileId)) selectedProfileIds.Add(profileId);
        }
        else
        {
            selectedProfileIds.Remove(profileId);
        }
    }

    private void OnM3uEnabledChanged(ChangeEventArgs e)
    {
        draftM3uEnabled = e.Value is true;
        if (draftM3uEnabled) PrefillM3uPath();
    }

    /// <summary>
    /// Applies a named compatibility profile to the draft. Custom keeps
    /// whatever the switches currently say.
    /// </summary>
    private void ApplyM3uPreset(string preset)
    {
        m3uPreset = preset;
        switch (preset)
        {
            case M3uPresetWidest:
                draft.M3uCrlf = true;
                draft.M3uBackslashes = false;
                draft.M3uBom = true;
                break;
            case M3uPresetCar:
                draft.M3uCrlf = true;
                draft.M3uBackslashes = true;
                draft.M3uBom = true;
                break;
            case M3uPresetPlain:
                draft.M3uCrlf = false;
                draft.M3uBackslashes = false;
                draft.M3uBom = false;
                break;
        }
    }

    private void OnM3uPresetChanged(ChangeEventArgs e)
    {
        var preset = e.Value as string;
        ApplyM3uPreset(preset is M3uPresetWidest or M3uPresetCar
            or M3uPresetPlain or M3uPresetCustom ? preset : M3uPresetCustom);
    }

    /// <summary>A manual switch makes the profile Custom, so the editor
    /// never claims a preset the flags no longer match.</summary>
    private void OnM3uTextOptionChanged() => m3uPreset = M3uPresetCustom;

    private static string DetectM3uPreset(SyncJob job)
    {
        if (job.M3uCrlf && job.M3uBom && !job.M3uBackslashes) return M3uPresetWidest;
        if (job.M3uCrlf && job.M3uBom && job.M3uBackslashes) return M3uPresetCar;
        if (!job.M3uCrlf && !job.M3uBom && !job.M3uBackslashes) return M3uPresetPlain;
        return M3uPresetCustom;
    }

    private string M3uPresetShortHint => m3uPreset switch
    {
        M3uPresetWidest => "UTF-8 BOM, Windows line endings, forward slashes.",
        M3uPresetCar => "UTF-8 BOM, Windows line endings, backslashes.",
        M3uPresetPlain => "No BOM, this host's line endings, forward slashes.",
        _ => "Pick the text options this player needs.",
    };

    private string M3uPresetHint => m3uPreset switch
    {
        M3uPresetWidest =>
            "UTF-8 with BOM, Windows line endings and forward slashes. Use a .m3u8 "
            + "path and tick Relative paths when the playlist travels with the music.",
        M3uPresetCar =>
            "UTF-8 with BOM, Windows line endings and backslashes. Use a .m3u8 "
            + "path and tick Relative paths. This is the car and MP4 player layout.",
        M3uPresetPlain =>
            "No BOM, this host's line endings and forward slashes, like jobs from "
            + "before the options existed. Choose Custom for CRLF without a BOM.",
        _ =>
            "Pick the text options your player needs. A .m3u8 path means UTF-8; "
            + "a BOM and CRLF help hardware players.",
    };

