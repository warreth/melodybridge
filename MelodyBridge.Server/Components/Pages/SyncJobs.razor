    {
        mediaServerProfiles = (await ServerProfiles.GetAllAsync()).ToList();
        ruleProfiles = await RuleProfiles.EnsureDefaultsAsync(
            defaultM3uFolder, mediaServerProfiles);
        archiveProfiles = (await ArchiveProfiles.GetAllAsync()).ToList();
