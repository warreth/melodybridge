@page "/sync-jobs"
@using System.Text.Json
@using MelodyBridge.Infrastructure.MediaServers
@inject ISyncJobRunner JobRunner
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@implements IDisposable

<PageTitle>Sync jobs - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Automation</span>
        <div class="title-with-help">
            <h1>Sync jobs</h1>
            <HelpTip Path="publishing#create-a-sync-job" Text="A sync job writes an M3U file or pushes a playlist to Jellyfin, Plex or Navidrome, by hand or on a schedule." />
        </div>
        <p>A sync job turns a saved playlist into an M3U file for your music player, or pushes it to Jellyfin, Plex or Navidrome.</p>
    </div>
    <div class="topbar-actions">
        <button class="btn-modern primary" @onclick="StartNewJob"><Icon Name="plus" Size="16" /> New sync job</button>
    </div>
</section>

@if (showWizard)
{
    @* No backdrop click-to-close on a five-step form: it discarded
       everything typed with one stray click. Cancel and the X remain. *@
    <div class="wizard-overlay">
        <div class="wizard-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">Step @(currentStep + 1) of 5</span>
                    <h2>@GetStepTitle()</h2>
                    @if (isEditing)
                    {
                        <span class="text-muted">Editing "@draft.Name"</span>
                    }
                </div>
                <button class="icon-button" title="Close" @onclick="CancelWizard"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                @if (currentStep == 0)
                {
                    <div class="wizard-step">
                        <div class="form-grid single">
                            <label>
                                Job name
                                <input @bind="draft.Name" placeholder="e.g. My Summer Hits" />
                            </label>
                            <label>
                                Source type
                                <select @bind="sourceType">
                                    <option value="playlist">Saved playlist</option>
                                    <option value="folder">Local folder</option>
                                </select>
                            </label>
                            @if (sourceType == "playlist")
                            {
                                <label>
                                    Source playlist
                                    <select @bind="selectedSourceId">
                                        <option value="">Select a source...</option>
                                        @foreach (var src in sources)
                                        {
                                            <option value="@src.Id">@src.Name (@(src.IsManualImport ? "Imported" : PlatformName(src.SourcePlatform)))</option>
                                        }
                                    </select>
                                </label>
                            }
                            else
                            {
                                <label>
                                    Source folder
                                    <select @bind="selectedFolder">
                                        <option value="">Choose a folder...</option>
                                        @foreach (var f in scanFolders)
                                        {
                                            <option value="@f">@f</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>
                        @if (sourceType == "playlist" && sources.Count == 0)
                        {
                            <div class="hint-box">
                                No playlists saved yet. Go to <a href="/playlists">Playlists</a> to add one first.
                            </div>
                        }
                        @if (sourceType == "folder" && scanFolders.Count == 0)
                        {
                            <div class="hint-box">
                                No scan locations yet. Add folders on the <a href="/library">Library</a> page first.
                            </div>
                        }
                    </div>
                }
                else if (currentStep == 1)
                {
                    <div class="wizard-step">
                        @if (scanFolders.Count == 0)
                        {
                            <div class="hint-box">
                                No scan locations yet. Add folders on the <a href="/library">Library</a> page first.
                            </div>
                        }
                        else
                        {
                            <div class="form-grid single">
                                @foreach (var folder in scanFolders)
                                {
                                    <label class="toggle-switch wide">
                                        <input type="checkbox"
                                               checked="@selectedFolders.Contains(folder)"
                                               @onchange="e => ToggleFolder(folder, e)" />
                                        <span class="toggle-slider"></span>
                                        <span>@folder</span>
                                    </label>
                                }
                            </div>
                            <div class="hint-box">
                                Pick the folders to search. Leave empty to search every folder.
                            </div>
                            <MountWarning />
                        }
                    </div>
                }
                else if (currentStep == 2)
                {
                    <div class="wizard-step">
                        <div class="form-grid">
                            <label>
                                Output type
                                <select @bind="draft.OutputTarget">
                                    <option value="@OutputTargetType.M3uFile">M3U File</option>
                                    <option value="@OutputTargetType.JellyfinApi">Jellyfin API</option>
                                    <option value="@OutputTargetType.PlexApi">Plex API</option>
                                    <option value="@OutputTargetType.NavidromeApi">Navidrome API</option>
                                </select>
                            </label>
                            @if (draft.OutputTarget == OutputTargetType.M3uFile)
                            {
                                <label>
                                    M3U output path
                                    <input @bind="draft.M3uOutputPath" placeholder="/app/playlists/playlist.m3u" />
                                </label>
                            }
                            else if (draft.OutputTarget == OutputTargetType.JellyfinApi)
                            {
                                <label>
                                    Jellyfin server URL
                                    <input @bind="draft.JellyfinServerUrl" placeholder="http://host.docker.internal:8096" />
                                </label>
                                <JellyfinConnect ServerUrl="@draft.JellyfinServerUrl"
                                                 Username="@wizardJellyfinUsername"
                                                 UsernameChanged="@(name => wizardJellyfinUsername = name ?? "")"
                                                 Connected="OnWizardConnected" />
                            }
                            else if (draft.OutputTarget == OutputTargetType.PlexApi)
                            {
                                <label>
                                    Plex server URL
                                    <input @bind="draft.JellyfinServerUrl" placeholder="http://host.docker.internal:32400" />
                                </label>
                                <label>
                                    Plex token
                                    <input @bind="draft.JellyfinApiKey" type="password" placeholder="X-Plex-Token" />
                                </label>
                            }
                            else if (draft.OutputTarget == OutputTargetType.NavidromeApi)
                            {
                                <label>
                                    Navidrome server URL
                                    <input @bind="draft.JellyfinServerUrl" placeholder="http://host.docker.internal:4533" />
                                </label>
                                <label>
                                    Navidrome username
                                    <input @bind="draft.JellyfinUserId" placeholder="admin" />
                                </label>
                                <label>
                                    Navidrome password
                                    <input @bind="draft.JellyfinApiKey" type="password" placeholder="password" />
                                </label>
                            }
                            <label>
                                Schedule
                                <select @bind="draft.Schedule">
                                    <option value="@SyncJobSchedule.Manual">Manual</option>
                                    <option value="@SyncJobSchedule.Hourly">Hourly</option>
                                    <option value="@SyncJobSchedule.Daily">Daily</option>
                                    <option value="@SyncJobSchedule.Weekly">Weekly</option>
                                    <option value="@SyncJobSchedule.Monthly">Monthly</option>
                                    <option value="@SyncJobSchedule.Cron">Cron</option>
                                </select>
                            </label>
                            @if (draft.Schedule == SyncJobSchedule.Cron)
                            {
                                <label>
                                    Cron expression
                                    <input @bind="draft.CronExpression" placeholder="0 3 * * *" />
                                </label>
                            }
                        </div>
                        @if (draft.OutputTarget != OutputTargetType.M3uFile)
                        {
                            <MediaServerUserPicker ServerUrl="@draft.JellyfinServerUrl"
                                                ApiKey="@draft.JellyfinApiKey"
                                                Kind="@(draft.OutputTarget switch
                                                {
                                                    OutputTargetType.PlexApi => "Plex",
                                                    OutputTargetType.NavidromeApi => "Navidrome",
                                                    _ => "Jellyfin",
                                                })"
                                                Username="@(draft.OutputTarget == OutputTargetType.NavidromeApi ? draft.JellyfinUserId : null)"
                                                ShowUserList="@(draft.OutputTarget == OutputTargetType.JellyfinApi)"
                                                UserLabel="Jellyfin user"
                                                @bind-UserId="draft.JellyfinUserId" />
                        }
                        @if (draft.Schedule == SyncJobSchedule.Cron)
                        {
                            <div class="hint-box">
                                Five-field cron with minute precision (minute hour day month weekday), for example <code>0 3 * * *</code> runs at 03:00 every night.
                            </div>
                        }
                    </div>
                }
                else if (currentStep == 3)
                {
                    <div class="wizard-step">
                        <RemapRulesEditor Title="Path"
                                          EmptyText="No rules yet."
                                          AddLabel="Add path rule"
                                          FromPlaceholder="/mnt/BackupHDD/Music"
                                          ToPlaceholder="/media/music"
                                          Rules="@pathRules" />
                        <RemapRulesEditor Title="Extension"
                                          EmptyText="No rules yet."
                                          AddLabel="Add extension rule"
                                          FromPlaceholder=".flac"
                                          ToPlaceholder=".opus"
                                          Rules="@extRules" />
                        <div class="hint-box">
                            Rules are only needed when your music player sees files under a different path or
                            extension than MelodyBridge does: for example inside a Docker container.
                            Leave empty to keep paths and extensions as they are.
                        </div>
                    </div>
                }
                else if (currentStep == 4)
                {
                    <div class="wizard-step">
                        <div class="review-list">
                            <div><strong>Name:</strong> @draft.Name</div>
                            <div><strong>Source:</strong> @(sourceType == "folder" ? selectedFolder : SourceDisplay)</div>
                            <div><strong>Search locations:</strong> @(SearchLocationSummary)</div>
                            <div><strong>Output target:</strong> @TargetLabel(draft.OutputTarget)</div>
                            @if (draft.OutputTarget == OutputTargetType.M3uFile)
                            {
                                <div><strong>M3U path:</strong> @draft.M3uOutputPath</div>
                            }
                            else
                            {
                                <div><strong>Server:</strong> @draft.JellyfinServerUrl</div>
                                @if (draft.OutputTarget == OutputTargetType.NavidromeApi)
                                {
                                    <div><strong>User:</strong> @draft.JellyfinUserId</div>
                                }
                            }
                            <div><strong>Schedule:</strong> @draft.Schedule</div>
                            @if (draft.Schedule == SyncJobSchedule.Cron && !string.IsNullOrWhiteSpace(draft.CronExpression))
                            {
                                <div><strong>Cron:</strong> @draft.CronExpression</div>
                            }
                            @if (pathRules.Count > 0)
                            {
                                <div>
                                    <strong>Path remap:</strong>
                                    @foreach (var r in pathRules)
                                    {
                                        <span>@r.From &rarr; @r.To;</span>
                                    }
                                </div>
                            }
                            @if (extRules.Count > 0)
                            {
                                <div>
                                    <strong>Extension remap:</strong>
                                    @foreach (var r in extRules)
                                    {
                                        <span>@r.From &rarr; @r.To;</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(stepError))
                {
                    <div class="hint-box wizard-error">@stepError</div>
                }
            </div>
            <div class="wizard-footer">
                <div class="flex-actions">
                    <button class="btn-modern ghost" @onclick="CancelWizard">Cancel</button>
                    @if (currentStep > 0)
                    {
                        <button class="btn-modern secondary" @onclick="PrevStep">Back</button>
                    }
                </div>
                <div class="wizard-actions">
                    @if (currentStep < 4)
                    {
                        <button class="btn-modern primary" @onclick="NextStep">Next</button>
                    }
                    else
                    {
                        <button class="btn-modern primary" @onclick="SaveJob" disabled="@saving">
                            @(saving ? "Saving..." : (isEditing ? "Save changes" : "Create sync job"))
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<section class="content-grid two">
    @foreach (var job in jobs)
    {
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">@TargetLabel(job.OutputTarget)</span>
                    <h2>@job.Name</h2>
                </div>
                @{
                    // A "Completed" run that resolved nothing is not the same
                    // story as one that delivered; the run history shows the
                    // same amber for it.
                    var barren = job.LastRunStatus == "Completed"
                        && job.LastRunTotalTracks > 0
                        && job.LastRunResolvedTracks == 0;
                    var pillVariant = job.LastRunStatus == "Completed" ? (barren ? "warn" : "ok")
                        : job.LastRunStatus == "Failed" ? "err"
                        : "neutral";
                }
                <StatusPill Variant="@pillVariant">
                    @(string.IsNullOrEmpty(job.LastRunStatus) ? "never run" : job.LastRunStatus)
                </StatusPill>
            </div>
            <p>@job.LastRunSummary</p>
            <div class="job-meta">
                <small>Last run: @(job.LastRunAt?.ToString("g") ?? "never")</small>
                <small>Schedule: @job.Schedule</small>
            </div>
            <div class="job-footer">
                <button class="btn-modern primary" @onclick="() => RunJobNow(job.Id)" disabled="@runningJobs.Contains(job.Id)">
                    <Icon Name="play" Size="14" />
                    @(runningJobs.Contains(job.Id) ? "Running..." : "Run now")
                </button>
                <button class="btn-modern secondary" @onclick="() => ViewJobLog(job)"><Icon Name="terminal" Size="14" /> Log</button>
                <button class="btn-modern ghost" @onclick="() => StartEditJob(job)"><Icon Name="pencil" Size="14" /> Edit</button>
                <button class="btn-modern ghost" @onclick="() => AskDeleteJob(job)"><Icon Name="trash" Size="14" /> Delete</button>
            </div>
        </div>
    }
</section>

@if (deleteJobId is { } doomedJobId)
{
    <ConfirmDialog Show="true"
                   Eyebrow="Delete sync job"
                   Title=@($"Delete '{deleteJobName}'?")
                   Message="The job and its run history are removed. Playlists and music files are not touched."
                   ConfirmLabel="Delete job"
                   OnConfirm=@(() => DeleteJob(doomedJobId))
                   OnCancel="CancelDeleteJob" />
}

@if (jobs.Count == 0 && !showWizard)
{
    <EmptyState IconName="clock" Title="No sync jobs yet">Click New sync job to create one.</EmptyState>
}

@if (showLog)
{
    <div class="wizard-overlay" @onclick="() => showLog = false">
        <div class="wizard-modal log-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">Run history</span>
                    <h2>@logJobName</h2>
                </div>
                <button class="icon-button" title="Close" @onclick="() => showLog = false"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                @if (logEntries.Count == 0)
                {
                    <p>No runs recorded yet.</p>
                }
                @foreach (var entry in logEntries)
                {
                    <div class="log-entry">
                        @{
                            // A run that resolved nothing is not a success
                            // story: keep green for runs that did the job.
                            var runPill = entry.Status == "Completed"
                                ? entry.TotalTracks > 0 && entry.ResolvedTracks == 0 ? "warn" : "ok"
                                : "err";
                        }
                        <StatusPill Variant="@runPill">@entry.Status</StatusPill>
                        <div>
                            <strong>@entry.Timestamp.ToString("g")</strong>
                            <p>@entry.Message</p>
                            <small>@entry.ResolvedTracks / @entry.TotalTracks tracks resolved</small>
                            @if (ParseWarnings(entry.WarningDetails) is { Count: > 0 } warnings)
                            {
                                <details>
                                    <summary>@warnings.Count @(warnings.Count == 1 ? "warning" : "warnings")</summary>
                                    <ul>
                                        @foreach (var w in warnings)
                                        {
                                            <li>@w</li>
                                        }
                                    </ul>
                                </details>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<SyncJobEntity> jobs = new();
    /// <summary>The card order the page shows, so a run does not re-sort it.</summary>
    private List<string>? jobOrder;
    private List<PlaylistEntity> sources = new();
    private List<string> scanFolders = new();
    private bool showWizard;
    private bool saving;
    private int currentStep;
    private bool showLog;
    private string logJobName = "";
    private List<SyncJobRunEntity> logEntries = new();
    private HashSet<string> runningJobs = new();
    private bool isEditing;
    private string? stepError;

    private SyncJob draft = new();
    private string sourceType = "playlist";
    private string selectedSourceId = "";
    private string selectedFolder = "";
    private HashSet<string> selectedFolders = new();
    private List<RemapRule> pathRules = new();
    private List<RemapRule> extRules = new();
    private string wizardJellyfinUsername = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync(bool preserveOrder = false)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var loaded = await db.SyncJobs.OrderByDescending(j => j.LastRunAt).ToListAsync();
        if (preserveOrder && jobOrder is { Count: > 0 })
        {
            // Running a job must not teleport its card while the user looks
            // at it: keep the order the page had.
            loaded = loaded
                .OrderBy(j => jobOrder.IndexOf(j.Id) is var i && i >= 0 ? i : int.MaxValue)
                .ThenBy(j => j.Name)
                .ToList();
        }
        jobs = loaded;
        jobOrder = jobs.Select(j => j.Id).ToList();
        sources = await db.Playlists.ToListAsync();
        scanFolders = await db.ScanLocations.Select(l => l.Path).ToListAsync();
    }

    private void StartNewJob()
    {
        draft = new SyncJob();
        isEditing = false;
        selectedSourceId = "";
        selectedFolder = "";
        sourceType = "playlist";
        selectedFolders = new HashSet<string>();
        pathRules = new List<RemapRule>();
        extRules = new List<RemapRule>();
        wizardJellyfinUsername = "";
        currentStep = 0;
        stepError = null;
        showWizard = true;
    }

    /// <summary>The connect component hands over the session token and user.</summary>
    private void OnWizardConnected(JellyfinLoginResult result)
    {
        if (!result.Succeeded) return;
        draft.JellyfinApiKey = result.Token!;
        if (!string.IsNullOrWhiteSpace(result.UserId))
            draft.JellyfinUserId = result.UserId!;
    }

    private void StartEditJob(SyncJobEntity job)
    {
        // hydrate the wizard from the stored entity so saving updates it in place
        draft = SyncJobMapping.MapToDomain(job);
        isEditing = true;
        sourceType = string.IsNullOrWhiteSpace(job.SourceId) && draft.SearchLocationPaths.Count > 0
            ? "folder" : "playlist";
        selectedSourceId = job.SourceId ?? "";
        selectedFolder = sourceType == "folder" ? draft.SearchLocationPaths.FirstOrDefault() ?? "" : "";
        // checked = stored paths only (an empty list means "every folder")
        selectedFolders = draft.SearchLocationPaths.ToHashSet();
        pathRules = draft.PathRemapRules
            .Select(kv => new RemapRule(kv.Key, kv.Value)).ToList();
        extRules = draft.ExtensionRemapRules
            .Select(kv => new RemapRule(kv.Key, kv.Value)).ToList();
        currentStep = 0;
        stepError = null;
        showWizard = true;
    }

    private void CancelWizard() { showWizard = false; }

    private string GetStepTitle() => currentStep switch
    {
        0 => "Pick your playlist",
        1 => "Where your music lives",
        2 => "Choose the output",
        3 => "Optional: fix file paths",
        4 => isEditing ? "Check and save" : "Check and create",
        _ => ""
    };

    /// <summary>The stored target name everywhere users look at it: friendly words.</summary>
    private static string TargetLabel(string target) => target switch
    {
        nameof(OutputTargetType.M3uFile) => "M3U file",
        nameof(OutputTargetType.JellyfinApi) => "Jellyfin",
        nameof(OutputTargetType.PlexApi) => "Plex",
        nameof(OutputTargetType.NavidromeApi) => "Navidrome",
        _ => target,
    };

    private static string TargetLabel(OutputTargetType target) => TargetLabel(target.ToString());

    /// <summary>Review summary of step 2. Empty selection means "no folder
    /// filter": the runner then searches every folder.</summary>
    private string SearchLocationSummary =>
        selectedFolders.SetEquals(scanFolders) && scanFolders.Count > 0 ? "All known"
        : selectedFolders.Count == 0 ? "Every folder"
        : string.Join(", ", selectedFolders);

    private void ToggleFolder(string folder, ChangeEventArgs e)
    {
        if (e.Value is true && !selectedFolders.Contains(folder))
            selectedFolders.Add(folder);
        else if (e.Value is false)
            selectedFolders.Remove(folder);
    }

    private void NextStep()
    {
        stepError = null;
        if (currentStep == 0)
        {
            // No blank-named jobs: prefill the source name so the card,
            // the delete dialog and the failure toasts always have a title.
            if (string.IsNullOrWhiteSpace(draft.Name))
                draft.Name = SuggestedJobName();
            if (sourceType == "playlist" && string.IsNullOrWhiteSpace(selectedSourceId))
            {
                stepError = "Choose a folder or a playlist first.";
                return;
            }
            if (sourceType == "folder" && string.IsNullOrWhiteSpace(selectedFolder))
            {
                stepError = "Choose a folder or a playlist first.";
                return;
            }
            if (sourceType == "folder")
            {
                // the step-1 folder IS the job's source: pre-check it, nothing else
                selectedFolders = new HashSet<string> { selectedFolder };
            }
        }
        if (currentStep == 2)
        {
            if (draft.OutputTarget == OutputTargetType.M3uFile && string.IsNullOrWhiteSpace(draft.M3uOutputPath))
            {
                stepError = "Enter the M3U output path first.";
                return;
            }
            if (draft.OutputTarget != OutputTargetType.M3uFile && string.IsNullOrWhiteSpace(draft.JellyfinServerUrl))
            {
                stepError = "Enter the server URL first.";
                return;
            }
            if (draft.OutputTarget == OutputTargetType.JellyfinApi
                && string.IsNullOrWhiteSpace(draft.JellyfinApiKey))
            {
                stepError = "Connect to Jellyfin first: sign in or use Quick Connect.";
                return;
            }
            if (draft.Schedule == SyncJobSchedule.Cron && string.IsNullOrWhiteSpace(draft.CronExpression))
            {
                stepError = "Enter a cron expression (5 fields, e.g. 0 3 * * *) first.";
                return;
            }
            if (draft.Schedule == SyncJobSchedule.Cron
                && !MelodyBridge.Core.ScanSchedule.TryParse(draft.CronExpression, out _))
            {
                // A lenient parse would silently degrade this to Manual and
                // the job would never run on its "schedule".
                stepError = $"'{draft.CronExpression}' is not a valid five-field cron expression (minute hour day month weekday, e.g. 0 3 * * *).";
                return;
            }
        }
        if (currentStep < 4) currentStep++;
    }

    private void PrevStep() { if (currentStep > 0) currentStep--; stepError = null; }

    /// <summary>A sensible default title from the picked source.</summary>
    private string SuggestedJobName()
    {
        if (sourceType == "playlist" && !string.IsNullOrWhiteSpace(selectedSourceId))
        {
            var playlist = sources.FirstOrDefault(s => s.Id == selectedSourceId);
            if (playlist?.Name is { Length: > 0 } name) return name;
        }
        if (sourceType == "folder" && !string.IsNullOrWhiteSpace(selectedFolder))
        {
            var trimmed = selectedFolder.TrimEnd('/', '\\');
            var last = trimmed.Split('/', '\\').LastOrDefault();
            if (!string.IsNullOrWhiteSpace(last)) return last!;
        }
        return "My sync job";
    }

    private async Task SaveJob()
    {
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            // folder source: the folder itself is the source; playlist source
            // keeps the checkbox selection from step 2
            var pathsList = sourceType == "folder"
                ? new List<string> { selectedFolder }
                : selectedFolders.Where(f => scanFolders.Contains(f)).ToList();
            var remapRules = RulesToDictionary(pathRules);
            var extRulesDict = RulesToDictionary(extRules);

            var entity = await db.SyncJobs.FindAsync(draft.Id);
            if (entity == null)
            {
                entity = new SyncJobEntity { Id = draft.Id };
                db.SyncJobs.Add(entity);
            }
            entity.Name = draft.Name;
            entity.SourceId = sourceType == "playlist" && !string.IsNullOrWhiteSpace(selectedSourceId)
                ? selectedSourceId : null;
            entity.SearchLocationPaths = JsonSerializer.Serialize(pathsList);
            entity.OutputTarget = draft.OutputTarget.ToString();
            entity.M3uOutputPath = draft.M3uOutputPath;
            entity.JellyfinServerUrl = draft.JellyfinServerUrl;
            entity.JellyfinApiKey = draft.JellyfinApiKey;
            entity.JellyfinUserId = draft.JellyfinUserId;
            entity.PathRemapRules = JsonSerializer.Serialize(remapRules);
            entity.ExtensionRemapRules = JsonSerializer.Serialize(extRulesDict);
            entity.Schedule = draft.Schedule.ToString();
            entity.CronExpression = draft.CronExpression;
            entity.LastRunStatus = string.IsNullOrWhiteSpace(entity.LastRunStatus) ? "Pending" : entity.LastRunStatus;
            await db.SaveChangesAsync();
            showWizard = false;
            await LoadDataAsync();
        }
        finally { saving = false; }
    }

    /// <summary>Review label for a playlist source: "Name (Imported)" or "Name (Platform)".</summary>
    private string SourceDisplay =>
        sources.FirstOrDefault(s => s.Id == selectedSourceId) is { } p
            ? $"{p.Name} ({(p.IsManualImport ? "Imported" : PlatformName(p.SourcePlatform))})"
            : selectedSourceId;

    private static string PlatformName(Platform platform) => platform switch
    {
        Platform.Spotify => "Spotify",
        Platform.YouTubeMusic => "YouTube Music",
        Platform.AppleMusic => "Apple Music",
        Platform.Tidal => "Tidal",
        Platform.AmazonMusic => "Amazon Music",
        Platform.Qobuz => "Qobuz",
        Platform.Soundcloud => "SoundCloud",
        Platform.Deezer => "Deezer",
        _ => "Unknown",
    };

    private static Dictionary<string, string> RulesToDictionary(List<RemapRule> rules) =>
        rules
            .Where(r => !string.IsNullOrWhiteSpace(r.From) && !string.IsNullOrWhiteSpace(r.To))
            .GroupBy(r => r.From.Trim())
            .ToDictionary(g => g.Key, g => g.First().To.Trim());

    private List<string>? ParseWarnings(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try { return JsonSerializer.Deserialize<List<string>>(json); }
        catch { return null; }
    }

    private async Task RunJobNow(string jobId)
    {
        runningJobs.Add(jobId);
        // the button disables before the first await; without this the
        // click handler runs its whole body before Blazor re-renders
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.SyncJobs.FindAsync(jobId);
            if (entity == null) return;
            await JobRunner.RunJobAsync(SyncJobMapping.MapToDomain(entity));
            await LoadDataAsync(preserveOrder: true);
        }
        finally { runningJobs.Remove(jobId); }
    }

    private async Task ViewJobLog(SyncJobEntity job)
    {
        logJobName = job.Name ?? "";
        await using var db = await DbFactory.CreateDbContextAsync();
        logEntries = await db.SyncJobRuns.Where(r => r.SyncJobId == job.Id).OrderByDescending(r => r.Timestamp).Take(20).ToListAsync();
        showLog = true;
    }

    // Delete flow: the card asks, the dialog confirms.
    private string? deleteJobId;
    private string deleteJobName = "";

    private void AskDeleteJob(SyncJobEntity job)
    {
        deleteJobId = job.Id;
        deleteJobName = job.Name ?? "";
    }

    private void CancelDeleteJob()
    {
        deleteJobId = null;
        StateHasChanged();
    }

    private async Task DeleteJob(string jobId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.SyncJobs.FindAsync(jobId);
        if (entity != null)
        {
            db.SyncJobs.Remove(entity);
            var runs = await db.SyncJobRuns.Where(r => r.SyncJobId == jobId).ToListAsync();
            db.SyncJobRuns.RemoveRange(runs);
            await db.SaveChangesAsync();
            await LoadDataAsync();
        }
        deleteJobId = null;
    }

    public void Dispose() { }
}
