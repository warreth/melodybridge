    {
        if (string.IsNullOrWhiteSpace(bulkRuleProfileId)) return;
        var profile = ruleProfiles.FirstOrDefault(p => p.Id == bulkRuleProfileId);
        if (profile is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var selected = selectedJobIds.ToList();
        var rows = await db.SyncJobs.Where(j => selected.Contains(j.Id)).ToListAsync();
        var changed = 0;
        foreach (var entity in rows)
        {
            var targets = SyncJobMapping.TargetsOf(entity).ToList();
            if (targets.Any(t => string.Equals(t.RuleProfileId, profile.Id, StringComparison.Ordinal)))
                continue;
            if (profile.Kind == OutputTargetType.M3uFile)
            {
                targets.RemoveAll(t => t.Kind == OutputTargetType.M3uFile);
                targets.Insert(0, BuildTarget(profile, entity.Name));
                entity.RuleProfileId = profile.Id;
            }
            else
            {
                targets.Add(BuildTarget(profile, entity.Name));
            }
            SyncJobMapping.ApplyTargets(entity, targets);
            changed++;
        }
        await db.SaveChangesAsync();
        await LoadDataAsync(preserveOrder: true);
        Notifications.Success($"Added '{profile.Name}' to {changed} sync job{(changed == 1 ? "" : "s")}.");
    }

    private async Task RemoveBulkProfile()
    {
        if (string.IsNullOrWhiteSpace(bulkRemoveRuleProfileId)) return;
        var profile = ruleProfiles.FirstOrDefault(p => p.Id == bulkRemoveRuleProfileId);
        if (profile is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var selected = selectedJobIds.ToList();
        var rows = await db.SyncJobs.Where(j => selected.Contains(j.Id)).ToListAsync();
        var changed = 0;
        foreach (var entity in rows)
        {
            var targets = SyncJobMapping.TargetsOf(entity).ToList();
            var remaining = targets
                .Where(t => !string.Equals(t.RuleProfileId, profile.Id, StringComparison.Ordinal))
                .ToList();
            if (remaining.Count == targets.Count) continue;
            if (string.Equals(entity.RuleProfileId, profile.Id, StringComparison.Ordinal))
                entity.RuleProfileId = null;
            SyncJobMapping.ApplyTargets(entity, remaining);
            changed++;
        }
        await db.SaveChangesAsync();
        await LoadDataAsync(preserveOrder: true);
        Notifications.Success($"Removed '{profile.Name}' from {changed} sync job{(changed == 1 ? "" : "s")}.");
    }

    private static SyncTarget BuildTarget(SyncRuleProfile profile, string jobName)
        => SyncRuleProfileStore.CreateTarget(profile, jobName);

    private async Task ApplyBulkSchedule()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var selected = selectedJobIds.ToList();
        await db.SyncJobs.Where(j => selected.Contains(j.Id))
            .ExecuteUpdateAsync(s => s
                .SetProperty(j => j.Schedule, bulkSchedule.ToString())
                .SetProperty(j => j.CronExpression, (string?)null));
        await LoadDataAsync(preserveOrder: true);
        Notifications.Success($"Set the schedule to {bulkSchedule} for {selected.Count} job{(selected.Count == 1 ? "" : "s")}.");
    }

    private void StartNewJob() => PrepareNewJob();

    private void PrepareNewJob()
    {
        draft = new SyncJob();
        // The first M3U publish profile is the default file target. A new
        // install with no profiles yet starts with no target and the
        // editor points at the profile button.
        draftM3uEnabled = M3uProfiles.Count > 0;
        draft.RuleProfileId = M3uProfiles.FirstOrDefault()?.Id ?? "";
        draftM3uFileNameOverride = null;
        ApplyM3uPreset(M3uPresetWidest);
        selectedProfileIds = new List<string>();
        legacyTargets = new List<SyncTarget>();
        droppedMissingTargets = false;
        keepLegacyConnection = false;
        legacyConnectionKind = OutputTargetType.JellyfinApi;
        isEditing = false;
        selectedSourceId = "";
        selectedFolder = "";
        sourceType = "playlist";
        selectedFolders = new HashSet<string>();
        pathRules = new List<RemapRule>();
        extRules = new List<RemapRule>();
        quickError = null;
        showQuickEditor = true;
    }

    private void StartEditJob(SyncJobEntity job) => PrepareEditJob(job);

    private void PrepareEditJob(SyncJobEntity job)
    {
        // The wizard owns focus; hand the menu trigger to the modal close path.
        suppressMenuFocus = true;
        // hydrate the wizard from the stored entity so saving updates it in place
        draft = SyncJobMapping.MapToDomain(job, ruleProfiles);
        var m3uTarget = draft.Targets
            .FirstOrDefault(t => t.Kind == OutputTargetType.M3uFile);
        draftM3uEnabled = m3uTarget is not null;
        if (draftM3uEnabled)
            m3uPreset = DetectM3uPreset(draft);
        else
            ApplyM3uPreset(M3uPresetWidest);
        draft.RuleProfileId = m3uTarget?.RuleProfileId ?? job.RuleProfileId ?? "";
        draft.M3uOutputPath ??= m3uTarget?.M3uPath;
        draftM3uFileNameOverride = m3uTarget?.M3uFileNameOverride;
        legacyTargets = draft.Targets
            .Where(t => string.IsNullOrWhiteSpace(t.RuleProfileId))
            .ToList();
        droppedMissingTargets = false;
        PruneLegacyTargets();
        selectedProfileIds = draft.Targets
            .Where(t => t.Kind != OutputTargetType.M3uFile
                && !string.IsNullOrWhiteSpace(t.RuleProfileId))
            .Select(t => t.RuleProfileId!)
            .Distinct()
            .ToList();
        PruneMissingProfiles();
        var inlineKind = legacyTargets
            .FirstOrDefault(t => t.Kind != OutputTargetType.M3uFile
                && string.IsNullOrWhiteSpace(t.ProfileId))?.Kind;
        keepLegacyConnection = inlineKind is not null
            && !string.IsNullOrWhiteSpace(draft.JellyfinServerUrl);
        legacyConnectionKind = inlineKind ?? OutputTargetType.JellyfinApi;
        isEditing = true;
        sourceType = string.IsNullOrWhiteSpace(job.SourceId) && draft.SearchLocationPaths.Count > 0
            ? "folder" : "playlist";
        selectedSourceId = job.SourceId ?? "";
        selectedFolder = sourceType == "folder" ? draft.SearchLocationPaths.FirstOrDefault() ?? "" : "";
        // checked = stored paths only (an empty list means "every folder")
        selectedFolders = draft.SearchLocationPaths.ToHashSet();
        pathRules = draft.PathRemapRules
            .Select(kv => new RemapRule(kv.Key, kv.Value)).ToList();
        extRules = draft.ExtensionRemapRules
            .Select(kv => new RemapRule(kv.Key, kv.Value)).ToList();
        quickError = null;
        showQuickEditor = true;
    }

    private void CloseLog()
    {
        showLog = false;
        _focusLog = false;
    }

    /// <summary>True returns focus to the menu trigger. A job action that
    /// opens the editor, log or confirm dialog answers false once, so the
    /// trigger is remembered for when that surface closes.</summary>
    private bool ShouldReturnMenuFocus()
    {
        if (!suppressMenuFocus) return true;
        suppressMenuFocus = false;
        return false;
    }

    /// <summary>The stored target name everywhere users look at it: friendly words.</summary>
    private static string TargetLabel(string target) => target switch
    {
        nameof(OutputTargetType.M3uFile) => "M3U file",
        nameof(OutputTargetType.JellyfinApi) => "Jellyfin",
        nameof(OutputTargetType.PlexApi) => "Plex",
        nameof(OutputTargetType.SubsonicApi) => "Subsonic",
        _ => target,
    };

    private static string TargetLabel(OutputTargetType target) => TargetLabel(target.ToString());

    /// <summary>A small kind icon for a target row.</summary>
    private static string TargetIcon(string? kind) => kind?.Trim().ToLowerInvariant() switch
    {
        "plex" => "hard-drive",
        "subsonic" or "navidrome" => "globe",
        _ => "server",
    };

    /// <summary>The output kind a media server profile publishes to.</summary>
    private static OutputTargetType KindOf(string? profileKind) => profileKind?.Trim().ToLowerInvariant() switch
    {
        "plex" => OutputTargetType.PlexApi,
        "subsonic" or "navidrome" => OutputTargetType.SubsonicApi,
        _ => OutputTargetType.JellyfinApi,
    };

    private void ToggleFolder(string folder, ChangeEventArgs e)
    {
        if (e.Value is true && !selectedFolders.Contains(folder))
            selectedFolders.Add(folder);
        else if (e.Value is false)
            selectedFolders.Remove(folder);
    }

    /// <summary>A sensible default title from the picked source.</summary>
    private string SuggestedJobName()
    {
        if (sourceType == "playlist" && !string.IsNullOrWhiteSpace(selectedSourceId))
        {
            var playlist = sources.FirstOrDefault(s => s.Id == selectedSourceId);
            if (playlist?.Name is { Length: > 0 } name) return name;
        }
        if (sourceType == "folder" && !string.IsNullOrWhiteSpace(selectedFolder))
        {
            var trimmed = selectedFolder.TrimEnd('/', '\\');
            var last = trimmed.Split('/', '\\').LastOrDefault();
            if (!string.IsNullOrWhiteSpace(last)) return last!;
        }
        return "My sync job";
    }

    private async Task SaveJob()
    {
        saving = true;
        try
        {
            // A profile deleted in another tab must not be stored as a
            // target: refresh and prune first, so the job never keeps a
            // dead id.
            await ReloadProfiles();

            SyncRuleProfile? m3uProfile = null;
            if (draftM3uEnabled)
            {
                m3uProfile = ruleProfiles.FirstOrDefault(p =>
                    p.Id == draft.RuleProfileId && p.Kind == OutputTargetType.M3uFile);
                if (m3uProfile is null)
                {
                    quickError = "Choose an M3U publish profile.";
                    return;
                }
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            // folder source: the folder itself is the source; playlist source
            // keeps the checkbox selection from step 2
            var pathsList = sourceType == "folder"
                ? new List<string> { selectedFolder }
                : selectedFolders.Where(f => scanFolders.Contains(f)).ToList();
            var remapRules = RulesToDictionary(pathRules);
            var extRulesDict = RulesToDictionary(extRules);

            var entity = await db.SyncJobs.FindAsync(draft.Id);
            if (entity == null)
            {
                // The scheduler anchors a never-run job here: it first runs
                // at its next scheduled time, not within a minute of saving.
                entity = new SyncJobEntity { Id = draft.Id, CreatedAt = DateTime.UtcNow };
                db.SyncJobs.Add(entity);
            }
            entity.Name = draft.Name;
            entity.SourceId = sourceType == "playlist" && !string.IsNullOrWhiteSpace(selectedSourceId)
                ? selectedSourceId : null;
            entity.SearchLocationPaths = JsonSerializer.Serialize(pathsList);
            entity.Schedule = draft.Schedule.ToString();
            entity.CronExpression = draft.CronExpression;

            // Every ticked publish profile becomes one target. A legacy
            // target stays until the user converts it, but a new profile
            // for the same destination replaces it.
            var targets = new List<SyncTarget>();
            if (m3uProfile is not null)
            {
                var m3uPath = draftM3uFileNameOverride is { Length: > 0 }
                    ? SyncRuleProfileStore.ResolveM3uPath(
                        m3uProfile, draft.Name, draftM3uFileNameOverride)
                    : null;
                targets.Add(SyncRuleProfileStore.CreateTarget(
                    m3uProfile, draft.Name, m3uPath));
            }
            foreach (var profile in SelectedPublishProfiles)
            {
                targets.Add(new SyncTarget(
                    profile.Kind,
                    ProfileId: profile.MediaServerProfileId,
                    RuleProfileId: profile.Id,
                    RuleProfileName: profile.Name,
                    SourceArchiveProfileId: profile.SourceArchiveProfileId,
                    PlaylistName: SyncRuleProfileStore.ResolvePlaylistName(profile, draft.Name),
                    PathRemapRules: profile.PathRemapRules,
                    ExtensionRemapRules: profile.ExtensionRemapRules,
                    AllowMetadataFallback: string.IsNullOrWhiteSpace(profile.SourceArchiveProfileId)));
            }
            targets.AddRange(legacyTargets
                .Where(t => !(m3uProfile is not null && t.Kind == OutputTargetType.M3uFile))
                .Where(t => !(t.Kind != OutputTargetType.M3uFile
                    && SelectedPublishProfiles.Any(p => p.Kind == t.Kind
                        && (string.IsNullOrWhiteSpace(t.ProfileId)
                            || string.Equals(p.MediaServerProfileId, t.ProfileId,
                                StringComparison.Ordinal))))));
            if (targets.Count == 0)
            {
                quickError = "Pick at least one publish profile first.";
                return;
            }
            SyncJobMapping.ApplyTargets(entity, targets);

            // Keep the legacy job-level columns in step with the first M3U
            // profile, so older readers and the preview see the same values.
            entity.RuleProfileId = m3uProfile?.Id;
            entity.M3uRelativePaths = m3uProfile?.M3uRelativePaths ?? draft.M3uRelativePaths;
            entity.M3uCrlf = m3uProfile?.M3uCrlf ?? draft.M3uCrlf;
            entity.M3uBackslashes = m3uProfile?.M3uBackslashes ?? draft.M3uBackslashes;
            entity.M3uBom = m3uProfile?.M3uBom ?? draft.M3uBom;
            entity.PathRemapRules = JsonSerializer.Serialize(
                m3uProfile?.PathRemapRules ?? remapRules);
            entity.ExtensionRemapRules = JsonSerializer.Serialize(
                m3uProfile?.ExtensionRemapRules ?? extRulesDict);
            entity.JellyfinUserId = draft.JellyfinUserId;
            var inlineReplaced = legacyTargets
                .Where(t => t.Kind != OutputTargetType.M3uFile
                    && string.IsNullOrWhiteSpace(t.ProfileId))
                .Any(t => SelectedPublishProfiles.Any(p => p.Kind == t.Kind));
            if (!keepLegacyConnection || inlineReplaced)
            {
                entity.JellyfinServerUrl = null;
                entity.JellyfinApiKey = null;
            }
            else
            {
                entity.JellyfinServerUrl = draft.JellyfinServerUrl;
                entity.JellyfinApiKey = draft.JellyfinApiKey;
            }

            entity.LastRunStatus = string.IsNullOrWhiteSpace(entity.LastRunStatus) ? "Pending" : entity.LastRunStatus;
            await db.SaveChangesAsync();
            showQuickEditor = false;
            await LoadDataAsync();
        }
        finally { saving = false; }
    }

    /// <summary>
    /// The next fire the scheduler will act on, or null for a manual job.
    /// A never-run job is anchored at its creation time, exactly like the
    /// scheduler does; a job with no anchor at all (a row from before the
    /// CreatedAt column) is due at the next poll.
    /// </summary>
    private static DateTimeOffset? NextRunOf(SyncJobEntity job)
    {
        var schedule = SyncJobMapping.ScheduleOf(job);
        if (schedule.Mode == ScanScheduleMode.Manual) return null;

        var anchor = job.LastRunAt ?? job.CreatedAt;
        var from = anchor is { } at ? new DateTimeOffset(at, TimeSpan.Zero) : DateTimeOffset.MinValue;
        if (schedule.Mode == ScanScheduleMode.Interval)
            return from.AddMinutes(schedule.IntervalMinutes ?? 0);

        var next = schedule.NextAfter(from);
        return next is { } fire && fire != DateTimeOffset.MaxValue ? fire : null;
    }

    /// <summary>" · next run &lt;time&gt;" for a scheduled job, nothing for manual.</summary>
    private static string NextRunSuffix(SyncJobEntity job)
    {
        if (SyncJobMapping.ScheduleOf(job).Mode == ScanScheduleMode.Manual) return "";
        if (NextRunOf(job) is not { } next) return " · no upcoming run";
        var local = next.ToLocalTime();
        return local <= DateTimeOffset.Now ? " · due now" : $" · next run {local:g}";
    }

    private static Dictionary<string, string> RulesToDictionary(List<RemapRule> rules) =>
        rules
            .Where(r => !string.IsNullOrWhiteSpace(r.From) && !string.IsNullOrWhiteSpace(r.To))
            .GroupBy(r => r.From.Trim())
            .ToDictionary(g => g.Key, g => g.First().To.Trim());

    private List<string>? ParseWarnings(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try { return JsonSerializer.Deserialize<List<string>>(json); }
        catch { return null; }
    }

    private async Task RunJobNow(string jobId)
    {
        runningJobs.Add(jobId);
        // the button disables before the first await; without this the
        // click handler runs its whole body before Blazor re-renders
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.SyncJobs.FindAsync(jobId);
            if (entity == null) return;
            await JobRunner.RunJobAsync(
                SyncJobMapping.MapToDomain(entity, ruleProfiles));
            await LoadDataAsync(preserveOrder: true);
        }
        finally { runningJobs.Remove(jobId); }
    }

    private async Task ViewJobLog(SyncJobEntity job)
    {
        suppressMenuFocus = true;
        logJobName = job.Name ?? "";
        await using var db = await DbFactory.CreateDbContextAsync();
        logEntries = await db.SyncJobRuns.Where(r => r.SyncJobId == job.Id).OrderByDescending(r => r.Timestamp).Take(20).ToListAsync();
        showLog = true;
        _focusLog = true;
    }

    // Delete flow: the card asks, the dialog confirms.
    private string? deleteJobId;
    private string deleteJobName = "";

    private void AskDeleteJob(SyncJobEntity job)
    {
        suppressMenuFocus = true;
        deleteJobId = job.Id;
        deleteJobName = job.Name ?? "";
    }

    private void CancelDeleteJob()
    {
        deleteJobId = null;
        StateHasChanged();
    }

    private async Task DeleteJob(string jobId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.SyncJobs.FindAsync(jobId);
        if (entity != null)
        {
            db.SyncJobs.Remove(entity);
            var runs = await db.SyncJobRuns.Where(r => r.SyncJobId == jobId).ToListAsync();
            db.SyncJobRuns.RemoveRange(runs);
            await db.SaveChangesAsync();
            await LoadDataAsync();
        }
        deleteJobId = null;
    }

    public void Dispose()
    {
        if (_mode is not null) _mode.Changed -= OnModeChanged;
    }
