@using Microsoft.Extensions.DependencyInjection
@page "/sync-jobs"
@using System.Text.Json
@using MelodyBridge.Infrastructure.MediaServers
@using MelodyBridge.Infrastructure.Services
@inject ISyncJobRunner JobRunner
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject MediaServerProfileStore ServerProfiles
@inject SyncRuleProfileStore RuleProfiles
@inject ArchiveProfileStore ArchiveProfiles
@inject SettingsStore Settings
@inject MelodyBridge.Server.Services.NotificationService Notifications
@inject IServiceProvider Services
@implements IDisposable

<PageTitle>Sync jobs - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Automation</span>
        <div class="title-with-help">
            <h1>Sync jobs</h1>
            <HelpTip Path="publishing#create-a-sync-job" Text="A sync job publishes through one or more publish profiles: an M3U file or a Jellyfin, Plex or Subsonic server (Navidrome, gonic, Airsonic, ...), by hand or on a schedule." />
        </div>
        <p>A sync job turns a saved playlist into an M3U file for your music player, or pushes it to Jellyfin, Plex or a Subsonic server, through one or more publish profiles.</p>
    </div>
    <div class="topbar-actions">
        @if (syncTab == "jobs")
        {
            @if (jobs.Count > 0)
            {
                <button class="btn-modern secondary" @onclick="RunAllNow"
                        disabled="@(runningAll || runningJobs.Count > 0)"
                        title="Run every sync job once, one after the other">
                    <Icon Name="play" Size="16" />
                    @(runningAll ? $"Running {runAllDone}/{runAllTotal}…" : "Run all now")
                </button>
            }
            <button class="btn-modern primary" @onclick="StartNewJob"><Icon Name="plus" Size="16" /> New sync job</button>
        }
        else
        {
            <button class="btn-modern primary" @onclick="StartNewProfile"><Icon Name="plus" Size="16" /> New publish profile</button>
        }
    </div>
</section>

<nav class="sync-tabs" aria-label="Sync jobs sections">
    <button class="sync-tab @(syncTab == "jobs" ? "on" : null)" @onclick='() => syncTab = "jobs"'
            aria-pressed="@(syncTab == "jobs" ? "true" : "false")">
        Jobs <span>@jobs.Count</span>
    </button>
    <button class="sync-tab @(syncTab == "profiles" ? "on" : null)" @onclick='() => syncTab = "profiles"'
            aria-pressed="@(syncTab == "profiles" ? "true" : "false")">
        Publish profiles <span>@ruleProfiles.Count</span>
    </button>
</nav>

@if (syncTab == "jobs")
{

@if (jobs.Count > 0)
{
    <section class="list-toolbar" aria-label="Sync job controls">
        <div class="list-toolbar-left with-sort">
            <span class="list-count">@jobs.Count sync job@(jobs.Count == 1 ? "" : "s")</span>
            <label class="sort-control" title="Sort sync jobs">
                <Icon Name="arrow-up-down" Size="14" />
                <select value="@syncJobsSort" @onchange="OnSyncJobsSortChanged" aria-label="Sort sync jobs">
                    <option value="last-run">Last run</option>
                    <option value="next-run">Next run</option>
                    <option value="status">Status</option>
                </select>
            </label>
        </div>
        <div class="list-toolbar-actions">
            @if (!IsSimple)
            {
                <button class="btn-modern ghost small" @onclick="ToggleBulkMode"
                        aria-pressed="@(bulkMode ? "true" : "false")">
                    <Icon Name="check" Size="14" /> @(bulkMode ? "Done selecting" : "Select jobs")
                </button>
                @if (syncJobsView == "cards")
                {
                    <label class="card-size-control" title="Card size">
                        <Icon Name="layout-grid" Size="14" />
                        <select aria-label="Sync job card size" value="@syncJobsCardSize"
                                @onchange="OnSyncJobsCardSizeChanged">
                            <option value="small">Small</option>
                            <option value="medium">Medium</option>
                            <option value="large">Large</option>
                        </select>
                    </label>
                }
                <div class="view-switch" role="group" aria-label="Sync job layout">
                    <button class="view-chip @(syncJobsView == "cards" ? "on" : null)" title="Card view"
                            aria-pressed="@(syncJobsView == "cards" ? "true" : "false")"
                            @onclick='() => SetSyncJobsView("cards")'>
                        <Icon Name="layout-grid" Size="15" /> <span>Cards</span>
                    </button>
                    <button class="view-chip @(syncJobsView == "rows" ? "on" : null)" title="Compact rows"
                            aria-pressed="@(syncJobsView == "rows" ? "true" : "false")"
                            @onclick='() => SetSyncJobsView("rows")'>
                        <Icon Name="rows" Size="15" /> <span>Rows</span>
                    </button>
                </div>
            }
        </div>
    </section>
}

@if (bulkMode && jobs.Count > 0)
{
    <section class="selection-bar sync-bulk-bar" aria-label="Bulk edit selected jobs">
        <label class="selection-all">
            <input type="checkbox" checked="@AllJobsSelected" @onchange="ToggleAllJobs" />
            Select all
        </label>
        <span class="text-muted">@selectedJobIds.Count selected</span>
        <div class="selection-actions">
            <select @bind="bulkRuleProfileId" aria-label="Publish profile to add">
                <option value="">Publish profile...</option>
                @foreach (var profile in ruleProfiles)
                {
                    <option value="@profile.Id">@profile.Name</option>
                }
            </select>
            <button class="btn-modern small" @onclick="ApplyBulkProfile"
                    disabled="@(selectedJobIds.Count == 0 || string.IsNullOrEmpty(bulkRuleProfileId))">
                Add profile
            </button>
            <select @bind="bulkRemoveRuleProfileId" aria-label="Publish profile to remove">
                <option value="">Remove profile...</option>
                @foreach (var profile in ruleProfiles)
                {
                    <option value="@profile.Id">@profile.Name</option>
                }
            </select>
            <button class="btn-modern small" @onclick="RemoveBulkProfile"
                    disabled="@(selectedJobIds.Count == 0 || string.IsNullOrEmpty(bulkRemoveRuleProfileId))">
                Remove profile
            </button>
            <select @bind="bulkSchedule" aria-label="Schedule for selected jobs">
                <option value="@SyncJobSchedule.Manual">Manual</option>
                <option value="@SyncJobSchedule.Hourly">Hourly</option>
                <option value="@SyncJobSchedule.Daily">Daily</option>
                <option value="@SyncJobSchedule.Weekly">Weekly</option>
                <option value="@SyncJobSchedule.Monthly">Monthly</option>
            </select>
            <button class="btn-modern small" @onclick="ApplyBulkSchedule"
                    disabled="@(selectedJobIds.Count == 0)">
                Set schedule
            </button>
        </div>
    </section>
}

@if (jobs.Count > 0 && syncJobsView == "rows")
{
    <section class="entity-rows">
        @foreach (var job in jobs)
        {
            var source = SourcePlaylist(job);
            <div class="entity-row sync-job-row" @key="job.Id">
                @if (bulkMode)
                {
                    <input class="row-select" type="checkbox"
                           checked="@selectedJobIds.Contains(job.Id)"
                           @onchange="e => ToggleJobSelected(job.Id, e)"
                           @onclick:stopPropagation="true"
                           aria-label="Select @job.Name" />
                }
                @if (source is not null)
                {
                    <a class="entity-row-cover sync-job-row-cover"
                       href="/playlists/@source.Id"
                       title="Open @source.Name"
                       aria-label="Open playlist @source.Name">
                        @if (!string.IsNullOrEmpty(source.CoverImageUrl))
                        {
                            <img src="@source.CoverImageUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <Icon Name="list-music" Size="18" />
                        }
                    </a>
                }
                <span class="entity-row-main">
                    <strong>@job.Name</strong>
                    <small class="job-source-line">
                        @if (ShowSource(job))
                        {
                            if (SourceHref(job) is { } sourceHref)
                            {
                                <a class="job-source-link" href="@sourceHref">@SourceLabel(job)</a>
                            }
                            else
                            {
                                <span>@SourceLabel(job)</span>
                            }
                        }
                        @foreach (var chip in TargetChipsOf(job))
                        {
                            <span class="target-inline"><Icon Name="@chip.Icon" Size="12" /> <span class="target-inline-text">@chip.Label</span></span>
                        }
                    </small>
                </span>
                <span class="entity-row-state">
                    <StatusPill Variant="@StatusVariant(job)">@StatusLabel(job)</StatusPill>
                </span>
                <span class="entity-row-meta">
                    <span>@LastRunLabel(job)</span>
                    <span>@ScheduleLabel(job)</span>
                </span>
                <span class="entity-row-actions">
                    <button class="btn-modern small primary" title="Run this job now"
                            @onclick="() => RunJobNow(job.Id)" disabled="@(runningAll || runningJobs.Contains(job.Id))">
                        <Icon Name="play" Size="14" />
                        <span class="btn-label">@(runningJobs.Contains(job.Id) ? "Running…" : "Run now")</span>
                    </button>
                    <CardMenu Label="Sync job actions"
                              ShouldFocusTriggerOnClose="ShouldReturnMenuFocus">
                        @JobMenu(job)
                    </CardMenu>
                </span>
            </div>
        }
    </section>
}
else
{
    <section class="sync-job-cards cards-@syncJobsCardSize">
        @foreach (var job in jobs)
        {
            var source = SourcePlaylist(job);
            <div class="panel-card job-card" @key="job.Id">
                <div class="panel-header">
                    <div class="sync-job-identity">
                        @if (bulkMode)
                        {
                            <input class="row-select" type="checkbox"
                                   checked="@selectedJobIds.Contains(job.Id)"
                                   @onchange="e => ToggleJobSelected(job.Id, e)"
                                   aria-label="Select @job.Name" />
                        }
                        @if (source is not null)
                        {
                            <a class="sync-job-cover"
                               href="/playlists/@source.Id"
                               title="Open @source.Name"
                               aria-label="Open playlist @source.Name">
                                @if (!string.IsNullOrEmpty(source.CoverImageUrl))
                                {
                                    <img src="@source.CoverImageUrl" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <Icon Name="list-music" Size="22" />
                                }
                            </a>
                        }
                        <div class="job-heading">
                            <h2>@job.Name</h2>
                            @if (ShowSource(job))
                            {
                                <small class="job-source-line">
                                    @if (SourceHref(job) is { } sourceHref)
                                    {
                                        <a class="job-source-link" href="@sourceHref">@SourceLabel(job)</a>
                                    }
                                    else
                                    {
                                        <span>@SourceLabel(job)</span>
                                    }
                                </small>
                            }
                        </div>
                    </div>
                    <StatusPill Variant="@StatusVariant(job)">
                        @StatusLabel(job)
                    </StatusPill>
                </div>
                <div class="target-chips">
                    @foreach (var chip in TargetChipsOf(job))
                    {
                        <span class="target-chip" title="@chip.Label"><Icon Name="@chip.Icon" Size="13" /> <span class="target-chip-text">@chip.Label</span></span>
                    }
                </div>
                @if (EffectiveM3uPath(job) is { Length: > 0 } m3uPath)
                {
                    <div class="job-output" title="M3U output path">
                        <Icon Name="list-music" Size="12" /> <code>@m3uPath</code>
                    </div>
                }
                <p class="job-summary">@JobSummary(job)</p>
                @if (job.LastRunTotalTracks > 0)
                {
                    var progressVariant = StatusVariant(job);
                    <div class="job-progress @(progressVariant == "err" ? "is-failed" : progressVariant == "warn" ? "is-warn" : "is-ok")"
                         title="@job.LastRunResolvedTracks of @job.LastRunTotalTracks tracks resolved">
                        <div class="progress-track">
                            <div class="progress-fill" style="width:@JobProgressPercent(job)%"></div>
                        </div>
                        <small>@job.LastRunResolvedTracks of @job.LastRunTotalTracks tracks resolved</small>
                    </div>
                }
                <div class="job-meta">
                    <small>@LastRunLabel(job)</small>
                    <small>@ScheduleLabel(job)</small>
                </div>
                <div class="job-footer">
                    <button class="btn-modern primary" @onclick="() => RunJobNow(job.Id)" disabled="@(runningAll || runningJobs.Contains(job.Id))">
                        <Icon Name="play" Size="14" />
                        @(runningJobs.Contains(job.Id) ? "Running..." : "Run now")
                    </button>
                    <CardMenu Label="Sync job actions"
                              ShouldFocusTriggerOnClose="ShouldReturnMenuFocus">
                        @JobMenu(job)
                    </CardMenu>
                </div>
            </div>
        }
    </section>
}

}

@if (syncTab == "profiles")
{
    <section class="settings-card sync-profiles">
        <div class="settings-head">
            <div>
                <span class="eyebrow">One profile per destination</span>
                <h2>Publish profiles</h2>
                <p class="panel-description">
                    A profile is one place a sync job publishes to: an M3U file or a
                    media server. It carries the connection, output format, playlist
                    name, source variant and path rules. A job ticks one or more
                    profiles, so each destination keeps its own rules.
                </p>
            </div>
        </div>
        @if (ruleProfiles.Count == 0)
        {
            <EmptyState IconName="sliders" Title="No publish profiles yet">
                Create one for your M3U player or a media server. A job can tick
                several profiles at once.
            </EmptyState>
        }
        else
        {
            <div class="rule-profile-list">
                @foreach (var profile in ruleProfiles)
                {
                    <div class="rule-profile-card" @key="profile.Id">
                        <div class="rule-profile-main">
                            <strong>@profile.Name</strong>
                            <StatusPill Variant="neutral">@TargetLabel(profile.Kind)</StatusPill>
                            <code>@ProfileDestination(profile)</code>
                            <small>
                                @RuleProfileJobCount(profile) job@(RuleProfileJobCount(profile) == 1 ? "" : "s")
                                · @ProfileSourceLabel(profile)
                                · @profile.PathRemapRules.Count path rule@(profile.PathRemapRules.Count == 1 ? "" : "s")
                                · @profile.ExtensionRemapRules.Count extension rule@(profile.ExtensionRemapRules.Count == 1 ? "" : "s")
                            </small>
                        </div>
                        <div class="flex-actions">
                            <button class="btn-modern small" @onclick="() => EditProfile(profile)">Edit</button>
                            <button class="btn-modern ghost small" @onclick="() => AskDeleteProfile(profile)">Delete</button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@if (showProfileEditor)
{
    <div class="wizard-overlay profile-editor-overlay">
        <div class="wizard-modal wide profile-editor-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">@(isEditingProfile ? "Edit publish profile" : "New publish profile")</span>
                    <h2>@(isEditingProfile ? profileDraft.Name : "Publish profile")</h2>
                </div>
                <button class="icon-button" title="Close" @onclick="CancelProfileEditor"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                <div class="profile-editor-grid">
                <div class="profile-editor-form">
                <div class="form-grid">
                    <label>
                        Profile name
                        <input @bind="profileDraft.Name" placeholder="Living room Jellyfin" />
                    </label>
                    <label>
                        Publishes to
                        <select @bind="profileKind">
                            <option value="@OutputTargetType.M3uFile">M3U file</option>
                            <option value="@OutputTargetType.JellyfinApi">Jellyfin</option>
                            <option value="@OutputTargetType.PlexApi">Plex</option>
                            <option value="@OutputTargetType.SubsonicApi">Subsonic</option>
                        </select>
                    </label>
                </div>
                @if (ProfileIsM3u)
                {
                    <div class="form-grid">
                        <label class="wide">
                            M3U output folder
                            <span class="path-field">
                                <input @bind="profileDraft.M3uOutputFolder" @bind:event="oninput"
                                       placeholder="/app/playlists" />
                                <FolderBrowseButton Value="@profileDraft.M3uOutputFolder"
                                                    ValueChanged="@(v => profileDraft.M3uOutputFolder = v)"
                                                    Label="the M3U output folder" />
                            </span>
                        </label>
                        <label>
                            File name pattern
                            <input @bind="profileDraft.M3uFileNamePattern" @bind:event="oninput"
                                   placeholder="{job}.m3u8" />
                            <small class="text-muted">Use <code>{job}</code> or <code>{playlist}</code> for the job name.</small>
                        </label>
                        <label class="wide">
                            Text format
                            <select value="@profilePreset" @onchange="OnProfilePresetChanged">
                                <option value="@M3uPresetWidest">Widest compatibility</option>
                                <option value="@M3uPresetCar">Windows car and MP4</option>
                                <option value="@M3uPresetPlain">Plain (old default)</option>
                                <option value="@M3uPresetCustom">Custom</option>
                            </select>
                            <small class="text-muted">@ProfilePresetHint</small>
                        </label>
                    </div>
                    <label class="toggle-switch wide">
                        <input type="checkbox" @bind="profileDraft.M3uRelativePaths" />
                        <span class="toggle-slider"></span>
                        <span>Relative paths in the M3U</span>
                    </label>
                    @if (profilePreset == M3uPresetCustom)
                    {
                        <div class="form-grid">
                            <label class="toggle-switch wide">
                                <input type="checkbox" @bind="profileDraft.M3uCrlf" />
                                <span class="toggle-slider"></span>
                                <span>Windows line endings (CRLF)</span>
                            </label>
                            <label class="toggle-switch wide">
                                <input type="checkbox" @bind="profileDraft.M3uBackslashes" />
                                <span class="toggle-slider"></span>
                                <span>Backslashes in relative paths</span>
                            </label>
                            <label class="toggle-switch wide">
                                <input type="checkbox" @bind="profileDraft.M3uBom" />
                                <span class="toggle-slider"></span>
                                <span>UTF-8 BOM</span>
                            </label>
                        </div>
                    }
                }
                else
                {
                    <div class="form-grid">
                        <label class="wide">
                            Media server
                            <select @bind="profileMediaServerProfileId">
                                <option value="">Choose a server...</option>
                                @foreach (var server in mediaServerProfiles.Where(p =>
                                    KindOf(p.Kind).ToString() == profileKind))
                                {
                                    <option value="@server.Id">@server.Name (@server.Kind)</option>
                                }
                            </select>
                            <small class="text-muted">
                                The connection lives in Settings, Media servers. This profile
                                keeps the rules for this one destination.
                            </small>
                        </label>
                        <label>
                            Playlist name
                            <input @bind="profilePlaylistNamePattern" @bind:event="oninput"
                                   placeholder="{job}" />
                            <small class="text-muted">Use <code>{job}</code> or <code>{playlist}</code> for the job name.</small>
                        </label>
                    </div>
                }
                <label class="wide">
                    Source
                    <select @bind="profileSourceArchiveProfileId">
                        <option value="">Primary library</option>
                        <option value="@SyncSourceVariants.DefaultArchive">Default archive</option>
                        @foreach (var archive in archiveProfiles)
                        {
                            <option value="@archive.Id">@archive.Name (@archive.RootPath)@(archive.Enabled ? "" : " (off)")</option>
                        }
                    </select>
                    <small class="text-muted">
                        Optional. Leave it on Primary library unless this profile
                        should publish an archive copy. Missing archive copies are
                        skipped, never replaced by the primary.
                    </small>
                </label>
                <div class="hint-box">
                    @if (ProfileIsM3u)
                    {
                        <span>
                            Path rules change what the player sees. The left side is the path
                            MelodyBridge stores; the right side is the path your player uses.
                        </span>
                    }
                    else
                    {
                        <span>
                            Most media servers resolve tracks by metadata. Add path rules
                            only when this server sees files under a different path or
                            extension.
                        </span>
                    }
                </div>
                @if (!IsSimple)
                {
                    <RemapRulesEditor Title="Path remap"
                                      EmptyText="No path rules. Paths stay as they are."
                                      AddLabel="Add path rule"
                                      FromPlaceholder="/music"
                                      ToPlaceholder="/media/music"
                                      Rules="@profilePathRules" />
                    <RemapRulesEditor Title="Extension remap"
                                      EmptyText="No extension rules."
                                      AddLabel="Add extension rule"
                                      FromPlaceholder=".flac"
                                      ToPlaceholder=".mp3"
                                      Rules="@profileExtRules" />
                }
                else
                {
                    <details class="quick-folders">
                        <summary>Path rules (optional)</summary>
                        <RemapRulesEditor Title="Path remap"
                                          EmptyText="No path rules. Paths stay as they are."
                                          AddLabel="Add path rule"
                                          FromPlaceholder="/music"
                                          ToPlaceholder="/media/music"
                                          Rules="@profilePathRules" />
                        <RemapRulesEditor Title="Extension remap"
                                          EmptyText="No extension rules."
                                          AddLabel="Add extension rule"
                                          FromPlaceholder=".flac"
                                          ToPlaceholder=".mp3"
                                          Rules="@profileExtRules" />
                    </details>
                }
                </div>
                <div class="profile-editor-preview">
                <div class="rule-preview">
                    <span class="eyebrow">Preview</span>
                    <div class="form-grid single">
                        <label>
                            Example job name
                            <input @bind="profilePreviewJobName" @bind:event="oninput" />
                        </label>
                        <label>
                            Example source path
                            <input @bind="profilePreviewSource" @bind:event="oninput" />
                        </label>
                    </div>
                    <dl class="rule-preview-list">
                        @if (ProfileIsM3u)
                        {
                            <div><dt>M3U file</dt><dd><code>@ProfilePreviewOutputPath</code></dd></div>
                            <div><dt>Source</dt><dd>@ProfilePreviewSourceVariant</dd></div>
                            <div><dt>Player path</dt><dd><code>@ProfilePreviewMappedPath</code></dd></div>
                            <div><dt>M3U entry</dt><dd><code>@ProfilePreviewEntry</code></dd></div>
                        }
                        else
                        {
                            <div><dt>Playlist name</dt><dd>@ProfilePreviewPlaylistName</dd></div>
                            <div><dt>Source</dt><dd>@ProfilePreviewSourceVariant</dd></div>
                            <div><dt>Server path</dt><dd><code>@ProfilePreviewMappedPath</code></dd></div>
                        }
                    </dl>
                </div>
                </div>
                </div>
                @if (!string.IsNullOrEmpty(profileError))
                {
                    <div class="hint-box danger">@profileError</div>
                }
            </div>
            <div class="wizard-footer">
                <div class="flex-actions">
                    <button class="btn-modern ghost" @onclick="CancelProfileEditor">Cancel</button>
                </div>
                <div class="wizard-actions">
                    <button class="btn-modern primary" @onclick="SaveProfile" disabled="@savingProfile">
                        @(savingProfile ? "Saving..." : "Save profile")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showQuickEditor)
{
    <div class="wizard-overlay">
        <div class="wizard-modal wide job-quick-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">@(isEditing ? "Edit sync job" : "New sync job")</span>
                    <h2>@(isEditing ? draft.Name : "Create a sync job")</h2>
                </div>
                <button class="icon-button" title="Close" @onclick="CancelQuickEditor"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                <div class="job-quick-grid">
                    <section class="quick-section">
                        <span class="eyebrow">Basics</span>
                        <label>
                            Job name
                            <input @bind="draft.Name" @bind:event="oninput"
                                   placeholder="e.g. My Summer Hits" />
                        </label>
                        <label>
                            Source type
                            <select @bind="sourceType">
                                <option value="playlist">Saved playlist</option>
                                <option value="folder">Local folder</option>
                            </select>
                        </label>
                        @if (sourceType == "playlist")
                        {
                            <label>
                                Source playlist
                                <select @bind="selectedSourceId">
                                    <option value="">Select a source...</option>
                                    @foreach (var src in sources)
                                    {
                                        <option value="@src.Id">@src.Name (@(src.IsManualImport ? "Imported" : PlatformNames.Display(src.SourcePlatform)))</option>
                                    }
                                </select>
                            </label>
                            @if (sources.Count == 0)
                            {
                                <div class="hint-box">
                                    No playlists saved yet. Add one on the
                                    <a href="/playlists">Playlists</a> page first.
                                </div>
                            }
                        }
                        else
                        {
                            <label>
                                Source folder
                                <select @bind="selectedFolder">
                                    <option value="">Choose a folder...</option>
                                    @foreach (var f in scanFolders)
                                    {
                                        <option value="@f">@f</option>
                                    }
                                </select>
                            </label>
                            @if (scanFolders.Count == 0)
                            {
                                <div class="hint-box">
                                    No scan locations yet. Add folders on the
                                    <a href="/library">Library</a> page first.
                                </div>
                            }
                            else
                            {
                                <MountWarning />
                            }
                        }
                        @if (scanFolders.Count > 0)
                        {
                            <details class="quick-folders">
                                <summary>Search folders (@(selectedFolders.Count == 0 ? "all" : selectedFolders.Count.ToString()))</summary>
                                @foreach (var folder in scanFolders)
                                {
                                    <label class="toggle-switch wide">
                                        <input type="checkbox"
                                               checked="@selectedFolders.Contains(folder)"
                                               @onchange="e => ToggleFolder(folder, e)" />
                                        <span class="toggle-slider"></span>
                                        <span>@folder</span>
                                    </label>
                                }
                                <small class="text-muted">Leave all unticked to search every folder.</small>
                            </details>
                        }
                        <div class="quick-divider"></div>
                        <span class="eyebrow">Schedule</span>
                        <label>
                            Run
                            <select @bind="draft.Schedule">
                                <option value="@SyncJobSchedule.Manual">Manual</option>
                                <option value="@SyncJobSchedule.Hourly">Hourly</option>
                                <option value="@SyncJobSchedule.Daily">Daily</option>
                                <option value="@SyncJobSchedule.Weekly">Weekly</option>
                                <option value="@SyncJobSchedule.Monthly">Monthly</option>
                                <option value="@SyncJobSchedule.Cron">Cron</option>
                            </select>
                        </label>
                        @if (draft.Schedule == SyncJobSchedule.Cron)
                        {
                            <label>
                                Cron expression
                                <input @bind="draft.CronExpression" placeholder="0 3 * * *" />
                            </label>
                        }
                    </section>

                    <section class="quick-section">
                        <span class="eyebrow">Publish to</span>
                        <label class="toggle-switch wide">
                            <input type="checkbox" checked="@draftM3uEnabled" @onchange="OnM3uEnabledChanged" />
                            <span class="toggle-slider"></span>
                            <span>M3U file</span>
                        </label>
                        @if (draftM3uEnabled)
                        {
                            <label>
                                M3U publish profile
                                <select @bind="draft.RuleProfileId" aria-label="M3U publish profile">
                                    <option value="">Choose a profile...</option>
                                    @foreach (var profile in M3uProfiles)
                                    {
                                        <option value="@profile.Id">@profile.Name</option>
                                    }
                                </select>
                            </label>
                            @if (QuickProfile is { } linkedProfile)
                            {
                                <div class="hint-box">
                                    Output path and format come from <strong>@linkedProfile.Name</strong>.
                                    <button class="link-button" type="button" @onclick="() => EditProfile(linkedProfile)">Edit profile</button>
                                </div>
                                <label class="target-path">
                                    M3U output path
                                    <input value="@QuickOutputPath" readonly />
                                </label>
                            }
                            else
                            {
                                <div class="hint-box">
                                    No M3U publish profile yet. Create one to set the folder,
                                    file name and text format.
                                    <button class="link-button" type="button" @onclick="StartNewProfile">New publish profile</button>
                                </div>
                            }
                        }
                        @if (ServerPublishProfiles.Count == 0)
                        {
                            <small class="text-muted">
                                No media server publish profiles yet. Create one here or add a
                                media server in <a href="/settings#media-servers">Settings, Media servers</a>.
                            </small>
                        }
                        else
                        {
                            @foreach (var profile in ServerPublishProfiles)
                            {
                                <label class="toggle-switch wide">
                                    <input type="checkbox"
                                           checked="@selectedProfileIds.Contains(profile.Id)"
                                           @onchange="e => ToggleProfile(profile.Id, e)" />
                                    <span class="toggle-slider"></span>
                                    <span>
                                        @profile.Name
                                        <small class="text-muted">@TargetLabel(profile.Kind) · @ProfileSourceLabel(profile)</small>
                                    </span>
                                </label>
                            }
                        }
                        @if (legacyTargets.Count > 0)
                        {
                            <div class="hint-box">
                                This job still has @legacyTargets.Count legacy target@(legacyTargets.Count == 1 ? "" : "s")
                                saved before publish profiles. They keep working, but the editor
                                needs a profile to save them again.
                            </div>
                            @foreach (var target in legacyTargets)
                            {
                                <div class="target-path">
                                    <span>@TargetLabel(target.Kind) (legacy)</span>
                                    @if (target.Kind == OutputTargetType.M3uFile
                                        || !string.IsNullOrWhiteSpace(target.ProfileId))
                                    {
                                        <button class="link-button" type="button"
                                                @onclick="() => ConvertLegacyTarget(target)">
                                            Convert to a profile
                                        </button>
                                    }
                                    else
                                    {
                                        <small class="text-muted">
                                            Saved connection. Add a media server profile in Settings first.
                                        </small>
                                    }
                                </div>
                            }
                        }
                        @if (droppedMissingTargets)
                        {
                            <div class="hint-box">
                                A publish profile target was removed because its profile no longer exists. Tick a replacement, then save the job.
                            </div>
                        }
                    </section>

                    <section class="quick-section">
                        <span class="eyebrow">Rules</span>
                        @{
                            var profilesInUse = new List<SyncRuleProfile>();
                            if (QuickProfile is { } fileRuleProfile) profilesInUse.Add(fileRuleProfile);
                            profilesInUse.AddRange(SelectedPublishProfiles);
                        }
                        @if (profilesInUse.Count == 0)
                        {
                            <p>No publish profile selected yet. Pick one above.</p>
                        }
                        else
                        {
                            @foreach (var profile in profilesInUse)
                            {
                                <p>
                                    <strong>@profile.Name</strong><br />
                                    @profile.PathRemapRules.Count path rules,
                                    @profile.ExtensionRemapRules.Count extension rules.
                                    @if (!string.IsNullOrWhiteSpace(profile.SourceArchiveProfileId))
                                    {
                                        <span>Source: @ProfileSourceLabel(profile).</span>
                                    }
                                </p>
                                <button class="btn-modern small" type="button" @onclick="() => EditProfile(profile)">
                                    Edit rules
                                </button>
                            }
                        }
                        <div class="quick-divider"></div>
                        <span class="eyebrow">Rule preview</span>
                        <label>
                            Example source path
                            <input @bind="previewSourcePath" />
                        </label>
                        @if (QuickProfile is { } previewFile)
                        {
                            <label>
                                M3U output path
                                <input value="@QuickOutputPath" readonly />
                            </label>
                            <dl class="rule-preview-list">
                                <div><dt>Player sees</dt><dd><code>@QuickMappedPath</code></dd></div>
                                <div><dt>M3U entry</dt><dd><code>@QuickM3uEntry</code></dd></div>
                            </dl>
                        }
                        else if (SelectedPublishProfiles.FirstOrDefault() is { } previewServer)
                        {
                            <dl class="rule-preview-list">
                                <div><dt>Playlist</dt><dd>@ProfilePlaylistNameFor(previewServer, draft.Name)</dd></div>
                                <div><dt>Source</dt><dd>@ProfileSourceLabel(previewServer)</dd></div>
                                <div><dt>Server path</dt><dd><code>@PreviewMappedPath(previewSourcePath, previewServer.PathRemapRules, previewServer.ExtensionRemapRules)</code></dd></div>
                            </dl>
                        }
                    </section>
                </div>
                @if (!IsSimple || legacyTargets.Count > 0 || keepLegacyConnection
                    || QuickJellyfinProfile is not null)
                {
                <details class="quick-advanced">
                    <summary><Icon Name="sliders" Size="14" /> Advanced options</summary>
                    <div class="quick-advanced-body">
                        @if (legacyTargets.Count > 0)
                        {
                            <div class="hint-box">
                                These rules apply only to the legacy targets above. New
                                targets use the rules from their publish profile.
                            </div>
                            <RemapRulesEditor Title="Legacy path remap"
                                              EmptyText="No path rules."
                                              AddLabel="Add path rule"
                                              FromPlaceholder="/music"
                                              ToPlaceholder="/media/music"
                                              Rules="@pathRules" />
                            <RemapRulesEditor Title="Legacy extension remap"
                                              EmptyText="No extension rules."
                                              AddLabel="Add extension rule"
                                              FromPlaceholder=".flac"
                                              ToPlaceholder=".mp3"
                                              Rules="@extRules" />
                        }
                        else
                        {
                            <div class="hint-box">
                                Path and extension rules live on each publish profile.
                                Open a profile above to change them.
                            </div>
                        }
                        @if (keepLegacyConnection)
                        {
                            <label class="toggle-switch wide">
                                <input type="checkbox" @bind="keepLegacyConnection" />
                                <span class="toggle-slider"></span>
                                <span>Keep the legacy connection saved in this job</span>
                            </label>
                        }
                        @if (QuickJellyfinProfile is { } quickJellyfin)
                        {
                            <MediaServerUserPicker ServerUrl="@quickJellyfin.BaseUrl"
                                                   ApiKey="@quickJellyfin.ApiKey"
                                                   Username="@draft.JellyfinUserId"
                                                   Kind="@quickJellyfin.Kind"
                                                   ShowUserList="true"
                                                   UserLabel="Jellyfin user"
                                                   @bind-UserId="draft.JellyfinUserId" />
                            <small class="text-muted">
                                This user decides whose favorites get marked on every Jellyfin target.
                            </small>
                        }
                        else if (keepLegacyConnection && legacyConnectionKind == OutputTargetType.JellyfinApi)
                        {
                            <MediaServerUserPicker ServerUrl="@draft.JellyfinServerUrl"
                                                   ApiKey="@draft.JellyfinApiKey"
                                                   Username="@draft.JellyfinUserId"
                                                   Kind="Jellyfin"
                                                   ShowUserList="true"
                                                   UserLabel="Jellyfin user"
                                                   @bind-UserId="draft.JellyfinUserId" />
                        }
                        else if (keepLegacyConnection && legacyConnectionKind == OutputTargetType.SubsonicApi)
                        {
                            <MediaServerUserPicker ServerUrl="@draft.JellyfinServerUrl"
                                                   ApiKey="@draft.JellyfinApiKey"
                                                   Username="@draft.JellyfinUserId"
                                                   Kind="Subsonic"
                                                   ShowUserList="false"
                                                   UserLabel="Navidrome username"
                                                   @bind-UserId="draft.JellyfinUserId" />
                        }
                    </div>
                </details>
                }
                @if (!string.IsNullOrEmpty(quickError))
                {
                    <div class="hint-box danger">@quickError</div>
                }
            </div>
            <div class="wizard-footer">
                <div class="flex-actions">
                    <button class="btn-modern ghost" @onclick="CancelQuickEditor">Cancel</button>
                </div>
                <div class="wizard-actions">
                    <button class="btn-modern primary" @onclick="SaveQuickJob" disabled="@saving">
                        @(saving ? "Saving..." : (isEditing ? "Save changes" : "Create sync job"))
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (deleteProfileId is { } doomedProfileId)
{
    <ConfirmDialog Show="true"
                   Eyebrow="Delete publish profile"
                   Title=@($"Delete '{deleteProfileName}'?")
                   Message="Jobs that use this profile lose that target. Add another publish profile before their next run."
                   ConfirmLabel="Delete profile"
                   OnConfirm=@(() => DeleteProfile(doomedProfileId))
                   OnCancel="CancelDeleteProfile" />
}

@if (deleteJobId is { } doomedJobId)
{
    <ConfirmDialog Show="true"
                   Eyebrow="Delete sync job"
                   Title=@($"Delete '{deleteJobName}'?")
                   Message="The job and its run history are removed. Playlists and music files are not touched."
                   ConfirmLabel="Delete job"
                   OnConfirm=@(() => DeleteJob(doomedJobId))
                   OnCancel="CancelDeleteJob" />
}

@if (jobs.Count == 0 && !showQuickEditor && syncTab == "jobs")
{
    <EmptyState IconName="clock" Title="No sync jobs yet">Click New sync job to create one.</EmptyState>
}

@if (showLog)
{
    <div class="wizard-overlay" @onclick="CloseLog">
        <div class="wizard-modal log-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">Run history</span>
                    <h2>@logJobName</h2>
                </div>
                <button class="icon-button" title="Close" @onclick="CloseLog" @ref="_logCloseButton"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                @if (logEntries.Count == 0)
                {
                    <p>No runs recorded yet.</p>
                }
                @foreach (var entry in logEntries)
                {
                    <div class="log-entry">
                        @{
                            // A run that resolved nothing is not a success
                            // story: keep green for runs that did the job.
                            var runPill = entry.Status == "Completed"
                                ? entry.TotalTracks > 0 && entry.ResolvedTracks == 0 ? "warn" : "ok"
                                : "err";
                        }
                        <StatusPill Variant="@runPill">@entry.Status</StatusPill>
                        <div>
                            <strong>@entry.Timestamp.ToString("g")</strong>
                            <p>@entry.Message</p>
                            <small>@entry.ResolvedTracks / @entry.TotalTracks tracks resolved</small>
                            @if (ParseWarnings(entry.WarningDetails) is { Count: > 0 } warnings)
                            {
                                <details>
                                    <summary>@warnings.Count @(warnings.Count == 1 ? "warning" : "warnings")</summary>
                                    <ul>
                                        @foreach (var w in warnings)
                                        {
                                            <li>@w</li>
                                        }
                                    </ul>
                                </details>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<SyncJobEntity> jobs = new();
    /// <summary>The card order the page shows, so a run does not re-sort it.</summary>
    private List<string>? jobOrder;
    private List<PlaylistEntity> sources = new();
    private Dictionary<string, PlaylistEntity> sourceById = new();
    private List<SyncRuleProfile> ruleProfiles = new();
    private List<ArchiveProfileEntity> archiveProfiles = new();
    private List<string> scanFolders = new();
    private bool showQuickEditor;
    private bool saving;
    private string syncTab = "jobs";
    private bool bulkMode;
    private HashSet<string> selectedJobIds = new();
    private string bulkRuleProfileId = "";
    private string bulkRemoveRuleProfileId = "";
    private SyncJobSchedule bulkSchedule = SyncJobSchedule.Manual;
    private string previewSourcePath = "/music/Artist/Album/Song.flac";
    private string? quickError;
    private bool showProfileEditor;
    private bool isEditingProfile;
    private bool savingProfile;
    private string profilePreset = M3uPresetWidest;
    private string? profileError;
    private SyncRuleProfile profileDraft = new();
    private List<RemapRule> profilePathRules = new();
    private List<RemapRule> profileExtRules = new();
    private string profileKind = nameof(OutputTargetType.M3uFile);
    private string profileMediaServerProfileId = "";
    private string profilePlaylistNamePattern = "{job}";
    private string profileSourceArchiveProfileId = "";
    private string profilePreviewJobName = "My playlist";
    private string profilePreviewSource = "/music/Artist/Album/Song.flac";
    private string? deleteProfileId;
    private string deleteProfileName = "";
    private bool showLog;
    private string logJobName = "";
    private List<SyncJobRunEntity> logEntries = new();
    private ElementReference _logCloseButton;
    private bool _focusLog;
    private bool suppressMenuFocus;
    private HashSet<string> runningJobs = new();
    /// <summary>True while "Run all now" walks every job; the buttons and
    /// the header label read it.</summary>
    private bool runningAll;
    private int runAllDone;
    private int runAllTotal;
    /// <summary>Card grid or compact rows, kept in settings across visits.</summary>
    private string syncJobsView = "cards";
    /// <summary>Job order: last run, next run or status, kept in settings.</summary>
    private string syncJobsSort = "last-run";
    /// <summary>Small, medium or large cards, kept in settings.</summary>
    private string syncJobsCardSize = "medium";
    /// <summary>" · next run ..." per job, computed once per load (the cron
    /// walk is not free and the card re-renders often).</summary>
    private Dictionary<string, string> nextRunLabels = new();
    private bool isEditing;
    private MelodyBridge.Server.Services.UiModeService? _mode;
    private bool IsSimple;

    private SyncJob draft = new();
    private string sourceType = "playlist";
    private string selectedSourceId = "";
    private string selectedFolder = "";
    private HashSet<string> selectedFolders = new();
    private List<RemapRule> pathRules = new();
    private List<RemapRule> extRules = new();
    /// <summary>Media server profiles the wizard can pick from (Settings, Media servers).</summary>
    private List<MediaServerProfile> mediaServerProfiles = new();
    /// <summary>Wizard target state: the M3U switch, the ticked profiles and
    /// a legacy job's saved connection.</summary>
    private bool draftM3uEnabled;
    /// <summary>Quick publish's per-job unique M3U file name, carried
    /// through an edit so the job keeps its separate file.</summary>
    private string? draftM3uFileNameOverride;
    private const string M3uPresetWidest = "widest";
    private const string M3uPresetCar = "car";
    private const string M3uPresetPlain = "plain";
    private const string M3uPresetCustom = "custom";
    /// <summary>The M3U text preset the wizard shows; Custom reveals the
    /// three switches.</summary>
    private string m3uPreset = M3uPresetWidest;
    private List<string> selectedProfileIds = new();
    /// <summary>Targets saved before publish profiles existed. They keep
    /// running through the legacy fallback and can be converted in place.</summary>
    private List<SyncTarget> legacyTargets = new();
    /// <summary>True when opening or reloading a job dropped a target whose
    /// profile no longer exists; the output step offers a replacement.</summary>
    private bool droppedMissingTargets;
    private bool keepLegacyConnection;
    private OutputTargetType legacyConnectionKind = OutputTargetType.JellyfinApi;
    /// <summary>The Playlist output folder setting: the M3U path prefill.</summary>
    private string defaultM3uFolder = "/app/playlists";

    protected override async Task OnInitializedAsync()
    {
        _mode = Services.GetService<MelodyBridge.Server.Services.UiModeService>();
        if (_mode is not null)
        {
            await _mode.EnsureLoadedAsync();
            IsSimple = !_mode.IsAdvanced;
            if (IsSimple) syncTab = "jobs";
            _mode.Changed += OnModeChanged;
        }
        defaultM3uFolder = await Settings.GetAsync("playlist_path", "/app/playlists");
        syncJobsView = await Settings.GetAsync("syncjobs_view", "cards");
        if (syncJobsView is not ("cards" or "rows")) syncJobsView = "cards";
        syncJobsSort = await Settings.GetAsync("syncjobs_sort", "last-run");
        if (syncJobsSort is not ("last-run" or "next-run" or "status")) syncJobsSort = "last-run";
        syncJobsCardSize = await Settings.GetAsync("syncjobs_card_size", "medium");
        if (syncJobsCardSize is not ("small" or "medium" or "large")) syncJobsCardSize = "medium";
        await LoadDataAsync();
        await ReloadProfiles();
    }

    private void OnModeChanged() => _ = InvokeAsync(() =>
    {
        if (_mode is null) return;
        IsSimple = !_mode.IsAdvanced;
        if (IsSimple) syncTab = "jobs";
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLog && showLog)
        {
            _focusLog = false;
            try
            {
                await _logCloseButton.FocusAsync();
            }
            catch
            {
                // Interop is unavailable during prerender and in some tests.
            }
        }
    }

    private async Task OnSyncJobsCardSizeChanged(ChangeEventArgs e)
    {
        var size = e.Value?.ToString() ?? "medium";
        if (size is not ("small" or "medium" or "large")) size = "medium";
        syncJobsCardSize = size;
        await Settings.SetAsync("syncjobs_card_size", size);
    }

    private async Task SetSyncJobsView(string view)
    {
        if (syncJobsView == view) return;
        syncJobsView = view;
        await Settings.SetAsync("syncjobs_view", view);
    }

    private async Task OnSyncJobsSortChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "last-run";
        syncJobsSort = value is "next-run" or "status" ? value : "last-run";
        jobs = SortJobs(jobs);
        jobOrder = jobs.Select(j => j.Id).ToList();
        await Settings.SetAsync("syncjobs_sort", syncJobsSort);
    }

    /// <summary>
    /// The list order. Last run is the default and puts never-run jobs
    /// last; next run puts manual jobs after every scheduled one; status
    /// puts failures first, then jobs that never ran, then completed runs.
    /// </summary>
    private List<SyncJobEntity> SortJobs(IEnumerable<SyncJobEntity> source)
        => syncJobsSort switch
        {
            "next-run" => source
                .OrderBy(j => NextRunOf(j) ?? DateTimeOffset.MaxValue)
                .ThenBy(j => j.Name)
                .ToList(),
            "status" => source
                .OrderBy(StatusRank)
                .ThenBy(j => j.Name)
                .ToList(),
            _ => source
                .OrderByDescending(j => j.LastRunAt ?? DateTime.MinValue)
                .ThenBy(j => j.Name)
                .ToList(),
        };

    private int StatusRank(SyncJobEntity job)
    {
        if (runningJobs.Contains(job.Id)) return 0;
        if (string.Equals(job.LastRunStatus, "Failed", StringComparison.OrdinalIgnoreCase)) return 1;
        if (string.IsNullOrWhiteSpace(job.LastRunStatus)
            || string.Equals(job.LastRunStatus, "Pending", StringComparison.OrdinalIgnoreCase)) return 2;
        if (string.Equals(job.LastRunStatus, "Completed", StringComparison.OrdinalIgnoreCase)
            && job.LastRunTotalTracks > 0 && job.LastRunResolvedTracks == 0) return 3;
        if (string.Equals(job.LastRunStatus, "Completed", StringComparison.OrdinalIgnoreCase)) return 4;
        return 5;
    }

    /// <summary>The card pill: running wins over the last recorded run.</summary>
    private string StatusLabel(SyncJobEntity job)
    {
        if (runningJobs.Contains(job.Id)) return "running";
        if (string.IsNullOrWhiteSpace(job.LastRunStatus)
            || string.Equals(job.LastRunStatus, "Pending", StringComparison.OrdinalIgnoreCase))
            return "not run yet";
        return job.LastRunStatus;
    }

    /// <summary>
    /// The pill variant. A "Completed" run that resolved nothing is not the
    /// same story as one that delivered, so it reads amber; a live run is
    /// amber too.
    /// </summary>
    private string StatusVariant(SyncJobEntity job)
    {
        if (runningJobs.Contains(job.Id)) return "warn";
        if (job.LastRunStatus == "Completed")
        {
            var barren = job.LastRunTotalTracks > 0 && job.LastRunResolvedTracks == 0;
            return barren ? "warn" : "ok";
        }
        return job.LastRunStatus == "Failed" ? "err" : "neutral";
    }

    /// <summary>The card and row menu: run history, editing and removal.</summary>
    private RenderFragment JobMenu(SyncJobEntity job) => @<text>
        <button title="Edit this job" @onclick="() => StartEditJob(job)">
            <Icon Name="pencil" Size="14" /> Edit
        </button>
        <button title="Run history" @onclick="() => ViewJobLog(job)">
            <Icon Name="terminal" Size="14" /> Log
        </button>
        <div class="card-menu-sep"></div>
        <button class="danger" title="Delete this job"
                disabled="@(runningAll || runningJobs.Contains(job.Id))"
                @onclick="() => AskDeleteJob(job)">
            <Icon Name="trash" Size="14" /> Delete
        </button>
    </text>;

    /// <summary>The playlist or folder a job publishes, for the card subtitle.</summary>
    private string SourceLabel(SyncJobEntity job)
    {
        if (job.SourceId is { Length: > 0 } sourceId
            && sources.FirstOrDefault(s => s.Id == sourceId) is { } playlist)
        {
            return playlist.Name;
        }
        if (job.SourceId is null && !string.IsNullOrWhiteSpace(job.SearchLocationPaths))
        {
            try
            {
                var paths = JsonSerializer.Deserialize<List<string>>(job.SearchLocationPaths);
                if (paths?.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p)) is { } path)
                {
                    var trimmed = path.TrimEnd('/', '\\');
                    var name = Path.GetFileName(trimmed);
                    return string.IsNullOrWhiteSpace(name) ? trimmed : name;
                }
            }
            catch (JsonException)
            {
                // A damaged row keeps a plain label instead of breaking the page.
            }
        }
        return "No source";
    }

    /// <summary>A saved playlist gets a link to its page; a folder has none.</summary>
    private string? SourceHref(SyncJobEntity job)
        => job.SourceId is { Length: > 0 } id && sources.Any(s => s.Id == id)
            ? $"/playlists/{id}"
            : null;

    /// <summary>The job name usually equals the playlist name: do not repeat it.</summary>
    private bool ShowSource(SyncJobEntity job)
        => !string.Equals(SourceLabel(job), job.Name, StringComparison.Ordinal);

    /// <summary>The publish profile name for a target, from the stored
    /// target, the live profile list, or the legacy job-level profile.</summary>
    private string? RuleProfileNameOf(SyncTarget target, SyncJobEntity job)
    {
        if (target.RuleProfileName is { Length: > 0 } stored) return stored;
        if (!string.IsNullOrWhiteSpace(target.RuleProfileId))
            return ruleProfiles.FirstOrDefault(p => p.Id == target.RuleProfileId)?.Name;
        // The job-level profile only owns a legacy M3U target, never a
        // legacy media server target.
        return target.Kind == OutputTargetType.M3uFile
            ? RuleProfileOf(job)?.Name
            : null;
    }

    /// <summary>One compact chip per target: M3U or a media server profile.</summary>
