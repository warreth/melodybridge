@page "/sync-jobs"
@using System.Text.Json
@using MelodyBridge.Infrastructure.MediaServers
@using MelodyBridge.Infrastructure.Services
@inject ISyncJobRunner JobRunner
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject MediaServerProfileStore ServerProfiles
@inject SettingsStore Settings
@inject MelodyBridge.Server.Services.NotificationService Notifications
@implements IDisposable

<PageTitle>Sync jobs - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Automation</span>
        <div class="title-with-help">
            <h1>Sync jobs</h1>
            <HelpTip Path="publishing#create-a-sync-job" Text="A sync job writes an M3U file or pushes a playlist to Jellyfin, Plex or a Subsonic server (Navidrome, gonic, Airsonic, ...), by hand or on a schedule." />
        </div>
        <p>A sync job turns a saved playlist into an M3U file for your music player, or pushes it to Jellyfin, Plex or a Subsonic server.</p>
    </div>
    <div class="topbar-actions">
        @if (jobs.Count > 0)
        {
            <button class="btn-modern secondary" @onclick="RunAllNow"
                    disabled="@(runningAll || runningJobs.Count > 0)"
                    title="Run every sync job once, one after the other">
                <Icon Name="play" Size="16" />
                @(runningAll ? $"Running {runAllDone}/{runAllTotal}…" : "Run all now")
            </button>
        }
        <button class="btn-modern primary" @onclick="StartNewJob"><Icon Name="plus" Size="16" /> New sync job</button>
    </div>
</section>

@if (jobs.Count > 0)
{
    <section class="list-toolbar" aria-label="Sync job controls">
        <div class="list-toolbar-left with-sort">
            <span class="list-count">@jobs.Count sync job@(jobs.Count == 1 ? "" : "s")</span>
            <label class="sort-control" title="Sort sync jobs">
                <Icon Name="arrow-up-down" Size="14" />
                <select value="@syncJobsSort" @onchange="OnSyncJobsSortChanged" aria-label="Sort sync jobs">
                    <option value="last-run">Last run</option>
                    <option value="next-run">Next run</option>
                    <option value="status">Status</option>
                </select>
            </label>
        </div>
        <div class="list-toolbar-actions">
            <div class="view-switch" role="group" aria-label="Sync job layout">
                <button class="view-chip @(syncJobsView == "cards" ? "on" : null)" title="Card view"
                        aria-pressed="@(syncJobsView == "cards" ? "true" : "false")"
                        @onclick='() => SetSyncJobsView("cards")'>
                    <Icon Name="layout-grid" Size="15" /> <span>Cards</span>
                </button>
                <button class="view-chip @(syncJobsView == "rows" ? "on" : null)" title="Compact rows"
                        aria-pressed="@(syncJobsView == "rows" ? "true" : "false")"
                        @onclick='() => SetSyncJobsView("rows")'>
                    <Icon Name="rows" Size="15" /> <span>Rows</span>
                </button>
            </div>
        </div>
    </section>
}

@if (showWizard)
{
    @* No backdrop click-to-close on a five-step form: it discarded
       everything typed with one stray click. Cancel and the X remain. *@
    <div class="wizard-overlay">
        <div class="wizard-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">Step @(currentStep + 1) of 5</span>
                    <h2>@GetStepTitle()</h2>
                    @if (isEditing)
                    {
                        <span class="text-muted">Editing "@draft.Name"</span>
                    }
                </div>
                <button class="icon-button" title="Close" @onclick="CancelWizard" @ref="_wizardCloseButton"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                @if (currentStep == 0)
                {
                    <div class="wizard-step">
                        <div class="form-grid single">
                            <label>
                                Job name
                                <input @bind="draft.Name" placeholder="e.g. My Summer Hits" />
                            </label>
                            <label>
                                Source type
                                <select @bind="sourceType">
                                    <option value="playlist">Saved playlist</option>
                                    <option value="folder">Local folder</option>
                                </select>
                            </label>
                            @if (sourceType == "playlist")
                            {
                                <label>
                                    Source playlist
                                    <select @bind="selectedSourceId">
                                        <option value="">Select a source...</option>
                                        @foreach (var src in sources)
                                        {
                                            <option value="@src.Id">@src.Name (@(src.IsManualImport ? "Imported" : PlatformName(src.SourcePlatform)))</option>
                                        }
                                    </select>
                                </label>
                            }
                            else
                            {
                                <label>
                                    Source folder
                                    <select @bind="selectedFolder">
                                        <option value="">Choose a folder...</option>
                                        @foreach (var f in scanFolders)
                                        {
                                            <option value="@f">@f</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>
                        @if (sourceType == "playlist" && sources.Count == 0)
                        {
                            <div class="hint-box">
                                No playlists saved yet. Go to <a href="/playlists">Playlists</a> to add one first.
                            </div>
                        }
                        @if (sourceType == "folder" && scanFolders.Count == 0)
                        {
                            <div class="hint-box">
                                No scan locations yet. Add folders on the <a href="/library">Library</a> page first.
                            </div>
                        }
                    </div>
                }
                else if (currentStep == 1)
                {
                    <div class="wizard-step">
                        @if (scanFolders.Count == 0)
                        {
                            <div class="hint-box">
                                No scan locations yet. Add folders on the <a href="/library">Library</a> page first.
                            </div>
                        }
                        else
                        {
                            <div class="form-grid single">
                                @foreach (var folder in scanFolders)
                                {
                                    <label class="toggle-switch wide">
                                        <input type="checkbox"
                                               checked="@selectedFolders.Contains(folder)"
                                               @onchange="e => ToggleFolder(folder, e)" />
                                        <span class="toggle-slider"></span>
                                        <span>@folder</span>
                                    </label>
                                }
                            </div>
                            <div class="hint-box">
                                Pick the folders to search. Leave empty to search every folder.
                            </div>
                            <MountWarning />
                        }
                    </div>
                }
                else if (currentStep == 2)
                {
                    <div class="wizard-step">
                        <div class="settings-section target-picker">
                            <span class="eyebrow">Targets</span>
                            <p class="target-lead">
                                One job can publish to several places at once. Tick every target it should reach.
                            </p>
                            <div class="target-list">
                                <label class="target-option @(draftM3uEnabled ? "on" : null)">
                                    <input type="checkbox" checked="@draftM3uEnabled" @onchange="OnM3uEnabledChanged" />
                                    <span class="target-option-body">
                                        <span class="target-option-title"><Icon Name="list-music" Size="16" /> M3U file</span>
                                        <span class="target-option-note">Write the playlist as an .m3u or .m3u8 file on disk.</span>
                                    </span>
                                </label>
                                @foreach (var profile in mediaServerProfiles)
                                {
                                    <label class="target-option @(selectedProfileIds.Contains(profile.Id) ? "on" : null)">
                                        <input type="checkbox"
                                               checked="@selectedProfileIds.Contains(profile.Id)"
                                               @onchange="e => ToggleProfile(profile.Id, e)" />
                                        <span class="target-option-body">
                                            <span class="target-option-title"><Icon Name="@TargetIcon(profile.Kind)" Size="16" /> @profile.Name</span>
                                            <span class="target-option-note">@TargetLabel(profile.Kind) <span class="target-url">@profile.BaseUrl</span></span>
                                        </span>
                                    </label>
                                }
                                @if (keepLegacyConnection)
                                {
                                    <label class="target-option on">
                                        <input type="checkbox" checked="@keepLegacyConnection"
                                               @onchange="e => keepLegacyConnection = e.Value is true" />
                                        <span class="target-option-body">
                                            <span class="target-option-title"><Icon Name="@TargetIcon(legacyConnectionKind.ToString())" Size="16" /> @TargetLabel(legacyConnectionKind.ToString())</span>
                                            <span class="target-option-note">Connection saved in this job. Leave it ticked or replace it with a profile.</span>
                                        </span>
                                    </label>
                                }
                            </div>
                            @if (mediaServerProfiles.Count == 0 && !keepLegacyConnection)
                            {
                                <div class="hint-box">
                                    No media server profiles yet. Create one under
                                    <a href="/settings#media-servers" target="_blank" rel="noopener">Settings, Media servers</a>,
                                    then reload the list here.
                                </div>
                            }
                            @if (droppedMissingTargets)
                            {
                                <div class="hint-box">
                                    A media server target was removed because its profile no longer exists.
                                    Tick a replacement above, then save the job.
                                </div>
                            }
                            @if (draftM3uEnabled)
                            {
                                <label class="target-path">
                                    M3U output path
                                    <input @bind="draft.M3uOutputPath" placeholder="/app/playlists/playlist.m3u8" />
                                </label>
                                <label class="target-path">
                                    Playlist compatibility
                                    <select value="@m3uPreset" @onchange="OnM3uPresetChanged">
                                        <option value="@M3uPresetWidest">Widest compatibility (recommended)</option>
                                        <option value="@M3uPresetCar">Windows car and MP4 players</option>
                                        <option value="@M3uPresetPlain">Plain (old default)</option>
                                        <option value="@M3uPresetCustom">Custom</option>
                                    </select>
                                </label>
                                <div class="hint-box">@M3uPresetHint</div>
                                <label class="toggle-switch wide">
                                    <input type="checkbox" @bind="draft.M3uRelativePaths" />
                                    <span class="toggle-slider"></span>
                                    <span>Relative paths in the M3U</span>
                                </label>
                                <div class="hint-box">
                                    Entries point from the M3U file to the music
                                    (<code>../music/song.flac</code>) instead of absolute paths,
                                    so the playlist still works when the folder moves. Put the
                                    playlist in the same folder as the music to get bare file
                                    names. Leave it off when your player needs absolute paths.
                                </div>
                                @if (m3uPreset == M3uPresetCustom)
                                {
                                    <label class="toggle-switch wide">
                                        <input type="checkbox" @bind="draft.M3uCrlf"
                                               @bind:after="OnM3uTextOptionChanged" />
                                        <span class="toggle-slider"></span>
                                        <span>Windows line endings (CRLF)</span>
                                    </label>
                                    <label class="toggle-switch wide">
                                        <input type="checkbox" @bind="draft.M3uBackslashes"
                                               @bind:after="OnM3uTextOptionChanged" />
                                        <span class="toggle-slider"></span>
                                        <span>Backslashes in relative paths</span>
                                    </label>
                                    <label class="toggle-switch wide">
                                        <input type="checkbox" @bind="draft.M3uBom"
                                               @bind:after="OnM3uTextOptionChanged" />
                                        <span class="toggle-slider"></span>
                                        <span>UTF-8 BOM</span>
                                    </label>
                                }
                            }
                            <div class="target-actions">
                                <a class="btn-modern ghost small" href="/settings#media-servers" target="_blank" rel="noopener">
                                    <Icon Name="plus" Size="14" /> Add a profile
                                </a>
                                <button class="btn-modern ghost small" type="button" @onclick="ReloadProfiles">
                                    <Icon Name="refresh" Size="14" /> Reload profiles
                                </button>
                            </div>
                            <div class="target-summary"><Icon Name="check" Size="14" /> <span>@TargetsSummary</span></div>
                        </div>
                        @{
                            var jellyfinProfile = SelectedProfiles.FirstOrDefault(
                                p => MediaServerKinds.MatchesOutputTarget(p.Kind, OutputTargetType.JellyfinApi));
                        }
                        @if (jellyfinProfile is not null)
                        {
                            <MediaServerUserPicker ServerUrl="@jellyfinProfile.BaseUrl"
                                                   ApiKey="@jellyfinProfile.ApiKey"
                                                   Username="@draft.JellyfinUserId"
                                                   Kind="@jellyfinProfile.Kind"
                                                   ShowUserList="true"
                                                   UserLabel="Jellyfin user"
                                                   @bind-UserId="draft.JellyfinUserId" />
                            <div class="hint-box">
                                The picked Jellyfin user applies to every Jellyfin target of this job: it
                                decides whose favorites get marked.
                            </div>
                        }
                        else if (keepLegacyConnection && legacyConnectionKind == OutputTargetType.JellyfinApi)
                        {
                            <MediaServerUserPicker ServerUrl="@draft.JellyfinServerUrl"
                                                   ApiKey="@draft.JellyfinApiKey"
                                                   Username="@draft.JellyfinUserId"
                                                   Kind="Jellyfin"
                                                   ShowUserList="true"
                                                   UserLabel="Jellyfin user"
                                                   @bind-UserId="draft.JellyfinUserId" />
                        }
                        else if (keepLegacyConnection && legacyConnectionKind == OutputTargetType.SubsonicApi)
                        {
                            <MediaServerUserPicker ServerUrl="@draft.JellyfinServerUrl"
                                                   ApiKey="@draft.JellyfinApiKey"
                                                   Username="@draft.JellyfinUserId"
                                                   Kind="Subsonic"
                                                   ShowUserList="false"
                                                   UserLabel="Navidrome username"
                                                   @bind-UserId="draft.JellyfinUserId" />
                        }
                        <div class="form-grid">
                            <label>
                                Schedule
                                <select @bind="draft.Schedule">
                                    <option value="@SyncJobSchedule.Manual">Manual</option>
                                    <option value="@SyncJobSchedule.Hourly">Hourly</option>
                                    <option value="@SyncJobSchedule.Daily">Daily</option>
                                    <option value="@SyncJobSchedule.Weekly">Weekly</option>
                                    <option value="@SyncJobSchedule.Monthly">Monthly</option>
                                    <option value="@SyncJobSchedule.Cron">Cron</option>
                                </select>
                                <small class="text-muted">
                                    A scheduled job first runs at its next scheduled time, not when you save it.
                                    Use Run now on the card to trigger it immediately.
                                </small>
                            </label>
                            @if (draft.Schedule == SyncJobSchedule.Cron)
                            {
                                <label>
                                    Cron expression
                                    <input @bind="draft.CronExpression" placeholder="0 3 * * *" />
                                </label>
                            }
                        </div>
                        @if (draft.Schedule == SyncJobSchedule.Cron)
                        {
                            <div class="hint-box">
                                Five-field cron with minute precision (minute hour day month weekday), for example <code>0 3 * * *</code> runs at 03:00 every night.
                            </div>
                        }
                    </div>
                }
                else if (currentStep == 3)
                {
                    <div class="wizard-step">
                        <RemapRulesEditor Title="Path"
                                          EmptyText="No rules yet."
                                          AddLabel="Add path rule"
                                          FromPlaceholder="/mnt/BackupHDD/Music"
                                          ToPlaceholder="/media/music"
                                          Rules="@pathRules" />
                        <RemapRulesEditor Title="Extension"
                                          EmptyText="No rules yet."
                                          AddLabel="Add extension rule"
                                          FromPlaceholder=".flac"
                                          ToPlaceholder=".opus"
                                          Rules="@extRules" />
                        <div class="hint-box">
                            Rules apply to the M3U entries and to the path lookup for Jellyfin,
                            Plex and Subsonic. Use them when the server sees your files under a
                            different path or extension than MelodyBridge does, for example inside
                            Docker. Leave empty when the paths match.
                        </div>
                    </div>
                }
                else if (currentStep == 4)
                {
                    <div class="wizard-step">
                        <div class="review-list">
                            <div><strong>Name:</strong> @draft.Name</div>
                            <div><strong>Source:</strong> @(sourceType == "folder" ? selectedFolder : SourceDisplay)</div>
                            <div><strong>Search locations:</strong> @(SearchLocationSummary)</div>
                            <div><strong>Targets:</strong> @TargetsSummary</div>
                            @if (draftM3uEnabled)
                            {
                                <div><strong>M3U path:</strong> @draft.M3uOutputPath</div>
                                <div><strong>M3U format:</strong> @M3uPresetName</div>
                            }
                            @foreach (var reviewProfile in SelectedProfiles)
                            {
                                <div><strong>@TargetLabel(reviewProfile.Kind):</strong> @reviewProfile.Name (@reviewProfile.BaseUrl)</div>
                            }
                            @if (keepLegacyConnection)
                            {
                                <div><strong>@TargetLabel(legacyConnectionKind.ToString()):</strong> @draft.JellyfinServerUrl (connection saved in this job)</div>
                            }
                            @if (SelectedProfiles.Any(pr => MediaServerKinds.MatchesOutputTarget(pr.Kind, OutputTargetType.JellyfinApi)))
                            {
                                <div><strong>Jellyfin user:</strong> @(string.IsNullOrWhiteSpace(draft.JellyfinUserId) ? "(server default)" : draft.JellyfinUserId)</div>
                            }
                            <div><strong>Schedule:</strong> @draft.Schedule</div>
                            @if (draft.Schedule == SyncJobSchedule.Cron && !string.IsNullOrWhiteSpace(draft.CronExpression))
                            {
                                <div><strong>Cron:</strong> @draft.CronExpression</div>
                            }
                            @if (pathRules.Count > 0)
                            {
                                <div>
                                    <strong>Path remap:</strong>
                                    @foreach (var r in pathRules)
                                    {
                                        <span>@r.From &rarr; @r.To;</span>
                                    }
                                </div>
                            }
                            @if (extRules.Count > 0)
                            {
                                <div>
                                    <strong>Extension remap:</strong>
                                    @foreach (var r in extRules)
                                    {
                                        <span>@r.From &rarr; @r.To;</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(stepError))
                {
                    <div class="hint-box wizard-error">@stepError</div>
                }
            </div>
            <div class="wizard-footer">
                <div class="flex-actions">
                    <button class="btn-modern ghost" @onclick="CancelWizard">Cancel</button>
                    @if (currentStep > 0)
                    {
                        <button class="btn-modern secondary" @onclick="PrevStep">Back</button>
                    }
                </div>
                <div class="wizard-actions">
                    @if (currentStep < 4)
                    {
                        <button class="btn-modern primary" @onclick="NextStep">Next</button>
                    }
                    else
                    {
                        <button class="btn-modern primary" @onclick="SaveJob" disabled="@saving">
                            @(saving ? "Saving..." : (isEditing ? "Save changes" : "Create sync job"))
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (jobs.Count > 0 && syncJobsView == "rows")
{
    <section class="entity-rows">
        @foreach (var job in jobs)
        {
            var source = SourcePlaylist(job);
            <div class="entity-row sync-job-row" @key="job.Id">
                @if (source is not null)
                {
                    <a class="entity-row-cover sync-job-row-cover"
                       href="/playlists/@source.Id"
                       title="Open @source.Name"
                       aria-label="Open playlist @source.Name">
                        @if (!string.IsNullOrEmpty(source.CoverImageUrl))
                        {
                            <img src="@source.CoverImageUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <Icon Name="list-music" Size="18" />
                        }
                    </a>
                }
                <span class="entity-row-main">
                    <strong>@job.Name</strong>
                    <small class="job-source-line">
                        @if (ShowSource(job))
                        {
                            if (SourceHref(job) is { } sourceHref)
                            {
                                <a class="job-source-link" href="@sourceHref">@SourceLabel(job)</a>
                            }
                            else
                            {
                                <span>@SourceLabel(job)</span>
                            }
                        }
                        @foreach (var chip in TargetChipsOf(job))
                        {
                            <span class="target-inline"><Icon Name="@chip.Icon" Size="12" /> <span class="target-inline-text">@chip.Label</span></span>
                        }
                    </small>
                </span>
                <span class="entity-row-state">
                    <StatusPill Variant="@StatusVariant(job)">@StatusLabel(job)</StatusPill>
                </span>
                <span class="entity-row-meta">
                    <span>@LastRunLabel(job)</span>
                    <span>@ScheduleLabel(job)</span>
                </span>
                <span class="entity-row-actions">
                    <button class="btn-modern small primary" title="Run this job now"
                            @onclick="() => RunJobNow(job.Id)" disabled="@(runningAll || runningJobs.Contains(job.Id))">
                        <Icon Name="play" Size="14" />
                        <span class="btn-label">@(runningJobs.Contains(job.Id) ? "Running…" : "Run now")</span>
                    </button>
                    <CardMenu Label="Sync job actions"
                              ShouldFocusTriggerOnClose="ShouldReturnMenuFocus">
                        @JobMenu(job)
                    </CardMenu>
                </span>
            </div>
        }
    </section>
}
else
{
    <section class="content-grid two">
        @foreach (var job in jobs)
        {
            var source = SourcePlaylist(job);
            <div class="panel-card job-card" @key="job.Id">
                <div class="panel-header">
                    <div class="sync-job-identity">
                        @if (source is not null)
                        {
                            <a class="sync-job-cover"
                               href="/playlists/@source.Id"
                               title="Open @source.Name"
                               aria-label="Open playlist @source.Name">
                                @if (!string.IsNullOrEmpty(source.CoverImageUrl))
                                {
                                    <img src="@source.CoverImageUrl" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <Icon Name="list-music" Size="22" />
                                }
                            </a>
                        }
                        <div class="job-heading">
                            <h2>@job.Name</h2>
                            @if (ShowSource(job))
                            {
                                <small class="job-source-line">
                                    @if (SourceHref(job) is { } sourceHref)
                                    {
                                        <a class="job-source-link" href="@sourceHref">@SourceLabel(job)</a>
                                    }
                                    else
                                    {
                                        <span>@SourceLabel(job)</span>
                                    }
                                </small>
                            }
                        </div>
                    </div>
                    <StatusPill Variant="@StatusVariant(job)">
                        @StatusLabel(job)
                    </StatusPill>
                </div>
                <div class="target-chips">
                    @foreach (var chip in TargetChipsOf(job))
                    {
                        <span class="target-chip"><Icon Name="@chip.Icon" Size="13" /> <span class="target-chip-text">@chip.Label</span></span>
                    }
                </div>
                <p class="job-summary">@JobSummary(job)</p>
                @if (job.LastRunTotalTracks > 0)
                {
                    var progressVariant = StatusVariant(job);
                    <div class="job-progress @(progressVariant == "err" ? "is-failed" : progressVariant == "warn" ? "is-warn" : "is-ok")"
                         title="@job.LastRunResolvedTracks of @job.LastRunTotalTracks tracks resolved">
                        <div class="progress-track">
                            <div class="progress-fill" style="width:@JobProgressPercent(job)%"></div>
                        </div>
                        <small>@job.LastRunResolvedTracks of @job.LastRunTotalTracks tracks resolved</small>
                    </div>
                }
                <div class="job-meta">
                    <small>@LastRunLabel(job)</small>
                    <small>@ScheduleLabel(job)</small>
                </div>
                <div class="job-footer">
                    <button class="btn-modern primary" @onclick="() => RunJobNow(job.Id)" disabled="@(runningAll || runningJobs.Contains(job.Id))">
                        <Icon Name="play" Size="14" />
                        @(runningJobs.Contains(job.Id) ? "Running..." : "Run now")
                    </button>
                    <CardMenu Label="Sync job actions"
                              ShouldFocusTriggerOnClose="ShouldReturnMenuFocus">
                        @JobMenu(job)
                    </CardMenu>
                </div>
            </div>
        }
    </section>
}

@if (deleteJobId is { } doomedJobId)
{
    <ConfirmDialog Show="true"
                   Eyebrow="Delete sync job"
                   Title=@($"Delete '{deleteJobName}'?")
                   Message="The job and its run history are removed. Playlists and music files are not touched."
                   ConfirmLabel="Delete job"
                   OnConfirm=@(() => DeleteJob(doomedJobId))
                   OnCancel="CancelDeleteJob" />
}

@if (jobs.Count == 0 && !showWizard)
{
    <EmptyState IconName="clock" Title="No sync jobs yet">Click New sync job to create one.</EmptyState>
}

@if (showLog)
{
    <div class="wizard-overlay" @onclick="CloseLog">
        <div class="wizard-modal log-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">Run history</span>
                    <h2>@logJobName</h2>
                </div>
                <button class="icon-button" title="Close" @onclick="CloseLog" @ref="_logCloseButton"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                @if (logEntries.Count == 0)
                {
                    <p>No runs recorded yet.</p>
                }
                @foreach (var entry in logEntries)
                {
                    <div class="log-entry">
                        @{
                            // A run that resolved nothing is not a success
                            // story: keep green for runs that did the job.
                            var runPill = entry.Status == "Completed"
                                ? entry.TotalTracks > 0 && entry.ResolvedTracks == 0 ? "warn" : "ok"
                                : "err";
                        }
                        <StatusPill Variant="@runPill">@entry.Status</StatusPill>
                        <div>
                            <strong>@entry.Timestamp.ToString("g")</strong>
                            <p>@entry.Message</p>
                            <small>@entry.ResolvedTracks / @entry.TotalTracks tracks resolved</small>
                            @if (ParseWarnings(entry.WarningDetails) is { Count: > 0 } warnings)
                            {
                                <details>
                                    <summary>@warnings.Count @(warnings.Count == 1 ? "warning" : "warnings")</summary>
                                    <ul>
                                        @foreach (var w in warnings)
                                        {
                                            <li>@w</li>
                                        }
                                    </ul>
                                </details>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

