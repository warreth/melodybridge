    private void EditProfile(SyncRuleProfile profile)
    {
        profileDraft = new SyncRuleProfile
        {
            Id = profile.Id,
            Name = profile.Name,
            M3uOutputFolder = profile.M3uOutputFolder,
            M3uFileNamePattern = profile.M3uFileNamePattern,
