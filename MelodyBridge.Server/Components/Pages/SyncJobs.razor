    /// <summary>
    /// Drops ticked profile ids that no longer exist (deleted under
    /// Settings since the job was saved) and flags the hint. A stale id has
    /// no checkbox to untick and saving filters it out, so keeping it would
    /// only block the wizard.
    /// </summary>
    private void PruneMissingProfiles()
    {
        if (selectedProfileIds.Count == 0) return;
        var existing = selectedProfileIds
            .Where(id => ruleProfiles.Any(p => p.Id == id
                && p.Kind != OutputTargetType.M3uFile))
            .ToList();
        if (existing.Count == selectedProfileIds.Count) return;
        selectedProfileIds = existing;
        droppedMissingTargets = true;
    }

    /// <summary>A legacy media server target whose connection profile was
    /// deleted under Settings is dropped with the same hint a missing
    /// publish profile gets.</summary>
    private void PruneLegacyTargets()
    {
        var missing = legacyTargets
            .Where(t => t.Kind != OutputTargetType.M3uFile
                && !string.IsNullOrWhiteSpace(t.ProfileId)
                && mediaServerProfiles.All(p => p.Id != t.ProfileId))
            .ToList();
        if (missing.Count == 0) return;
        legacyTargets.RemoveAll(missing.Contains);
        droppedMissingTargets = true;
    }

    private async Task LoadDataAsync(bool preserveOrder = false)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var loaded = await db.SyncJobs.OrderByDescending(j => j.LastRunAt).ToListAsync();
        if (preserveOrder && jobOrder is { Count: > 0 })
        {
            // Running a job must not teleport its card while the user looks
            // at it: keep the order the page had.
            loaded = loaded
                .OrderBy(j => jobOrder.IndexOf(j.Id) is var i && i >= 0 ? i : int.MaxValue)
                .ThenBy(j => j.Name)
                .ToList();
        }
        else
        {
            loaded = SortJobs(loaded);
        }
        jobs = loaded;
        jobOrder = jobs.Select(j => j.Id).ToList();
        nextRunLabels = jobs.ToDictionary(j => j.Id, NextRunSuffix);
        sources = await db.Playlists.ToListAsync();
        sourceById = sources.ToDictionary(s => s.Id);
        scanFolders = await db.ScanLocations.Select(l => l.Path).ToListAsync();
        ruleProfiles = await RuleProfiles.GetAllAsync();
        archiveProfiles = (await ArchiveProfiles.GetAllAsync()).ToList();
    }

