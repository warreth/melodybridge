    private static string DetectProfilePreset(SyncRuleProfile profile)
    {
        if (profile.M3uCrlf && profile.M3uBom && !profile.M3uBackslashes) return M3uPresetWidest;
        if (profile.M3uCrlf && profile.M3uBom && profile.M3uBackslashes) return M3uPresetCar;
        if (!profile.M3uCrlf && !profile.M3uBom && !profile.M3uBackslashes) return M3uPresetPlain;
        return M3uPresetCustom;
    }

    private void OnProfilePresetChanged(ChangeEventArgs e)
    {
        profilePreset = e.Value?.ToString() ?? M3uPresetCustom;
        switch (profilePreset)
        {
            case M3uPresetWidest:
                profileDraft.M3uCrlf = true; profileDraft.M3uBom = true;
                profileDraft.M3uBackslashes = false; break;
            case M3uPresetCar:
                profileDraft.M3uCrlf = true; profileDraft.M3uBom = true;
                profileDraft.M3uBackslashes = true; break;
            case M3uPresetPlain:
                profileDraft.M3uCrlf = false; profileDraft.M3uBom = false;
                profileDraft.M3uBackslashes = false; break;
        }
    }

    private async Task SaveProfile()
    {
        profileError = null;
        if (string.IsNullOrWhiteSpace(profileDraft.Name))
        {
            profileError = "Give the profile a name.";
            return;
        }
        if (!Enum.TryParse<OutputTargetType>(profileKind, true, out var kind))
            kind = OutputTargetType.M3uFile;
        if (kind == OutputTargetType.M3uFile
            && string.IsNullOrWhiteSpace(profileDraft.M3uOutputFolder))
        {
            profileError = "Enter the M3U output folder.";
            return;
        }
        if (kind != OutputTargetType.M3uFile
            && string.IsNullOrWhiteSpace(profileMediaServerProfileId))
        {
            profileError = "Choose the media server this profile publishes to.";
            return;
        }
        if (kind != OutputTargetType.M3uFile)
        {
            var connection = mediaServerProfiles
                .FirstOrDefault(p => p.Id == profileMediaServerProfileId);
            if (connection is null)
            {
                profileError = "The selected media server connection no longer exists.";
                return;
            }
            if (KindOf(connection.Kind) != kind)
            {
                profileError =
                    $"The selected connection is a {TargetLabel(KindOf(connection.Kind))} server, not {TargetLabel(kind)}.";
                return;
            }
        }
        if (!string.IsNullOrWhiteSpace(profileSourceArchiveProfileId)
            && !string.Equals(profileSourceArchiveProfileId, SyncSourceVariants.DefaultArchive,
                StringComparison.Ordinal)
            && archiveProfiles.All(p => p.Id != profileSourceArchiveProfileId))
        {
            profileError = "The selected archive profile no longer exists.";
            return;
        }

        savingProfile = true;
        try
        {
            profileDraft.Name = profileDraft.Name.Trim();
            profileDraft.Kind = kind;
            profileDraft.MediaServerProfileId = kind == OutputTargetType.M3uFile
                ? null : profileMediaServerProfileId;
            profileDraft.PlaylistNamePattern = string.IsNullOrWhiteSpace(profilePlaylistNamePattern)
                ? "{job}" : profilePlaylistNamePattern.Trim();
            profileDraft.SourceArchiveProfileId = string.IsNullOrWhiteSpace(profileSourceArchiveProfileId)
                ? null : profileSourceArchiveProfileId;
            profileDraft.M3uOutputFolder = profileDraft.M3uOutputFolder.Trim();
            profileDraft.M3uFileNamePattern = string.IsNullOrWhiteSpace(profileDraft.M3uFileNamePattern)
                ? "{job}.m3u8" : profileDraft.M3uFileNamePattern.Trim();
            profileDraft.PathRemapRules = RulesToDictionary(profilePathRules);
            profileDraft.ExtensionRemapRules = RulesToDictionary(profileExtRules);
            await RuleProfiles.SaveAsync(profileDraft);
            showProfileEditor = false;
            await LoadDataAsync();
            Notifications.Success($"Saved publish profile '{profileDraft.Name}'.");
        }
        finally
        {
            savingProfile = false;
        }
    }

