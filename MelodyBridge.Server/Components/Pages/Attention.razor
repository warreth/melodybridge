@page "/attention"
@using MelodyBridge.Application.Services
@using MelodyBridge.Infrastructure.Services
@inject AttentionService AttentionData
@inject ArchiveBackfillService ArchiveBackfill
@inject IAttentionActions Actions
@inject IAttentionRepairRunner Repair
@inject UiModeService Mode
@inject PlaylistStore Store
@inject NotificationService Notifications
@inject DataChangeTracker Changes
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Needs attention - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Library health</span>
        <h1>Needs attention</h1>
        <p>@(IsSimple
            ? "A quick health check with one repair button. Full controls live in Advanced mode."
            : "Every failed download, open review and archive repair in one place, grouped by what it needs.")</p>
    </div>
    <div class="topbar-actions">
        <small class="text-muted updated-note">@(lastLoaded == default ? "" : $"loaded {lastLoaded:HH:mm:ss}")</small>
        <button class="btn-modern ghost small" @onclick="LoadAsync" disabled="@(loading || Repair.IsRunning)">
            <Icon Name="refresh" Size="14" /> @(loading ? "Loading…" : "Refresh")
        </button>
        <a class="btn-modern secondary small" href="/playlists">
            <Icon Name="list-music" Size="14" /> Playlists
        </a>
    </div>
</section>

@if (ArchiveBackfill.Progress is { Running: true } backfill)
{
    <div class="attention-progress" aria-live="polite">
        <span class="spinner"></span>
        <div>
            <strong>Building archive copies</strong>
            <small>
                @(backfill.Total > 0
                    ? $"{backfill.Done} of {backfill.Total}"
                      + (backfill.Failed > 0 ? $", {backfill.Failed} failed" : "")
                    : "Preparing…")
                @if (!string.IsNullOrWhiteSpace(backfill.Current))
                {
                    <span> · @backfill.Current</span>
                }
            </small>
        </div>
        <div class="progress-track" aria-hidden="true">
            <span style="width:@ArchiveBackfillPercent%"></span>
        </div>
        @if (backfill.Total > 0)
        {
            @if (backfill.Eta is { } eta)
            {
                <small class="attention-eta">ETA @EtaText(eta)</small>
            }
            else
            {
                <small class="attention-eta">ETA calculating</small>
            }
        }
        <button class="btn-modern small ghost" @onclick="ArchiveBackfill.Stop">Stop</button>
    </div>
}
else if (ArchiveBackfill.Progress is { Total: > 0, Failed: > 0 } lastPass)
{
    <div class="result-box error attention-result">
        <strong>Last archive pass: @lastPass.Done of @lastPass.Total, @lastPass.Failed failed</strong>
        @if (!string.IsNullOrWhiteSpace(lastPass.Message))
        {
            <span>@lastPass.Message</span>
        }
    </div>
}

@if (Repair.Current is { } repairRun)
{
    @if (repairRun.State == AttentionRepairState.Running)
    {
        <div class="attention-progress" aria-live="polite">
            <span class="spinner"></span>
            <div>
                <strong>@repairRun.Current</strong>
                <small>@repairRun.Processed of @repairRun.Total</small>
            </div>
            <div class="progress-track" aria-hidden="true">
                <span style="width:@repairRun.Percent%"></span>
            </div>
            @if (repairRun.EtaUtc is { } eta)
            {
                <small class="attention-eta">ETA @eta.ToLocalTime().ToString("HH:mm")</small>
            }
            else
            {
                <small class="attention-eta">ETA calculating</small>
            }
            <button class="btn-modern small ghost" @onclick="StopAction">Stop</button>
        </div>
    }
    else
    {
        <div class="result-box @(repairRun.State == AttentionRepairState.Finished && repairRun.Failed == 0 ? "ok" : "error") attention-result">
            <strong>@repairRun.Summary</strong>
            @if (repairRun.Messages.Count > 0)
            {
                <span>@string.Join(" · ", repairRun.Messages.Take(3))</span>
            }
        </div>
    }
}

@if (IsSimple)
{
    <section class="panel-card attention-simple">
        @if (snapshot.Total == 0)
        {
            <div class="attention-simple-icon ok"><Icon Name="check-circle" Size="24" /></div>
            <h2>Nothing needs attention</h2>
            <p>Every downloaded track passed its checks. Keep listening.</p>
        }
        else
        {
            <div class="attention-simple-head">
                <div>
                    <span class="eyebrow">Overview</span>
                    <h2>@snapshot.Total item@(snapshot.Total == 1 ? "" : "s") need@(snapshot.Total == 1 ? "s" : "") a fix</h2>
                </div>
                <span class="attention-simple-number">@snapshot.Total</span>
            </div>
            <p>@FixSummary</p>
            <div class="attention-simple-actions">
                <button class="btn-modern primary attention-simple-fix"
                        disabled="@(Repair.IsRunning || AutoFixTotal == 0)"
                        @onclick="RunFixAllAsync">
                    <Icon Name="check" Size="18" /> Fix all @AutoFixTotal
                </button>
                <button class="btn-modern ghost" @onclick="SwitchToAdvancedAsync">
                    Open Advanced mode
                </button>
            </div>
            <p class="attention-simple-note">
                Simple mode fixes the safe issues automatically. Advanced mode shows every group,
                per-track actions, reviews and archive settings.
            </p>
        }
    </section>
}
else
{
    <section class="attention-summary">
        <button class="attention-metric @(selectedFilter == "all" ? "active" : null)" @onclick='() => SetFilter("all")'>
            <strong>@snapshot.Total</strong>
            <span>all open</span>
        </button>
        <button class="attention-metric bad @(selectedFilter == "failed" ? "active" : null)" @onclick='() => SetFilter("failed")'>
            <strong>@snapshot.FailedCount</strong>
            <span>failed</span>
        </button>
        <button class="attention-metric warn @(selectedFilter == "review" ? "active" : null)" @onclick='() => SetFilter("review")'>
            <strong>@snapshot.ReviewCount</strong>
            <span>reviews</span>
        </button>
        <button class="attention-metric warn @(selectedFilter == "dedup" ? "active" : null)" @onclick='() => SetFilter("dedup")'>
            <strong>@snapshot.DedupCount</strong>
            <span>hardlinks</span>
        </button>
        <button class="attention-metric @(selectedFilter == "archive" ? "active" : null)" @onclick='() => SetFilter("archive")'>
            <strong>@snapshot.ArchiveCount</strong>
            <span>archives</span>
        </button>
        <button class="attention-metric @(selectedFilter == "playlists" ? "active" : null)" @onclick='() => SetFilter("playlists")'>
            <strong>@snapshot.Playlists.Count</strong>
            <span>playlists</span>
        </button>
    </section>

    <section class="attention-repair" aria-labelledby="attention-fix-title">
        <div class="attention-repair-copy">
            <span class="eyebrow">Repair</span>
            <h2 id="attention-fix-title">Fix what can be fixed</h2>
            <p>@FixSummary</p>
        </div>
        <div class="attention-repair-actions">
            @if (AutoFixTotal > 0)
            {
                <button class="btn-modern primary" disabled="@(Busy)" @onclick="RunFixAllAsync">
                    <Icon Name="check" Size="15" /> Fix all @AutoFixTotal
                </button>
            }
        </div>
    </section>

    @if (_lastResult is not null)
    {
        <div class="result-box @(_lastResult.Failed == 0 ? "ok" : "error") attention-result">
            <strong>@_lastResult.Summary</strong>
            @if (_lastResult.Messages.Count > 0)
            {
                <span>@string.Join(" · ", _lastResult.Messages.Take(3))</span>
            }
        </div>
    }

    @if (_busy)
    {
        <div class="attention-progress">
            <span class="spinner"></span>
            <div>
                <strong>@_busyLabel</strong>
                <small>@_progressDone of @_progressTotal</small>
            </div>
            <div class="progress-track" aria-hidden="true">
                <span style="width:@ProgressPercent%"></span>
            </div>
            <button class="btn-modern small ghost" @onclick="StopAction">Stop</button>
        </div>
    }

    @if (SelectedTracks.Count > 0)
    {
        <section class="attention-bulk" aria-label="Bulk actions">
            <strong>@SelectedTracks.Count selected</strong>
            @if (HasRetrySelection)
            {
                <button class="btn-modern small primary" disabled="@_busy" @onclick="() => RunSelectedAsync(SelectedAction.Retry)">
                    Retry downloads
                </button>
                <button class="btn-modern small secondary" disabled="@_busy" @onclick="() => RunSelectedAsync(SelectedAction.RetryElsewhere)">
                    Retry elsewhere
                </button>
            }
            @if (HasHardlinkSelection)
            {
                <button class="btn-modern small secondary" disabled="@_busy" @onclick="() => RunSelectedAsync(SelectedAction.Hardlink)">
                    Find hardlinks
                </button>
            }
            @if (HasDedupSelection)
            {
                <button class="btn-modern small secondary" disabled="@_busy" @onclick="() => RunSelectedAsync(SelectedAction.DedupHardlink)">
                    Hardlink existing
                </button>
                <button class="btn-modern small secondary" disabled="@_busy" @onclick="() => RunSelectedAsync(SelectedAction.DedupDownload)">
                    Download new
                </button>
            }
            @if (HasReverifySelection)
            {
                <button class="btn-modern small secondary" disabled="@_busy" @onclick="() => RunSelectedAsync(SelectedAction.Reverify)">
                    Recheck files
                </button>
            }
            @if (HasArchiveSelection)
            {
                <button class="btn-modern small secondary" disabled="@_busy" @onclick="() => RunSelectedAsync(SelectedAction.Archive)">
                    Recreate archives
                </button>
            }
            <button class="btn-modern small ghost" @onclick="ClearSelection">Clear</button>
        </section>
    }

    @if (snapshot.Total == 0)
    {
        <EmptyState IconName="check-circle" Title="Nothing needs attention">
            Every downloaded track passed its checks.
        </EmptyState>
    }
    else if (selectedFilter == "all")
    {
        <section class="panel-card attention-pick">
            <span class="attention-pick-icon"><Icon Name="filter" Size="18" /></span>
            <div>
                <strong>Pick a category above</strong>
                <span>Each filter shows only its own tracks. Fix all still repairs every group.</span>
            </div>
        </section>
    }
    else if (selectedFilter == "playlists")
    {
        @if (snapshot.Playlists.Count == 0)
        {
            <EmptyState IconName="list-music" Title="No playlist warnings">
                Every playlist refreshed completely.
            </EmptyState>
        }
        else
        {
            <section class="attention-group" aria-labelledby="group-playlists">
                <div class="attention-group-head">
                    <div class="attention-group-title">
                        <span class="attention-group-icon warn"><Icon Name="list-music" Size="17" /></span>
                        <div>
                            <h2 id="group-playlists">Playlist syncs <span class="group-count">@snapshot.Playlists.Count</span></h2>
                            <p>A refresh was incomplete or failed. Re-sync to fetch the rest.</p>
                        </div>
                    </div>
                    <div class="attention-group-actions">
                        @if (ResyncablePlaylists.Count > 0)
                        {
                            <button class="btn-modern small secondary" disabled="@_busy"
                                    @onclick="RunFixPlaylistsAsync">
                                Re-sync all @ResyncablePlaylists.Count
                            </button>
                        }
                    </div>
                </div>
                <div class="attention-rows">
                    @foreach (var playlist in snapshot.Playlists)
                    {
                        <div class="attention-row">
                            <span class="attention-playlist-icon"><Icon Name="list-music" Size="15" /></span>
                            <div class="attention-row-copy">
                                <div class="attention-row-title">
                                    <strong>@playlist.Name</strong>
                                    <StatusPill Variant="@(playlist.Status == SyncStatus.Failed ? "err" : "warn")">
                                        @(playlist.Status == SyncStatus.Failed ? "failed" : "partial")
                                    </StatusPill>
                                </div>
                                <small>@(playlist.Warning ?? "The last refresh did not complete.")</small>
                            </div>
                            <div class="attention-row-actions">
                                @if (playlist.SourceUrl is { Length: > 0 } source
                                    && !source.StartsWith("spotify:import:", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="btn-modern small secondary" disabled="@_busy"
                                            @onclick="() => ResyncPlaylistAsync(playlist)">
                                        Re-sync
                                    </button>
                                }
                                <a class="btn-modern small ghost" href="/playlists/@playlist.PlaylistId">Open</a>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    }
    else if (VisibleGroups.Count == 0)
    {
        <EmptyState IconName="check-circle" Title="Nothing in this group">
            This category has no open items. Pick another filter.
        </EmptyState>
    }
    else
    {
        @foreach (var group in VisibleGroups)
        {
            <section class="attention-group" aria-labelledby="group-@group.Kind">
                <div class="attention-group-head">
                    <div class="attention-group-title">
                        <span class="attention-group-icon @Tone(group.Kind)">
                            <Icon Name="@KindIcon(group.Kind)" Size="17" />
                        </span>
                        <div>
                            <h2 id="group-@group.Kind">
                                @group.Label
                                <span class="group-count">@group.Tracks.Count</span>
                            </h2>
                            <p>@group.Description</p>
                        </div>
                    </div>
                    <div class="attention-group-actions">
                        @if (group.Tracks.Count > 1)
                        {
                            <button class="btn-modern small ghost" @onclick="() => ToggleGroup(group)">
                                @(GroupSelected(group) ? "Clear group" : "Select group")
                            </button>
                        }
                        @if (AttentionKinds.IsFailure(group.Kind)
                            || group.Kind == AttentionKinds.FileMissing)
                        {
                            <button class="btn-modern small secondary" disabled="@_busy"
                                    @onclick="() => RunGroupAsync(group, SelectedAction.Retry)">
                                Retry all
                            </button>
                        }
                        @if (group.Kind == AttentionKinds.Unverified)
                        {
                            <button class="btn-modern small secondary" disabled="@_busy"
                                    @onclick="() => RunGroupAsync(group, SelectedAction.Reverify)">
                                Recheck all
                            </button>
                        }
                        @if (group.Kind == AttentionKinds.Dedup)
                        {
                            <button class="btn-modern small secondary" disabled="@_busy"
                                    @onclick="() => RunGroupAsync(group, SelectedAction.DedupHardlink)">
                                Find hardlinks
                            </button>
                        }
                        @if (group.Kind == AttentionKinds.Archive)
                        {
                            <button class="btn-modern small secondary" disabled="@_busy"
                                    @onclick="() => RunGroupAsync(group, SelectedAction.Archive)">
                                Recreate all
                            </button>
                        }
                    </div>
                </div>

                <div class="attention-rows">
                    @foreach (var track in VisibleTracks(group))
                    {
                        <div class="attention-row @(selected.Contains(track.TrackId) ? "selected" : null)">
                            <input type="checkbox" class="row-select" checked="@selected.Contains(track.TrackId)"
                                   aria-label="Select @track.Title"
                                   @onchange="() => ToggleTrack(track.TrackId)" />
                            <div class="attention-row-copy">
                                <div class="attention-row-title">
                                    <strong>@track.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(track.Artist))
                                    {
                                        <span>@track.Artist</span>
                                    }
                                    <a class="attention-playlist" href="/playlists/@track.PlaylistId">@track.PlaylistName</a>
                                </div>
                                <small>@track.Detail</small>
                            </div>
                            <StatusPill Variant="@PillVariant(track.Kind)">@KindShort(track.Kind)</StatusPill>
                            <div class="attention-row-actions">
                                @if (AttentionKinds.IsFailure(track.Kind) || track.Kind == AttentionKinds.FileMissing)
                                {
                                    <button class="btn-modern small secondary" disabled="@_busy"
                                            @onclick="() => RunTrackAsync(track, SelectedAction.Retry)">
                                        Retry
                                    </button>
                                    <button class="btn-modern small ghost" disabled="@_busy"
                                            @onclick="() => RunTrackAsync(track, SelectedAction.RetryElsewhere)">
                                        Elsewhere
                                    </button>
                                    <button class="btn-modern small ghost" disabled="@_busy"
                                            @onclick="() => RunTrackAsync(track, SelectedAction.Hardlink)">
                                        Hardlink
                                    </button>
                                }
                                else if (track.Kind == AttentionKinds.Dedup)
                                {
                                    <button class="btn-modern small secondary" disabled="@_busy"
                                            @onclick="() => RunTrackAsync(track, SelectedAction.DedupHardlink)">
                                        Hardlink existing
                                    </button>
                                    <button class="btn-modern small ghost" disabled="@_busy"
                                            @onclick="() => RunTrackAsync(track, SelectedAction.DedupDownload)">
                                        Download new
                                    </button>
                                }
                                else if (track.Kind.StartsWith("review-", StringComparison.Ordinal))
                                {
                                    <button class="btn-modern small secondary" disabled="@_busy"
                                            @onclick="() => RunTrackAsync(track, SelectedAction.Keep)">
                                        Keep file
                                    </button>
                                    <button class="btn-modern small ghost" disabled="@_busy"
                                            @onclick="() => RunTrackAsync(track, SelectedAction.RetryReview)">
                                        Retry download
                                    </button>
                                }
                                else if (track.Kind == AttentionKinds.Archive)
                                {
                                    <button class="btn-modern small secondary" disabled="@_busy"
                                            @onclick="() => RunTrackAsync(track, SelectedAction.Archive)">
                                        Recreate
                                    </button>
                                }
                                else if (track.Kind == AttentionKinds.Unverified)
                                {
                                    <button class="btn-modern small secondary" disabled="@_busy"
                                            @onclick="() => RunTrackAsync(track, SelectedAction.Reverify)">
                                        Recheck
                                    </button>
                                }
                                <a class="btn-modern small ghost" href="/playlists/@track.PlaylistId">Open</a>
                            </div>
                        </div>
                    }
                </div>
                @if (group.Tracks.Count > RowLimit)
                {
                    <button class="attention-more" @onclick="() => ToggleExpanded(group.Kind)">
                        @(expandedGroups.Contains(group.Kind)
                            ? $"Show first {RowLimit}"
                            : $"Show all {group.Tracks.Count}")
                        <Icon Name="@(expandedGroups.Contains(group.Kind) ? "chevron-up" : "chevron-down")" Size="14" />
                    </button>
                }
            </section>
        }
    }
}

@code {
    /// <summary>Reports on the caller's thread; the page marshals its own render.</summary>
    private sealed class InlineProgress(Action<int> report) : IProgress<int>
    {
        public void Report(int value) => report(value);
    }

    private enum SelectedAction
    {
        Retry,
        RetryElsewhere,
        Hardlink,
        Archive,
        Keep,
        RetryReview,
        Reverify,
        DedupHardlink,
        DedupDownload,
    }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "kind")]
    public string? QueryKind { get; set; }

    private AttentionSnapshot snapshot = new(Array.Empty<AttentionGroup>(), Array.Empty<AttentionPlaylist>());
    private const int RowLimit = 8;
    private readonly HashSet<int> selected = new();
    private readonly HashSet<string> expandedGroups = new(StringComparer.Ordinal);
    private string selectedFilter = "all";
    private UiModeService? _mode;
    private bool IsSimple;
    private bool loading;
    private bool _busy;
    private string _busyLabel = "";
    private int _progressDone;
    private int _progressTotal;
    private AttentionBulkResult? _lastResult;
    private CancellationTokenSource? _actionCts;
    private DateTime lastLoaded;
    private long _seenVersion = -1;
    private Timer? _timer;
    private bool _disposed;
    private bool _archiveWasRunning;
    private CancellationTokenSource? _loadCts;

    private bool Busy => _busy || Repair.IsRunning;

    private IReadOnlyList<AttentionGroup> VisibleGroups => selectedFilter switch
    {
        "failed" => snapshot.Groups
            .Where(group => AttentionKinds.IsFailure(group.Kind)).ToList(),
        "review" => snapshot.Groups
            .Where(group => group.Kind.StartsWith("review-", StringComparison.Ordinal)).ToList(),
        "dedup" => snapshot.Groups
            .Where(group => group.Kind == AttentionKinds.Dedup).ToList(),
        "archive" => snapshot.Groups
            .Where(group => group.Kind is AttentionKinds.Archive
                or AttentionKinds.FileMissing or AttentionKinds.Unverified).ToList(),
        _ => Array.Empty<AttentionGroup>(),
    };

    private IReadOnlyList<AttentionPlaylist> ResyncablePlaylists => snapshot.Playlists
        .Where(playlist => !string.IsNullOrWhiteSpace(playlist.SourceUrl)
            && !playlist.SourceUrl.StartsWith("spotify:import:", StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IReadOnlyList<AttentionRepairStep> FixSteps => snapshot.Groups
        .Select(group => new AttentionRepairStep(
            AttentionFixPolicy.ForKind(group.Kind),
            group.Tracks.Select(track => track.TrackId).ToList()))
        .ToList();

    private int AutoFixTotal => snapshot.TrackCount + ResyncablePlaylists.Count;

    private string FixSummary
    {
        get
        {
            var parts = FixSteps
                .GroupBy(step => step.Action)
                .OrderBy(group => group.Key)
                .Select(group => AttentionFixPolicy.Summary(
                    group.Key, group.Sum(step => step.TrackIds.Count)))
                .ToList();
            if (ResyncablePlaylists.Count > 0)
                parts.Add($"re-sync {ResyncablePlaylists.Count} playlist{(ResyncablePlaylists.Count == 1 ? "" : "s")}");
            return parts.Count == 0
                ? "Nothing needs a fix."
                : string.Join(", ", parts) + ".";
        }
    }

    private static string BusyLabel(SelectedAction action) => action switch
    {
        SelectedAction.Retry => "Retrying downloads",
        SelectedAction.RetryElsewhere => "Retrying at another source",
        SelectedAction.Hardlink => "Looking for hardlinks",
        SelectedAction.Archive => "Recreating archive copies",
        SelectedAction.Keep => "Keeping files",
        SelectedAction.RetryReview => "Retrying reviewed files",
        SelectedAction.Reverify => "Rechecking unverified files",
        SelectedAction.DedupHardlink => "Hardlinking existing files",
        SelectedAction.DedupDownload => "Downloading new copies",
        _ => "Working",
    };

    private IReadOnlyList<AttentionTrack> VisibleTracks(AttentionGroup group)
        => expandedGroups.Contains(group.Kind) || group.Tracks.Count <= RowLimit
            ? group.Tracks
            : group.Tracks.Take(RowLimit).ToList();

    private void ToggleExpanded(string kind)
    {
        if (!expandedGroups.Add(kind)) expandedGroups.Remove(kind);
    }

    private IReadOnlyList<AttentionTrack> SelectedTracks => snapshot.Groups
        .SelectMany(group => group.Tracks)
        .Where(track => selected.Contains(track.TrackId))
        .ToList();

    private bool HasRetrySelection => SelectedTracks.Any(track =>
        AttentionKinds.IsFailure(track.Kind) || track.Kind == AttentionKinds.FileMissing);

    private bool HasHardlinkSelection => SelectedTracks.Any(track =>
        AttentionKinds.IsFailure(track.Kind) || track.Kind == AttentionKinds.FileMissing);

    private bool HasDedupSelection => SelectedTracks.Any(track =>
        track.Kind == AttentionKinds.Dedup);

    private bool HasReverifySelection => SelectedTracks.Any(track =>
        track.Kind == AttentionKinds.Unverified);

    private bool HasArchiveSelection => SelectedTracks.Any(track =>
        track.Kind == AttentionKinds.Archive);

    private int ProgressPercent => _progressTotal <= 0
        ? 0
        : Math.Clamp(100 * _progressDone / _progressTotal, 0, 100);

    private int ArchiveBackfillPercent
    {
        get
        {
            var progress = ArchiveBackfill.Progress;
            return progress.Total <= 0
                ? 0
                : Math.Clamp(100 * progress.Done / progress.Total, 0, 100);
        }
    }

    private static string EtaText(TimeSpan eta)
        => eta.TotalHours >= 1
            ? eta.ToString(@"h\:mm\:ss")
            : eta.ToString(@"m\:ss");

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(QueryKind))
            selectedFilter = NormalizeFilter(QueryKind);
    }

    protected override async Task OnInitializedAsync()
    {
        _mode = Mode;
        await _mode.EnsureLoadedAsync();
        IsSimple = !_mode.IsAdvanced;
        _mode.Changed += OnModeChanged;
        Repair.Changed += OnRepairChanged;
        ArchiveBackfill.Changed += OnArchiveBackfillChanged;
        _archiveWasRunning = ArchiveBackfill.IsRunning;
        selectedFilter = NormalizeFilter(QueryKind);
        await LoadAsync();
        _timer = new Timer(_ => _ = InvokeAsync(async () =>
        {
            if (_disposed || Busy) return;
            if (Changes.Version == _seenVersion) return;
            await LoadAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private static string NormalizeFilter(string? kind)
        => kind is "failed" or "review" or "dedup" or "archive" or "playlists"
            ? kind
            : "all";

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;
        loading = true;
        try
        {
            _seenVersion = Changes.Version;
            snapshot = await AttentionData.GetAsync(ct);
            selected.RemoveWhere(id => !snapshot.Groups
                .SelectMany(group => group.Tracks)
                .Any(track => track.TrackId == id));
            lastLoaded = DateTime.Now;
        }
        catch (OperationCanceledException)
        {
            // A newer load or a navigation replaced this one.
        }
        finally
        {
            loading = false;
        }
    }

    private void SetFilter(string filter)
    {
        selectedFilter = NormalizeFilter(filter);
        selected.Clear();
        StateHasChanged();
    }

    private void OnArchiveBackfillChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        var running = ArchiveBackfill.IsRunning;
        if (_archiveWasRunning && !running)
        {
            _archiveWasRunning = false;
            await LoadAsync();
        }
        else
        {
            _archiveWasRunning = running;
        }
        StateHasChanged();
    });

    private void OnRepairChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        if (Repair.Current is not { State: AttentionRepairState.Running })
            await LoadAsync();
        StateHasChanged();
    });

    private void OnModeChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed || _mode is null) return;
        IsSimple = !_mode.IsAdvanced;
        StateHasChanged();
    });

    private async Task SwitchToAdvancedAsync()
    {
        if (_mode is null) return;
        await _mode.SetAsync(advanced: true);
    }

    private void ToggleTrack(int trackId)
    {
        if (!selected.Add(trackId)) selected.Remove(trackId);
    }

    private bool GroupSelected(AttentionGroup group)
        => group.Tracks.Count > 0 && group.Tracks.All(track => selected.Contains(track.TrackId));

    private void ToggleGroup(AttentionGroup group)
    {
        if (GroupSelected(group))
            foreach (var track in group.Tracks) selected.Remove(track.TrackId);
        else
            foreach (var track in group.Tracks) selected.Add(track.TrackId);
    }

    private void ClearSelection() => selected.Clear();

    private Task RunSelectedAsync(SelectedAction action)
    {
        var tracks = action switch
        {
            SelectedAction.Retry or SelectedAction.RetryElsewhere
                => SelectedTracks.Where(track => AttentionKinds.IsFailure(track.Kind)
                    || track.Kind == AttentionKinds.FileMissing).ToList(),
            SelectedAction.Hardlink
                => SelectedTracks.Where(track => AttentionKinds.IsFailure(track.Kind)
                    || track.Kind == AttentionKinds.FileMissing).ToList(),
            SelectedAction.Reverify
                => SelectedTracks.Where(track => track.Kind == AttentionKinds.Unverified).ToList(),
            SelectedAction.Archive
                => SelectedTracks.Where(track => track.Kind == AttentionKinds.Archive).ToList(),
            SelectedAction.DedupHardlink or SelectedAction.DedupDownload
                => SelectedTracks.Where(track => track.Kind == AttentionKinds.Dedup).ToList(),
            _ => SelectedTracks,
        };
        return RunAsync(tracks, action, null);
    }

    private Task RunGroupAsync(AttentionGroup group, SelectedAction action)
        => RunAsync(group.Tracks, action, group);

    private Task RunTrackAsync(AttentionTrack track, SelectedAction action)
        => RunAsync(new[] { track }, action, null);

    private async Task RunAsync(
        IReadOnlyList<AttentionTrack> tracks, SelectedAction action, AttentionGroup? group)
    {
        if (tracks.Count == 0 || _busy) return;
        _busy = true;
        _lastResult = null;
        _busyLabel = BusyLabel(action);
        _progressDone = 0;
        _progressTotal = tracks.Count;
        _actionCts = new CancellationTokenSource();
        var token = _actionCts.Token;
        IProgress<int> progress = new InlineProgress(done =>
        {
            _progressDone = done;
            _ = InvokeAsync(StateHasChanged);
        });
        var ids = tracks.Select(track => track.TrackId).ToList();
        StateHasChanged();
        // Let the busy panel render before the first await enters the
        // background action. Progress callbacks marshal back to this circuit.
        await Task.Yield();
        try
        {
            var result = await Task.Run(
                () => RunActionAsync(action, ids, progress, token), token);
            _lastResult = result;
            if (result.Failed == 0) Notifications.Success(result.Summary);
            else Notifications.Warn(result.Summary);
            selected.Clear();
            if (group is not null && group.Tracks.Count == 1) selected.Clear();
            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
            Notifications.Info("The action was stopped.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error("The action failed: " + ex.Message);
        }
        finally
        {
            _busy = false;
            _actionCts?.Dispose();
            _actionCts = null;
            StateHasChanged();
        }
    }

    private Task<AttentionBulkResult> RunActionAsync(
        SelectedAction action, IReadOnlyList<int> ids,
        IProgress<int> progress, CancellationToken token)
        => action switch
        {
            SelectedAction.Retry => Actions.RetryAsync(ids, false, progress, token),
            SelectedAction.RetryElsewhere => Actions.RetryAsync(ids, true, progress, token),
            SelectedAction.Hardlink => Actions.HardlinkAsync(ids, progress, token),
            SelectedAction.Archive => Actions.ArchiveAsync(ids, progress, token),
            SelectedAction.Keep => Actions.QualityReviewAsync(ids, QualityReviewAction.Keep, progress, token),
            SelectedAction.RetryReview => Actions.QualityReviewAsync(ids, QualityReviewAction.Retry, progress, token),
            SelectedAction.Reverify => Actions.ReverifyAsync(ids, progress, token),
            SelectedAction.DedupHardlink => Actions.DedupAsync(ids, true, progress, token),
            SelectedAction.DedupDownload => Actions.DedupAsync(ids, false, progress, token),
            _ => Task.FromResult(new AttentionBulkResult(0, 0, new List<string>())),
        };

    private void RunFixAllAsync() => StartFix(BuildPlan(FixSteps, ResyncablePlaylists));

    private void RunFixPlaylistsAsync() => StartFix(BuildPlan(
        Array.Empty<AttentionRepairStep>(), ResyncablePlaylists));

    private void StartFix(AttentionRepairPlan plan)
    {
        if (Repair.Start(plan)) return;
        if (Repair.IsRunning) Notifications.Info("A repair is already running.");
    }

    private static AttentionRepairPlan BuildPlan(
        IReadOnlyList<AttentionRepairStep> steps,
        IReadOnlyList<AttentionPlaylist> playlists)
        => new(
            steps,
            playlists.Select(playlist => new AttentionRepairPlaylist(
                playlist.Name, playlist.SourceUrl!)).ToList());

    private void StopAction()
    {
        if (Repair.IsRunning) Repair.Stop();
        else _actionCts?.Cancel();
    }

    private async Task ResyncPlaylistAsync(AttentionPlaylist playlist)
    {
        _busy = true;
        _busyLabel = "Re-syncing " + playlist.Name;
        try
        {
            await Store.AddOrRefreshAsync(playlist.SourceUrl!);
            Notifications.Success($"{playlist.Name} refreshed.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Could not refresh {playlist.Name}: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Tone(string kind) => kind switch
    {
        AttentionKinds.FailedNoSource or AttentionKinds.FailedAuth
            or AttentionKinds.FailedCorrupt or AttentionKinds.FileMissing => "bad",
        AttentionKinds.FailedQualityFilter or AttentionKinds.FailedFormat
            or AttentionKinds.FailedDuration or AttentionKinds.FailedInvalidAudio
            or AttentionKinds.FailedTimeout or AttentionKinds.FailedCancelled
            or AttentionKinds.FailedMetadata or AttentionKinds.FailedOther => "warn",
        AttentionKinds.Dedup => "warn",
        AttentionKinds.ReviewLength or AttentionKinds.ReviewSpectrum or AttentionKinds.ReviewBoth => "warn",
        _ => "neutral",
    };

    private static string PillVariant(string kind) => Tone(kind) switch
    {
        "bad" => "err",
        "warn" => "warn",
        _ => "neutral",
    };

    private static string KindShort(string kind) => kind switch
    {
        AttentionKinds.FailedNoSource => "no source",
        AttentionKinds.FailedQualityFilter => "quality",
        AttentionKinds.FailedFormat => "format",
        AttentionKinds.FailedDuration => "length",
        AttentionKinds.FailedInvalidAudio => "not audio",
        AttentionKinds.FailedCorrupt => "corrupt",
        AttentionKinds.FailedAuth => "login",
        AttentionKinds.FailedTimeout => "timeout",
        AttentionKinds.FailedCancelled => "cancelled",
        AttentionKinds.FailedMetadata => "metadata",
        AttentionKinds.FailedOther => "error",
        AttentionKinds.Dedup => "hardlink",
        AttentionKinds.ReviewLength => "length review",
        AttentionKinds.ReviewSpectrum => "quality review",
        AttentionKinds.ReviewBoth => "two reviews",
        AttentionKinds.Archive => "archive",
        AttentionKinds.FileMissing => "missing file",
        AttentionKinds.Unverified => "unverified",
        _ => "open",
    };

    private static string KindIcon(string kind) => kind switch
    {
        AttentionKinds.FailedNoSource => "search",
        AttentionKinds.FailedQualityFilter => "filter",
        AttentionKinds.FailedFormat => "file-down",
        AttentionKinds.FailedDuration => "clock",
        AttentionKinds.FailedInvalidAudio or AttentionKinds.FailedCorrupt => "alert",
        AttentionKinds.FailedAuth => "eye",
        AttentionKinds.FailedTimeout => "clock",
        AttentionKinds.FailedCancelled => "x",
        AttentionKinds.FailedMetadata => "info",
        AttentionKinds.FailedOther => "alert",
        AttentionKinds.Dedup => "copy",
        AttentionKinds.ReviewLength or AttentionKinds.ReviewSpectrum or AttentionKinds.ReviewBoth => "sliders",
        AttentionKinds.Archive => "archive",
        AttentionKinds.FileMissing => "folder",
        AttentionKinds.Unverified => "help",
        _ => "alert",
    };

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        Repair.Changed -= OnRepairChanged;
        ArchiveBackfill.Changed -= OnArchiveBackfillChanged;
        if (_mode is not null) _mode.Changed -= OnModeChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _actionCts?.Cancel();
        _actionCts?.Dispose();
    }
}
