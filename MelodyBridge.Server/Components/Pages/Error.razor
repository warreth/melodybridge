@page "/Error"
@using System.Diagnostics
@layout MainLayout

<PageTitle>Error - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Error</span>
        <h1>Something broke</h1>
        <p>The request failed and was stopped. Nothing was half-written:
            downloads and syncs restart clean on their next run.</p>
    </div>
</section>

<section class="panel-card" style="max-width:480px;">
    @if (ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@RequestId</code>
        </p>
        <p class="text-muted">
            Quote this ID in the logs page: the failing entry sits right
            next to it. <a href="/logs">Open the logs</a>.
        </p>
    }
    else
    {
        <p class="text-muted"><a href="/logs">Open the logs</a> to see what happened.</p>
    }
    <a class="btn-modern primary" href="/">Back to the dashboard</a>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
