@page "/dev"
@rendermode InteractiveServer
@using MelodyBridge.Core
@using MelodyBridge.Server.Services
@inject DevPanelService Dev
@inject DevDiagnosticsService Diagnostics
@inject IDownloaderRegistry Registry
@inject IDownloadManager DownloadMgr
@inject MelodyBridge.Server.Services.NotificationService Notifications
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@implements IDisposable

<PageTitle>Dev panel - MelodyBridge</PageTitle>

@if (!Dev.Enabled)
{
    <PageTitle>Not found</PageTitle>
    <section class="empty-state">
        <h2>Page not found</h2>
        <p>Sorry, there's nothing at this address.</p>
    </section>
}
else
{

<section class="page-title">
    <div>
        <span class="eyebrow">Developer</span>
        <h1>Dev panel</h1>
        <p>Probe plugins, read runtime and database facts, search, download, and inspect live logs.</p>
    </div>
    <div class="flex-actions">
        <button class="btn-modern ghost" @onclick="ClearQueue" title="Clear completed downloads">
            <Icon Name="x" Size="14" Class="btn-icon" /> Clear queue
        </button>
        <button class="btn-modern ghost" @onclick="ClearAll">
            <Icon Name="trash" Size="14" Class="btn-icon" /> Clear logs
        </button>
    </div>
</section>

<div class="dev-layout">

    @* ── SEARCH PANEL ── *@
    <section class="panel-card dev-search-section">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Step 1</span>
                <h2>Search tracks</h2>
            </div>
        </div>
        <div class="search-controls">
            <div class="search-row">
                <input type="search" class="search-input" @bind="Dev.SearchQuery"
                       @bind:event="oninput"
                       placeholder="artist: song title, or paste a URL…"
                       @onkeydown="HandleSearchKeyDown" />
                <select class="search-provider-select" @bind="Dev.SearchProviderId">
                    <option value="">All providers</option>
                    @foreach (var p in _providers)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
                <button class="btn-modern primary" @onclick="DoSearch" disabled="@_searching">
                    @if (_searching)
                    {
                        <span class="spinner"></span>
                    }
                    Search
                </button>
            </div>
        </div>

        @if (Dev.SearchResults.Count > 0)
        {
            <div class="search-results-count">
                <span class="pill neutral">@Dev.SearchResults.Count @(Dev.SearchResults.Count == 1 ? "result" : "results")</span>
                @if (_hasMoreProviders)
                {
                    <span class="hint">: not all providers may have responded yet</span>
                }
            </div>
            <div class="search-results-list">
                @foreach (var result in Dev.SearchResults)
                {
                    <div class="search-result-item" title="@result.Url">
                        <div class="sr-artwork">
                            @if (result.SourcePlatform == Platform.YouTubeMusic)
                            {
                                <BrandIcon Name="youtube" Size="20" Class="sr-artwork-icon" />
                            }
                            else if (result.SourcePlatform == Platform.Spotify)
                            {
                                <BrandIcon Name="spotify" Size="20" Class="sr-artwork-icon" />
                            }
                            else
                            {
                                <Icon Name="music" Size="18" Class="sr-artwork-icon" />
                            }
                        </div>
                        <div class="sr-meta">
                            <span class="sr-title">@result.Title</span>
                            <span class="sr-artist">@result.Artist</span>
                            @if (!string.IsNullOrEmpty(result.Album))
                            {
                                <span class="sr-album">@result.Album</span>
                            }
                        </div>
                        <div class="sr-badges">
                            <span class="pill outline small">@FormatPlatform(result.SourcePlatform)</span>
                            <span class="pill outline small">@result.ProviderName</span>
                        </div>
                        <div class="sr-actions">
                            <button class="btn-modern primary small"
                                    @onclick="() => QueueSearchDownload(result)"
                                    title="Download this track">
                                Download
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(Dev.LastSearchResult))
        {
            <div class="search-results-empty">
                <pre class="dev-result">@Dev.LastSearchResult</pre>
            </div>
        }
    </section>

    @* ── DIRECT DOWNLOAD ── *@
    <section class="panel-card dev-dl-section">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Step 2</span>
                <h2>Direct download</h2>
            </div>
        </div>
        <div class="form-grid single">
            <label>
                Track / playlist URL
                <input @bind="Dev.DownloadUrl" placeholder="https://open.spotify.com/track/…" />
                @if (!string.IsNullOrEmpty(_downloadUrlError))
                {
                    <small class="text-warn">@_downloadUrlError</small>
                }
            </label>
            <label>
                Provider
                <select @bind="Dev.SelectedProviderId">
                    <option value="">Auto (quality waterfall)</option>
                    @foreach (var p in _providers)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </label>
            <label>
                Quality
                <select @bind="Dev.SelectedQuality">
                    <option value="">Highest available</option>
                    <option value="flac_24">24-bit FLAC</option>
                    <option value="flac_16">16-bit FLAC</option>
                    <option value="aac_320">320 AAC</option>
                    <option value="mp3_320">320 MP3</option>
                    <option value="mp3_128">128 MP3</option>
                </select>
            </label>
        </div>
        <button class="btn-modern primary" @onclick="DirectDownload" disabled="@_directDownloading">
            @(_directDownloading ? "Downloading…" : "Download & verify")
        </button>
        @if (!string.IsNullOrEmpty(Dev.LastDownloadResult))
        {
            <pre class="dev-result @(_directDownloadSucceeded ? "success" : "error")">@Dev.LastDownloadResult</pre>
        }
    </section>

    @* ── DOWNLOAD QUEUE ── *@
    <section class="panel-card dev-queue-section">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Queue</span>
                <h2>Download queue <span class="pill neutral">@Dev.DownloadQueue.Count tasks</span></h2>
            </div>
        </div>

        @if (Dev.DownloadQueue.Count == 0)
        {
            <div class="empty-state">
                No queued downloads yet. Search for tracks above, then press Download.
            </div>
        }
        else
        {
            <div class="queue-list">
                @foreach (var task in Dev.DownloadQueue)
                {
                    <div class="queue-item queue-@task.Status.ToLowerInvariant()">
                        <div class="qi-status">
                            @if (task.Status == "Downloading")
                            {
                                <span class="spinner"></span>
                            }
                            else if (task.Status == "Completed")
                            {
                                <Icon Name="check" Size="15" Class="qi-icon ok" />
                            }
                            else if (task.Status == "Failed")
                            {
                                <Icon Name="x" Size="15" Class="qi-icon err" />
                            }
                            else
                            {
                                <Icon Name="clock" Size="15" Class="qi-icon pending" />
                            }
                        </div>
                        <div class="qi-meta">
                            <span class="qi-track">@task.TrackInfo</span>
                            <span class="qi-provider">@task.ProviderName</span>
                        </div>
                        <div class="qi-result">
                            @if (task.Status == "Completed" && !string.IsNullOrEmpty(task.ResultPath))
                            {
                                <span class="qi-path" title="@task.ResultPath">@Path.GetFileName(task.ResultPath)</span>
                            }
                            else if (task.Status == "Failed" && !string.IsNullOrEmpty(task.ErrorMessage))
                            {
                                <span class="qi-error">@task.ErrorMessage</span>
                            }
                            else
                            {
                                <span class="qi-status-text">@task.Status</span>
                            }
                        </div>
                        @if (task.Status is "Completed" or "Failed")
                        {
                            <button class="btn-icon-only ghost small" @onclick="() => RemoveDownloadTask(task.Id)" title="Remove"><Icon Name="x" Size="14" /></button>
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>

@* ── DIAGNOSTICS ── *@
<section class="panel-card dev-diagnostics-section">
    <div class="panel-header">
        <div>
            <span class="eyebrow">System</span>
            <h2>Diagnostics</h2>
        </div>
        <div class="panel-actions">
            <button class="btn-modern ghost" @onclick="RefreshFactsAsync" disabled="@_factsLoading">
                @if (_factsLoading)
                {
                    <span class="spinner"></span>
                }
                Refresh
            </button>
            <button class="btn-modern secondary" @onclick="CopyReportAsync"
                    disabled="@(_facts is null || _counts is null)">
                <Icon Name="copy" Size="14" Class="btn-icon" /> Copy report
            </button>
        </div>
    </div>
    @if (_factsError is not null)
    {
        <div class="hint-box">
            <Icon Name="alert" Size="14" Class="inline-icon" />
            @_factsError
        </div>
    }
    else if (_facts is null || _counts is null)
    {
        <p class="hint">Reading the runtime and database facts...</p>
    }
    else
    {
        <div class="diag-grid">
            <div class="diag-block">
                <span class="eyebrow">Runtime</span>
                <dl class="fact-list">
                    <div><dt>Version</dt><dd>@_facts.AppVersion</dd></div>
                    <div><dt>Environment</dt><dd>@_facts.EnvironmentName</dd></div>
                    <div><dt>Runtime</dt><dd>@_facts.Runtime</dd></div>
                    <div><dt>OS</dt><dd>@_facts.OperatingSystem</dd></div>
                    <div><dt>Architecture</dt><dd>@_facts.Architecture</dd></div>
                    <div><dt>Uptime</dt><dd>@FormatUptime(_facts.Uptime)</dd></div>
                </dl>
            </div>
            <div class="diag-block">
                <span class="eyebrow">Database</span>
                <dl class="fact-list">
                    <div><dt>File</dt><dd class="mono" title="@_facts.DatabasePath">@(_facts.DatabasePath ?? "unknown")</dd></div>
                    <div>
                        <dt>Size</dt>
                        <dd>
                            @FormatBytes(_facts.DatabaseBytes)
                            <span class="text-muted">(WAL @FormatBytes(_facts.WalBytes))</span>
                        </dd>
                    </div>
                    <div><dt>Playlists</dt><dd>@_counts.Playlists</dd></div>
                    <div>
                        <dt>Tracks</dt>
                        <dd>
                            @_counts.Tracks
                            <span class="text-muted">@_counts.Downloaded downloaded, @_counts.Failed failed</span>
                        </dd>
                    </div>
                    <div><dt>Sync jobs</dt><dd>@_counts.SyncJobs</dd></div>
                    <div><dt>Scan locations</dt><dd>@_counts.ScanLocations</dd></div>
                    <div><dt>Settings</dt><dd>@_counts.Settings</dd></div>
                </dl>
            </div>
        </div>
    }
</section>

@* ── PLUGIN HEALTH ── *@
<section class="panel-card dev-health-section">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Plugins</span>
            <h2>
                Health
                <span class="pill neutral">@(_probingPlugins ? "probing" : $"{_pluginHealth.Count} probed")</span>
            </h2>
        </div>
        <div class="panel-actions">
            <button class="btn-modern secondary" @onclick="ProbePluginsAsync" disabled="@_probingPlugins">
                @if (_probingPlugins)
                {
                    <span class="spinner"></span>
                }
                @(_probingPlugins ? "Probing..." : "Probe all")
            </button>
        </div>
    </div>
    @if (_probingPlugins && _pluginHealth.Count == 0)
    {
        <p class="hint">
            Probing every plugin in parallel. Slow providers are cut off after 15 seconds.
        </p>
    }
    else if (_pluginHealth.Count == 0)
    {
        <p class="hint">
            Run one availability check per registered plugin. Nothing is downloaded;
            this only asks each plugin whether it is ready.
        </p>
    }
    else
    {
        <div class="health-grid">
            @foreach (var plugin in _pluginHealth)
            {
                <div class="health-row">
                    <div class="health-name">
                        <strong>@plugin.Name</strong>
                        <span class="hint">@plugin.Id</span>
                    </div>
                    <div class="health-tags">
                        @if (!plugin.Enabled)
                        {
                            <StatusPill Variant="neutral">disabled</StatusPill>
                        }
                        <StatusPill Variant="@(plugin.Available ? "ok" : "err")">
                            @(plugin.Available ? "ready" : "unavailable")
                        </StatusPill>
                        <span class="hint">@plugin.ElapsedMs ms</span>
                    </div>
                    @if (!plugin.Available && !string.IsNullOrWhiteSpace(plugin.Reason))
                    {
                        <p class="health-reason">@plugin.Reason</p>
                    }
                </div>
            }
        </div>
    }
</section>

@* ── LOG VIEWER ── *@
<section class="panel-card log-section">
    <div class="panel-header dev-log-head">
        <div>
            <span class="eyebrow">Output</span>
            <h2>Log viewer <span class="pill neutral">@_filteredLogs.Count of @_logs.Count</span></h2>
        </div>
        <div class="log-tools">
            <input type="search" class="search-input log-search" placeholder="Filter text or category..."
                   value="@_logSearch" @oninput="OnLogSearch" />
            <button class="btn-modern ghost" @onclick="CopyLogsAsync" disabled="@(_filteredLogs.Count == 0)">
                <Icon Name="copy" Size="14" Class="btn-icon" /> Copy
            </button>
        </div>
        <div class="log-filters">
            @foreach (var lvl in _logLevels)
            {
                <button class="btn-filter @(_activeLogLevel == lvl ? "active" : "")"
                        @onclick="() => SetLogLevel(lvl)">
                    @lvl
                </button>
            }
        </div>
    </div>
    <div class="log-container">
        @if (_filteredLogs.Count == 0)
        {
            <div class="log-empty">@(_logs.Count == 0 ? "Nothing captured yet." : "No log entries match the current filter.")</div>
        }
        @foreach (var entry in _filteredLogs)
        {
            <div class="log-line log-@entry.Level.ToLowerInvariant()">
                <span class="log-time">@entry.Timestamp.ToString("HH:mm:ss.fff")</span>
                <span class="log-level">@entry.Level</span>
                <span class="log-cat">[@entry.Category]</span>
                <span class="log-msg">@MelodyBridge.Server.Services.LogRedactor.Redact(entry.Message)</span>
                @if (!string.IsNullOrEmpty(entry.Detail))
                {
                    <pre class="log-detail">@MelodyBridge.Server.Services.LogRedactor.Redact(entry.Detail)</pre>
                }
            </div>
        }
    </div>
</section>

}

@code {
    private List<IDownloader> _providers = new();
    private List<DevLogEntry> _logs = new();
    private List<DevLogEntry> _filteredLogs = new();
    private bool _searching;
    private bool _hasMoreProviders;
    private bool _directDownloading;
    private bool _directDownloadSucceeded;
    private string? _downloadUrlError;
    private string _activeLogLevel = "All";
    private string _logSearch = string.Empty;
    private static readonly string[] _logLevels = ["All", "Info", "Warn", "Error", "Debug"];

    private DevSystemFacts? _facts;
    private DevDatabaseCounts? _counts;
    private List<DevPluginHealth> _pluginHealth = new();
    private bool _factsLoading;
    private bool _probingPlugins;
    private string? _factsError;

    private Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        _providers = Registry.GetAll().ToList();
        RefreshState();
        await RefreshFactsAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _pollTimer = new Timer(async _ =>
            {
                await InvokeAsync(() =>
                {
                    RefreshState();
                    StateHasChanged();
                });
            }, null, 1000, 2000);
        }
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }

    private void RefreshState()
    {
        _logs = Dev.GetLogs().ToList();
        ApplyLogFilter();
    }

    private void ApplyLogFilter()
    {
        IEnumerable<DevLogEntry> filtered = _activeLogLevel == "All"
            ? _logs
            : _logs.Where(e => e.Level.Equals(_activeLogLevel, StringComparison.OrdinalIgnoreCase));
        var search = _logSearch.Trim();
        if (search.Length > 0)
        {
            filtered = filtered.Where(e =>
                e.Category.Contains(search, StringComparison.OrdinalIgnoreCase)
                || e.Message.Contains(search, StringComparison.OrdinalIgnoreCase)
                || (e.Detail?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        _filteredLogs = filtered.ToList();
    }

    private void OnLogSearch(ChangeEventArgs e)
    {
        _logSearch = e.Value?.ToString() ?? string.Empty;
        ApplyLogFilter();
    }

    private async Task RefreshFactsAsync()
    {
        _factsLoading = true;
        _factsError = null;
        try
        {
            var factsTask = Diagnostics.GetSystemFactsAsync();
            var countsTask = Diagnostics.GetDatabaseCountsAsync();
            await Task.WhenAll(factsTask, countsTask);
            _facts = await factsTask;
            _counts = await countsTask;
        }
        catch (Exception ex)
        {
            _factsError = $"Could not read system facts: {ex.Message}";
            Dev.LogWarn("Diagnostics", _factsError);
        }
        finally
        {
            _factsLoading = false;
            RefreshState();
        }
    }

    private async Task ProbePluginsAsync()
    {
        _probingPlugins = true;
        try
        {
            _pluginHealth = (await Diagnostics.ProbePluginsAsync()).ToList();
            Dev.LogInfo("Plugins",
                $"Probed {_pluginHealth.Count} plugins: {_pluginHealth.Count(p => p.Available)} ready");
        }
        catch (Exception ex)
        {
            Dev.LogError("Plugins", $"Probe failed: {ex.Message}");
            Notifications.Error($"Plugin probe failed: {ex.Message}");
        }
        finally
        {
            _probingPlugins = false;
            RefreshState();
        }
    }

    private async Task CopyReportAsync()
    {
        if (_facts is null || _counts is null) return;
        var report = Diagnostics.BuildReport(_facts, _counts, _pluginHealth);
        var copied = await JS.InvokeAsync<bool>("melody.copyText", report);
        if (copied)
            Notifications.Success("Diagnostics report copied.");
        else
            Notifications.Error("Could not copy the report. Select the text and copy it manually.");
    }

    private async Task CopyLogsAsync()
    {
        if (_filteredLogs.Count == 0) return;
        var text = string.Join(Environment.NewLine, _filteredLogs.Select(entry =>
            $"{entry.Timestamp:HH:mm:ss.fff} [{entry.Level}] {entry.Category}: " +
            MelodyBridge.Server.Services.LogRedactor.Redact(entry.Message)));
        var copied = await JS.InvokeAsync<bool>("melody.copyText", text);
        if (copied)
            Notifications.Success($"{_filteredLogs.Count} log entries copied.");
        else
            Notifications.Error("Could not copy the visible log entries.");
    }

    private void SetLogLevel(string level)
    {
        _activeLogLevel = level;
        ApplyLogFilter();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoSearch();
    }

    private async Task DoSearch()
    {
        var query = Dev.SearchQuery;
        if (string.IsNullOrWhiteSpace(query))
        {
            Dev.LogWarn("Search", "No query entered");
            RefreshState();
            return;
        }

        _searching = true;
        _hasMoreProviders = false;
        Dev.SearchResults.Clear();
        Dev.LastSearchResult = null;

        try
        {
            Dev.LogInfo("Search", $"Searching for \"{query}\"");

            // Query is "artist - title" or a plain title; split on " - "
            // when present. Without a separator the whole query is the
            // title, never both fields (that doubled the search term).
            var parts = query.Split(" - ", 2, StringSplitOptions.TrimEntries);
            var artist = parts.Length == 2 ? parts[0] : "";
            var title = parts.Length == 2 ? parts[1] : query;

            foreach (var plugin in Registry.GetEnabled())
            {
                // The provider select narrows the sweep; "All providers"
                // leaves it empty.
                if (!string.IsNullOrEmpty(Dev.SearchProviderId)
                    && plugin.Id != Dev.SearchProviderId)
                    continue;
                try
                {
                    if (!await plugin.IsAvailableAsync())
                    {
                        Dev.LogWarn("Search", $"{plugin.Name}: unavailable, skipped");
                        continue;
                    }

                    var hit = await plugin.SearchAsync(new TrackQuery(artist, title, Core.DownloadQuality.Any));
                    if (hit is null || hit.SourceUrl is null)
                    {
                        Dev.LogInfo("Search", $"{plugin.Name}: no hit");
                        continue;
                    }

                    Dev.LogInfo("Search", $"{plugin.Name}: found \"{hit.Title}\"");
                    Dev.SearchResults.Add(new InteractiveSearchResult(
                        hit.Title, hit.Artist ?? artist, null, hit.SourceUrl,
                        Core.Platform.Unknown, Array.Empty<Core.TrackQuality>(),
                        plugin.Id, plugin.Name
                    ));
                }
                catch (Exception ex)
                {
                    Dev.LogWarn("Search", $"{plugin.Name}: error: {ex.Message}");
                }
            }

            _hasMoreProviders = false;

            if (Dev.SearchResults.Count == 0)
            {
                Dev.LastSearchResult = string.IsNullOrEmpty(Dev.SearchProviderId)
                    ? "No results found from any plugin."
                    : "No results from the selected provider.";
                Dev.LogInfo("Search", "No results across the queried plugins");
            }
            else
            {
                Dev.LogInfo("Search", $"Total: {Dev.SearchResults.Count} result{(Dev.SearchResults.Count == 1 ? "" : "s")}");
            }
        }
        catch (Exception ex)
        {
            Dev.LastSearchResult = $"Search exception: {ex.Message}";
            Dev.LogError("Search", $"Exception: {ex.Message}", ex.ToString());
        }
        finally
        {
            _searching = false;
            RefreshState();
        }
    }

    private async Task QueueSearchDownload(InteractiveSearchResult result)
    {
        var taskId = Dev.NextDownloadTaskId();
        var task = new DevDownloadTask(
            taskId,
            $"{result.Artist}: {result.Title}",
            result.Url,
            result.ProviderName,
            "Pending",
            null, null
        );
        Dev.DownloadQueue.Add(task);
        Dev.LogInfo("Queue", $"Queued: {result.Artist}: {result.Title} from {result.ProviderName}");

        _ = DownloadTaskAsync(task, result);
        RefreshState();
    }

    private async Task DownloadTaskAsync(DevDownloadTask task, InteractiveSearchResult result)
    {
        try
        {
            task.Status = "Downloading";
            RefreshState();

            var quality = new TrackQuality(320, MediaType.MP3);
            if (result.AvailableQualities.Count > 0)
            {
                quality = result.AvailableQualities
                    .OrderByDescending(q => q.Bitrate)
                    .First();
            }

            var outputDir = Path.Combine(Path.GetTempPath(), "MelodyBridge_DevTest");
            Directory.CreateDirectory(outputDir);

            var path = await DownloadMgr.DownloadAsync(result.Url, outputDir, $"dev-{task.Id}");
            if (path != null)
            {
                task.Status = "Completed";
                task.ResultPath = path;
                Dev.LogInfo("Queue", $"Downloaded: {Path.GetFileName(path)} ({new FileInfo(path).Length:N0} bytes)");
            }
            else
            {
                task.Status = "Failed";
                task.ErrorMessage = "no plugin could download this URL";
                Dev.LogError("Queue", $"Failed: {task.TrackInfo}: {task.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            task.Status = "Failed";
            task.ErrorMessage = ex.Message;
            Dev.LogError("Queue", $"Exception: {task.TrackInfo}: {ex.Message}", ex.ToString());
        }
        RefreshState();
    }

    private async Task DirectDownload()
    {
        var url = Dev.DownloadUrl;
        if (string.IsNullOrWhiteSpace(url))
        {
            _downloadUrlError = "Paste a track or playlist URL first.";
            Dev.LogWarn("Download", "No URL provided");
            RefreshState();
            return;
        }
        _downloadUrlError = null;

        _directDownloading = true;
        _directDownloadSucceeded = false;
        Dev.LastDownloadResult = null;

        try
        {
            Dev.LogInfo("Download", $"Starting direct download: {url}");

            var outputDir = Path.Combine(Path.GetTempPath(), "MelodyBridge_DevTest");
            Directory.CreateDirectory(outputDir);

            string? filePath;

            if (!string.IsNullOrEmpty(Dev.SelectedProviderId))
            {
                var plugin = _providers.FirstOrDefault(p => p.Id == Dev.SelectedProviderId);
                if (plugin == null)
                {
                    Dev.LogError("Download", $"Plugin '{Dev.SelectedProviderId}' not found");
                    RefreshState();
                    return;
                }

                var result = await plugin.DownloadAsync(url, outputDir, $"dev-{Dev.NextDownloadTaskId()}");
                filePath = result.Success ? result.FilePath : null;
                Dev.LogInfo("Download", $"Plugin result: {(result.Success ? "OK" : "Failed")} | {result.ErrorMessage ?? result.FilePath}");
            }
            else
            {
                filePath = await DownloadMgr.DownloadAsync(url, outputDir, "dev-test");
                Dev.LogInfo("Download", $"Waterfall returned: {filePath ?? "null (all failed)"}");
            }

            if (filePath != null && File.Exists(filePath))
            {
                var fi = new FileInfo(filePath);
                var header = await CheckAudioHeaderAsync(filePath);
                Dev.LastDownloadResult = $"✅ {fi.Name}  ({fi.Length:N0} bytes)  {header}";
                _directDownloadSucceeded = true;
                Dev.LogInfo("Download", $"Success: {Dev.LastDownloadResult}");
            }
            else
            {
                Dev.LastDownloadResult = "Download returned no file";
                Dev.LogError("Download", "All providers failed for direct download");
            }
        }
        catch (Exception ex)
        {
            Dev.LastDownloadResult = $"Exception: {ex.Message}";
            Dev.LogError("Download", $"Exception: {ex.Message}", ex.ToString());
        }
        finally
        {
            _directDownloading = false;
            RefreshState();
        }
    }

    private void RemoveDownloadTask(string taskId)
    {
        Dev.DownloadQueue.RemoveAll(t => t.Id == taskId);
        RefreshState();
    }

    private void ClearQueue()
    {
        if (Dev.DownloadQueue.Count == 0)
        {
            Notifications.Info("Queue is already empty.");
            return;
        }
        Dev.DownloadQueue.Clear();
        Notifications.Success("Queue cleared.");
        RefreshState();
    }

    private void ClearAll()
    {
        Dev.ClearLogs();
        Dev.LastDownloadResult = null;
        Dev.LastSearchResult = null;
        Dev.SearchResults.Clear();
        Notifications.Info("Log buffer cleared.");
        RefreshState();
    }

    private static string FormatUptime(TimeSpan uptime)
        => uptime.TotalDays >= 1
            ? $"{(int)uptime.TotalDays}d {uptime.Hours}h {uptime.Minutes}m"
            : uptime.TotalHours >= 1
                ? $"{(int)uptime.TotalHours}h {uptime.Minutes}m"
                : $"{uptime.Minutes}m {uptime.Seconds}s";

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1L << 30 => $"{bytes / (double)(1L << 30):0.0} GB",
        >= 1L << 20 => $"{bytes / (double)(1L << 20):0.0} MB",
        >= 1L << 10 => $"{bytes / (double)(1L << 10):0.0} KB",
        _ => $"{bytes} B",
    };

    private static string FormatPlatform(Platform p) => p switch
    {
        Platform.YouTubeMusic => "YouTube",
        Platform.AppleMusic => "Apple",
        Platform.AmazonMusic => "Amazon",
        _ => p.ToString()
    };

    private static TrackQuality ParseQuality(string? q) => q switch
    {
        "flac_24" => new(24, MediaType.FLAC),
        "flac_16" => new(16, MediaType.FLAC),
        "aac_320" => new(320, MediaType.AAC),
        "mp3_320" => new(320, MediaType.MP3),
        "mp3_128" => new(128, MediaType.MP3),
        _ => new(320, MediaType.MP3),
    };

    private static async Task<string> CheckAudioHeaderAsync(string filePath)
    {
        using var fs = File.OpenRead(filePath);
        var header = new byte[16];
        var read = await fs.ReadAsync(header, 0, Math.Min(16, header.Length));
        if (read < 4) return "too small";

        if (header[0] == 0x49 && header[1] == 0x44 && header[2] == 0x33) return "MP3 (ID3v2)";
        if (header[0] == 0xFF && (header[1] & 0xE0) == 0xE0) return "MP3";
        if (header[0] == 0x66 && header[1] == 0x4C && header[2] == 0x61 && header[3] == 0x43) return "FLAC";
        if (header[0] == 0x4F && header[1] == 0x67 && header[2] == 0x67 && header[3] == 0x53) return "OGG (Vorbis/Opus)";
        if (header[4] == 0x66 && header[5] == 0x74 && header[6] == 0x79 && header[7] == 0x70) return "M4A/AAC (MP4)";
        if (header[8] == 0x77 && header[9] == 0x61 && header[10] == 0x76 && header[11] == 0x65) return "WAV";
        return $"unknown ({BitConverter.ToString(header[..Math.Min(8, read)])})";
    }
}
