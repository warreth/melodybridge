@page "/auth/callback"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Accounts
@using Microsoft.Extensions.Logging

@inject SpotifyAccountProvider Spotify
@inject YouTubeAccountProvider YouTube
@inject NavigationManager Nav
@inject ILogger<AuthCallback> Logger

@* The OAuth landing page: Spotify and YouTube redirect here after login.
   The provider exchanges the code; the user sees a clear success or error
   and goes back to the accounts panel. *@

<PageTitle>Connecting account</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Accounts</span>
        <h1>Connecting your account</h1>
        <p>Finishing the login and returning you to the accounts settings.</p>
    </div>
</section>

<section class="panel-card" style="max-width:480px; margin-inline:auto;">
    <div class="panel-header">
        <div>
            <h2>Login status</h2>
        </div>
    </div>

    @if (done)
    {
        <div class="workflow-list">
            <div class="workflow-step done">
                <span class="workflow-number"><Icon Name="check" Size="16" /></span>
                <span>@message</span>
            </div>
        </div>
        <p class="text-muted">You can close this window, or <a href="/settings#accounts">go back to the accounts settings</a>.</p>
    }
    else if (error is not null)
    {
        <div class="result-box error">@error</div>
        <p class="text-muted"><a href="/settings#accounts">Back to the accounts settings</a> and try connecting again.</p>
    }
    else
    {
        <div class="workflow-step todo">
            <span class="workflow-number">…</span>
            <span>Finishing the login, one moment</span>
        </div>
    }
</section>

@code {
    private bool done;
    private bool processed;
    private string? error;
    private string message = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Provider { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The host renders this page with ServerPrerendered, so
        // OnInitialized runs once during the prerender and once more when
        // the circuit starts, while the provider's pending login is
        // one-shot. The exchange therefore runs on the first interactive
        // render, exactly once; the prerendered pass only shows the
        // "one moment" state. Running it twice used to consume the pending
        // login and show a false error after a successful connect.
        if (!firstRender || processed) return;
        processed = true;

        var query = new Uri(Nav.Uri).Query;
        try
        {
            if (string.IsNullOrWhiteSpace(query))
                throw new InvalidOperationException("This page is only reached from a login redirect.");

            IAccountSourceProvider? provider = Provider?.ToLowerInvariant() switch
            {
                "spotify" => Spotify,
                "youtube" => (IAccountSourceProvider)YouTube,
                _ => null,
            };
            if (provider is null)
                throw new InvalidOperationException($"Unknown provider '{Provider}'.");

            // The redirect URL this page runs on, as registered in the
            // platform's app settings: rebuilt exactly the way Settings
            // built it when the login started, provider marker included:
            // Spotify requires the exchange URI to match the authorize one
            // character for character. Localhost hosts are exchanged with
            // 127.0.0.1, the same substitution Settings makes.
            var origin = Nav.BaseUri.TrimEnd('/');
            var redirectUrl = Settings.LoopbackUri(new Uri(
                $"{origin}/auth/callback?provider={Provider?.ToLowerInvariant()}"));

            message = await provider.CompleteLoginAsync(query, redirectUrl);
            done = true;
        }
        catch (Exception ex)
        {
            // Same channel as the Logs page: the account categories map
            // there, so a failed login is never silent again.
            Logger.LogWarning(ex, "Account login callback failed for {Provider}", Provider ?? "unknown");
            error = ex.Message;
        }

        StateHasChanged();
    }
}
