@page "/advanced"
@using MelodyBridge.Application.Services
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Services
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject SettingsStore Settings
@inject PlaylistStore PlaylistStore
@inject FileNameRenamer Renamer
@inject IDownloadCoordinator Coordinator
@inject NotificationService Notifications
@inject DevPanelService DevPanel

<PageTitle>Advanced - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">System</span>
        <div class="title-with-help">
            <h1>Advanced</h1>
            <HelpTip Path="reference#the-advanced-page" Text="Developer tools, download limits, the dedup toggle, display, logging and maintenance options." />
        </div>
        <p>Download behaviour, diagnostics and library maintenance.</p>
    </div>
    <div class="topbar-actions">
        @if (dirty)
        {
            <span class="save-state pending">Unsaved changes</span>
        }
        <button class="btn-modern primary" @onclick="SaveAll" disabled="@saving">@(saving ? "Saving…" : "Save")</button>
    </div>
</section>

<section class="advanced-layout">
    <div class="settings-card" id="downloads">
        <div class="settings-head">
            <div>
                <span class="eyebrow">Behaviour</span>
                <h2>Downloads</h2>
            </div>
        </div>
        <div class="form-grid single">
            <div class="field-with-help">
                <label>
                    Max simultaneous track downloads
                    <input @bind="maxConcurrentDownloads" @bind:after="MarkDirty" type="number" min="1" max="8" step="1" />
                </label>
                <HelpTip Path="reference#the-advanced-page" Text="How many tracks download at once, between 1 and 8. Higher finishes playlists faster but hits every source harder." />
            </div>
            <div class="field-with-help">
                <label>
                    Plugin time budget (seconds)
                    <input @bind="pluginBudgetSeconds" @bind:after="MarkDirty" type="number" min="30" max="3600" step="10" />
                </label>
                <HelpTip Path="reference#the-advanced-page" Text="Time one plugin may spend on a track before the next one is tried." />
            </div>
            <div class="field-with-help">
                <label>
                    Track time budget (seconds)
                    <input @bind="trackBudgetSeconds" @bind:after="MarkDirty" type="number" min="60" max="14400" step="60" />
                </label>
                <HelpTip Path="reference#the-advanced-page" Text="Total time one track may take across all plugins." />
            </div>
            <div class="field-with-help">
                <label>
                    Downloaded file names
                    <input @bind="fileNamePattern" @bind:after="MarkDirty" type="text" spellcheck="false" />
                </label>
                <HelpTip Path="reference#the-advanced-page" Text="The pattern for new downloads. Tokens: {artist}, {title}, {album}, {track}. Use {source} to keep the plugin's own file name." />
            </div>
        </div>
        <div class="hint-box">
            New downloads use this pattern. Available tokens:
            <code>{artist}</code>, <code>{title}</code>, <code>{album}</code>,
            <code>{track}</code> and <code>{source}</code>. Existing tracks keep
            their names until you run the rename action under Maintenance.
        </div>
        <div class="toggle-with-help">
            <label class="toggle-switch wide">
                <input type="checkbox" @bind="dedupEnabled" @bind:after="MarkDirty" />
                <span class="toggle-slider"></span>
                <span>Hardlink duplicate tracks across playlists</span>
            </label>
            <HelpTip Path="concepts#duplicate-tracks" Text="When a track already exists in another playlist folder in the right quality, link it instead of downloading it again." />
        </div>
        <div class="hint-box">
            Identical tracks are hardlinked across playlists: same bytes, no
            second download. A quality difference pauses the track so you can
            link it or fetch a fresh copy. Cross-drive links fall back to a
            normal download.
        </div>
        <div class="hint-box">
            Higher values finish large playlists faster but hit every source
            harder. The limit covers playlist and manual downloads together;
            the next run uses the new value.
        </div>
    </div>
    <div class="advanced-side">
        <div class="settings-card">
            <div class="settings-head">
                <div>
                    <span class="eyebrow">Developer</span>
                    <h2>Advanced mode</h2>
                </div>
            </div>
            <label class="toggle-switch wide">
                <input type="checkbox" @bind="advancedMode" @bind:after="MarkDirty" />
                <span class="toggle-slider"></span>
                <span>Show developer tools and technical details</span>
            </label>
            <div class="hint-box">
                Adds the Dev panel and the longer notes for unofficial accounts.
                Leave it off for everyday use.
            </div>
            @if (DevPanel.Enabled)
            {
                <p>
                    <a class="btn-modern secondary" href="/dev">
                        <Icon Name="terminal" Size="16" /> Open the Dev panel
                    </a>
                </p>
            }
        </div>
        <div class="settings-card">
            <div class="settings-head">
                <div>
                    <span class="eyebrow">Interface</span>
                    <h2>Display</h2>
                </div>
            </div>
            <div class="toggle-with-help">
                <label class="toggle-switch wide">
                    <input type="checkbox" @bind="showFilename" @bind:after="MarkDirty" />
                    <span class="toggle-slider"></span>
                    <span>Show the file column on playlist tracks</span>
                </label>
                <HelpTip Path="concepts#archive-copies" Text="Reveals the exact file behind every track, archive copies included." />
            </div>
            <div class="hint-box">
                Shows the file behind each track, archive copies included.
            </div>
        </div>

        <div class="settings-card">
            <div class="settings-head">
                <div>
                    <span class="eyebrow">Logging</span>
                    <h2>Database activity</h2>
                </div>
            </div>
            <label class="toggle-switch wide">
                <input type="checkbox" @bind="logDatabaseActivity" @bind:after="MarkDirty" />
                <span class="toggle-slider"></span>
                <span>Show database activity in the logs</span>
            </label>
            <div class="hint-box">
                Logs every SQL command. Turn it on only while debugging a database
                problem.
            </div>
        </div>
    </div>
    <div class="settings-card advanced-maintenance">
        <div class="settings-head">
            <div>
                <span class="eyebrow">Maintenance</span>
                <h2>Library maintenance</h2>
                <p class="panel-description">
                    Repair the facts, tags and file names of tracks that are already on disk.
                    These actions never change the audio itself.
                </p>
            </div>
        </div>
        <div class="maintenance-grid">
            <div class="maintenance-action">
                <strong>Audio facts</strong>
                <p>
                    Re-measure bitrate, sample rate and size, then run the quality check again.
                    Missing files are queued for a new download.
                </p>
                <button class="btn-modern primary" disabled="@recomputing" @onclick="RecomputeFacts">
                    @(recomputing ? "Recomputing…" : "Recompute audio facts")
                </button>
            </div>
            <div class="maintenance-action">
                <strong>Tags</strong>
                <p>
                    Fill missing cover art, lyrics, release credit and album name.
                    Existing tags and embedded artwork are left alone.
                </p>
                <button class="btn-modern" disabled="@retagging" @onclick="RetagLibrary">
                    @(retagging ? "Re-tagging…" : "Re-tag library")
                </button>
                @if (retagResult is not null)
                {
                    <p class="text-muted">@retagResult</p>
                }
            </div>
            <div class="maintenance-action">
                <strong>File names</strong>
                <p>
                    Apply the download name pattern to tracks already on disk.
                    Tags and audio stay untouched.
                </p>
                <p class="maintenance-pattern">
                    Current pattern <code>@fileNamePattern</code>
                    <a href="#downloads">Change</a>
                </p>
                <button class="btn-modern" disabled="@(renaming || renameCounting || saving)" @onclick="AskRenameFiles">
                    @(renameCounting ? "Checking tracks…" : renaming ? "Renaming…" : "Check file names")
                </button>
            </div>
        </div>
        @if (renameConfirm && renameSummary is { } summary)
        {
            <div class="rename-preview" aria-live="polite">
                <div class="rename-preview-head">
                    <div>
                        <span class="eyebrow">Rename preview</span>
                        <h3>
                            @(summary.ToRename == 0
                                ? "Nothing will change"
                                : $"{summary.ToRename} downloaded {(summary.ToRename == 1 ? "track" : "tracks")} will be renamed")
                        </h3>
                        <p class="rename-pattern">New names follow <code>@fileNamePattern</code>.</p>
                    </div>
                    <button class="icon-button" type="button" title="Close preview" @onclick="CancelRename">
                        <Icon Name="x" Size="16" />
                    </button>
                </div>
                <dl class="rename-counts">
                    <div class="primary">
                        <dt>Will be renamed</dt>
                        <dd>@summary.ToRename</dd>
                    </div>
                    <div>
                        <dt>Already named</dt>
                        <dd>@summary.AlreadyNamed</dd>
                    </div>
                    <div class="@(summary.Missing > 0 ? "warn" : null)">
                        <dt>Missing files</dt>
                        <dd>@summary.Missing</dd>
                    </div>
                    <div class="@(summary.Shared > 0 ? "warn" : null)">
                        <dt>Shared paths</dt>
                        <dd>@summary.Shared</dd>
                    </div>
                    <div class="@(summary.Outside > 0 ? "warn" : null)">
                        <dt>Outside library folders</dt>
                        <dd>@summary.Outside</dd>
                    </div>
                    <div class="@(summary.ArchiveSkipped > 0 ? "muted" : null)">
                        <dt>Archive copies skipped</dt>
                        <dd>@summary.ArchiveSkipped</dd>
                    </div>
                </dl>
                <p class="rename-note">
                    @summary.Total downloaded tracks checked. Archive copies move with their track,
                    and playlists pick up new paths on their next sync. Skipped paths are logged
                    with the reason when you open <a href="/logs">Logs</a> at Debug.
                </p>
                @if (summary.Shared > 0 || summary.Outside > 0)
                {
                    <p class="rename-note">
                        Shared means more than one row points at the same path. Rows for the same
                        song move together; different songs stay put. Outside means the file is not
                        under the configured music, archive, playlist or scan folders.
                    </p>
                }
                <div class="flex-actions">
                    @if (summary.ToRename > 0)
                    {
                        <button class="btn-modern primary" disabled="@renaming" @onclick="RenameFiles">
                            @(renaming
                                ? "Renaming…"
                                : $"Rename {summary.ToRename} {(summary.ToRename == 1 ? "track" : "tracks")}")
                        </button>
                    }
                    <button class="btn-modern ghost" disabled="@renaming" @onclick="CancelRename">
                        @(summary.ToRename == 0 ? "Close" : "Cancel")
                    </button>
                </div>
            </div>
        }
        @if (renameResult is not null)
        {
            <p class="text-muted">@renameResult</p>
        }
    </div>
</section>

@code {
    private int maxConcurrentDownloads = 2;
    private int pluginBudgetSeconds = 240;
    private int trackBudgetSeconds = 1200;
    private bool showFilename;
    private bool dedupEnabled = true;
    private bool logDatabaseActivity;
    private bool advancedMode;
    private bool recomputing;
    private bool retagging;
    private string? retagResult;
    private string fileNamePattern = FileNamePattern.Default;
    private bool renaming;
    private bool renameCounting;
    private bool renameConfirm;
    private RenamePlanSummary? renameSummary;
    private string? renameResult;

    // Unsaved-changes state for the floating save bar.
    private bool dirty;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(await Settings.GetAsync("download_max_concurrent", "2"), out var maxConcurrent))
            maxConcurrentDownloads = Math.Clamp(maxConcurrent, 1, 8);
        if (int.TryParse(await Settings.GetAsync("download_plugin_budget_seconds", "240"), out var pluginBudget))
            pluginBudgetSeconds = Math.Clamp(pluginBudget, 30, 3600);
        if (int.TryParse(await Settings.GetAsync("download_track_budget_seconds", "1200"), out var trackBudget))
            trackBudgetSeconds = Math.Clamp(trackBudget, 60, 14400);
        showFilename = await Settings.GetBoolAsync("show_filename", false);
        dedupEnabled = await Settings.GetBoolAsync(PlaylistStore.DedupSettingKey, true);
        logDatabaseActivity = await Settings.GetBoolAsync(DatabaseLogSwitch.SettingKey, false);
        advancedMode = await Settings.GetBoolAsync(DevPanelService.AdvancedSettingKey, DevPanel.Enabled);
        fileNamePattern = await Settings.GetAsync(FileNamePattern.SettingKey, FileNamePattern.Default);
    }

    private async Task SaveAll()
    {
        saving = true;
        try
        {
            // Out-of-range input is shown as stored, never silently clamped:
            // typing 20 and reading 8 back after a reload felt like a lie.
            var clamped = Math.Clamp(maxConcurrentDownloads, 1, 8);
            var wasClamped = clamped != maxConcurrentDownloads;
            maxConcurrentDownloads = clamped;
            var clampedPluginBudget = Math.Clamp(pluginBudgetSeconds, 30, 3600);
            var clampedTrackBudget = Math.Clamp(trackBudgetSeconds, 60, 14400);
            var budgetsClamped = clampedPluginBudget != pluginBudgetSeconds || clampedTrackBudget != trackBudgetSeconds;
            pluginBudgetSeconds = clampedPluginBudget;
            trackBudgetSeconds = clampedTrackBudget;
            await Settings.SetAsync("download_max_concurrent", clamped.ToString());
            await Settings.SetAsync("download_plugin_budget_seconds", clampedPluginBudget.ToString());
            await Settings.SetAsync("download_track_budget_seconds", clampedTrackBudget.ToString());
            await Settings.SetAsync("show_filename", showFilename ? "true" : "false");
            await Settings.SetAsync(PlaylistStore.DedupSettingKey, dedupEnabled ? "true" : "false");
            await Settings.SetAsync(DatabaseLogSwitch.SettingKey, logDatabaseActivity ? "true" : "false");
            await Settings.SetAsync(DevPanelService.AdvancedSettingKey, advancedMode ? "true" : "false");
            await Settings.SetAsync(FileNamePattern.SettingKey, fileNamePattern.Trim());
            // Applies immediately, no restart: the log pipeline reads the
            // switch on every entry.
            DatabaseLogSwitch.Set(logDatabaseActivity);
            DevPanel.Enabled = advancedMode;
            dirty = false;
            if (wasClamped)
            {
                Notifications.Warn($"Saved. Concurrency is limited to 1-8, so it is set to {clamped}.");
            }
            else if (budgetsClamped)
            {
                Notifications.Warn("Saved. Time budgets are limited to 30-3600 and 60-14400 seconds.");
            }
            else
            {
                Notifications.Success("Settings saved.");
            }
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>An edit landed: the floating save bar appears.</summary>
    private void MarkDirty() => dirty = true;

    /// <summary>
    /// Fills missing tags (cover, lyrics, release credit, album) on already
    /// downloaded files. Only missing fields are written; the counts are
    /// shown next to the buttons and in a toast.
    /// </summary>
    private async Task RetagLibrary()
    {
        retagging = true;
        try
        {
            var (updated, skipped, failed) = await PlaylistStore.RetagLibraryAsync();
            retagResult = $"Re-tagged {updated} file(s); {skipped} already complete, {failed} could not be read.";
            Notifications.Success(
                $"Re-tagged {updated} file(s), {skipped} already complete, {failed} failed");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Re-tag failed: {ex.Message}");
        }
        finally
        {
            retagging = false;
        }
    }

    /// <summary>
    /// Preview the rename pass with the saved pattern. The field above may
    /// hold an unsaved edit; the files follow what new downloads follow.
    /// </summary>
    private async Task AskRenameFiles()
    {
        renameResult = null;
        renameConfirm = false;
        if (Coordinator.Snapshot().Any(run => run.State is
                DownloadRunState.Running or DownloadRunState.Paused or DownloadRunState.Cancelling))
        {
            renameResult = "A download run is still active. Pause or wait for it before renaming files.";
            return;
        }

        renameCounting = true;
        try
        {
            var summary = await Renamer.CountAsync();
            if (summary.KeepsSourceName)
            {
                renameResult = "The {source} pattern keeps the plugin names, so there is nothing to rename.";
                return;
            }
            if (summary.ToRename == 0)
            {
                renameResult = summary.Total == 0
                    ? "No downloaded tracks to rename."
                    : "Nothing to rename. The breakdown shows why.";
                renameSummary = summary;
                renameConfirm = true;
                return;
            }
            renameSummary = summary;
            renameConfirm = true;
        }
        catch (Exception ex)
        {
            renameResult = $"Could not check the tracks: {ex.Message}";
            Notifications.Error(renameResult);
        }
        finally
        {
            renameCounting = false;
        }
    }

    private void CancelRename()
    {
        renameConfirm = false;
        renameSummary = null;
    }

    private async Task RenameFiles()
    {
        renameConfirm = false;
        renameSummary = null;
        renaming = true;
        try
        {
            var report = await Renamer.RenameAsync();
            var parts = new List<string>
            {
                $"Renamed {report.Renamed} {(report.Renamed == 1 ? "track" : "tracks")}",
            };
            if (report.Skipped > 0) parts.Add($"{report.Skipped} skipped");
            if (report.ArchiveSkipped > 0)
                parts.Add($"{report.ArchiveSkipped} archive {(report.ArchiveSkipped == 1 ? "copy" : "copies")} skipped");
            if (report.Failed > 0) parts.Add($"{report.Failed} failed");
            renameResult = string.Join(", ", parts) + ".";
            Notifications.Success(renameResult);
        }
        catch (Exception ex)
        {
            renameResult = $"Rename failed: {ex.Message}";
            Notifications.Error(renameResult);
        }
        finally
        {
            renaming = false;
        }
    }

    private async Task RecomputeFacts()
    {
        recomputing = true;
        try
        {
            var (recomputed, missing, flagged) = await PlaylistStore.RecomputeMissingFactsAsync();
            var summary = $"Recomputed facts for {recomputed} track(s), {missing} file(s) missing";
            if (flagged > 0) summary += $", {flagged} flagged for review";
            Notifications.Success(summary + ".");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Recompute failed: {ex.Message}");
        }
        finally
        {
            recomputing = false;
        }
    }
}
