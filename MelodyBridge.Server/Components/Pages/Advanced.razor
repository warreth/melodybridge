@page "/advanced"
@using MelodyBridge.Infrastructure.Services
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject SettingsStore Settings

<PageTitle>Advanced - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">System</span>
        <h1>Advanced</h1>
        <p>Intervals and interface details most people never need to touch.</p>
    </div>
    <button class="btn-modern primary" @onclick="SaveAll">Save</button>
</section>

@if (!string.IsNullOrWhiteSpace(savedMessage))
{
    <div class="toast-preview">@savedMessage</div>
}

<section class="content-grid two">
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Behaviour</span>
                <h2>Sync &amp; scanning</h2>
            </div>
        </div>
        <div class="form-grid single">
            <label>
                Auto-scan interval (seconds)
                <input @bind="autoScanIntervalSec" type="number" min="30" step="10" />
            </label>
            <label>
                Sync check interval (seconds)
                <input @bind="syncCheckIntervalSec" type="number" min="60" step="30" />
            </label>
            <label>
                Max simultaneous track downloads
                <input @bind="maxConcurrentDownloads" type="number" min="1" max="8" step="1" />
            </label>
        </div>
        <div class="hint-box">
            How often background jobs wake up to rescan folders and check
            auto-sync playlists. Higher is calmer; the minimums protect the CPU.
            More simultaneous downloads finish large playlists faster but hit
            every source harder; the next run picks up the new value.
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Interface</span>
                <h2>Display</h2>
            </div>
        </div>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="showFilename" />
            <span class="toggle-slider"></span>
            <span>Show the file column on playlist tracks</span>
        </label>
        <div class="hint-box">
            The filename column shows the exact file behind each track in a
            playlist — useful when hunting inflated downloads.
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Notifications</span>
                <h2>Toast behaviour</h2>
            </div>
        </div>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="notifyDownloads" />
            <span class="toggle-slider"></span>
            <span>Toast when a playlist download finishes</span>
        </label>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="notifyFailures" />
            <span class="toggle-slider"></span>
            <span>Toast when a track or sync job fails</span>
        </label>
        <div class="hint-box">
            Failures are always written to the log regardless of this
            setting. Toasts only decide what pops up in the corner.
        </div>
    </div>
</section>

@code {
    private int autoScanIntervalSec = 60;
    private int syncCheckIntervalSec = 300;
    private int maxConcurrentDownloads = 2;
    private bool showFilename;
    private bool notifyDownloads = true;
    private bool notifyFailures = true;
    private string? savedMessage;

    protected override async Task OnInitializedAsync()
    {
        autoScanIntervalSec = int.Parse(await Settings.GetAsync("auto_scan_interval", "60"));
        syncCheckIntervalSec = int.Parse(await Settings.GetAsync("sync_check_interval", "300"));
        if (int.TryParse(await Settings.GetAsync("download_max_concurrent", "2"), out var maxConcurrent))
            maxConcurrentDownloads = Math.Clamp(maxConcurrent, 1, 8);
        showFilename = await Settings.GetBoolAsync("show_filename", false);
        notifyDownloads = await Settings.GetBoolAsync("notify_downloads", true);
        notifyFailures = await Settings.GetBoolAsync("notify_failures", true);
    }

    private async Task SaveAll()
    {
        await Settings.SetAsync("auto_scan_interval", autoScanIntervalSec.ToString());
        await Settings.SetAsync("sync_check_interval", syncCheckIntervalSec.ToString());
        await Settings.SetAsync("download_max_concurrent", Math.Clamp(maxConcurrentDownloads, 1, 8).ToString());
        await Settings.SetAsync("show_filename", showFilename ? "true" : "false");
        await Settings.SetAsync("notify_downloads", notifyDownloads ? "true" : "false");
        await Settings.SetAsync("notify_failures", notifyFailures ? "true" : "false");
        savedMessage = "Saved.";
    }
}
