@page "/advanced"
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Services
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject SettingsStore Settings
@inject PlaylistStore PlaylistStore
@inject NotificationService Notifications
@inject NtfyNotifier Ntfy

<PageTitle>Advanced - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">System</span>
        <div class="title-with-help">
            <h1>Advanced</h1>
            <HelpTip Path="reference#the-advanced-page" Text="Download limits, the dedup toggle, display, logging, notifications and maintenance options." />
        </div>
        <p>Interface and maintenance details most people never need to touch.</p>
    </div>
    <div class="topbar-actions">
        @if (dirty)
        {
            <span class="save-state pending">Unsaved changes</span>
        }
        <button class="btn-modern primary" @onclick="SaveAll" disabled="@saving">@(saving ? "Saving…" : "Save")</button>
    </div>
</section>

<section class="content-grid two advanced-grid">
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Behaviour</span>
                <h2>Downloads</h2>
            </div>
        </div>
        <div class="form-grid single">
            <div class="field-with-help">
                <label>
                    Max simultaneous track downloads
                    <input @bind="maxConcurrentDownloads" @bind:after="MarkDirty" type="number" min="1" max="8" step="1" />
                </label>
                <HelpTip Path="reference#the-advanced-page" Text="How many tracks download at once, between 1 and 8. Higher finishes playlists faster but hits every source harder." />
            </div>
        </div>
        <div class="toggle-with-help">
            <label class="toggle-switch wide">
                <input type="checkbox" @bind="dedupEnabled" @bind:after="MarkDirty" />
                <span class="toggle-slider"></span>
                <span>Hardlink duplicate tracks across playlists</span>
            </label>
            <HelpTip Path="concepts#duplicate-tracks" Text="When a track already exists in another playlist folder in the right quality, link it instead of downloading it again." />
        </div>
        <div class="hint-box">
            When a track already exists in another playlist folder in the
            exact quality this playlist asks for, MelodyBridge links the
            existing file instead of downloading it again: same bytes,
            zero extra disk space. A quality difference pauses that track
            for your call (link it or download a fresh copy); a cross-drive
            link falls back to a normal download. Folders stay as they are;
            no pool, no moving files.
        </div>
        <div class="hint-box">
            More simultaneous downloads finish large playlists faster but hit
            every source harder; the next run picks up the new value. When
            playlists and library folders refresh is set where they live:
            the playlist's own schedule on its page, the folder's schedule
            on the Library page.
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Interface</span>
                <h2>Display</h2>
            </div>
        </div>
        <div class="toggle-with-help">
            <label class="toggle-switch wide">
                <input type="checkbox" @bind="showFilename" @bind:after="MarkDirty" />
                <span class="toggle-slider"></span>
                <span>Show the file column on playlist tracks</span>
            </label>
            <HelpTip Path="concepts#archive-copies" Text="Reveals the exact file behind every track, archive copies included." />
        </div>
        <div class="hint-box">
            The filename column shows the exact file behind each track in a
            playlist: useful when hunting inflated downloads.
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Logging</span>
                <h2>Database activity</h2>
            </div>
        </div>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="logDatabaseActivity" @bind:after="MarkDirty" />
            <span class="toggle-slider"></span>
            <span>Show database activity in the logs</span>
        </label>
        <div class="hint-box">
            Every SQL command the app runs lands in the log as an
            Executed DbCommand line. Turn this on only while debugging a
            database problem; off it hides that noise and keeps warnings.
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Notifications</span>
                <h2>Toast behaviour</h2>
            </div>
        </div>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="notifyDownloads" @bind:after="MarkDirty" />
            <span class="toggle-slider"></span>
            <span>Toast when a playlist download finishes</span>
        </label>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="notifyFailures" @bind:after="MarkDirty" />
            <span class="toggle-slider"></span>
            <span>Toast when a track, sync job or background task fails</span>
        </label>
        <div class="hint-box">
            Failures are always written to the log regardless of this
            setting. Toasts only decide what pops up in the corner.
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Notifications</span>
                <div class="title-with-help">
                    <h2>ntfy push</h2>
                    <HelpTip Path="reference#ntfy-push" Text="Push events to your own ntfy server. The categories work independently of the toast switches above." />
                </div>
            </div>
        </div>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="ntfyEnabled" @bind:after="MarkDirty" />
            <span class="toggle-slider"></span>
            <span>Send notifications to ntfy</span>
        </label>
        <div class="form-grid single">
            <label>
                Topic URL
                <input @bind="ntfyUrl" @bind:after="MarkDirty" placeholder="https://ntfy.sh/melodybridge" />
            </label>
            <label>
                Access token (optional)
                <input type="password" @bind="ntfyToken" @bind:after="MarkDirty" placeholder="tk_..." />
            </label>
        </div>
        <span class="eyebrow ntfy-section">Send when</span>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="ntfyDownloads" @bind:after="MarkDirty" />
            <span class="toggle-slider"></span>
            <span>A playlist download run finishes</span>
        </label>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="ntfyJobs" @bind:after="MarkDirty" />
            <span class="toggle-slider"></span>
            <span>A sync job completes</span>
        </label>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="ntfyJobFailures" @bind:after="MarkDirty" />
            <span class="toggle-slider"></span>
            <span>A sync job fails</span>
        </label>
        <label class="toggle-switch wide">
            <input type="checkbox" @bind="ntfyFailures" @bind:after="MarkDirty" />
            <span class="toggle-slider"></span>
            <span>A background task fails (auto-sync, scan, crashed run)</span>
        </label>
        <div class="hint-box">
            The message goes to the server you enter here, including track
            names. A protected topic needs its access token. The categories
            are independent of the toast toggles above. The test button uses
            the values as typed; press Save to keep them.
        </div>
        <div class="flex-actions">
            <button class="btn-modern" disabled="@testingNtfy" @onclick="TestNtfy">
                @(testingNtfy ? "Sending…" : "Send test notification")
            </button>
        </div>
        @if (ntfyTestResult is not null)
        {
            <div class="hint-box">@ntfyTestResult</div>
        }
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Maintenance</span>
                <h2>Library maintenance</h2>
            </div>
        </div>
        <p>
            Older downloads can miss the bitrate, sample-rate and size
            columns. Recompute reads those facts straight from the files on
            disk; tracks whose file has vanished are queued for a
            re-download.
        </p>
        <div class="flex-actions">
            <button class="btn-modern primary" disabled="@recomputing" @onclick="RecomputeFacts">
                @(recomputing ? "Recomputing…" : "Recompute audio facts")
            </button>
        </div>
    </div>
</section>

@code {
    private int maxConcurrentDownloads = 2;
    private bool showFilename;
    private bool dedupEnabled = true;
    private bool notifyDownloads = true;
    private bool notifyFailures = true;
    private bool ntfyEnabled;
    private string ntfyUrl = "";
    private string ntfyToken = "";
    private bool ntfyDownloads = true;
    private bool ntfyJobs = true;
    private bool ntfyJobFailures = true;
    private bool ntfyFailures = true;
    private bool testingNtfy;
    private string? ntfyTestResult;
    private bool logDatabaseActivity;
    private bool recomputing;

    // Unsaved-changes state for the floating save bar.
    private bool dirty;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(await Settings.GetAsync("download_max_concurrent", "2"), out var maxConcurrent))
            maxConcurrentDownloads = Math.Clamp(maxConcurrent, 1, 8);
        showFilename = await Settings.GetBoolAsync("show_filename", false);
        dedupEnabled = await Settings.GetBoolAsync(PlaylistStore.DedupSettingKey, true);
        notifyDownloads = await Settings.GetBoolAsync("notify_downloads", true);
        notifyFailures = await Settings.GetBoolAsync("notify_failures", true);
        ntfyEnabled = await Settings.GetBoolAsync("ntfy_enabled", false);
        ntfyUrl = await Settings.GetAsync("ntfy_url", "");
        ntfyToken = await Settings.GetAsync("ntfy_token", "");
        ntfyDownloads = await Settings.GetBoolAsync(NtfyNotifier.SettingKeyFor(NotificationCategories.Downloads), true);
        ntfyJobs = await Settings.GetBoolAsync(NtfyNotifier.SettingKeyFor(NotificationCategories.Jobs), true);
        ntfyJobFailures = await Settings.GetBoolAsync(NtfyNotifier.SettingKeyFor(NotificationCategories.JobFailures), true);
        ntfyFailures = await Settings.GetBoolAsync(NtfyNotifier.SettingKeyFor(NotificationCategories.Failures), true);
        logDatabaseActivity = await Settings.GetBoolAsync(DatabaseLogSwitch.SettingKey, false);
    }

    private async Task SaveAll()
    {
        saving = true;
        try
        {
            // Out-of-range input is shown as stored, never silently clamped:
            // typing 20 and reading 8 back after a reload felt like a lie.
            var clamped = Math.Clamp(maxConcurrentDownloads, 1, 8);
            var wasClamped = clamped != maxConcurrentDownloads;
            maxConcurrentDownloads = clamped;
            await Settings.SetAsync("download_max_concurrent", clamped.ToString());
            await Settings.SetAsync("show_filename", showFilename ? "true" : "false");
            await Settings.SetAsync(PlaylistStore.DedupSettingKey, dedupEnabled ? "true" : "false");
            await Settings.SetAsync("notify_downloads", notifyDownloads ? "true" : "false");
            await Settings.SetAsync("notify_failures", notifyFailures ? "true" : "false");
            await SaveNtfyAsync();
            await Settings.SetAsync(DatabaseLogSwitch.SettingKey, logDatabaseActivity ? "true" : "false");
            // Applies immediately, no restart: the log pipeline reads the
            // switch on every entry.
            DatabaseLogSwitch.Set(logDatabaseActivity);
            dirty = false;
            if (wasClamped)
            {
                Notifications.Warn($"Saved. Concurrency is limited to 1-8, so it is set to {clamped}.");
            }
            else
            {
                Notifications.Success("Settings saved.");
            }
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>An edit landed: the floating save bar appears.</summary>
    private void MarkDirty() => dirty = true;

    /// <summary>Persists the ntfy block; a test send saves first so it tests what is on screen.</summary>
    private async Task SaveNtfyAsync()
    {
        await Settings.SetAsync("ntfy_enabled", ntfyEnabled ? "true" : "false");
        await Settings.SetAsync("ntfy_url", ntfyUrl.Trim());
        await Settings.SetAsync("ntfy_token", ntfyToken.Trim());
        await Settings.SetAsync(NtfyNotifier.SettingKeyFor(NotificationCategories.Downloads), ntfyDownloads ? "true" : "false");
        await Settings.SetAsync(NtfyNotifier.SettingKeyFor(NotificationCategories.Jobs), ntfyJobs ? "true" : "false");
        await Settings.SetAsync(NtfyNotifier.SettingKeyFor(NotificationCategories.JobFailures), ntfyJobFailures ? "true" : "false");
        await Settings.SetAsync(NtfyNotifier.SettingKeyFor(NotificationCategories.Failures), ntfyFailures ? "true" : "false");
    }

    /// <summary>Sends a test message with the typed values; nothing is persisted
    /// (the save bar still shows the unsaved edit), the enable toggle is not required.</summary>
    private async Task TestNtfy()
    {
        testingNtfy = true;
        ntfyTestResult = null;
        try
        {
            var failure = await Ntfy.TestAsync(ntfyUrl.Trim(), ntfyToken.Trim());
            ntfyTestResult = failure is null ? "Test sent." : $"Test failed: {failure}";
        }
        finally
        {
            testingNtfy = false;
        }
    }

    private async Task RecomputeFacts()
    {
        recomputing = true;
        try
        {
            var (recomputed, missing) = await PlaylistStore.RecomputeMissingFactsAsync();
            Notifications.Success($"Recomputed facts for {recomputed} track(s), {missing} file(s) missing");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Recompute failed: {ex.Message}");
        }
        finally
        {
            recomputing = false;
        }
    }
}
