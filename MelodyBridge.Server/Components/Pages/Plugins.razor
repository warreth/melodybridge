    /// <summary>
    /// What this plugin can actually deliver, derived from its declared
    /// capabilities (never a hand-kept list that drifts), plus a short
    /// note about its source.
    /// </summary>
    private static IEnumerable<string> QualityBadges(IDownloader plugin)
    {
        var badges = new List<string>();
        // One badge per declared level: same band, same kind, same control
        // collapse into one line; a service that cannot be asked for a
        // level says so.
        var levels = plugin.Capabilities.Deliverables
            .GroupBy(d => (d.Lossless, d.MinKbps, d.MaxKbps, d.Controlled));
        foreach (var group in levels)
        {
            var names = string.Join("/", group.Select(d => FormatName(d.Container)).Distinct());
            var label = group.Key.Lossless
                ? $"{names} lossless"
                : $"{names} {DescribeBand(group.Key.MinKbps, group.Key.MaxKbps)}";
            if (!group.Key.Controlled) label += ", service decides";
            badges.Add(label);
        }
        badges.AddRange(PluginNotes(plugin.Id));
        return badges;
    }

    private static string DescribeBand(int? min, int? max) => (min, max) switch
    {
        (null, null) => "any bitrate",
        (null, { } cap) => $"up to {cap} kbps",
        ({ } floor, null) => $"{floor}+ kbps",
        ({ } floor, { } cap) when floor == cap => $"{floor} kbps",
        ({ } floor, { } cap) => $"{floor}-{cap} kbps",
    };

    private static string FormatName(AudioFormat format) => format switch
    {
        AudioFormat.Mp3 => "MP3",
        AudioFormat.Flac => "FLAC",
        AudioFormat.Opus => "Opus",
        AudioFormat.Aac => "AAC",
        _ => format.ToString(),
    };

