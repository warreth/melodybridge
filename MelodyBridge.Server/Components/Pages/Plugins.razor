@page "/plugins"
@using System.Collections.Concurrent
@using System.Text
@using Microsoft.JSInterop
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Downloaders
@using MelodyBridge.Infrastructure.Services
@inject IDownloaderRegistry Registry
@inject YtDlpUpdater YtDlp
@inject MelodyBridge.Server.Services.NotificationService Notifications
@inject MelodyBridge.Infrastructure.Services.PluginAuthMonitor AuthMonitor
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Plugins - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Sources</span>
        <div class="title-with-help">
            <h1>Plugins</h1>
            <HelpTip Path="concepts#the-waterfall" Text="Set up your sources here. Downloads try the enabled sources in the order below." />
        </div>
        <p>One setup list, one try order. Tracks start at the top and move down
            until a source delivers a file that passes the quality check.</p>
    </div>
    <div class="topbar-actions">
        <a class="btn-modern small secondary" href="/downloads">
            <Icon Name="download" Size="14" /> Downloads
        </a>
        <small class="text-muted updated-note">@(lastAvailabilityCheck == DateTimeOffset.MinValue ? "" : $"checked {lastAvailabilityCheck.ToLocalTime():HH:mm}")</small>
        <button class="btn-modern small ghost" disabled="@refreshingStatus" @onclick="RefreshAvailabilityAsync" title="Probe every plugin again">
            <Icon Name="refresh" Size="14" /> @(refreshingStatus ? "Checking…" : "Refresh status")
        </button>
    </div>
</section>

@if (ShowAuthBanner)
{
    <section class="auth-alert" role="alert" aria-live="polite">
        <div class="auth-alert-icon" aria-hidden="true">
            <Icon Name="alert" Size="22" />
        </div>
        <div class="auth-alert-body">
            <div class="auth-alert-head">
                <strong>@AuthAlertTitle</strong>
                <button class="btn-modern small ghost" @onclick="DismissAuthBanner">
                    Dismiss
                </button>
            </div>
            <p>
                These plugins are skipped until their login works again, so a
                download never reaches their catalogue. The token itself can
                still look fine on the provider's site.
            </p>
            <ul class="auth-alert-list">
                @foreach (var issue in authIssues)
                {
                    <li>
                        <div class="auth-alert-copy">
                            <strong>@issue.PluginName</strong>
                            <span>@issue.Message</span>
                        </div>
                        <button class="btn-modern small ghost"
                                @onclick="() => OpenAuthSettings(issue.PluginId)">
                            Open settings
                        </button>
                    </li>
                }
            </ul>
        </div>
    </section>
}

@{
    var plan = RoutePlan;
    var enabledPlugins = EnabledPlugins;
}
<section class="panel-card source-order">
    <div class="source-order-head">
        <div>
            <span class="eyebrow">Try order</span>
            <h2>Which source is tried first?</h2>
            <p class="panel-description">
                Move a source up or down with the arrows. Disabled sources are
                skipped. A quality preset can reorder the actual try sequence
                by capability, which is what the preview below shows.
            </p>
        </div>
        <div class="source-order-preview-control">
            <label for="route-preset">Preview quality</label>
            <select id="route-preset" class="route-select" aria-label="Preview a quality"
                    @bind="routePreset">
                @foreach (var preset in QualityPresets.All)
                {
                    <option value="@preset.Id">@preset.Label</option>
                }
            </select>
        </div>
    </div>

    @if (enabledPlugins.Count == 0)
    {
        <div class="hint-box danger">
            No source is enabled. Turn one on in the list below to start downloading.
        </div>
    }
    else
    {
        <div class="order-list" aria-label="Sources in try order">
            @for (var i = 0; i < enabledPlugins.Count; i++)
            {
                var plugin = enabledPlugins[i];
                var checkedNow = availability.TryGetValue(plugin.Id, out var status);
                status ??= new PluginStatus(false, null);
                var checking = checkingPlugins.ContainsKey(plugin.Id);
                var auth = (plugin as IPluginAuthStatusProvider)?.AuthStatus;
                var authProblem = auth?.NeedsAttention == true;
                <div class="order-row @(authProblem ? "has-problem" : null)">
                    <span class="order-index">@(i + 1)</span>
                    <span class="order-icon @(authProblem ? "has-problem" : null)">
                        <Icon Name="@PluginIconName(plugin.Id)" Size="17" />
                    </span>
                    <div class="order-main">
                        <strong>@plugin.Name</strong>
                        <span class="order-reason">@OrderReason(plugin, checkedNow, status, auth, checking)</span>
                    </div>
                    <StatusPill Variant="@(checking ? "neutral" : authProblem ? "unavailable" : !checkedNow ? "neutral" : status.Ready ? "ready" : "unavailable")"
                                Title="@(checking ? "Checking this plugin" : authProblem ? auth!.Message : !checkedNow ? "Checking this plugin" : status.Ready ? "Checked and reachable" : status.Detail ?? "Could not reach this plugin")">
                        @(checking ? "checking…" : authProblem ? AuthLabel(auth!.State) : !checkedNow ? "checking…" : status.Ready ? "ready" : "unavailable")
                    </StatusPill>
                    <div class="btn-group" role="group" aria-label="@plugin.Name order">
                        <button class="icon-button" title="Try this source earlier"
                                aria-label="Move @plugin.Name up"
                                disabled="@(i == 0)"
                                @onclick="() => MoveUp(plugin.Id)"><Icon Name="chevron-up" Size="16" /></button>
                        <button class="icon-button" title="Try this source later"
                                aria-label="Move @plugin.Name down"
                                disabled="@(i == enabledPlugins.Count - 1)"
                                @onclick="() => MoveDown(plugin.Id)"><Icon Name="chevron-down" Size="16" /></button>
                    </div>
                    <button class="icon-button order-open" title="Open @plugin.Name settings"
                            aria-label="Open @plugin.Name settings"
                            @onclick="() => OpenAuthSettings(plugin.Id)">
                        <Icon Name="sliders" Size="15" />
                    </button>
                </div>
            }
        </div>
    }

    <div class="route-preview">
        <div class="route-preview-head">
            <span class="eyebrow">For @RouteQualityLabel</span>
            <span class="text-muted">capability order</span>
        </div>
        @if (routePreset == QualityPresets.Id.Auto)
        {
            <p class="route-skipped">
                No filter tries every enabled source in the order above. Pick
                another quality to preview which sources that request will skip.
            </p>
        }
        else if (plan.Plugins.Count == 0)
        {
            <div class="hint-box danger">
                No enabled plugin declares that it can serve this quality.
            </div>
        }
        else
        {
            <div class="route-chain" aria-label="Plugins in try order for this quality">
                @for (var i = 0; i < plan.Plugins.Count; i++)
                {
                    var plugin = plan.Plugins[i];
                    <a href="#plugin-@plugin.Id" class="route-step"
                       @onclick:preventDefault="true"
                       @onclick="() => OpenAuthSettings(plugin.Id)">
                        <span class="route-index">@(i + 1)</span>
                        <span>@plugin.Name</span>
                    </a>
                }
            </div>
            <p class="route-skipped">
                @if (plan.Excluded.Count == 0)
                {
                    <span>Every enabled plugin can serve this quality.</span>
                }
                else
                {
                    <span>
                        Skipped: @string.Join(", ", plan.Excluded.Select(x => $"{x.plugin.Name} ({x.reason})"))
                    </span>
                }
            </p>
        }
    </div>
</section>

<SearchProviderPanel />

<section class="panel-card dependency-strip">
    <div class="dependency-row">
        <span class="dependency-icon"><Icon Name="play" Size="16" /></span>
        <div class="dependency-copy">
            <strong>yt-dlp @(ytDlpChecked ? ytDlpVersion ?? "not found" : "checking…")</strong>
            <small>Shared by the YouTube and SoundCloud plugins. Updates stay until the next image pull.</small>
        </div>
        <button class="btn-modern small ghost" disabled="@updatingYtDlp" @onclick="UpdateYtDlp">
            <Icon Name="refresh" Size="14" /> @(updatingYtDlp ? "Updating…" : "Update")
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(ytDlpMessage))
    {
        <div class="hint-box">@ytDlpMessage</div>
    }
</section>

<section class="plugin-toolbar" aria-label="Plugin filters">
    <label class="plugin-search">
        <Icon Name="search" Size="15" />
        <input type="search" placeholder="Find a plugin…" aria-label="Find a plugin"
               value="@pluginSearch" @oninput="OnPluginSearch" />
    </label>
    <div class="filter-chips">
        @foreach (var filter in PluginFilters)
        {
            <button class="filter-chip @(pluginFilter == filter.Id ? "active" : "")"
                    aria-pressed="@(pluginFilter == filter.Id ? "true" : "false")"
                    @onclick="() => SetPluginFilter(filter.Id)">
                @filter.Label
                <span class="filter-count">@filter.Count</span>
            </button>
        }
    </div>
    <span class="plugin-count">@FilteredPlugins.Count of @orderedPlugins.Count</span>
</section>

<section class="plugin-groups">
    @if (VisibleGroups.Count == 0)
    {
        <EmptyState IconName="search" Title="No plugins match">
            Clear the search or pick another filter.
        </EmptyState>
    }
    @foreach (var group in VisibleGroups)
    {
        <section class="plugin-group" aria-labelledby="group-@group.Id">
            <div class="plugin-group-head">
                <div>
                    <span class="eyebrow">@group.Eyebrow</span>
                    <h2 id="group-@group.Id">@group.Title <span class="group-count">@group.Plugins.Count</span></h2>
                    <p>@group.Description</p>
                </div>
            </div>
            <div class="plugin-list">
                @foreach (var plugin in group.Plugins)
                {
                    var enabled = Registry.IsEnabled(plugin.Id);
                    var checkedNow = availability.TryGetValue(plugin.Id, out var status);
                    status ??= new PluginStatus(false, null);
                    var auth = (plugin as IPluginAuthStatusProvider)?.AuthStatus;
                    var authProblem = enabled && auth?.NeedsAttention == true;
                    var authMessage = authProblem ? auth!.Message : null;
                    var details = auth is { State: PluginAuthState.Valid } ? auth : null;
                    var checking = checkingPlugins.ContainsKey(plugin.Id);
                    <article class="plugin-card @(enabled ? "" : "disabled") @(authProblem ? "auth-error" : null)"
                             id="plugin-@plugin.Id">
                        <div class="plugin-head">
                            <span class="plugin-icon-wrap @(authProblem ? "auth-error" : null)">
                                <Icon Name="@PluginIconName(plugin.Id)" Size="20" Class="provider-icon" />
                                @if (authProblem)
                                {
                                    <span class="plugin-auth-flag" title="@authMessage" aria-label="Login needs attention">!</span>
                                }
                            </span>
                            <div class="plugin-title">
                                <strong>@plugin.Name</strong>
                                <div class="plugin-description">@plugin.Description</div>
                                @if (details is not null)
                                {
                                    <div class="plugin-account">
                                        @if (!string.IsNullOrWhiteSpace(details.Account))
                                        {
                                            <span>@details.Account</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(details.Plan))
                                        {
                                            <span>@details.Plan</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(details.Tier))
                                        {
                                            <span>@details.Tier</span>
                                        }
                                        @if (details.ExpiresAtUtc is { } expires)
                                        {
                                            <span>@ExpiryText(expires)</span>
                                        }
                                    </div>
                                }
                                <div class="plugin-meta">
                                    @if (checking)
                                    {
                                        <span class="plugin-checking"><span class="spinner"></span> checking…</span>
                                    }
                                    else if (LastCheckedText(plugin.Id) is { } checkedText)
                                    {
                                        <span>@checkedText</span>
                                    }
                                    @if (PluginGuideUrl(plugin.Id) is { } guide)
                                    {
                                        <a class="plugin-guide" href="@guide" target="_blank" rel="noopener">
                                            Setup guide <Icon Name="external" Size="11" />
                                        </a>
                                    }
                                    @if (enabled && auth is { State: PluginAuthState.Missing })
                                    {
                                        <button class="plugin-setup-link" @onclick="() => OpenAuthSettings(plugin.Id)">
                                            Add @(IsAccountPlugin(plugin) ? "your login" : "setup")
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="plugin-tail">
                                <button class="icon-button plugin-test" title="Test connection"
                                        aria-label="Test @plugin.Name"
                                        disabled="@(testingPluginId == plugin.Id)"
                                        @onclick="() => TestPluginAsync(plugin.Id)">
                                    @if (testingPluginId == plugin.Id)
                                    {
                                        <span class="spinner"></span>
                                    }
                                    else
                                    {
                                        <Icon Name="refresh" Size="15" />
                                    }
                                </button>
                                <StatusPill Variant="@(authProblem ? "unavailable" : !checkedNow ? "neutral" : status.Ready ? "ready" : "unavailable")"
                                            Class="@(authProblem ? "auth-pill" : null)"
                                            Title="@(authProblem ? authMessage : !checkedNow ? "Checking this plugin" : status.Ready ? "Checked and reachable" : status.Detail ?? "Could not reach this plugin")">
                                    @(authProblem ? AuthLabel(auth!.State) : !checkedNow ? "checking…" : status.Ready ? "ready" : "unavailable")
                                </StatusPill>
                                <label class="toggle-switch">
                                    <input type="checkbox" checked="@enabled"
                                           aria-label="Enable @plugin.Name"
                                           @onchange="e => TogglePluginAsync(plugin.Id, (bool)e.Value!)" />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                        </div>
                        <div class="plugin-quality">
                            @foreach (var badge in QualityBadges(plugin))
                            {
                                <span class="quality-badge">@badge</span>
                            }
                        </div>
                        @{
                            var note = authProblem
                                ? authMessage ?? plugin.LastUnavailableReason ?? status.Detail
                                : !status.Ready
                                    ? plugin.LastUnavailableReason ?? status.Detail
                                    : auth?.Message;
                        }
                        @if (!string.IsNullOrEmpty(note))
                        {
                            <div class="plugin-note @(authProblem || auth?.State == PluginAuthState.PlanRestricted ? "auth" : null)">
                                <Icon Name="@(authProblem ? "alert" : "info")" Size="15" />
                                <span>@note</span>
                                <button class="btn-modern small ghost plugin-note-action"
                                        @onclick="() => CopyDiagnosticsAsync(plugin)">
                                    <Icon Name="copy" Size="13" /> Copy diagnostics
                                </button>
                            </div>
                        }
                        @if (plugin.ConfigFields.Count > 0)
                        {
                            var open = openSettings.Contains(plugin.Id);
                            <div class="plugin-settings @(open ? "open" : null)">
                                <button type="button" class="settings-toggle" aria-expanded="@open"
                                        @onclick="() => ToggleSettings(plugin.Id)">
                                    <Icon Name="sliders" Size="15" />
                                    <span>@(IsAccountPlugin(plugin) ? "Account and settings" : "Settings")</span>
                                    <Icon Name="chevron-down" Size="16" Class="settings-chevron" />
                                </button>
                                @if (open)
                                {
                                    <div class="settings-body">
                                        @{
                                            var advancedOnly = plugin.ConfigFields.All(f => f.Advanced);
                                        }
                                        @foreach (var field in plugin.ConfigFields.Where(f => advancedOnly || !f.Advanced))
                                        {
                                            var key = $"{plugin.Id}:{field.Key}";
                                            <PluginConfigFieldEditor PluginId="@plugin.Id" Field="@field"
                                                Value="@configValues.GetValueOrDefault(key, "")"
                                                ValueChanged="@(v => ConfigChanged(key, v))" />
                                        }
                                        @if (!advancedOnly && plugin.ConfigFields.Any(f => f.Advanced))
                                        {
                                            var advanced = advancedSettings.Contains(plugin.Id);
                                            <button type="button" class="advanced-toggle" aria-expanded="@advanced"
                                                    @onclick="() => ToggleAdvanced(plugin.Id)">
                                                <Icon Name="chevron-right" Size="14" Class="advanced-chevron" />
                                                <span>Advanced</span>
                                            </button>
                                            @if (advanced)
                                            {
                                                <div class="advanced-fields">
                                                    @foreach (var field in plugin.ConfigFields.Where(f => f.Advanced))
                                                    {
                                                        var key = $"{plugin.Id}:{field.Key}";
                                                        <PluginConfigFieldEditor PluginId="@plugin.Id" Field="@field"
                                                            Value="@configValues.GetValueOrDefault(key, "")"
                                                            ValueChanged="@(v => ConfigChanged(key, v))" />
                                                    }
                                                </div>
                                            }
                                        }
                                        <div class="flex-actions end">
                                            <button class="btn-modern small primary" @onclick="() => SaveConfigAsync(plugin.Id)">Save settings</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        </section>
    }
</section>

@code {
    /// <summary>Availability verdict per plugin plus why it is not ready.</summary>
    private sealed record PluginStatus(bool Ready, string? Detail);

    private List<IDownloader> orderedPlugins = new();
    private Dictionary<string, PluginStatus> availability = new();
    private readonly ConcurrentDictionary<string, long> availabilityVersions = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<PluginAuthIssue> authIssues = Array.Empty<PluginAuthIssue>();
    private Dictionary<string, string> configValues = new();
    private Timer? _timer;
    private bool refreshingStatus;
    private bool ytDlpChecked;
    private DateTimeOffset lastAvailabilityCheck = DateTimeOffset.MinValue;
    private int availabilitySweep;
    private readonly ConcurrentDictionary<string, byte> checkingPlugins = new(StringComparer.OrdinalIgnoreCase);
    private readonly ConcurrentDictionary<string, DateTimeOffset> lastChecked = new(StringComparer.OrdinalIgnoreCase);
    private string? testingPluginId;
    private string? handledFragment;
    private bool hashRead;
    private string browserHash = string.Empty;
    private bool pluginsLoaded;
    private bool disposed;
    private Task? _liveStatusTask;
    private QualityPresets.Id routePreset = QualityPresets.Id.Auto;
    private string pluginSearch = string.Empty;
    private string pluginFilter = "all";
    private string? ytDlpVersion;
    private string? ytDlpMessage;
    private bool updatingYtDlp;

    private sealed record PluginFilter(string Id, string Label, int Count);

    private sealed record PluginGroup(
        string Id, string Eyebrow, string Title, string Description,
        IReadOnlyList<IDownloader> Plugins);

    private static bool IsAccountPlugin(IDownloader plugin)
        => plugin is IPluginAuthStatusProvider;

    private bool HasProblem(IDownloader plugin)
    {
        if (!Registry.IsEnabled(plugin.Id)) return false;
        if ((plugin as IPluginAuthStatusProvider)?.AuthStatus.NeedsAttention == true) return true;
        return availability.TryGetValue(plugin.Id, out var status) && !status.Ready;
    }

    private IReadOnlyList<PluginFilter> PluginFilters =>
    [
        new("all", "All", orderedPlugins.Count),
        new("accounts", "Accounts", orderedPlugins.Count(IsAccountPlugin)),
        new("free", "Free", orderedPlugins.Count(p => !IsAccountPlugin(p))),
        new("problems", "Problems", orderedPlugins.Count(HasProblem)),
    ];

    private IReadOnlyList<IDownloader> FilteredPlugins
    {
        get
        {
            IEnumerable<IDownloader> plugins = orderedPlugins;
            if (pluginFilter == "accounts") plugins = plugins.Where(IsAccountPlugin);
            else if (pluginFilter == "free") plugins = plugins.Where(p => !IsAccountPlugin(p));
            else if (pluginFilter == "problems") plugins = plugins.Where(HasProblem);

            if (!string.IsNullOrWhiteSpace(pluginSearch))
            {
                var needle = pluginSearch.Trim();
                plugins = plugins.Where(p =>
                    p.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || p.Id.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || p.Description.Contains(needle, StringComparison.OrdinalIgnoreCase));
            }
            return plugins.ToList();
        }
    }

    private IReadOnlyList<IDownloader> EnabledPlugins
        => orderedPlugins.Where(p => Registry.IsEnabled(p.Id)).ToList();

    private IReadOnlyList<PluginGroup> VisibleGroups
    {
        get
        {
            var filtered = FilteredPlugins;
            var groups = new List<PluginGroup>();
            if (pluginFilter == "problems")
            {
                if (filtered.Count > 0)
                    groups.Add(new PluginGroup(
                        "problems", "Needs a decision", "Problems",
                        "Unavailable right now, or a stored login stopped working.",
                        filtered));
                return groups;
            }

            var accounts = filtered.Where(IsAccountPlugin).ToList();
            var free = filtered.Where(plugin => !IsAccountPlugin(plugin)).ToList();

            if (pluginFilter != "free" && accounts.Count > 0)
                groups.Add(new PluginGroup(
                    "accounts", "Your subscriptions", "Accounts",
                    "Qobuz, Deezer and Tidal use your own account or token. Add it once, then leave the plugin enabled.",
                    accounts));
            if (pluginFilter != "accounts" && free.Count > 0)
                groups.Add(new PluginGroup(
                    "free", "No account needed", "Free and community sources",
                    "Free APIs and community mirrors. Some use a companion tool or container: yt-dlp, slskd, and FlareSolverr for Lucida.",
                    free));

            return groups;
        }
    }

    /// <summary>The short reason shown under a name in the try-order list.</summary>
    private static string OrderReason(
        IDownloader plugin, bool checkedNow, PluginStatus status,
        PluginAuthStatus? auth, bool checking)
    {
        if (checking) return "checking…";
        if (auth?.NeedsAttention == true) return auth.Message ?? "Login needs attention";
        if (!checkedNow) return "waiting for the status check";
        if (!status.Ready) return plugin.LastUnavailableReason ?? status.Detail ?? "Not available";
        if (auth is { State: PluginAuthState.Missing }) return "Add your login in the settings below";
        if (!string.IsNullOrWhiteSpace(auth?.Account)) return auth.Account!;
        return "Ready";
    }

    private void OnPluginSearch(ChangeEventArgs e)
        => pluginSearch = e.Value?.ToString() ?? string.Empty;

    private void SetPluginFilter(string filter) => pluginFilter = filter;

    protected override async Task OnInitializedAsync()
    {
        _ = Registry.GetEnabled(); // force cache load
        await ReorderPluginsAsync();
        // The background login sweep may already know about a stale token:
        // show that mark before the first slow network probe finishes.
        authIssues = AuthMonitor.Snapshot();
        AuthMonitor.Changed += OnAuthMonitorChanged;
        await LoadConfigValuesAsync();

        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            if (DateTimeOffset.UtcNow - lastAvailabilityCheck <= TimeSpan.FromSeconds(30))
                return;
            await ReorderPluginsAsync();
            MarkChecking();
            StateHasChanged();
            await RefreshAvailability();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Availability and the yt-dlp version both wait on the outside
        // world: a network probe and a process start. Render the cards with
        // their checking pills first, then let those checks land, instead
        // of holding the whole page for the slowest one.
        if (firstRender) _liveStatusTask = LoadLiveStatusAsync();

        var fragment = Nav.ToAbsoluteUri(Nav.Uri).Fragment.TrimStart('#');

        // An initial request never sends the fragment to the server, so
        // Blazor's Uri has none. Read the browser's hash once for deep
        // links; every later render reuses that answer instead of calling
        // JavaScript again and again.
        if (fragment.Length > 0)
        {
            hashRead = false;
            browserHash = string.Empty;
        }
        else
        {
            if (!hashRead)
            {
                try
                {
                    // Loose test runtimes return null for an unset string result.
                    browserHash = (await JS.InvokeAsync<string>("melody.getHash"))?.TrimStart('#') ?? string.Empty;
                    hashRead = true;
                }
                catch (JSException)
                {
                    return;
                }
                catch (JSDisconnectedException)
                {
                    return;
                }
                catch (InvalidOperationException)
                {
                    return;
                }
            }
            fragment = browserHash;
        }

        if (string.Equals(fragment, handledFragment, StringComparison.Ordinal)) return;

        if (fragment.Length == 0)
        {
            handledFragment = fragment;
            return;
        }

        if (!fragment.StartsWith("plugin-", StringComparison.OrdinalIgnoreCase))
        {
            handledFragment = fragment;
            return;
        }

        var id = fragment["plugin-".Length..];
        // The first render can happen before the registry has loaded, so
        // wait for a render that actually has the card before marking the
        // link handled and opening its settings. Once loaded, an id that
        // matches no card is a stale bookmark: mark it handled as well.
        if (!orderedPlugins.Any(plugin => string.Equals(plugin.Id, id, StringComparison.OrdinalIgnoreCase)))
        {
            if (pluginsLoaded) handledFragment = fragment;
            return;
        }

        handledFragment = fragment;
        await OpenAuthSettings(id);
    }

    /// <summary>
    /// Runs the two slow external checks together after the first render.
    /// The page stays usable while they run; the pills show "checking…".
    /// </summary>
    private async Task LoadLiveStatusAsync()    {
        refreshingStatus = true;
        MarkChecking();
        await InvokeAsync(StateHasChanged);
        try
        {
            var versionTask = LoadYtDlpVersionAsync();
            await RefreshAvailability();
            await versionTask;
        }
        finally
        {
            if (!disposed)
            {
                refreshingStatus = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadYtDlpVersionAsync()
    {
        ytDlpVersion = await YtDlp.GetVersionAsync();
        ytDlpChecked = true;
    }

    /// <summary>
    /// The monitor already knows when a login issue appears or clears, so
    /// the page reacts to that instead of re-rendering every second.
    /// </summary>
    private void OnAuthMonitorChanged()
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (disposed) return;
            authIssues = AuthMonitor.Snapshot();
            StateHasChanged();
        });
    }

    /// <summary>Loads every plugin's config fields from the registry store.</summary>
    private async Task LoadConfigValuesAsync()
    {
        var values = new Dictionary<string, string>();
        foreach (var plugin in orderedPlugins)
            foreach (var field in plugin.ConfigFields)
            {
                values[$"{plugin.Id}:{field.Key}"] = await Registry.GetConfigAsync(plugin.Id, field.Key);
            }
        configValues = values;
    }

    private void ConfigChanged(string key, string value)
        => configValues[key] = value;

    /// <summary>Plugin ids whose Settings panel is expanded.</summary>
    private readonly HashSet<string> openSettings = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Plugin ids whose Advanced fields are shown.</summary>
    private readonly HashSet<string> advancedSettings = new(StringComparer.OrdinalIgnoreCase);

    private void ToggleSettings(string id)
    {
        if (!openSettings.Add(id)) openSettings.Remove(id);
    }

    private void ToggleAdvanced(string id)
    {
        if (!advancedSettings.Add(id)) advancedSettings.Remove(id);
    }

    /// <summary>Runs the yt-dlp update and shows the outcome.</summary>
    private async Task UpdateYtDlp()
    {
        updatingYtDlp = true;
        ytDlpMessage = null;
        StateHasChanged();
        try
        {
            var before = ytDlpVersion;
            var result = await YtDlp.UpdateAsync();
            ytDlpVersion = await YtDlp.GetVersionAsync();
            ytDlpMessage = ytDlpVersion == before
                ? $"yt-dlp is already up to date ({ytDlpVersion})."
                : result.Message;
        }
        finally
        {
            updatingYtDlp = false;
            StateHasChanged();
        }
    }

    /// <summary>The header button: a visible busy state around the sweep.</summary>
    private async Task RefreshAvailabilityAsync()
    {
        refreshingStatus = true;
        MarkChecking();
        StateHasChanged();
        try
        {
            await RefreshAvailability();
        }
        finally
        {
            refreshingStatus = false;
            StateHasChanged();
        }
    }

    private async Task SaveConfigAsync(string pluginId)
    {
        var plugin = orderedPlugins.FirstOrDefault(p => p.Id == pluginId);
        if (plugin is null) return;
        foreach (var field in plugin.ConfigFields)
            await Registry.SetConfigAsync(pluginId, field.Key, configValues.GetValueOrDefault($"{pluginId}:{field.Key}"));

        // A newly pasted token must be tested for real, not answered from
        // the "down" verdict cached before the save. Bump the version
        // before probing so an older sweep cannot overwrite this answer.
        var version = BumpAvailabilityVersion(plugin.Id);
        (plugin as IPluginAvailabilityRefresh)?.RefreshAvailability();
        var (ready, reason) = await ProbePluginAsync(plugin);
        if (AvailabilityVersion(plugin.Id) == version)
            availability[plugin.Id] = new PluginStatus(ready, ready ? null : reason);
        authIssues = AuthMonitor.Snapshot();
        lastAvailabilityCheck = DateTimeOffset.UtcNow;

        var auth = (plugin as IPluginAuthStatusProvider)?.AuthStatus;
        if (auth is { NeedsAttention: true })
            Notifications.Warn($"{plugin.Name}: {auth.Message ?? "the login still needs attention"}");
        else if (!ready)
            Notifications.Warn($"{plugin.Name} settings saved, but the plugin is not ready: {reason}");
        else
            Notifications.Success($"{plugin.Name} settings saved; the connection works.");

        StateHasChanged();
    }

    private Task ReorderPluginsAsync()
    {
        var enabled = (Registry.GetEnabled() ?? Array.Empty<IDownloader>()).ToList();
        var disabled = (Registry.GetAll() ?? Array.Empty<IDownloader>())
            .Where(p => !enabled.Contains(p))
            .ToList();
        orderedPlugins = enabled.Concat(disabled).ToList();
        pluginsLoaded = true;
        return Task.CompletedTask;
    }

    /// <summary>Marks a fresh save/test result as newer than any sweep.</summary>
    private long BumpAvailabilityVersion(string pluginId)
        => availabilityVersions.AddOrUpdate(pluginId, 1, (_, current) => current + 1);

    private long AvailabilityVersion(string pluginId)
        => availabilityVersions.TryGetValue(pluginId, out var version) ? version : 0;

    /// <summary>
    /// The first live check of the page. A test waits on this instead of
    /// guessing how long a provider needs.
    /// </summary>
    internal Task LiveStatusLoaded => _liveStatusTask ?? Task.CompletedTask;

    internal async Task RefreshAvailability()
    {
        // The page timer and the Refresh status button can overlap. A slow
        // sweep must never run twice concurrently: it would pile up network
        // probes and race on the results dictionary.
        if (Interlocked.CompareExchange(ref availabilitySweep, 1, 0) == 1)
        {
            authIssues = AuthMonitor.Snapshot();
            return;
        }

        try
        {
            MarkChecking();

            var results = new ConcurrentDictionary<string, (PluginStatus Status, long Version)>(
                StringComparer.OrdinalIgnoreCase);
            // Task.WhenAll plus a gate keeps four probes in flight without
            // the thread-pool scheduler that Parallel.ForEachAsync uses;
            // that scheduler can starve a component render under load.
            using var gate = new SemaphoreSlim(4);
            await Task.WhenAll(orderedPlugins.Select(async plugin =>
            {
                await gate.WaitAsync();
                try
                {
                    // Stamp the sweep before the probe. A save or test that
                    // starts while this probe runs bumps the version and
                    // makes this older answer ineligible to win.
                    var version = AvailabilityVersion(plugin.Id);
                    using var budget = new CancellationTokenSource(TimeSpan.FromSeconds(30));
                    var (ready, reason) = await ProbePluginAsync(plugin, budget.Token);
                    results[plugin.Id] = (new PluginStatus(ready, reason), version);
                }
                finally
                {
                    gate.Release();
                }
            }));

            // Merge instead of replacing: a save or test may have written a
            // fresher verdict for one plugin while the rest of the sweep
            // was still running.
            foreach (var (pluginId, result) in results)
            {
                if (AvailabilityVersion(pluginId) == result.Version)
                    availability[pluginId] = result.Status;
            }
            foreach (var staleId in availability.Keys
                         .Where(id => !results.ContainsKey(id)).ToList())
                availability.Remove(staleId);
            authIssues = AuthMonitor.Snapshot();
            lastAvailabilityCheck = DateTimeOffset.UtcNow;
        }
        finally
        {
            checkingPlugins.Clear();
            Interlocked.Exchange(ref availabilitySweep, 0);
        }
    }

    /// <summary>Marks every card as checking; the caller renders it.</summary>
    private void MarkChecking()
    {
        checkingPlugins.Clear();
        foreach (var plugin in orderedPlugins)
            checkingPlugins[plugin.Id] = 0;
    }

    /// <summary>
    /// One plugin's availability plus its own login verdict. The login
    /// register is updated here, so the banner and the sidebar mark use
    /// the same observation the card does.
    /// </summary>
    private async Task<(bool Ready, string? Reason)> ProbePluginAsync(
        IDownloader plugin, CancellationToken ct = default)
    {
        try
        {
            var ready = await plugin.IsAvailableAsync(ct);
            ObserveAuth(plugin);
            var auth = (plugin as IPluginAuthStatusProvider)?.AuthStatus;
            return (ready, ready
                ? null
                : auth?.Message ?? AvailabilityHint(plugin) ?? "Could not reach this plugin");
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            ObserveAuth(plugin);
            return (false, "The check timed out");
        }
        catch (Exception ex)
        {
            ObserveAuth(plugin);
            return (false, ex.Message);
        }
        finally
        {
            lastChecked[plugin.Id] = DateTimeOffset.UtcNow;
        }
    }

    /// <summary>
    /// A disabled plugin's stale token is irrelevant: it must not keep the
    /// banner or the sidebar mark alive.
    /// </summary>
    private void ObserveAuth(IDownloader plugin)
    {
        if (Registry.IsEnabled(plugin.Id))
            AuthMonitor.Observe(plugin);
        else
            AuthMonitor.Clear(plugin.Id);
    }

    /// <summary>The waterfall order and exclusions for the previewed quality.</summary>
    private QualityRouter.Plan RoutePlan
    {
        get
        {
            var enabled = orderedPlugins
                .Where(plugin => Registry.IsEnabled(plugin.Id))
                .ToList();
            return QualityRouter.Route(QualityPresets.ToQuality(routePreset), enabled);
        }
    }

    private string RouteQualityLabel =>
        QualityPresets.All.First(preset => preset.Id == routePreset).Label;

    internal bool ShowAuthBanner => authIssues.Count > 0 && !AuthMonitor.BannerDismissed;

    /// <summary>The banner headline, with the number of affected plugins.</summary>
    private string AuthAlertTitle => authIssues.Count == 1
        ? "One plugin needs your login"
        : $"{authIssues.Count} plugins need your login";

    /// <summary>"checked 2 minutes ago", so a ready pill has a timestamp.</summary>
    private string? LastCheckedText(string pluginId)
    {
        if (!lastChecked.TryGetValue(pluginId, out var at)) return null;
        var age = DateTimeOffset.UtcNow - at;
        if (age.TotalSeconds < 45) return "checked just now";
        if (age.TotalMinutes < 60)
        {
            var minutes = Math.Max(1, (int)Math.Round(age.TotalMinutes));
            return $"checked {minutes} minute{(minutes == 1 ? "" : "s")} ago";
        }
        var hours = Math.Max(1, (int)Math.Round(age.TotalHours));
        return $"checked {hours} hour{(hours == 1 ? "" : "s")} ago";
    }

    /// <summary>"expires in 12 days", or the past tense when it already passed.</summary>
    private static string ExpiryText(DateTimeOffset expires)
    {
        var left = expires - DateTimeOffset.UtcNow;
        if (left <= TimeSpan.Zero) return "expired";
        if (left.TotalDays >= 1)
        {
            var days = (int)Math.Ceiling(left.TotalDays);
            return $"expires in {days} day{(days == 1 ? "" : "s")}";
        }
        if (left.TotalHours >= 1)
        {
            var hours = (int)Math.Ceiling(left.TotalHours);
            return $"expires in {hours} hour{(hours == 1 ? "" : "s")}";
        }
        var minutes = Math.Max(1, (int)Math.Ceiling(left.TotalMinutes));
        return $"expires in {minutes} minute{(minutes == 1 ? "" : "s")}";
    }

