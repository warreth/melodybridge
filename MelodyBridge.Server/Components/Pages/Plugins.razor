    /// <summary>Rechecks one plugin without probing the whole page.</summary>
    private async Task TestPluginAsync(string pluginId)
    {
        var plugin = orderedPlugins.FirstOrDefault(p => p.Id == pluginId);
        if (plugin is null) return;

        testingPluginId = pluginId;
        checkingPlugins[pluginId] = 0;
        (plugin as IPluginAvailabilityRefresh)?.RefreshAvailability();
        StateHasChanged();
        try
        {
            using var budget = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var (ready, reason) = await ProbePluginAsync(plugin, budget.Token);
            availability[pluginId] = new PluginStatus(ready, reason);
            authIssues = AuthMonitor.Snapshot();
            lastAvailabilityCheck = DateTimeOffset.UtcNow;

            var auth = (plugin as IPluginAuthStatusProvider)?.AuthStatus;
            if (auth is { NeedsAttention: true })
                Notifications.Warn($"{plugin.Name}: {auth.Message ?? "the login needs attention"}");
            else if (!ready)
                Notifications.Warn($"{plugin.Name} is not ready: {reason}");
            else
                Notifications.Success($"{plugin.Name} is ready.");
        }
        finally
        {
            testingPluginId = null;
            checkingPlugins.TryRemove(pluginId, out _);
            StateHasChanged();
        }
    }

    /// <summary>Copies a support-friendly summary of one plugin's state.</summary>
    private async Task CopyDiagnosticsAsync(IDownloader plugin)
    {
        var auth = (plugin as IPluginAuthStatusProvider)?.AuthStatus;
        var status = availability.GetValueOrDefault(plugin.Id);
        var text = new StringBuilder()
            .AppendLine("MelodyBridge plugin diagnostics")
            .AppendLine($"Version: {AppInfo.Version}")
            .AppendLine($"Plugin: {plugin.Name} ({plugin.Id})")
            .AppendLine($"Enabled: {(Registry.IsEnabled(plugin.Id) ? "yes" : "no")}")
            .AppendLine($"Availability: {(status is null ? "unknown" : status.Ready ? "ready" : "unavailable")}")
            .AppendLine($"Last reason: {plugin.LastUnavailableReason ?? "(none)"}")
            .AppendLine($"Capabilities: {DescribeCapabilities(plugin.Capabilities)}")
            .ToString();

        if (auth is not null)
        {
            text += $"Login: {auth.State}"
                + (string.IsNullOrWhiteSpace(auth.Account) ? "" : $", account {auth.Account}")
                + (string.IsNullOrWhiteSpace(auth.Plan) ? "" : $", plan {auth.Plan}")
                + (string.IsNullOrWhiteSpace(auth.Tier) ? "" : $", tier {auth.Tier}")
                + (auth.ExpiresAtUtc is { } expires ? $", expires {expires:u}" : "")
                + Environment.NewLine;
            if (!string.IsNullOrWhiteSpace(auth.Message))
                text += $"Login reason: {auth.Message}{Environment.NewLine}";
        }

        foreach (var field in plugin.ConfigFields)
        {
            var value = configValues.GetValueOrDefault($"{plugin.Id}:{field.Key}") ?? "";
            var shown = field.Secret
                ? (value.Length > 0 ? "set" : "not set")
                : (value.Length > 0 ? value : "(empty)");
            text += $"{field.Label}: {shown}{Environment.NewLine}";
        }

        bool copied;
        try
        {
            copied = await JS.InvokeAsync<bool>("melody.copyText", text);
        }
        catch (Exception)
        {
            copied = false;
        }

        if (copied) Notifications.Success($"Diagnostics for {plugin.Name} copied.");
        else Notifications.Warn("The browser would not let the page copy. Open the Logs page and export instead.");
    }

    /// <summary>One short line of declared levels, for the diagnostics text.</summary>
    private static string DescribeCapabilities(PluginCapabilities capabilities)
        => capabilities.Deliverables.Count == 0
            ? "(none)"
            : string.Join(", ", capabilities.Deliverables.Select(deliverable =>
                deliverable.Container == AudioFormat.Auto
                    ? (deliverable.Lossless ? "auto lossless" : "auto lossy")
                    : $"{deliverable.Container} {(deliverable.Lossless ? "lossless" : $"{deliverable.MaxKbps ?? 0} kbps")}"));

