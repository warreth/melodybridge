        "archiveorg" => new[] { "public-domain recordings" },
        "lucida" => new[] { "needs a FlareSolverr URL" },
        "monochrome" => new[] { "lossless", "no account" },
        "slskd" => new[] { "lossless FLAC", "your own slskd" },
        "qobuz" => new[] { "your subscription", "hi-res" },
        "deemix" => new[] { "your ARL", "FLAC with HiFi" },
        "tidal" => new[] { "your subscription", "hi-res" },
        "rhythmax" => new[] { "no Tidal account", "Tidal ISRC search" },
        "flacmusic" => new[] { "title-only fallback", "Kuwo and NetEase" },
        "jumo" => new[] { "no account", "community front-end" },
