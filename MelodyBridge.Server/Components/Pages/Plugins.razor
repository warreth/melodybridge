@page "/plugins"
@using System.Collections.Concurrent
@using System.Text
@using Microsoft.JSInterop
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Downloaders
@using MelodyBridge.Infrastructure.Services
@inject IDownloaderRegistry Registry
@inject Application.Services.DownloadCoordinator Coordinator
@inject YtDlpUpdater YtDlp
@inject MelodyBridge.Server.Services.NotificationService Notifications
@inject MelodyBridge.Infrastructure.Services.PluginAuthMonitor AuthMonitor
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Plugins - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Waterfall</span>
        <div class="title-with-help">
            <h1>Plugins</h1>
            <HelpTip Path="concepts#the-waterfall" Text="Plugins declare what they can serve. Each track is routed to the fitting plugins and tried in order until one delivers." />
        </div>
        <p>Plugins are tried in this order, and that order is the whole
            story for the <strong>No filter</strong> quality. When a
            playlist asks for a specific quality, MelodyBridge first picks
            the plugins that can really deliver it (the declarations below
            decide, not this list) and your order only decides between
            equals.</p>
    </div>
    <div class="topbar-actions">
        <small class="text-muted updated-note">@(lastAvailabilityCheck == DateTimeOffset.MinValue ? "" : $"checked {lastAvailabilityCheck.ToLocalTime():HH:mm}")</small>
        <button class="btn-modern small ghost" disabled="@refreshingStatus" @onclick="RefreshAvailabilityAsync" title="Probe every plugin again">
            <Icon Name="refresh" Size="14" /> @(refreshingStatus ? "Checking…" : "Refresh status")
        </button>
    </div>
</section>

@if (ShowAuthBanner)
{
    <section class="auth-alert" role="alert" aria-live="polite">
        <div class="auth-alert-icon" aria-hidden="true">
            <Icon Name="alert" Size="22" />
        </div>
        <div class="auth-alert-body">
            <div class="auth-alert-head">
                <strong>@AuthAlertTitle</strong>
                <button class="btn-modern small ghost" @onclick="DismissAuthBanner">
                    Dismiss
                </button>
            </div>
            <p>
                These plugins are skipped until their login works again, so a
                download never reaches their catalogue. The token itself can
                still look fine on the provider's site.
            </p>
            <ul class="auth-alert-list">
                @foreach (var issue in authIssues)
                {
                    <li>
                        <div class="auth-alert-copy">
                            <strong>@issue.PluginName</strong>
                            <span>@issue.Message</span>
                        </div>
                        <button class="btn-modern small ghost"
                                @onclick="() => OpenAuthSettings(issue.PluginId)">
                            Open settings
                        </button>
                    </li>
                }
            </ul>
        </div>
    </section>
}

@{
    var plan = RoutePlan;
}
<section class="panel-card route-preview">
    <div class="route-preview-head">
        <div>
            <span class="eyebrow">Route preview</span>
            <h2>For @RouteQualityLabel</h2>
        </div>
        <select class="route-select" aria-label="Preview a quality"
                @bind="routePreset">
            @foreach (var preset in QualityPresets.All)
            {
                <option value="@preset.Id">@preset.Label</option>
            }
        </select>
    </div>
    @if (plan.Plugins.Count == 0)
    {
        <div class="hint-box danger">
            No enabled plugin declares that it can serve this quality.
        </div>
    }
    else
    {
        <div class="route-chain" aria-label="Plugins in try order">
            @for (var i = 0; i < plan.Plugins.Count; i++)
            {
                var plugin = plan.Plugins[i];
                <a href="#plugin-@plugin.Id" class="route-step"
                   @onclick:preventDefault="true"
                   @onclick="() => OpenAuthSettings(plugin.Id)">
                    <span class="route-index">@(i + 1)</span>
                    <span>@plugin.Name</span>
                </a>

            }
        </div>
        <p class="route-skipped">
            @if (plan.Excluded.Count == 0)
            {
                <span>Every enabled plugin can serve this quality.</span>
            }
            else
            {
                <span>
                    Skipped: @string.Join(", ", plan.Excluded.Select(x => $"{x.plugin.Name} ({x.reason})"))
                </span>
            }
        </p>
    }
    <p class="route-note">
        Based on each plugin's declared capabilities. Availability is still checked per track.
    </p>
</section>

@if (runs.Count > 0)
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Active</span>
                <h2>Live downloads</h2>
            </div>
        </div>
        <div class="qi-result">
            @foreach (var run in runs)
            {
                <div class="qi-item">
                    <div class="qi-grow">
                        <strong>@run.PlaylistName</strong>
                        <div class="qi-meta">
                            @run.State · @run.Done/@run.Total done · @run.Failed failed
                            @if (!string.IsNullOrEmpty(run.CurrentTrack))
                            {
                                <span> · now: @run.CurrentTrack</span>
                            }
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width:@run.Percent%"></div>
                        </div>
                    </div>
                    <div class="flex-actions">
                        @if (run.State == Application.Services.DownloadRunState.Running)
                        {
                            <button class="btn-modern small ghost" @onclick="() => Coordinator.Pause(run.PlaylistId)"><Icon Name="pause" Size="14" /> Pause</button>
                        }
                        else if (run.State == Application.Services.DownloadRunState.Paused)
                        {
                            <button class="btn-modern small primary" @onclick="() => Coordinator.Start(run.PlaylistId)"><Icon Name="play" Size="14" /> Resume</button>
                        }
                        @if (run.State is Application.Services.DownloadRunState.Running or Application.Services.DownloadRunState.Paused)
                        {
                            <button class="btn-modern small ghost" @onclick="() => Coordinator.Cancel(run.PlaylistId)"><Icon Name="x" Size="14" /> Cancel</button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

<section class="panel-card">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Dependency</span>
            <div class="title-with-help">
                <h2>yt-dlp</h2>
                <HelpTip Path="reference#the-plugins-page" Text="The shared yt-dlp binary behind the YouTube and SoundCloud plugins. Updating keeps until the next image pull." />
            </div>
        </div>
    </div>
    <div class="qi-item">
        <div class="qi-grow">
            <strong>@(ytDlpChecked ? ytDlpVersion ?? "not found" : "checking…")</strong>
            <div class="qi-meta">
                Shared by the YouTube and SoundCloud plugins. Updates stay
                until the next image pull, which brings its own copy.
            </div>
        </div>
        <div class="flex-actions">
            <button class="btn-modern small" disabled="@updatingYtDlp" @onclick="UpdateYtDlp">
                <Icon Name="refresh" Size="14" /> @(updatingYtDlp ? "Updating…" : "Update yt-dlp")
            </button>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(ytDlpMessage))
    {
        <div class="hint-box">@ytDlpMessage</div>
    }
</section>

<section class="plugin-list">
    @foreach (var plugin in orderedPlugins)
    {
        var enabled = Registry.IsEnabled(plugin.Id);
        var checkedNow = availability.TryGetValue(plugin.Id, out var status);
        status ??= new PluginStatus(false, null);
        var auth = (plugin as IPluginAuthStatusProvider)?.AuthStatus;
        var authProblem = enabled && auth?.NeedsAttention == true;
        var authMessage = authProblem ? auth!.Message : null;
        var details = auth is { State: PluginAuthState.Valid } ? auth : null;
        var checking = checkingPlugins.ContainsKey(plugin.Id);
        <article class="plugin-card @(enabled ? "" : "disabled") @(authProblem ? "auth-error" : null)"
                 id="plugin-@plugin.Id">
            <div class="plugin-head">
                <span class="plugin-icon-wrap @(authProblem ? "auth-error" : null)">
                    <Icon Name="@PluginIconName(plugin.Id)" Size="20" Class="provider-icon" />
                    @if (authProblem)
                    {
                        <span class="plugin-auth-flag" title="@authMessage" aria-label="Login needs attention">!</span>
                    }
                </span>
                <div class="plugin-title">
                    <strong>@plugin.Name</strong>
                    <div class="plugin-description">@plugin.Description</div>
                    @if (details is not null)
                    {
                        <div class="plugin-account">
                            @if (!string.IsNullOrWhiteSpace(details.Account))
                            {
                                <span>@details.Account</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(details.Plan))
                            {
                                <span>@details.Plan</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(details.Tier))
                            {
                                <span>@details.Tier</span>
                            }
                            @if (details.ExpiresAtUtc is { } expires)
                            {
                                <span>@ExpiryText(expires)</span>
                            }
                        </div>
                    }
                    <div class="plugin-meta">
                        @if (checking)
                        {
                            <span class="plugin-checking"><span class="spinner"></span> checking…</span>
                        }
                        else if (LastCheckedText(plugin.Id) is { } checkedText)
                        {
                            <span>@checkedText</span>
                        }
                        @if (PluginGuideUrl(plugin.Id) is { } guide)
                        {
                            <a class="plugin-guide" href="@guide" target="_blank" rel="noopener">
                                Setup guide <Icon Name="external" Size="11" />
                            </a>
                        }
                    </div>
                </div>
                <div class="plugin-tail">
                    <button class="icon-button plugin-test" title="Test connection"
                            aria-label="Test @plugin.Name"
                            disabled="@(testingPluginId == plugin.Id)"
                            @onclick="() => TestPluginAsync(plugin.Id)">
                        @if (testingPluginId == plugin.Id)
                        {
                            <span class="spinner"></span>
                        }
                        else
                        {
                            <Icon Name="refresh" Size="15" />
                        }
                    </button>
                    <StatusPill Variant="@(authProblem ? "unavailable" : !checkedNow ? "neutral" : status.Ready ? "ready" : "unavailable")"
                                Class="@(authProblem ? "auth-pill" : null)"
                                Title="@(authProblem ? authMessage : !checkedNow ? "Checking this plugin" : status.Ready ? "Checked and reachable" : status.Detail ?? "Could not reach this plugin")">
                        @(authProblem ? AuthLabel(auth!.State) : !checkedNow ? "checking…" : status.Ready ? "ready" : "unavailable")
                    </StatusPill>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@enabled"
                               aria-label="Enable @plugin.Name"
                               @onchange="e => TogglePluginAsync(plugin.Id, (bool)e.Value!)" />
                        <span class="toggle-slider"></span>
                    </label>
                    @if (enabled)
                    {
                        <div class="btn-group" role="group" aria-label="@plugin.Name priority">
                            <button class="icon-button" title="Try this plugin first"
                                    aria-label="Move @plugin.Name up"
                                    disabled="@(firstEnabledId == plugin.Id)"
                                    @onclick="() => MoveUp(plugin.Id)"><Icon Name="chevron-up" Size="16" /></button>
                            <button class="icon-button" title="Try this plugin later"
                                    aria-label="Move @plugin.Name down"
                                    disabled="@(lastEnabledId == plugin.Id)"
                                    @onclick="() => MoveDown(plugin.Id)"><Icon Name="chevron-down" Size="16" /></button>
                        </div>
                    }
                </div>
            </div>
            <div class="plugin-quality">
                @foreach (var badge in QualityBadges(plugin))
                {
                    <span class="quality-badge">@badge</span>
                }
            </div>
            @{
                var note = authProblem
                    ? authMessage ?? plugin.LastUnavailableReason ?? status.Detail
                    : !status.Ready
                        ? plugin.LastUnavailableReason ?? status.Detail
                        : auth?.Message;
            }
            @if (!string.IsNullOrEmpty(note))
            {
                <div class="plugin-note @(authProblem || auth?.State == PluginAuthState.PlanRestricted ? "auth" : null)">
                    <Icon Name="@(authProblem ? "alert" : "info")" Size="15" />
                    <span>@note</span>
                    <button class="btn-modern small ghost plugin-note-action"
                            @onclick="() => CopyDiagnosticsAsync(plugin)">
                        <Icon Name="copy" Size="13" /> Copy diagnostics
                    </button>
                </div>
            }
            @if (plugin.ConfigFields.Count > 0)
            {
                var open = openSettings.Contains(plugin.Id);
                <div class="plugin-settings @(open ? "open" : null)">
                    <button type="button" class="settings-toggle" aria-expanded="@open"
                            @onclick="() => ToggleSettings(plugin.Id)">
                        <Icon Name="sliders" Size="15" />
                        <span>Settings</span>
                        <Icon Name="chevron-down" Size="16" Class="settings-chevron" />
                    </button>
                    @if (open)
                    {
                        <div class="settings-body">
                            @{
                                // When every field sits behind Advanced (a
                                // single base URL, say), the panel would open
                                // on a lone toggle: show those fields straight
                                // away instead.
                                var advancedOnly = plugin.ConfigFields.All(f => f.Advanced);
                            }
                            @foreach (var field in plugin.ConfigFields.Where(f => advancedOnly || !f.Advanced))
                            {
                                var key = $"{plugin.Id}:{field.Key}";
                                <PluginConfigFieldEditor PluginId="@plugin.Id" Field="@field"
                                    Value="@configValues.GetValueOrDefault(key, "")"
                                    ValueChanged="@(v => ConfigChanged(key, v))" />
                            }
                            @if (!advancedOnly && plugin.ConfigFields.Any(f => f.Advanced))
                            {
                                var advanced = advancedSettings.Contains(plugin.Id);
                                <button type="button" class="advanced-toggle" aria-expanded="@advanced"
                                        @onclick="() => ToggleAdvanced(plugin.Id)">
                                    <Icon Name="chevron-right" Size="14" Class="advanced-chevron" />
                                    <span>Advanced</span>
                                </button>
                                @if (advanced)
                                {
                                    <div class="advanced-fields">
                                        @foreach (var field in plugin.ConfigFields.Where(f => f.Advanced))
                                        {
                                            var key = $"{plugin.Id}:{field.Key}";
                                            <PluginConfigFieldEditor PluginId="@plugin.Id" Field="@field"
                                                Value="@configValues.GetValueOrDefault(key, "")"
                                                ValueChanged="@(v => ConfigChanged(key, v))" />
                                        }
                                    </div>
                                }
                            }
                            <div class="flex-actions end">
                                <button class="btn-modern small primary" @onclick="() => SaveConfigAsync(plugin.Id)">Save settings</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    }
</section>

@code {
    /// <summary>Availability verdict per plugin plus why it is not ready.</summary>
    private sealed record PluginStatus(bool Ready, string? Detail);

    private List<IDownloader> orderedPlugins = new();
    private Dictionary<string, PluginStatus> availability = new();
    private IReadOnlyList<PluginAuthIssue> authIssues = Array.Empty<PluginAuthIssue>();
    private Dictionary<string, string> configValues = new();
    private List<Application.Services.DownloadRun> runs = new();
    private Timer? _timer;
    private string? firstEnabledId;
    private string? lastEnabledId;
    private bool refreshingStatus;
    private bool ytDlpChecked;
    private DateTimeOffset lastAvailabilityCheck = DateTimeOffset.MinValue;
    private int availabilitySweep;
    private readonly ConcurrentDictionary<string, byte> checkingPlugins = new(StringComparer.OrdinalIgnoreCase);
    private readonly ConcurrentDictionary<string, DateTimeOffset> lastChecked = new(StringComparer.OrdinalIgnoreCase);
    private string? testingPluginId;
    private bool fragmentHandled;
    private QualityPresets.Id routePreset = QualityPresets.Id.Lossless;
    private string? ytDlpVersion;
    private string? ytDlpMessage;
    private bool updatingYtDlp;

    protected override async Task OnInitializedAsync()
    {
        _ = Registry.GetEnabled(); // force cache load
        await ReorderPluginsAsync();
        // The background login sweep may already know about a stale token:
        // show that mark before the first slow network probe finishes.
        authIssues = AuthMonitor.Snapshot();
        await RefreshAvailability();
        authIssues = AuthMonitor.Snapshot();
        await LoadConfigValuesAsync();
        ytDlpVersion = await YtDlp.GetVersionAsync();
        ytDlpChecked = true;
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            runs = Coordinator.Snapshot().Where(r => r.State != Application.Services.DownloadRunState.Finished).ToList();
            await ReorderPluginsAsync();
            // Keep the ready pills honest: a cheap re-probe (plugins cache
            // their own verdicts) every half minute.
            if (DateTimeOffset.UtcNow - lastAvailabilityCheck > TimeSpan.FromSeconds(30))
            {
                MarkChecking();
                StateHasChanged();
                await RefreshAvailability();
            }
            authIssues = AuthMonitor.Snapshot();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (fragmentHandled) return;
        var fragment = Nav.ToAbsoluteUri(Nav.Uri).Fragment.TrimStart('#');
        if (!fragment.StartsWith("plugin-", StringComparison.OrdinalIgnoreCase)) return;
        fragmentHandled = true;

        var id = fragment["plugin-".Length..];
        if (orderedPlugins.Any(plugin => string.Equals(plugin.Id, id, StringComparison.OrdinalIgnoreCase)))
            await OpenAuthSettings(id);
    }

    /// <summary>Loads every plugin's config fields from the registry store.</summary>
    private async Task LoadConfigValuesAsync()
    {
        var values = new Dictionary<string, string>();
        foreach (var plugin in orderedPlugins)
            foreach (var field in plugin.ConfigFields)
            {
                values[$"{plugin.Id}:{field.Key}"] = await Registry.GetConfigAsync(plugin.Id, field.Key);
            }
        configValues = values;
    }

    private void ConfigChanged(string key, string value)
        => configValues[key] = value;

    /// <summary>Plugin ids whose Settings panel is expanded.</summary>
    private readonly HashSet<string> openSettings = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Plugin ids whose Advanced fields are shown.</summary>
    private readonly HashSet<string> advancedSettings = new(StringComparer.OrdinalIgnoreCase);

    private void ToggleSettings(string id)
    {
        if (!openSettings.Add(id)) openSettings.Remove(id);
    }

    private void ToggleAdvanced(string id)
    {
        if (!advancedSettings.Add(id)) advancedSettings.Remove(id);
    }

    /// <summary>Runs the yt-dlp update and shows the outcome.</summary>
    private async Task UpdateYtDlp()
    {
        updatingYtDlp = true;
        ytDlpMessage = null;
        StateHasChanged();
        try
        {
            var before = ytDlpVersion;
            var result = await YtDlp.UpdateAsync();
            ytDlpVersion = await YtDlp.GetVersionAsync();
            ytDlpMessage = ytDlpVersion == before
                ? $"yt-dlp is already up to date ({ytDlpVersion})."
                : result.Message;
        }
        finally
        {
            updatingYtDlp = false;
            StateHasChanged();
        }
    }

    /// <summary>The header button: a visible busy state around the sweep.</summary>
    private async Task RefreshAvailabilityAsync()
    {
        refreshingStatus = true;
        MarkChecking();
        StateHasChanged();
        try
        {
            await RefreshAvailability();
        }
        finally
        {
            refreshingStatus = false;
            StateHasChanged();
        }
    }

    private async Task SaveConfigAsync(string pluginId)
    {
        var plugin = orderedPlugins.FirstOrDefault(p => p.Id == pluginId);
        if (plugin is null) return;
        foreach (var field in plugin.ConfigFields)
            await Registry.SetConfigAsync(pluginId, field.Key, configValues.GetValueOrDefault($"{pluginId}:{field.Key}"));

        // A newly pasted token must be tested for real, not answered from
        // the "down" verdict cached before the save.
        (plugin as IPluginAvailabilityRefresh)?.RefreshAvailability();
        var (ready, reason) = await ProbePluginAsync(plugin);
        availability[plugin.Id] = new PluginStatus(ready, ready ? null : reason);
        authIssues = AuthMonitor.Snapshot();
        lastAvailabilityCheck = DateTimeOffset.UtcNow;

        var auth = (plugin as IPluginAuthStatusProvider)?.AuthStatus;
        if (auth is { NeedsAttention: true })
            Notifications.Warn($"{plugin.Name}: {auth.Message ?? "the login still needs attention"}");
        else if (!ready)
            Notifications.Warn($"{plugin.Name} settings saved, but the plugin is not ready: {reason}");
        else
            Notifications.Success($"{plugin.Name} settings saved; the connection works.");

        StateHasChanged();
    }

    private Task ReorderPluginsAsync()
    {
        var enabled = (Registry.GetEnabled() ?? Array.Empty<IDownloader>()).ToList();
        var disabled = (Registry.GetAll() ?? Array.Empty<IDownloader>())
            .Where(p => !enabled.Contains(p))
            .ToList();
        orderedPlugins = enabled.Concat(disabled).ToList();
        firstEnabledId = enabled.FirstOrDefault()?.Id;
        lastEnabledId = enabled.LastOrDefault()?.Id;
        return Task.CompletedTask;
    }

    internal async Task RefreshAvailability()
    {
        // The 1s page timer and the Refresh status button can overlap. A
        // slow sweep must never run twice concurrently: it would pile up
        // network probes and race on the results dictionary.
        if (Interlocked.CompareExchange(ref availabilitySweep, 1, 0) == 1)
        {
            authIssues = AuthMonitor.Snapshot();
            return;
        }

        try
        {
            MarkChecking();

            var results = new ConcurrentDictionary<string, PluginStatus>(StringComparer.OrdinalIgnoreCase);
            await Parallel.ForEachAsync(
                orderedPlugins,
                new ParallelOptions { MaxDegreeOfParallelism = 4 },
                async (plugin, _) =>
                {
                    using var budget = new CancellationTokenSource(TimeSpan.FromSeconds(30));
                    var (ready, reason) = await ProbePluginAsync(plugin, budget.Token);
                    results[plugin.Id] = new PluginStatus(ready, reason);
                });

            availability = new Dictionary<string, PluginStatus>(results, StringComparer.OrdinalIgnoreCase);
            authIssues = AuthMonitor.Snapshot();
            lastAvailabilityCheck = DateTimeOffset.UtcNow;
        }
        finally
        {
            checkingPlugins.Clear();
            Interlocked.Exchange(ref availabilitySweep, 0);
        }
    }

    /// <summary>Marks every card as checking; the caller renders it.</summary>
    private void MarkChecking()
    {
        checkingPlugins.Clear();
        foreach (var plugin in orderedPlugins)
            checkingPlugins[plugin.Id] = 0;
    }

    /// <summary>
    /// One plugin's availability plus its own login verdict. The login
    /// register is updated here, so the banner and the sidebar mark use
    /// the same observation the card does.
    /// </summary>
    private async Task<(bool Ready, string? Reason)> ProbePluginAsync(
        IDownloader plugin, CancellationToken ct = default)
    {
        try
        {
            var ready = await plugin.IsAvailableAsync(ct);
            ObserveAuth(plugin);
            var auth = (plugin as IPluginAuthStatusProvider)?.AuthStatus;
            return (ready, ready
                ? null
                : auth?.Message ?? AvailabilityHint(plugin) ?? "Could not reach this plugin");
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            ObserveAuth(plugin);
            return (false, "The check timed out");
        }
        catch (Exception ex)
        {
            ObserveAuth(plugin);
            return (false, ex.Message);
        }
        finally
        {
            lastChecked[plugin.Id] = DateTimeOffset.UtcNow;
        }
    }

    /// <summary>
    /// A disabled plugin's stale token is irrelevant: it must not keep the
    /// banner or the sidebar mark alive.
    /// </summary>
    private void ObserveAuth(IDownloader plugin)
    {
        if (Registry.IsEnabled(plugin.Id))
            AuthMonitor.Observe(plugin);
        else
            AuthMonitor.Clear(plugin.Id);
    }

    /// <summary>The waterfall order and exclusions for the previewed quality.</summary>
    private QualityRouter.Plan RoutePlan
    {
        get
        {
            var enabled = orderedPlugins
                .Where(plugin => Registry.IsEnabled(plugin.Id))
                .ToList();
            return QualityRouter.Route(QualityPresets.ToQuality(routePreset), enabled);
        }
    }

    private string RouteQualityLabel =>
        QualityPresets.All.First(preset => preset.Id == routePreset).Label;

    internal bool ShowAuthBanner => authIssues.Count > 0 && !AuthMonitor.BannerDismissed;

    /// <summary>The banner headline, with the number of affected plugins.</summary>
    private string AuthAlertTitle => authIssues.Count == 1
        ? "One plugin needs your login"
        : $"{authIssues.Count} plugins need your login";

    /// <summary>"checked 2 minutes ago", so a ready pill has a timestamp.</summary>
    private string? LastCheckedText(string pluginId)
    {
        if (!lastChecked.TryGetValue(pluginId, out var at)) return null;
        var age = DateTimeOffset.UtcNow - at;
        if (age.TotalSeconds < 45) return "checked just now";
        if (age.TotalMinutes < 60)
        {
            var minutes = Math.Max(1, (int)Math.Round(age.TotalMinutes));
            return $"checked {minutes} minute{(minutes == 1 ? "" : "s")} ago";
        }
        var hours = Math.Max(1, (int)Math.Round(age.TotalHours));
        return $"checked {hours} hour{(hours == 1 ? "" : "s")} ago";
    }

    /// <summary>"expires in 12 days", or the past tense when it already passed.</summary>
    private static string ExpiryText(DateTimeOffset expires)
    {
        var left = expires - DateTimeOffset.UtcNow;
        if (left <= TimeSpan.Zero) return "expired";
        if (left.TotalDays >= 1)
        {
            var days = (int)Math.Ceiling(left.TotalDays);
            return $"expires in {days} day{(days == 1 ? "" : "s")}";
        }
        if (left.TotalHours >= 1)
        {
            var hours = (int)Math.Ceiling(left.TotalHours);
            return $"expires in {hours} hour{(hours == 1 ? "" : "s")}";
        }
        var minutes = Math.Max(1, (int)Math.Ceiling(left.TotalMinutes));
        return $"expires in {minutes} minute{(minutes == 1 ? "" : "s")}";
    }

