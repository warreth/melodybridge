@page "/downloads"
@using MelodyBridge.Core
@implements IDisposable
@inject IDownloaderRegistry Registry
@inject IDownloadManager DownloadMgr
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory

<PageTitle>Downloads - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Retriever</span>
        <h1>Download plugins</h1>
        <p>Plugins are tried top-down for every track. Toggle them, reorder priority, and watch live progress.</p>
    </div>
</section>

<section class="panel-card">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Waterfall</span>
            <h2>Priority order</h2>
        </div>
    </div>
    <div class="provider-list">
        @for (var i = 0; i < orderedPlugins.Count; i++)
        {
            var plugin = orderedPlugins[i];
            var enabled = Registry.IsEnabled(plugin.Id);
            var available = availability.TryGetValue(plugin.Id, out var av) && av;
            <div class="provider-row @(enabled ? "enabled" : "disabled")">
                <span class="provider-icon">@(plugin.Id switch { "soundcloud" => "☁", "archiveorg" => "🏛", _ => "▶" })</span>
                <div class="provider-info">
                    <strong>@plugin.Name</strong>
                    <small>@(string.IsNullOrEmpty(plugin.Description) ? plugin.Id : plugin.Description)</small>
                </div>
                <div class="provider-badges">
                    <span class="pill @(available ? "ok" : "warn")" title="@(available ? "Plugin is operational" : "Plugin currently unavailable (binary missing or service down) — it is skipped in the waterfall")">
                        @(available ? "ready" : "unavailable")
                    </span>
                </div>
                <div class="provider-actions">
                    <button class="btn-modern small ghost" title="Move up"
                            disabled="@(i == 0)" @onclick="() => MoveUp(plugin.Id)">↑</button>
                    <button class="btn-modern small ghost" title="Move down"
                            disabled="@(i == orderedPlugins.Count - 1)" @onclick="() => MoveDown(plugin.Id)">↓</button>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@enabled"
                               @onchange="e => TogglePlugin(plugin.Id, (bool)(e.Value ?? false))" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
        }
    </div>
    <div class="hint-box">
        The first enabled plugin that can find and download a track wins. Unavailable
        plugins (missing binary, service down) are skipped automatically.
    </div>
</section>

<section class="panel-card">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Queue</span>
            <h2>Live downloads</h2>
        </div>
        <button class="btn-modern ghost small" @onclick="RefreshProgress">Refresh</button>
    </div>
    @if (progressItems.Count == 0)
    {
        <div class="empty-state">No active downloads. Start one from a playlist's page.</div>
    }
    else
    {
        <div class="qi-result">
            @foreach (var item in progressItems)
            {
                <div class="qi-item">
                    <span class="qi-icon @(item.Status switch {
                        "done" => "ok",
                        "failed" => "err",
                        _ => "pending"
                    })">
                        @(item.Status switch { "done" => "✓", "failed" => "✕", _ => "…" })
                    </span>
                    <div style="flex:1; min-width:0;">
                        <strong>@item.Title</strong>
                        <div class="qi-meta">@item.Status@(item.Plugin is null ? "" : $" · {item.Plugin}")</div>
                        @if (item.FilePath is not null)
                        {
                            <div class="qi-path">@item.FilePath</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(savedMessage))
{
    <div class="result-box ok">@savedMessage</div>
}

@code {
    private List<DownloadProgress> progressItems = new();
    private List<IDownloader> orderedPlugins = new();
    private Dictionary<string, bool> availability = new();
    private Timer? _timer;
    private string? savedMessage;

    protected override async Task OnInitializedAsync()
    {
        _ = Registry.GetEnabled(); // force cache load
        ReorderPlugins();
        await RefreshAvailability();
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            progressItems = DownloadMgr.SnapshotProgress().ToList();
            StateHasChanged();
            await Task.CompletedTask;
        }), null, 1000, 1000);
    }

    private async Task RefreshAvailability()
    {
        var results = new Dictionary<string, bool>();
        foreach (var plugin in orderedPlugins)
        {
            try { results[plugin.Id] = await plugin.IsAvailableAsync(); }
            catch { results[plugin.Id] = false; }
        }
        availability = results;
    }

    private void ReorderPlugins()
    {
        // Registry.GetEnabled already sorts by priority; show disabled ones too, in priority order.
        var enabled = (Registry.GetEnabled() ?? Array.Empty<IDownloader>()).ToList();
        var rest = (Registry.GetAll() ?? Array.Empty<IDownloader>())
            .Where(p => !enabled.Contains(p))
            .ToList();
        orderedPlugins = enabled.Concat(rest).ToList();
    }

    private async Task TogglePlugin(string id, bool enabled)
    {
        await Registry.SetEnabledAsync(id, enabled);
        ReorderPlugins();
        savedMessage = $"{id} {(enabled ? "enabled" : "disabled")}";
    }

    private async Task MoveUp(string id) => await SwapPriority(id, -1);
    private async Task MoveDown(string id) => await SwapPriority(id, +1);

    private async Task SwapPriority(string id, int direction)
    {
        var idx = orderedPlugins.FindIndex(p => p.Id == id);
        var other = idx + direction;
        if (other < 0 || other >= orderedPlugins.Count) return;

        var a = await Registry.GetPriorityAsync(orderedPlugins[idx].Id);
        var b = await Registry.GetPriorityAsync(orderedPlugins[other].Id);
        await Registry.SetPriorityAsync(orderedPlugins[idx].Id, b);
        await Registry.SetPriorityAsync(orderedPlugins[other].Id, a);
        ReorderPlugins();
    }

    private void RefreshProgress()
    {
        progressItems = DownloadMgr.SnapshotProgress().ToList();
    }

    public void Dispose() => _timer?.Dispose();
}
