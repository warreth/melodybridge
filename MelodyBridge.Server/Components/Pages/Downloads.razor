@page "/downloads"
@using MelodyBridge.Core
@implements IDisposable
@inject IDownloaderRegistry Registry
@inject IDownloadManager DownloadMgr

<PageTitle>Downloads - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Your music</span>
        <h1>Download plugins</h1>
        <p>Plugins are tried top-down for every track. Toggle them, reorder the waterfall, and watch live progress.</p>
    </div>
</section>

<section class="panel-card">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Waterfall</span>
            <h2>Priority order</h2>
        </div>
    </div>
    <div class="provider-list">
        @for (var i = 0; i < orderedPlugins.Count; i++)
        {
            var plugin = orderedPlugins[i];
            var enabled = Registry.IsEnabled(plugin.Id);
            var available = availability.TryGetValue(plugin.Id, out var av) && av;
            <div class="provider-row @(enabled ? "enabled" : "disabled")">
                <span class="provider-rank">@(i + 1)</span>
                <div class="provider-info">
                    <strong>@plugin.Name</strong>
                    <small>@(string.IsNullOrEmpty(plugin.Description) ? plugin.Id : plugin.Description)</small>
                </div>
                <span class="pill @(available ? "ok" : "warn")"
                      title="@(available ? "Plugin is operational" : "Plugin currently unavailable (missing binary or service down). It is skipped in the waterfall.")">
                    @(available ? "ready" : "unavailable")
                </span>
                <div class="provider-actions">
                    <button class="btn-modern small ghost" title="Move up"
                            disabled="@(i == 0)" @onclick="() => MoveAsync(plugin.Id, -1)">↑</button>
                    <button class="btn-modern small ghost" title="Move down"
                            disabled="@(i == orderedPlugins.Count - 1)" @onclick="() => MoveAsync(plugin.Id, +1)">↓</button>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@enabled"
                               @onchange="e => TogglePluginAsync(plugin.Id, (bool)(e.Value ?? false))" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
        }
    </div>
    <div class="hint-box">
        The first enabled plugin that finds and downloads a track wins. Unavailable
        plugins are skipped automatically.
    </div>
</section>

<section class="panel-card">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Queue</span>
            <h2>Live downloads</h2>
        </div>
    </div>
    @if (progressItems.Count == 0)
    {
        <div class="empty-state">No active downloads. Start one from a playlist page.</div>
    }
    else
    {
        <div class="qi-result">
            @foreach (var item in progressItems)
            {
                <div class="qi-item">
                    <span class="qi-icon @(item.Status switch {
                        "done" => "ok",
                        "failed" => "err",
                        _ => "pending"
                    })">
                        @(item.Status switch { "done" => "✓", "failed" => "✕", _ => "…" })
                    </span>
                    <div style="flex:1; min-width:0;">
                        <strong>@item.Title</strong>
                        <div class="qi-meta">@item.Status@(item.Plugin is null ? "" : $" · {item.Plugin}")</div>
                        @if (item.FilePath is not null)
                        {
                            <div class="qi-path">@item.FilePath</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(savedMessage))
{
    <div class="result-box ok">@savedMessage</div>
}

@code {
    private List<DownloadProgress> progressItems = new();
    private List<IDownloader> orderedPlugins = new();
    private Dictionary<string, bool> availability = new();
    private Timer? _timer;
    private string? savedMessage;

    protected override async Task OnInitializedAsync()
    {
        _ = Registry.GetEnabled(); // force cache load
        ReorderPlugins();
        await RefreshAvailability();
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            progressItems = DownloadMgr.SnapshotProgress().ToList();
            StateHasChanged();
        }), null, 1000, 1000);
    }

    /// <summary>
    /// The visible order is exactly the persisted waterfall order: enabled
    /// plugins by priority, then disabled ones by priority. No swaps, no
    /// drift: rendering and the database always agree.
    /// </summary>
    private void ReorderPlugins()
    {
        var enabled = (Registry.GetEnabled() ?? Array.Empty<IDownloader>()).ToList();
        var disabled = (Registry.GetAll() ?? Array.Empty<IDownloader>())
            .Where(p => !enabled.Contains(p))
            .ToList();
        orderedPlugins = enabled.Concat(disabled).ToList();
    }

    private async Task RefreshAvailability()
    {
        var results = new Dictionary<string, bool>();
        foreach (var plugin in orderedPlugins)
        {
            try { results[plugin.Id] = await plugin.IsAvailableAsync(); }
            catch { results[plugin.Id] = false; }
        }
        availability = results;
    }

    private async Task TogglePluginAsync(string id, bool enabled)
    {
        await Registry.SetEnabledAsync(id, enabled);
        ReorderPlugins();
        savedMessage = $"{id} {(enabled ? "enabled" : "disabled")}";
    }

    /// <summary>
    /// Moves one plugin up or down by rebuilding the full order and
    /// persisting it with SetOrderAsync, which renumbers all priorities
    /// densely. The old swap approach broke when priorities drifted.
    /// </summary>
    private async Task MoveAsync(string id, int direction)
    {
        var ids = orderedPlugins.Select(p => p.Id).ToList();
        var idx = ids.IndexOf(id);
        var other = idx + direction;
        if (idx < 0 || other < 0 || other >= ids.Count) return;

        (ids[idx], ids[other]) = (ids[other], ids[idx]);
        await Registry.SetOrderAsync(ids);
        ReorderPlugins();
        await RefreshAvailability();
    }

    public void Dispose() => _timer?.Dispose();
}
