@page "/logs"
@using MelodyBridge.Core.Logging
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Services
@implements IDisposable
@inject ILogCollector LogCollector
@inject LogExporter Exporter
@inject IJSRuntime JS

<PageTitle>Logs - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">System</span>
        <h1>Logs</h1>
        <p>Everything the app did recently: playlist syncs, downloads, scans, and errors.</p>
    </div>
    <div class="topbar-actions">
        <button class="btn-modern ghost" @onclick="CopyToClipboardAsync" disabled="@FilteredEmpty">Copy</button>
        <button class="btn-modern ghost" @onclick="DownloadFileAsync" disabled="@FilteredEmpty">Export</button>
        <button class="btn-modern secondary" @onclick="ClearLogs">Clear</button>
    </div>
</section>

@if (errorCount > 0)
{
    <section class="panel-card log-error-banner">
        <div class="log-error-head">
            <Icon Name="alert" Size="20" Class="qi-icon err" />
            <div>
                <strong>@errorCount recent problem@(errorCount == 1 ? "" : "s") detected</strong>
                <p>Errors the app ran into. Click one to jump to that area.</p>
            </div>
            <button class="btn-modern ghost small" @onclick="ShowOnlyErrors">
                @(showingErrorsOnly ? "Show all" : "Show only problems")
            </button>
        </div>
        @foreach (var entry in errorPreview)
        {
            <div class="log-row err clickable" @onclick="() => SelectEntry(entry)">
                <span class="log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                <span class="log-category">@LogAreas.FromCategory(entry.Category)</span>
                <span class="log-message">@entry.Message</span>
            </div>
        }
        @if (errorPreview.Count < errorCount)
        {
            <div class="logs-count">and @(errorCount - errorPreview.Count) more in the stream below</div>
        }
    </section>
}

<section class="panel-card">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Filter</span>
            <h2>Event stream</h2>
        </div>
    </div>
    <div class="logs-toolbar">
        <input type="search" class="search-input" placeholder="Search text..."
               value="@searchText" @oninput="OnSearchChanged" />
        <label class="toggle-switch wide auto-scroll">
            <input type="checkbox" @bind="newestFirst" />
            <span class="toggle-slider"></span>
            <span>Newest first</span>
        </label>
        <div class="filter-chips">
            <button class="filter-chip @(selectedArea is null ? "active" : "")" @onclick="() => SelectArea(null)">
                All areas
            </button>
            @foreach (var area in LogAreas.All)
            {
                <button class="filter-chip @(selectedArea == area ? "active" : "")" @onclick="() => SelectArea(area)">
                    @area
                </button>
            }
        </div>
        <div class="filter-chips">
            <button class="filter-chip @(selectedLevel is null ? "active" : "")" @onclick="() => SelectLevel(null)">
                All levels
            </button>
            @foreach (var levelFilter in LevelFilters)
            {
                <button class="filter-chip @(selectedLevel?.Label == levelFilter.Label ? "active" : "") chip-level-@LevelClass(levelFilter.Levels[0])"
                        @onclick="() => SelectLevel(levelFilter)">
                    @levelFilter.Label
                </button>
            }
        </div>
    </div>

    @if (filtered.Count == 0)
    {
        <EmptyState IconName="search" Title="No log entries match">
            <p>Adjust the area, level or search text.</p>
        </EmptyState>
    }
    else
    {
        <div class="logs-list">
            @foreach (var entry in newestFirst ? filtered.AsEnumerable() : filtered.AsEnumerable().Reverse())
            {
                <div class="log-row @LevelClass(entry.Level)">
                    <span class="log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                    <span class="log-level">@entry.Level.ToString().ToUpperInvariant()</span>
                    <span class="log-category">@LogAreas.FromCategory(entry.Category)</span>
                    <span class="log-message">@entry.Message</span>
                </div>
            }
        </div>
        <div class="logs-count">@filtered.Count of @totalEntries entries</div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="result-box ok">@statusMessage</div>
}

@code {
    private const int ErrorPreviewLimit = 3;

    private List<LogEntry> filtered = new();
    private List<LogEntry> errorPreview = new();
    private int totalEntries;
    private int errorCount;
    private string? selectedArea;
    private LevelFilter? selectedLevel;
    private bool showingErrorsOnly;
    private bool newestFirst = true;
    private string searchText = string.Empty;
    private string? statusMessage;
    private Timer? _timer;

    private sealed record LevelFilter(string Label, LogLevel[] Levels);

    /// <summary>Level chips: Error covers Error and Critical.</summary>
    private static readonly LevelFilter[] LevelFilters =
    {
        new("Info", new[] { LogLevel.Info, LogLevel.Debug, LogLevel.Trace }),
        new("Warning", new[] { LogLevel.Warn }),
        new("Error", new[] { LogLevel.Error, LogLevel.Critical }),
    };

    private bool FilteredEmpty => filtered.Count == 0;

    protected override void OnInitialized()
    {
        Refresh();
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        }), null, 2000, 2000);
    }

    private void Refresh()
    {
        var entries = LogCollector.GetEntries();
        totalEntries = entries.Count;
        errorCount = entries.Count(IsError);
        errorPreview = entries.Where(IsError).Take(ErrorPreviewLimit).ToList();
        filtered = entries.Where(Matches).ToList();
    }

    private static bool IsError(LogEntry e)
        => e.Level is LogLevel.Error or LogLevel.Critical;    private bool Matches(LogEntry e)
    {
        if (showingErrorsOnly && !IsError(e))
            return false;
        if (selectedArea is not null && LogAreas.FromCategory(e.Category) != selectedArea)
            return false;
        if (selectedLevel is not null && !selectedLevel.Levels.Contains(e.Level))
            return false;
        if (string.IsNullOrWhiteSpace(searchText))
            return true;
        return e.Message?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true
            || e.Category?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true
            || LogAreas.FromCategory(e.Category ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase);
}

    private static string LevelClass(LogLevel level) => level switch
    {
        LogLevel.Error or LogLevel.Critical => "err",
        LogLevel.Warn => "warn",
        _ => "info",
    };

    private void SelectArea(string? area)
    {
        selectedArea = area;
        Refresh();
    }

    private void SelectLevel(LevelFilter? level)
    {
        selectedLevel = level;
        Refresh();
    }

    private void ShowOnlyErrors()
    {
        showingErrorsOnly = !showingErrorsOnly;
        Refresh();
    }

    private void SelectEntry(LogEntry entry)
    {
        // Jump into the stream: that area, only errors until cleared.
        showingErrorsOnly = true;
        selectedArea = LogAreas.FromCategory(entry.Category);
        Refresh();
        statusMessage = $"Showing errors from {selectedArea}";
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        Refresh();
    }

    private async Task CopyToClipboardAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", BuildText());
        statusMessage = $"Copied {filtered.Count} entries to clipboard";
    }

    private async Task DownloadFileAsync()
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(BuildText());
        var name = $"melodybridge-logs-{DateTime.Now:yyyyMMdd-HHmmss}.txt";
        await JS.InvokeVoidAsync("melody.downloadFile", name, "text/plain", bytes);
        statusMessage = $"Exported {filtered.Count} entries to {name}";
    }

    private void ClearLogs()
    {
        LogCollector.Clear();
        showingErrorsOnly = false;
        Refresh();
        statusMessage = "Log buffer cleared";
    }

    /// <summary>Plain text, oldest first, honoring the active filters.</summary>
    private string BuildText()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"MelodyBridge logs ({filtered.Count} entries, generated {DateTime.Now:yyyy-MM-dd HH:mm:ss})");
        foreach (var e in Enumerable.Reverse(filtered))
        {
            sb.Append('[').Append(e.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))
              .Append("] ").Append(e.Level.ToString().ToUpperInvariant())
              .Append(" [").Append(LogAreas.FromCategory(e.Category)).Append("] ").AppendLine(e.Message);
            if (!string.IsNullOrEmpty(e.Detail))
                sb.AppendLine($"    {e.Detail.Replace("\n", "\n    ")}");
        }
        return sb.ToString();
    }

    public void Dispose() => _timer?.Dispose();
}
