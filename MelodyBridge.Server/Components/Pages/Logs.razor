@page "/logs"
@using MelodyBridge.Core.Logging
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Services
@implements IDisposable
@inject ILogCollector LogCollector
@inject LogExporter Exporter
@inject LogsViewState View
@inject IJSRuntime JS

<PageTitle>Logs - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">System</span>
        <div class="title-with-help">
            <h1>Logs</h1>
            <HelpTip Path="reference#when-a-download-fails" Text="Filter by area or level. Track failures carry the reason the waterfall gave up; the docs explain each one." />
        </div>
        <p>Everything the app did recently: playlist syncs, downloads, scans, and errors.
            Framework debug chatter stays out; each row is grouped by the area that owns it.</p>
    </div>
    <div class="topbar-actions">
        <button class="btn-modern ghost" @onclick="CopyToClipboardAsync" disabled="@FilteredEmpty">Copy</button>
        <button class="btn-modern ghost" @onclick="DownloadFileAsync" disabled="@FilteredEmpty">Export</button>
        <button class="btn-modern secondary" @onclick="() => confirmClear = true">Clear</button>
    </div>
</section>

@if (confirmClear)
{
    <ConfirmDialog Show="true"
                   Eyebrow="Clear logs"
                   Title="Clear the log buffer?"
                   Message=@($"Removes all {totalEntries} buffered entries for every open page. Nothing on disk is touched.")
                   ConfirmLabel="Clear logs"
                   OnConfirm="ClearLogs"
                   OnCancel="CancelClear" />
}

@if (errorCount > 0 && errorCount > dismissedErrorCount)
{
    <section class="panel-card log-error-banner">
        <div class="log-error-head">
            <Icon Name="alert" Size="20" Class="qi-icon err" />
            <div>
                <strong>@errorCount recent problem@(errorCount == 1 ? "" : "s") detected</strong>
                <p>Errors the app ran into. Click one to jump to that area.</p>
            </div>
            <button class="btn-modern ghost small" @onclick="ShowOnlyErrors">
                @(showingErrorsOnly ? "Show all" : "Show only problems")
            </button>
            <button class="btn-modern ghost small" @onclick="DismissBanner">Hide</button>
        </div>
        @foreach (var entry in errorPreview)
        {
            <div class="log-row err clickable" @onclick="() => SelectEntry(entry)">
                <span class="log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                <span class="log-category" title="@entry.Category">@LogAreas.FromCategory(entry.Category)</span>
                <span class="log-message">@LogRedactor.Redact(entry.Message)</span>
            </div>
        }
        @if (errorPreview.Count < errorCount)
        {
            <div class="logs-count">and @(errorCount - errorPreview.Count) more in the stream below</div>
        }
    </section>
}

<section class="panel-card">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Filter</span>
            <h2>Event stream</h2>
        </div>
    </div>
    <div class="logs-toolbar">
        <input type="search" class="search-input" placeholder="Search text..."
               value="@searchText" @oninput="OnSearchChanged" />
        <div class="logs-toolbar-toggles">
            <label class="toggle-switch wide auto-scroll">
                <input type="checkbox" @bind="newestFirst" @bind:after="OnViewOptionChanged" />
                <span class="toggle-slider"></span>
                <span>Newest first</span>
            </label>
            <label class="toggle-switch wide">
                <input type="checkbox" @bind="paused" @bind:after="OnPauseChanged" />
                <span class="toggle-slider"></span>
                <span>@(paused ? "Paused" : "Pause live")</span>
            </label>
            <label class="toggle-switch wide">
                <input type="checkbox" @bind="groupByTrack" @bind:after="OnViewOptionChanged" />
                <span class="toggle-slider"></span>
                <span>Group by track</span>
            </label>
        </div>
        <div class="logs-source-row">
            <label class="log-source-filter">
                <span>Source</span>
                <select @bind="selectedSource" @bind:after="OnSourceChanged">
                    <option value="all">All sources</option>
                    @foreach (var source in LogSources.All)
                    {
                        var count = sourceCounts.GetValueOrDefault(source);
                        <option value="@source">@source@(count > 0 ? $" ({count})" : "")</option>
                    }
                </select>
            </label>
            <span class="logs-live @(paused ? "paused" : null)">
                <span class="status-dot @(paused ? "warning" : "online")" aria-hidden="true"></span>
                @(paused ? "Live stream paused" : "Live")
            </span>
        </div>
        <div class="filter-chips">
            <button class="filter-chip @(selectedArea is null ? "active" : "")"
                    data-area="all" @onclick="() => SelectArea(null)">
                All areas
            </button>
            @foreach (var area in LogAreas.All)
            {
                var count = areaCounts.GetValueOrDefault(area);
                <button class="filter-chip @(selectedArea == area ? "active" : "")"
                        data-area="@area" title="@count entries in @area"
                        @onclick="() => SelectArea(area)">
                    @area
                    @if (count > 0)
                    {
                        <span class="chip-count" aria-hidden="true">@count</span>
                    }
                </button>
            }
        </div>
        <div class="filter-chips">
            <button class="filter-chip @(selectedLevel is null ? "active" : "")"
                    data-level="all" @onclick="() => SelectLevel(null)">
                All levels
            </button>
            @foreach (var levelFilter in LevelFilters)
            {
                var count = levelCounts.GetValueOrDefault(levelFilter.Label);
                <button class="filter-chip @(selectedLevel?.Label == levelFilter.Label ? "active" : "") chip-level-@LevelClass(levelFilter.Levels[0])"
                        data-level="@levelFilter.Label" title="@count entries at @levelFilter.Label"
                        @onclick="() => SelectLevel(levelFilter)">
                    @levelFilter.Label
                    @if (count > 0)
                    {
                        <span class="chip-count" aria-hidden="true">@count</span>
                    }
                </button>
            }
        </div>
    </div>

    @if (pinnedEntries.Count > 0)
    {
        <div class="pinned-logs">
            <div class="pinned-head">
                <strong><Icon Name="pin" Size="13" /> Pinned</strong>
                <button class="btn-modern small ghost" @onclick="ClearPinned">Clear</button>
            </div>
            <div class="logs-list">
                @foreach (var entry in pinnedEntries)
                {
                    <LogEntryRow @key="entry" Entry="entry" Pinned="true"
                                 OnCopy="CopyEntryAsync" OnPin="TogglePin" />
                }
            </div>
        </div>
    }

    @if (filtered.Count == 0)
    {
        @if (totalEntries == 0)
        {
            <EmptyState IconName="terminal" Title="Nothing logged yet">The buffer starts filling as the app works.</EmptyState>
        }
        else
        {
            <EmptyState IconName="search" Title="No log entries match">
                <p>Adjust the area, source, level or search text.</p>
            </EmptyState>
        }
    }
    else
    {
        <div class="logs-list">
            @if (groupByTrack)
            {
                @foreach (var group in GroupedEntries())
                {
                    <div class="log-group-head">
                        <Icon Name="music" Size="13" />
                        <strong>@group.Name</strong>
                        <span>@group.Entries.Count</span>
                    </div>
                    @foreach (var entry in group.Entries)
                    {
                        <LogEntryRow @key="entry" Entry="entry"
                                     Pinned="@IsPinned(entry)"
                                     OnCopy="CopyEntryAsync" OnPin="TogglePin" />
                    }
                }
            }
            else
            {
                @foreach (var entry in newestFirst ? StreamEntries : StreamEntries.Reverse())
                {
                    <LogEntryRow @key="entry" Entry="entry"
                                 Pinned="@IsPinned(entry)"
                                 OnCopy="CopyEntryAsync" OnPin="TogglePin" />
                }
            }
        </div>
        <div class="logs-count">
            @filtered.Count of @totalEntries entries
            @if (pinnedEntries.Count > 0)
            {
                <span> · @pinnedEntries.Count pinned</span>
            }
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="result-box ok">@statusMessage</div>
}

@code {
    private const int ErrorPreviewLimit = 3;

    private List<LogEntry> filtered = new();
    private List<LogEntry> errorPreview = new();
    private Dictionary<string, int> areaCounts = new();
    private Dictionary<string, int> levelCounts = new();
    private Dictionary<string, int> sourceCounts = new();
    private List<LogEntry> pinnedEntries = new();
    private int totalEntries;
    private int errorCount;
    private string? selectedArea;
    private LevelFilter? selectedLevel;
    private string selectedSource = "all";
    private bool showingErrorsOnly;
    private bool newestFirst = true;
    private bool paused;
    /// <summary>The observe marker the idle tick compares: total collected
    /// keeps counting when entries are evicted, which a count alone would miss.</summary>
    private long _observedCollected = -1;
    private bool groupByTrack;
    private string searchText = string.Empty;
    private string? statusMessage;
    private int dismissedErrorCount;
    private bool confirmClear;
    private Timer? _timer;

    private sealed record LevelFilter(string Label, LogLevel[] Levels);

    /// <summary>
    /// Level chips. The default is Info+ (everything a normal reader
    /// needs); Debug is its own chip so trace noise never floods the page
    /// unless it is asked for. Error covers Error and Critical.
    /// </summary>
    private static readonly LevelFilter[] LevelFilters =
    {
        new("Info+", new[] { LogLevel.Info, LogLevel.Warn, LogLevel.Error, LogLevel.Critical }),
        new("Warning", new[] { LogLevel.Warn }),
        new("Error", new[] { LogLevel.Error, LogLevel.Critical }),
        new("Debug", new[] { LogLevel.Debug, LogLevel.Trace }),
    };

    private bool FilteredEmpty => filtered.Count == 0;

    protected override void OnInitialized()
    {
        selectedArea = View.SelectedArea;
        selectedSource = string.IsNullOrWhiteSpace(View.SelectedSource) ? "all" : View.SelectedSource;
        searchText = View.SearchText;
        newestFirst = View.NewestFirst;
        groupByTrack = View.GroupByTrack;
        selectedLevel = View.SelectedLevel switch
        {
            null or "Info+" => LevelFilters[0],
            "all" => null,
            var label => LevelFilters.FirstOrDefault(filter => filter.Label == label)
                ?? LevelFilters[0],
        };

        Refresh();
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            if (paused) return;
            // Idle ticks do no LINQ passes and no re-render: the collector's
            // count is the only cheap "anything new" signal it has.
            var now = LogCollector.TotalCollected;
            if (now == _observedCollected) return;
            _observedCollected = now;
            Refresh();
            StateHasChanged();
        }), null, 2000, 2000);
    }

    private void Refresh()
    {
        var entries = LogCollector.GetEntries();
        totalEntries = entries.Count;
        errorCount = entries.Count(IsError);
        errorPreview = entries.Where(IsError).Take(ErrorPreviewLimit).ToList();
        areaCounts = entries
            .GroupBy(entry => LogAreas.FromCategory(entry.Category))
            .ToDictionary(group => group.Key, group => group.Count());
        levelCounts = LevelFilters.ToDictionary(
            filter => filter.Label,
            filter => entries.Count(entry => filter.Levels.Contains(entry.Level)));
        sourceCounts = entries
            .GroupBy(entry => LogSources.FromCategory(entry.Category))
            .ToDictionary(group => group.Key, group => group.Count());
        filtered = entries.Where(Matches).ToList();
    }

    private static bool IsError(LogEntry e)
        => e.Level is LogLevel.Error or LogLevel.Critical;

    private bool Matches(LogEntry e)
    {
        if (showingErrorsOnly && !IsError(e))
            return false;
        if (selectedArea is not null && LogAreas.FromCategory(e.Category) != selectedArea)
            return false;
        if (selectedSource != "all" && LogSources.FromCategory(e.Category) != selectedSource)
            return false;
        if (selectedLevel is not null && !selectedLevel.Levels.Contains(e.Level))
            return false;
        if (string.IsNullOrWhiteSpace(searchText))
            return true;
        return e.Message?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true
            || e.Category?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true
            || LogAreas.FromCategory(e.Category ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase);
}

    private static string LevelClass(LogLevel level) => level switch
    {
        LogLevel.Error or LogLevel.Critical => "err",
        LogLevel.Warn => "warn",
        LogLevel.Debug or LogLevel.Trace => "debug",
        _ => "info",
    };

    private void SelectArea(string? area)
    {
        selectedArea = area;
        View.SelectedArea = area;
        Refresh();
    }

    private void SelectLevel(LevelFilter? level)
    {
        selectedLevel = level;
        View.SelectedLevel = level?.Label ?? "all";
        Refresh();
    }

    private void OnSourceChanged()
    {
        View.SelectedSource = selectedSource;
        Refresh();
    }

    private void OnViewOptionChanged()
    {
        View.NewestFirst = newestFirst;
        View.GroupByTrack = groupByTrack;
        StateHasChanged();
    }

    /// <summary>Resuming catches up immediately instead of waiting for the next tick.</summary>
    private void OnPauseChanged()
    {
        if (paused) return;
        Refresh();
        StateHasChanged();
    }

    private void ShowOnlyErrors()
    {
        showingErrorsOnly = !showingErrorsOnly;
        Refresh();
    }

    /// <summary>Hides the banner until new problems arrive.</summary>
    private void DismissBanner() => dismissedErrorCount = errorCount;

    private void SelectEntry(LogEntry entry)
    {
        // Jump into the stream: that area, only errors until cleared.
        showingErrorsOnly = true;
        selectedArea = LogAreas.FromCategory(entry.Category);
        selectedSource = "all";
        View.SelectedArea = selectedArea;
        View.SelectedSource = "all";
        Refresh();
        statusMessage = $"Showing errors from {selectedArea}";
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        View.SearchText = searchText;
        Refresh();
    }

    /// <summary>Filtered entries that are not already shown in the pinned card.</summary>
    private IEnumerable<LogEntry> StreamEntries => filtered.Where(entry => !IsPinned(entry));

    /// <summary>One entry per track, newest group first, each group in the chosen order.</summary>
    private IReadOnlyList<LogGroup> GroupedEntries()
    {
        var ordered = newestFirst ? StreamEntries : StreamEntries.Reverse();
        return ordered
            .GroupBy(entry => string.IsNullOrWhiteSpace(entry.Group)
                ? "Other events"
                : entry.Group!)
            .Select(group => new LogGroup(group.Key, group.ToList()))
            .OrderByDescending(group => group.Entries.Max(entry => entry.Timestamp))
            .ToList();
    }

    private sealed record LogGroup(string Name, IReadOnlyList<LogEntry> Entries);

    private bool IsPinned(LogEntry entry) => pinnedEntries.Contains(entry);

    private void TogglePin(LogEntry entry)
    {
        if (!pinnedEntries.Remove(entry))
            pinnedEntries.Insert(0, entry);
        StateHasChanged();
    }

    private void ClearPinned()
    {
        pinnedEntries.Clear();
        StateHasChanged();
    }

    private async Task CopyEntryAsync(LogEntry entry)
    {
        var text = $"[{entry.Timestamp.ToLocalTime():yyyy-MM-dd HH:mm:ss}] "
            + $"{entry.Level.ToString().ToUpperInvariant()} [{LogAreas.FromCategory(entry.Category)}] "
            + LogRedactor.Redact(entry.Message);
        if (!string.IsNullOrWhiteSpace(entry.Detail))
            text += Environment.NewLine + LogRedactor.Redact(entry.Detail);

        bool copied;
        try
        {
            copied = await JS.InvokeAsync<bool>("melody.copyText", text);
        }
        catch (JSException)
        {
            copied = false;
        }

        statusMessage = copied ? "Entry copied to clipboard" : "The browser would not let the page copy.";
    }

    private async Task CopyToClipboardAsync()
    {
        bool copied;
        try
        {
            // The helper falls back to the selection trick on plain-http
            // hosts, where navigator.clipboard does not exist.
            copied = await JS.InvokeAsync<bool>("melody.copyText", BuildText());
        }
        catch (JSException)
        {
            copied = false;
        }
        statusMessage = copied
            ? $"Copied {filtered.Count} {(filtered.Count == 1 ? "entry" : "entries")} to clipboard"
            : "The browser would not let the page copy. Use Export instead.";
    }

    private async Task DownloadFileAsync()
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(BuildText());
        var name = $"melodybridge-logs-{DateTime.Now:yyyyMMdd-HHmmss}.txt";
        await JS.InvokeVoidAsync("melody.downloadFile", name, "text/plain", bytes);
        statusMessage = $"Exported {filtered.Count} {(filtered.Count == 1 ? "entry" : "entries")} to {name}";
    }

    private void CancelClear() => confirmClear = false;

    private void ClearLogs()
    {
        LogCollector.Clear();
        pinnedEntries.Clear();
        showingErrorsOnly = false;
        confirmClear = false;
        dismissedErrorCount = 0;
        Refresh();
        StateHasChanged();
        // A cleared buffer must re-render even though nothing was newly
        // collected: the idle gate compares totals, not emptiness.
        statusMessage = "Log buffer cleared";
    }

    /// <summary>Plain text, oldest first, honoring the active filters.</summary>
    private string BuildText()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"MelodyBridge logs ({filtered.Count} entries, generated {DateTime.Now:yyyy-MM-dd HH:mm:ss})");
        foreach (var e in Enumerable.Reverse(filtered))
        {
            sb.Append('[').Append(e.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))
              .Append("] ").Append(e.Level.ToString().ToUpperInvariant())
              .Append(" [").Append(LogAreas.FromCategory(e.Category)).Append("] ");
            if (!string.IsNullOrWhiteSpace(e.Group))
                sb.Append('[').Append(e.Group).Append("] ");
            sb.AppendLine(LogRedactor.Redact(e.Message));
            if (!string.IsNullOrEmpty(e.Detail))
                sb.AppendLine($"    {LogRedactor.Redact(e.Detail).Replace("\n", "\n    ")}");
        }
        return sb.ToString();
    }

    public void Dispose() => _timer?.Dispose();
}
