@page "/playlists"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Data
@using MelodyBridge.Infrastructure.Services
@inject IPlaylistService PlaylistService
@inject IEnumerable<ISourceProvider> SourceProviders
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Playlists - MelodyBridge</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Playlists</h1>
        <div class="btn-group">
            <button class="btn btn-outline-secondary" @onclick="ExportAllPlaylists">
                <i class="bi bi-download"></i> Export All
            </button>
            <label class="btn btn-outline-secondary mb-0">
                <i class="bi bi-upload"></i> Import
                <InputFile OnChange="ImportPlaylists" style="display: none;" accept=".json" />
            </label>
            <button class="btn btn-primary" @onclick="ShowAddPlaylistModal">
                <i class="bi bi-plus-circle"></i> Add Playlist
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(importMessage))
    {
        <div class="alert alert-@(isImportSuccess ? "success" : "danger") alert-dismissible fade show" role="alert">
            @importMessage
            <button type="button" class="btn-close" @onclick="() => importMessage = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (playlists.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No playlists yet. Add your first playlist to get started.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var playlist in playlists)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                        {
                            <img src="@playlist.CoverImageUrl" class="card-img-top" alt="@playlist.Name" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-music-note-list" style="font-size: 4rem; color: white;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@playlist.Name</h5>
                            @if (!string.IsNullOrEmpty(playlist.Description))
                            {
                                <p class="card-text text-muted small">@playlist.Description</p>
                            }
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-music-note"></i> @playlist.TrackCount tracks
                                </small>
                                <span class="badge bg-@GetStatusBadgeClass(playlist.LastSyncStatus)">
                                    @playlist.LastSyncStatus
                                </span>
                            </div>
                            @if (playlist.LastSyncAt.HasValue)
                            {
                                <small class="text-muted d-block mb-2">
                                    Last synced: @playlist.LastSyncAt.Value.ToLocalTime().ToString("g")
                                </small>
                            }
                            @if (playlist.AutoSyncEnabled)
                            {
                                <small class="text-success d-block mb-2">
                                    <i class="bi bi-arrow-repeat"></i> Auto-sync every @playlist.AutoSyncIntervalMinutes min
                                </small>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-top-0">
                            <div class="btn-group w-100" role="group">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewPlaylist(playlist.Id)">
                                    <i class="bi bi-eye"></i> View
                                </button>
                                <button class="btn btn-sm btn-outline-success" @onclick="() => SyncPlaylist(playlist.Id)" disabled="@(syncingPlaylistId == playlist.Id)">
                                    @if (syncingPlaylistId == playlist.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-clockwise"></i>
                                    }
                                    Sync
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditPlaylist(playlist)">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePlaylist(playlist.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showAddModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingPlaylist == null ? "Add Playlist" : "Edit Playlist")</h5>
                    <button type="button" class="btn-close" @onclick="HideAddPlaylistModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Playlist URL</label>
                        <input type="text" class="form-control" @bind="newPlaylistUrl" placeholder="https://open.spotify.com/playlist/..." disabled="@(editingPlaylist != null)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name (optional)</label>
                        <input type="text" class="form-control" @bind="newPlaylistName" placeholder="Auto-detected from URL" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (optional)</label>
                        <textarea class="form-control" @bind="newPlaylistDescription" rows="3"></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" @bind="newPlaylistAutoSync" id="autoSyncCheck">
                        <label class="form-check-label" for="autoSyncCheck">
                            Enable auto-sync
                        </label>
                    </div>
                    @if (newPlaylistAutoSync)
                    {
                        <div class="mb-3">
                            <label class="form-label">Auto-sync interval (minutes)</label>
                            <input type="number" class="form-control" @bind="newPlaylistSyncInterval" min="5" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(addPlaylistError))
                    {
                        <div class="alert alert-danger">@addPlaylistError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideAddPlaylistModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SavePlaylist" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        }
                        @(editingPlaylist == null ? "Add" : "Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PlaylistEntity> playlists = new();
    private bool isLoading = true;
    private bool showAddModal = false;
    private bool isSaving = false;
    private string? syncingPlaylistId = null;
    private string addPlaylistError = string.Empty;
    
    private string newPlaylistUrl = string.Empty;
    private string newPlaylistName = string.Empty;
    private string newPlaylistDescription = string.Empty;
    private bool newPlaylistAutoSync = false;
    private int newPlaylistSyncInterval = 60;
    private PlaylistEntity? editingPlaylist = null;
    private string importMessage = string.Empty;
    private bool isImportSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlaylists();
    }

    private async Task LoadPlaylists()
    {
        isLoading = true;
        playlists = await PlaylistService.GetAllPlaylistsAsync();
        isLoading = false;
    }

    private void ShowAddPlaylistModal()
    {
        showAddModal = true;
        editingPlaylist = null;
        newPlaylistUrl = string.Empty;
        newPlaylistName = string.Empty;
        newPlaylistDescription = string.Empty;
        newPlaylistAutoSync = false;
        newPlaylistSyncInterval = 60;
        addPlaylistError = string.Empty;
    }

    private void HideAddPlaylistModal()
    {
        showAddModal = false;
        editingPlaylist = null;
    }

    private async Task ExportAllPlaylists()
    {
        try
        {
            var json = await PlaylistService.ExportPlaylistsAsync();
            var bytes = System.Text.Encoding.UTF8.GetBytes(json);
            var fileName = $"melodybridge_playlists_{DateTime.Now:yyyyMMdd}.json";
            
            // Trigger download via JS interop
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/json", bytes);
        }
        catch (Exception ex)
        {
            importMessage = $"Export failed: {ex.Message}";
            isImportSuccess = false;
        }
    }

    private async Task ImportPlaylists(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var count = await PlaylistService.ImportPlaylistsAsync(json);
            
            importMessage = $"Successfully imported {count} new playlists.";
            isImportSuccess = true;
            
            await LoadPlaylists();
        }
        catch (Exception ex)
        {
            importMessage = $"Import failed: {ex.Message}";
            isImportSuccess = false;
        }
    }

    private void EditPlaylist(PlaylistEntity playlist)
    {
        editingPlaylist = playlist;
        newPlaylistUrl = playlist.SourceUrl;
        newPlaylistName = playlist.Name;
        newPlaylistDescription = playlist.Description ?? string.Empty;
        newPlaylistAutoSync = playlist.AutoSyncEnabled;
        newPlaylistSyncInterval = playlist.AutoSyncIntervalMinutes ?? 60;
        showAddModal = true;
        addPlaylistError = string.Empty;
    }

    private async Task SavePlaylist()
    {
        if (string.IsNullOrWhiteSpace(newPlaylistUrl))
        {
            addPlaylistError = "Please enter a playlist URL";
            return;
        }

        isSaving = true;
        addPlaylistError = string.Empty;

        try
        {
            if (editingPlaylist != null)
            {
                // Update existing playlist
                editingPlaylist.Name = string.IsNullOrWhiteSpace(newPlaylistName) ? editingPlaylist.Name : newPlaylistName;
                editingPlaylist.Description = newPlaylistDescription;
                editingPlaylist.AutoSyncEnabled = newPlaylistAutoSync;
                editingPlaylist.AutoSyncIntervalMinutes = newPlaylistAutoSync ? newPlaylistSyncInterval : null;
                await PlaylistService.UpdatePlaylistAsync(editingPlaylist);
            }
            else
            {
                // Create new playlist
                var sourceProvider = SourceProviders.FirstOrDefault(p => 
                    newPlaylistUrl.Contains(p.Name, StringComparison.OrdinalIgnoreCase));

                if (sourceProvider == null)
                {
                    addPlaylistError = "Unsupported playlist URL. Currently supported: Spotify, YouTube";
                    return;
                }

                // Fetch playlist metadata
                var sourcePlaylist = await sourceProvider.GetPlaylistAsync(newPlaylistUrl);
                if (sourcePlaylist == null)
                {
                    addPlaylistError = "Failed to fetch playlist. Please check the URL and try again.";
                    return;
                }

                var playlist = new PlaylistEntity
                {
                    Name = string.IsNullOrWhiteSpace(newPlaylistName) ? (sourcePlaylist.Name ?? "Untitled Playlist") : newPlaylistName,
                    Description = string.IsNullOrWhiteSpace(newPlaylistDescription) ? sourcePlaylist.Description : newPlaylistDescription,
                    SourceUrl = newPlaylistUrl,
                    SourcePlatform = sourceProvider.Platform,
                    CoverImageUrl = sourcePlaylist.CoverImageUrl,
                    Owner = sourcePlaylist.Owner,
                    TrackCount = sourcePlaylist.Tracks?.Count ?? 0,
                    Tracks = sourcePlaylist.Tracks?.Select(t => new TrackEntity
                    {
                        Title = t.Title,
                        Artist = t.Artist,
                        Album = null,
                        SourceUrl = null,
                        Platform = sourceProvider.Platform.ToString()
                    }).ToList() ?? new(),
                    AutoSyncEnabled = newPlaylistAutoSync,
                    AutoSyncIntervalMinutes = newPlaylistAutoSync ? newPlaylistSyncInterval : null,
                    LastSyncAt = DateTime.UtcNow,
                    LastSyncStatus = SyncStatus.Completed
                };

                await PlaylistService.CreatePlaylistAsync(playlist);
            }

            await LoadPlaylists();
            HideAddPlaylistModal();
        }
        catch (Exception ex)
        {
            addPlaylistError = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SyncPlaylist(string playlistId)
    {
        syncingPlaylistId = playlistId;
        try
        {
            var playlist = playlists.FirstOrDefault(p => p.Id == playlistId);
            if (playlist == null) return;

            var sourceProvider = SourceProviders.FirstOrDefault(p => p.Platform == playlist.SourcePlatform);
            if (sourceProvider != null)
            {
                await PlaylistService.SyncPlaylistAsync(playlistId, sourceProvider);
                await LoadPlaylists();
            }
        }
        finally
        {
            syncingPlaylistId = null;
        }
    }

    private async Task DeletePlaylist(string playlistId)
    {
        if (confirm($"Are you sure you want to delete this playlist?"))
        {
            await PlaylistService.DeletePlaylistAsync(playlistId);
            await LoadPlaylists();
        }
    }

    private void ViewPlaylist(string playlistId)
    {
        Navigation.NavigateTo($"/playlists/{playlistId}");
    }

    private string GetStatusBadgeClass(SyncStatus status)
    {
        return status switch
        {
            SyncStatus.Completed => "success",
            SyncStatus.Failed => "danger",
            SyncStatus.InProgress => "warning",
            _ => "secondary"
        };
    }

    private bool confirm(string message)
    {
        // In a real app, use JS interop for confirmation
        return true;
    }
}
