@page "/playlists"

@using MelodyBridge.Infrastructure.Accounts
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Data
@using MelodyBridge.Infrastructure.Services
@inject PlaylistStore Store
@inject SettingsStore Settings
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SpotifyAccountProvider SpotifyAccount
@inject SpotifyUnofficialAccountProvider SpotifyWeb
@inject YouTubeAccountProvider YouTubeAccount
@inject Application.Services.DownloadCoordinator Coordinator
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject MediaServerProfileStore ServerProfiles
@implements IDisposable

<PageTitle>Playlists - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Your music</span>
        <div class="title-with-help">
            <h1>Playlists</h1>
            <HelpTip Path="quickstart" Text="Public links need no account. Add one, download it on its page, then publish it with a sync job." />
        </div>
        <p>Save a public Spotify or YouTube playlist here, or import from your account or an export file.</p>
    </div>
    <div class="topbar-actions">
        <div class="view-switch" role="group" aria-label="Playlist layout">
            <button class="view-chip @(playlistsView == "cards" ? "on" : null)" title="Card view"
                    aria-pressed="@(playlistsView == "cards" ? "true" : "false")"
                    @onclick='() => SetPlaylistsView("cards")' >
                <Icon Name="layout-grid" Size="15" /> <span>Cards</span>
            </button>
            <button class="view-chip @(playlistsView == "rows" ? "on" : null)" title="Compact rows"
                    aria-pressed="@(playlistsView == "rows" ? "true" : "false")"
                    @onclick='() => SetPlaylistsView("rows")' >
                <Icon Name="rows" Size="15" /> <span>Rows</span>
            </button>
        </div>
        <button class="btn-modern ghost" @onclick="ShowAccountPanel">Import</button>
        <button class="btn-modern secondary" @onclick="ShowPublishPanelAsync" title="Create sync jobs for these playlists in a few clicks">
            <Icon Name="send" Size="15" /> Publish
        </button>
        <button class="btn-modern primary" @onclick="ShowAddForm">Add playlist</button>
    </div>
</section>

@if (!string.IsNullOrEmpty(message))
{
    <div class="result-box @(messageIsError ? "error" : "ok")">@message</div>
}

@if (!string.IsNullOrEmpty(publishMessage))
{
    <div class="result-box ok">
        @publishMessage
        <a href="/sync-jobs">Open Sync jobs</a> to change schedules, remaps or add more targets.
    </div>
}

@if (loading)
{
    <Skeleton Kind="cards" Rows="6" />
}
else if (playlists.Count == 0)
{
    <EmptyState IconName="list-music" Title="No playlists yet">Paste a public Spotify or YouTube playlist link to save its tracks locally.</EmptyState>
}
else if (playlistsView == "rows")
{
    <section class="entity-rows">
        @foreach (var playlist in playlists)
        {
            var (downloaded, failed, total, sizeBytes) = downloadStats.GetValueOrDefault(playlist.Id, (0, 0, 0, 0));
            var run = Coordinator.RunFor(playlist.Id);
            <div class="entity-row">
                <a class="entity-row-link" href="/playlists/@playlist.Id" title="Open @playlist.Name">
                    <span class="entity-row-cover">
                        @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                        {
                            <img src="@playlist.CoverImageUrl" alt="@playlist.Name" loading="lazy" />
                        }
                        else
                        {
                            <Icon Name="music" Size="18" />
                        }
                    </span>
                    <span class="entity-row-main">
                        <strong>@playlist.Name</strong>
                        <small>
                            @(playlist.IsManualImport ? "Imported" : playlist.SourcePlatform.ToString())
                            · @playlist.TrackCount track@(playlist.TrackCount == 1 ? "" : "s")
                            @if (!string.IsNullOrEmpty(playlist.Owner))
                            {
                                <span> · by @playlist.Owner</span>
                            }
                        </small>
                    </span>
                    <span class="entity-row-state">
                        @if (run is { State: Application.Services.DownloadRunState.Running })
                        {
                            <StatusPill Variant="warn">@run.Percent% downloading</StatusPill>
                        }
                        else if (run is { State: Application.Services.DownloadRunState.Paused })
                        {
                            <StatusPill Variant="warn">paused</StatusPill>
                        }
                        else if (downloaded == total && total > 0)
                        {
                            <StatusPill Variant="ok">complete</StatusPill>
                        }
                        else if (downloaded > 0)
                        {
                            <StatusPill Variant="neutral">@downloaded/@total</StatusPill>
                        }
                        else
                        {
                            <StatusPill Variant="neutral">not downloaded</StatusPill>
                        }
                        @if (playlist.SyncWarning is { Length: > 0 })
                        {
                            <StatusPill Variant="warn" Title="@playlist.SyncWarning">partial</StatusPill>
                        }
                    </span>
                    <span class="entity-row-meta">
                        @if (sizeBytes > 0)
                        {
                            <span>@TrackDisplay.Size(sizeBytes)</span>
                        }
                        <span>@(playlist.LastSyncAt?.ToLocalTime().ToString("d") ?? "never")</span>
                    </span>
                </a>
                <CardMenu Label="Playlist actions">
                    <button class="danger" title="Remove this playlist"
                            @onclick="() => AskDelete(playlist)"><Icon Name="trash" Size="14" /> Remove</button>
                </CardMenu>
            </div>
        }
    </section>
}
else
{
    <section class="content-grid three">
        @foreach (var playlist in playlists)
        {
            var (downloaded, failed, total, sizeBytes) = downloadStats.GetValueOrDefault(playlist.Id, (0, 0, 0, 0));
            var run = Coordinator.RunFor(playlist.Id);
            <div class="panel-card playlist-card">
                <a class="playlist-cover" href="/playlists/@playlist.Id" title="Open @playlist.Name">
                    @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                    {
                        <img src="@playlist.CoverImageUrl" alt="@playlist.Name" loading="lazy" />
                    }
                    else
                    {
                        <span class="playlist-cover-placeholder"><Icon Name="music" Size="28" Class="cover-placeholder-icon" /></span>
                    }
                    @if (run is { State: Application.Services.DownloadRunState.Running })
                    {
                        <span class="cover-badge downloading" title="Downloading: @run.Done of @run.Total done">@run.Percent% downloading</span>
                    }
                    else if (run is { State: Application.Services.DownloadRunState.Paused })
                    {
                        <span class="cover-badge paused" title="Download paused">paused</span>
                    }
                    else if (downloaded == total && total > 0)
                    {
                        <span class="cover-badge complete" title="All tracks downloaded"><Icon Name="check-circle" Size="12" /> complete</span>
                    }
                    else if (downloaded > 0)
                    {
                        <span class="cover-badge partial" title="@downloaded of @total downloaded">@downloaded/@total</span>
                    }
                </a>
                <div class="panel-header">
                    <div>
                        <span class="eyebrow">@(playlist.IsManualImport ? "Imported" : playlist.SourcePlatform.ToString())</span>
                        <h2><a href="/playlists/@playlist.Id">@playlist.Name</a></h2>
                    </div>
                    <CardMenu Label="Playlist actions">
                        <button class="danger" title="Remove this playlist"
                                @onclick="() => AskDelete(playlist)"><Icon Name="trash" Size="14" /> Remove</button>
                    </CardMenu>
                </div>
                <div class="card-tags">
                    <span class="quality-badge">@playlist.TrackCount track@(playlist.TrackCount == 1 ? "" : "s")</span>
                    @if (!string.IsNullOrEmpty(playlist.Owner))
                    {
                        <span class="quality-badge">by @playlist.Owner</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(playlist.PreferredFormat) && playlist.PreferredFormat != "auto")
                    {
                        <span class="quality-badge">@QualityLabel(playlist.PreferredFormat)</span>
                    }
                    @if (sizeBytes > 0)
                    {
                        <span class="quality-badge">@TrackDisplay.Size(sizeBytes) on disk</span>
                    }
                </div>
                <small class="job-meta">
                    @(playlist.IsManualImport ? "Imported" : "Last synced"): @(playlist.LastSyncAt?.ToLocalTime().ToString("g") ?? "never")
                    @if (!playlist.IsManualImport)
                    {
                        <span> · @ScheduleOf(playlist).Describe()</span>
                    }
                    @if (playlist.SyncWarning is { Length: > 0 })
                    {
                        <span class="sync-warn" title="@playlist.SyncWarning"> · partial sync</span>
                    }
                </small>
            </div>
        }
    </section>
}

@if (showAddForm)
{
    <div class="wizard-overlay" @onclick="CloseAddForm">
        <div class="wizard-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">New source</span>
                    <h2>Add playlist</h2>
                </div>
                <button class="icon-button" @onclick="HideAddForm"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                <div class="hint-box">
                    Public Spotify and YouTube playlists, no account needed.
                    Quality defaults to <strong>@savedDefaultQualityLabel</strong>: change the default in Settings.
                </div>
                <div class="form-grid sync-split">
                    <label class="wide">
                        Playlist link
                        <input @bind="newUrl" placeholder="https://open.spotify.com/playlist/… or youtube.com/playlist?list=…" />
                    </label>
                    <label class="wide">
                        Download folder (optional)
                        <input @bind="newTargetDirectory" placeholder="@resolvedDefaultMusicPath" />
                        <small class="text-muted">@newFolderHint</small>
                    </label>
                    <div class="quality-field wide">
                        <QualityPicker @bind-Value="newQuality" />
                    </div>
                    <div class="toggle-with-help wide">
                        <label class="toggle-switch wide">
                            <input type="checkbox" @bind="newStrictQuality" />
                            <span class="toggle-slider"></span>
                            <span>Strict quality</span>
                        </label>
                        <HelpTip Path="concepts#strict-quality" Text="On: only the exact quality above is accepted; a track no source can deliver fails with the reason. Off: the download steps down to the best lower quality the enabled plugins declare, until one delivers." />
                    </div>
                    @if (!newStrictQuality)
                    {
                        <div class="toggle-with-help wide">
                            <label class="toggle-switch wide">
                                <input type="checkbox" @bind="newAllowContainerChange" />
                                <span class="toggle-slider"></span>
                                <span>Allow container changes while stepping down</span>
                            </label>
                            <HelpTip Path="concepts#strict-quality" Text="Off: a fallback stays in the chosen container, so an FLAC request fails when no lossless source exists. On: it may land on the best lossy file." />
                        </div>
                    }
                    <SchedulePicker Label="Auto-sync schedule" @bind-Value="newSchedule" />
                    <label>
                        Sync mode
                        <select @bind="newSyncMode">
                            <option value="@PlaylistSyncMode.Additive">Additive: keep removed tracks as history</option>
                            <option value="@PlaylistSyncMode.Mirror">Mirror: remove tracks deleted from source</option>
                        </select>
                    </label>
                </div>
            </div>
            <div class="wizard-footer">
                @if (!string.IsNullOrEmpty(addError))
                {
                    @* Full-width first row of the footer: the error must be
                       visible where the button that caused it lives. *@
                    <div class="wizard-error result-box error">@addError</div>
                }
                <button class="btn-modern secondary" @onclick="HideAddForm">Cancel</button>
                <span></span>
                <button class="btn-modern primary" @onclick="Add" disabled="@busy">@(busy ? "Fetching…" : "Fetch & save")</button>
            </div>
        </div>
    </div>
}

@if (showAccountPanel)
{
    <div class="wizard-overlay" @onclick="CloseAccountPanel">
        <div class="wizard-modal wide" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">Import</span>
                    <div class="title-with-help">
                        <h2>Import your music</h2>
                        <HelpTip Path="accounts" Text="Account imports through your own Spotify app need Premium. Without it, use the unofficial web session or import a file." />
                    </div>
                </div>
                <button class="icon-button" @onclick="HideAccountPanel"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                <TabStrip Tabs="ImportTabs" ActiveId="@importTab"
                           OnSelect="id => importTab = id" AriaLabel="Where the music comes from" />

                @if (importTab == "accounts")
                {
                    <div class="account-grid">
                        @foreach (var entry in accountPanels)
                        {
                            <div class="account-card">
                                <div class="account-head">
                                    <strong>@entry.Name</strong>
                                    @if (entry.Unofficial)
                                    {
                                        <StatusPill Variant="warn">unofficial</StatusPill>
                                    }
                                    <StatusPill Variant="@(entry.Connected ? "ok" : "neutral")">
                                        @(entry.Connected ? "connected" : "not connected")
                                    </StatusPill>
                                </div>
                                @if (entry.Connected)
                                {
                                    <div class="flex-actions">
                                        <button class="btn-modern secondary" @onclick="() => ImportLiked(entry.Name)" disabled="@busy">
                                            @(LikedAlreadySaved(entry.Name) ? "Update liked songs" : "Import liked songs")
                                        </button>
                                        <button class="btn-modern secondary" @onclick="() => LoadAccountPlaylists(entry.Name)" disabled="@busy">
                                            Show my playlists
                                        </button>
                                    </div>
                                    @if (entry.Unofficial)
                                    {
                                        <p class="account-note">
                                            Runs on your Spotify web session, not the official API.
                                            It can break when Spotify changes things, and the cookie is
                                            a live credential of your account: a burner account is safest.
                                        </p>
                                    }
                                }
                                else if (entry.Unofficial)
                                {
                                    <p class="account-note">
                                        Not connected. <a href="/settings#accounts">Paste your Spotify
                                        session cookie in Settings</a> to import without a Premium
                                        developer app.
                                    </p>
                                }
                                else
                                {
                                    <p class="account-note">
                                        Not connected. <a href="/settings#accounts">Connect it in Settings</a>
                                        to import your private playlists and liked songs.
                                    </p>
                                }
                            </div>
                        }
                    </div>
                    <p class="account-note">
                        Account imports use Spotify's official API and need
                        <strong>Spotify Premium</strong>: Spotify requires it from the owner of
                        the developer app. The <em>unofficial</em> card runs on your own web
                        session instead, which works on a free account. The <em>Files</em> tab
                        needs neither.
                    </p>

                    @if (accountPlaylists is not null)
                    {
                        <div class="table-wrap">
                            <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>Playlist</th>
                                        <th>Owner</th>
                                        <th>Tracks</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pl in accountPlaylists)
                                    {
                                        var saved = savedAccountIds.Contains(pl.Id);
                                        <tr>
                                            <td><strong>@pl.Name</strong></td>
                                            <td class="text-muted">@(pl.Owner ?? "-")</td>
                                            <td class="text-muted">@pl.TrackCount</td>
                                            <td>
                                                @if (saved)
                                                {
                                                    <StatusPill Variant="ok" Title="Already saved locally; importing again updates it">saved</StatusPill>
                                                }
                                                else
                                                {
                                                    <StatusPill Variant="neutral">new</StatusPill>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn-modern secondary" @onclick="() => ImportAccountPlaylist(pl)" disabled="@busy">
                                                    @(busy && importingId == pl.Id
                                                        ? "Importing…"
                                                        : saved ? "Update" : "Import")
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (accountError is not null)
                    {
                        <div class="result-box error">@accountError</div>
                    }
                }
                else
                {
                    <div class="import-options">
                        <div class="import-option">
                            <div class="import-option-main">
                                <strong>Exportify CSV</strong>
                                <StatusPill Variant="ok">recommended</StatusPill>
                                <p>
                                    Liked songs or any playlist, exported at
                                    <a href="https://exportify.net" target="_blank" rel="noopener">exportify.net</a>.
                                    Log in there and click <em>Export Liked Songs</em> (or a playlist).
                                    The <em>Export All</em> zip works too.
                                </p>
                            </div>
                            <div class="import-option-action">
                                @if (busy && uploadingRoute == "exportify")
                                {
                                    <StatusPill Variant="warn">reading file…</StatusPill>
                                }
                                else
                                {
                                    <InputFile OnChange="ImportExportifyFile" accept=".csv,.zip,text/csv,application/zip" class="btn-modern secondary" disabled="@busy" />
                                }
                            </div>
                        </div>
                        <div class="import-option">
                            <div class="import-option-main">
                                <strong>Spotify data export</strong>
                                <StatusPill Variant="neutral">manual</StatusPill>
                                <p>
                                    Request <em>Download your data</em> at
                                    <a href="https://www.spotify.com/account/privacy" target="_blank" rel="noopener">spotify.com/account/privacy</a>.
                                    Spotify emails the package within a few days. It holds
                                    <code>YourLibrary.json</code> and <code>Playlist1.json</code>; upload the zip as it comes.
                                </p>
                            </div>
                            <div class="import-option-action">
                                @if (busy && uploadingRoute == "takeout")
                                {
                                    <StatusPill Variant="warn">reading file…</StatusPill>
                                }
                                else
                                {
                                    <InputFile OnChange="ImportTakeoutFile" accept=".json,.zip,application/json,application/zip" class="btn-modern secondary" disabled="@busy" />
                                }
                            </div>
                        </div>
                    </div>
                    <div class="hint-box">
                        Upload the CSV, the JSON or the whole zip: archives are read entry by entry.
                        Uploaded files are read once; re-uploading the same file updates instead of duplicating.
                    </div>
                    @if (fileImportError is not null)
                    {
                        <div class="result-box error">@fileImportError</div>
                    }
                }
            </div>
        </div>
    </div>
}

@if (showPublishPanel)
{
    <div class="wizard-overlay" @onclick="ClosePublishPanel">
        <div class="wizard-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">Quick publish</span>
                    <h2>Send playlists to your servers</h2>
                    <p class="text-muted">
                        The quick path: each playlist gets its own sync job with the same
                        name, publishing to the servers you tick. Need schedules, path
                        remaps, an M3U file or different targets per playlist? Do it on
                        the Sync jobs page.
                    </p>
                </div>
                <button class="icon-button" title="Close" @onclick="ClosePublishPanel"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                @if (publishProfiles.Count == 0)
                {
                    <div class="hint-box">
                        No media server profiles yet. Create one under
                        <a href="/settings#media-servers">Settings, Media servers</a>, then come back.
                    </div>
                }
                else if (publishablePlaylists.Count == 0)
                {
                    <div class="hint-box">
                        Every playlist already has a sync job. Manage them on the
                        <a href="/sync-jobs">Sync jobs</a> page.
                    </div>
                }
                else
                {
                    <h3>Playlists</h3>
                    <div class="publish-list">
                        @foreach (var playlist in publishablePlaylists)
                        {
                            var on = publishPlaylistIds.Contains(playlist.Id);
                            <label class="publish-option @(on ? "on" : null)">
                                <input type="checkbox" checked="@on"
                                       @onchange="e => TogglePublishPlaylist(playlist.Id, e)" />
                                <span class="publish-option-body">
                                    <strong>@playlist.Name</strong>
                                    <small>
                                        @(playlist.IsManualImport ? "Imported" : playlist.SourcePlatform.ToString())
                                        · @playlist.TrackCount track@(playlist.TrackCount == 1 ? "" : "s")
                                        @if (!string.IsNullOrEmpty(playlist.Owner))
                                        {
                                            <span> · by @playlist.Owner</span>
                                        }
                                    </small>
                                </span>
                            </label>
                        }
                    </div>
                    @if (alreadyPublishedCount > 0)
                    {
                        <p class="publish-option-note">
                            @alreadyPublishedCount playlist@(alreadyPublishedCount == 1 ? "" : "s")
                            already has a sync job and @(alreadyPublishedCount == 1 ? "is" : "are") not listed again.
                        </p>
                    }
                    <h3>Send to</h3>
                    <div class="publish-list">
                        @foreach (var profile in publishProfiles)
                        {
                            var on = publishProfileIds.Contains(profile.Id);
                            <label class="publish-option @(on ? "on" : null)">
                                <input type="checkbox" checked="@on"
                                       @onchange="e => TogglePublishProfile(profile.Id, e)" />
                                <span class="publish-option-body">
                                    <strong>@profile.Name</strong>
                                    <small>@profile.Kind <span class="text-muted">@profile.BaseUrl</span></small>
                                </span>
                            </label>
                        }
                    </div>
                }
            </div>
            <div class="wizard-footer">
                <button class="btn-modern ghost" @onclick="ClosePublishPanel">Cancel</button>
                <span></span>
                <button class="btn-modern primary" @onclick="CreatePublishJobs"
                        disabled="@(publishing || !CanPublish)">
                    @(publishing ? "Creating…" : PublishButtonLabel)
                </button>
            </div>
        </div>
    </div>
}

@if (confirmDeleteId is { } id)
{
    <ConfirmDialog Show="true"
                   Eyebrow="Remove playlist"
                   Title=@($"Remove '{confirmDeleteName}'?")
                   Message="The playlist and its track list leave MelodyBridge. Your account and other playlists are not touched."
                   ConfirmLabel="Remove playlist"
                   Busy="busy"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CancelDelete">
        @if (deleteFileCount > 0)
        {
            <label class="toggle-switch wide">
                <input type="checkbox" @bind="deleteFilesWithPlaylist" />
                <span class="toggle-slider"></span>
                <span>Delete the downloaded music files too, archive copies included (@deleteFileCount @(deleteFileCount == 1 ? "file" : "files"), @(TrackDisplay.Size(deleteFileSizeBytes)))</span>
            </label>
        }
    </ConfirmDialog>
}

@code {
    private List<PlaylistEntity> playlists = new();
    private Dictionary<string, (int downloaded, int failed, int total, long sizeBytes)> downloadStats = new();
    private bool loading = true;
    private bool busy;
    private bool showAddForm;
    private bool showAccountPanel;

    private string newUrl = string.Empty;
    private string newTargetDirectory = string.Empty;
    /// <summary>Card grid or compact rows, kept in settings across visits.</summary>
    private string playlistsView = "cards";
    /// <summary>One folder per playlist under the music path (default on).</summary>
    private bool playlistFolders = true;
    private string resolvedDefaultMusicPath = "/music";
    private string newQuality = "auto";
    private ScanSchedule newSchedule = ScanSchedule.Manual;
    private PlaylistSyncMode newSyncMode = PlaylistSyncMode.Additive;
    private bool newStrictQuality = true;
    private bool newAllowContainerChange = true;

    private string message = string.Empty;
    private bool messageIsError;
    private string addError = string.Empty;

    private List<UserPlaylist>? accountPlaylists;
    private string accountListProvider = string.Empty;
    private string? importingId;
    private string? accountError;
    private string? fileImportError;

    /// <summary>The import modal's two halves: connected accounts, or files.</summary>
    private static readonly TabStrip.Tab[] ImportTabs =
    [
        new("accounts", "Accounts"),
        new("files", "Files"),
    ];
    private string importTab = "accounts";
    private List<(string Name, bool Connected, bool Unofficial)> accountPanels = new();
    private HashSet<string> savedAccountIds = new();
    private HashSet<string> savedSpotifyIds = new();
    private HashSet<string> savedYouTubeIds = new();

    private Timer? refreshTimer;

    // Quick publish: one sync job per ticked playlist, named after it,
    // targeting the ticked media server profiles. Playlists that already
    // have a job are hidden, so nothing is duplicated.
    private bool showPublishPanel;
    private bool publishing;
    private string publishMessage = string.Empty;
    private List<MediaServerProfile> publishProfiles = new();
    private readonly HashSet<string> publishPlaylistIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> publishProfileIds = new(StringComparer.Ordinal);
    private HashSet<string> jobPlaylistIds = new(StringComparer.Ordinal);

    private List<PlaylistEntity> publishablePlaylists
        => playlists.Where(p => !jobPlaylistIds.Contains(p.Id)).ToList();

    private int alreadyPublishedCount => playlists.Count - publishablePlaylists.Count;

    private bool CanPublish => publishPlaylistIds.Count > 0 && publishProfileIds.Count > 0;

    private string PublishButtonLabel => publishPlaylistIds.Count switch
    {
        0 => "Create sync jobs",
        1 => "Create 1 sync job",
        var n => $"Create {n} sync jobs",
    };

    private async Task ShowPublishPanelAsync()
    {
        publishMessage = string.Empty;
        publishPlaylistIds.Clear();
        publishProfileIds.Clear();
        publishing = false;
        publishProfiles = (await ServerProfiles.GetAllAsync()).ToList();
        jobPlaylistIds = await QuickSyncJobs.PlaylistsWithJobAsync(DbFactory);
        showPublishPanel = true;
    }

    private void ClosePublishPanel() => showPublishPanel = false;

    private void TogglePublishPlaylist(string playlistId, ChangeEventArgs e)
    {
        if (e.Value is true) publishPlaylistIds.Add(playlistId);
        else publishPlaylistIds.Remove(playlistId);
    }

    private void TogglePublishProfile(string profileId, ChangeEventArgs e)
    {
        if (e.Value is true) publishProfileIds.Add(profileId);
        else publishProfileIds.Remove(profileId);
    }

    private async Task CreatePublishJobs()
    {
        if (!CanPublish) return;
        publishing = true;
        try
        {
            var selected = playlists
                .Where(p => publishPlaylistIds.Contains(p.Id))
                .Select(p => (p.Id, p.Name))
                .ToList();
            var profiles = publishProfiles
                .Where(p => publishProfileIds.Contains(p.Id))
                .ToList();
            var created = await QuickSyncJobs.CreateAsync(DbFactory, selected, profiles);
            publishMessage = created.Count switch
            {
                0 => "Nothing to create: those playlists already have sync jobs.",
                1 => $"Created the sync job '{created[0].Name}'.",
                _ => $"Created {created.Count} sync jobs, one per playlist.",
            };
            showPublishPanel = false;
            jobPlaylistIds = await QuickSyncJobs.PlaylistsWithJobAsync(DbFactory);
        }
        finally
        {
            publishing = false;
        }
    }

    // Delete flow: the card asks, the dialog confirms.
    private string? confirmDeleteId;
    private string confirmDeleteName = string.Empty;
    private bool deleteFilesWithPlaylist;
    private int deleteFileCount;
    private long deleteFileSizeBytes;

    /// <summary>Offered as a card action: remove the list, files optional.
    /// The dialog counts the existing primary and archive files.</summary>
    private async Task AskDelete(PlaylistEntity playlist)
    {
        confirmDeleteId = playlist.Id;
        confirmDeleteName = playlist.Name;
        deleteFilesWithPlaylist = false;
        var impact = await Store.GetDeleteImpactAsync(playlist.Id);
        deleteFileCount = impact.Files;
        deleteFileSizeBytes = impact.Bytes;
    }

    private void CancelDelete()
    {
        confirmDeleteId = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (confirmDeleteId is not { } id) return;
        busy = true;
        try
        {
            await Store.DeleteAsync(id, deleteFilesWithPlaylist);
            message = deleteFilesWithPlaylist
                ? $"Removed '{confirmDeleteName}' and its files."
                : $"Removed '{confirmDeleteName}'. The music files stay on disk.";
            messageIsError = false;
            confirmDeleteId = null;
            await Load();
        }
        finally { busy = false; }
    }

    /// <summary>Quality presets shared with the settings page: one list, one truth.</summary>
    private static string QualityLabel(string preferredFormat) => QualityPresets.LabelFor(preferredFormat);

    /// <summary>The default from Settings, fixed once at load: the hint
    /// must not rewrite itself while the user changes the picker.</summary>
    private string savedDefaultQualityLabel = "auto";

    /// <summary>
    /// The import dialog's order: the account's own playlists first, then
    /// alphabetical. Public for the ordering test.
    /// </summary>
    public static IEnumerable<UserPlaylist> OrderImportList(IEnumerable<UserPlaylist> playlists)
        => playlists
            .OrderByDescending(p => p.IsOwned)
            .ThenBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase);

    /// <summary>What an empty download folder resolves to for a new playlist.</summary>
    private string newFolderHint => playlistFolders
        ? $"Leave empty to use the default music path; this playlist gets its own folder there ({resolvedDefaultMusicPath}/playlist name)."
        : $"Leave empty to drop the files directly in the default music path ({resolvedDefaultMusicPath}).";

    private async Task SetPlaylistsView(string view)
    {
        if (playlistsView == view) return;
        playlistsView = view;
        await Settings.SetAsync("playlists_view", view);
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
        await LoadDefaultQualityAsync();
        resolvedDefaultMusicPath = await Settings.GetAsync("music_path", "/music");
        playlistFolders = await Settings.GetBoolAsync("playlist_folders", true);
        playlistsView = await Settings.GetAsync("playlists_view", "cards");
        if (playlistsView is not ("cards" or "rows")) playlistsView = "cards";
        // Live badge refresh while any run is active.
        refreshTimer = new Timer(_ => InvokeAsync(async () =>
        {
            downloadStats = await Store.GetDownloadStatsAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task LoadDefaultQualityAsync()
    {
        var raw = await Settings.GetAsync("default_quality", "auto");
        if (PlaylistStore.IsValidFormat(raw))
        {
            newQuality = raw;
            savedDefaultQualityLabel = QualityLabel(raw);
        }
    }

    private async Task Load()
    {
        loading = true;
        playlists = await Store.GetAllAsync();
        downloadStats = await Store.GetDownloadStatsAsync();
        loading = false;
    }

    private void ShowAddForm()
    {
        newUrl = string.Empty;
        newTargetDirectory = string.Empty;
        newSchedule = ScanSchedule.Manual;
        newSyncMode = PlaylistSyncMode.Additive;
        newStrictQuality = true;
        newAllowContainerChange = true;
        addError = string.Empty;
        showAddForm = true;
    }

    private void HideAddForm() => showAddForm = false;

    private void CloseAddForm(EventArgs e) => showAddForm = false;

    private void ShowAccountPanel()
    {
        showAccountPanel = true;
        accountError = null;
        accountPlaylists = null;
        importTab = "accounts";
        _ = LoadAccountStatusAsync();
    }

    private void HideAccountPanel() => showAccountPanel = false;

    private void CloseAccountPanel(EventArgs e) => showAccountPanel = false;

    private async Task LoadAccountStatusAsync()
    {
        accountPanels = new List<(string, bool, bool)>
        {
            (SpotifyAccountProvider.ProviderName, await SpotifyAccount.IsConnectedAsync(), false),
            (SpotifyUnofficialAccountProvider.ProviderName, await SpotifyWeb.IsConnectedAsync(), true),
            (YouTubeAccountProvider.ProviderName, await YouTubeAccount.IsConnectedAsync(), false),
        };
        // One lookup per platform: liked songs are saved under their own
        // external id ("spotify-liked", "LL"), so the import button can
        // say Update instead of Import when they are already here.
        savedSpotifyIds = await Store.GetSavedExternalIdsAsync(Platform.Spotify);
        savedYouTubeIds = await Store.GetSavedExternalIdsAsync(Platform.YouTubeMusic);
        StateHasChanged();
    }

    private async Task LoadAccountPlaylists(string providerName)
    {
        busy = true;
        accountError = null;
        try
        {
            var account = providerName switch
            {
                SpotifyAccountProvider.ProviderName => (IAccountSourceProvider)SpotifyAccount,
                SpotifyUnofficialAccountProvider.ProviderName => SpotifyWeb,
                _ => YouTubeAccount,
            };
            accountPlaylists = OrderImportList(await account.GetUserPlaylistsAsync()).ToList();
            accountListProvider = providerName;
            // Already-saved playlists get their pill and an Update label;
            // the same platform + external id pair a re-import updates.
            savedAccountIds = await Store.GetSavedExternalIdsAsync(
                providerName == YouTubeAccountProvider.ProviderName
                    ? Platform.YouTubeMusic
                    : Platform.Spotify);
        }
        catch (Exception ex)
        {
            accountError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task ImportLiked(string providerName)
    {
        busy = true;
        accountError = null;
        try
        {
            var added = await Store.AddOrRefreshLikedAsync(providerName, TargetOrNull());
            Navigation.NavigateTo($"/playlists/{added.Id}");
        }
        catch (Exception ex)
        {
            accountError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task ImportAccountPlaylist(UserPlaylist playlist)
    {
        busy = true;
        importingId = playlist.Id;
        accountError = null;
        try
        {
            // Both Spotify connections can import through the plain add
            // flow: the store prefers the account when one is connected,
            // and private playlists then work too.
            var url = accountListProvider == YouTubeAccountProvider.ProviderName
                ? $"https://www.youtube.com/playlist?list={playlist.Id}"
                : $"https://open.spotify.com/playlist/{playlist.Id}";
            var (added, newlySaved) = await Store.AddOrRefreshDetailedAsync(url, TargetOrNull());
            message = newlySaved
                ? $"Saved '{added.Name}' with {added.TrackCount} tracks."
                : $"'{added.Name}' was already saved; updated it ({added.TrackCount} tracks).";
            Navigation.NavigateTo($"/playlists/{added.Id}");
        }
        catch (Exception ex)
        {
            accountError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private string? TargetOrNull()
        => string.IsNullOrWhiteSpace(newTargetDirectory) ? null : newTargetDirectory;

    /// <summary>Liked songs are saved under their own external id per provider.</summary>
    private bool LikedAlreadySaved(string providerName)
        => providerName switch
        {
            SpotifyAccountProvider.ProviderName => savedSpotifyIds.Contains("spotify-liked"),
            SpotifyUnofficialAccountProvider.ProviderName =>
                savedSpotifyIds.Contains(SpotifyUnofficialAccountProvider.LikedId),
            _ => savedYouTubeIds.Contains("LL"),
        };

    /// <summary>The playlist's schedule, legacy rows included (interval kept working).</summary>
    private static ScanSchedule ScheduleOf(PlaylistEntity playlist)
        => playlist.ScheduleCron is { Length: > 0 }
            ? ScanSchedule.Parse(playlist.ScheduleCron)
            : playlist.AutoSyncEnabled
                ? ScanSchedule.FromInterval(playlist.AutoSyncIntervalMinutes ?? 60)
                : ScanSchedule.Manual;

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(newUrl))
        {
            addError = "Paste a playlist URL first.";
            return;
        }
        busy = true;
        addError = string.Empty;
        try
        {
            var target = TargetOrNull();
            var (playlist, newlySaved) = await Store.AddOrRefreshDetailedAsync(newUrl.Trim(), target);
            await Store.UpdateScheduleAsync(playlist.Id, null, newSchedule, target, newSyncMode, newQuality,
                strictQuality: newStrictQuality, allowContainerChange: newAllowContainerChange);
            showAddForm = false;
            message = newlySaved
                ? $"Saved '{playlist.Name}' with {playlist.TrackCount} tracks."
                : $"'{playlist.Name}' was already saved; updated it ({playlist.TrackCount} tracks).";
            messageIsError = false;
            await Load();
        }
        catch (Exception ex)
        {
            addError = ex.Message;
        }
        finally { busy = false; }
    }

    /// <summary>
    /// Shared path for both file imports (Exportify CSV, Spotify data
    /// export): read the upload, parse it, persist through the store.
    /// The parser decides the flavor; the message names it.
    /// </summary>
    private async Task ImportUploadedFile(InputFileChangeEventArgs e)
    {
        fileImportError = null;
        busy = true;
        try
        {
            ParsedUpload upload;
            using (var stream = e.File.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024))
                upload = await PlaylistFileImporter.ParseStreamAsync(e.File.Name, stream);

            if (upload.Files.Count == 0)
                throw new InvalidOperationException(
                    "Could not read that file. Expected an Exportify CSV, a Spotify data export (YourLibrary.json / Playlist1.json), or a zip of either.");

            var (playlists, tracks) = await Store.ImportFilesAsync(upload.Files, TargetOrNull());
            message = playlists > 0
                ? $"Imported {playlists} {(playlists == 1 ? "playlist" : "playlists")}, {tracks} {(tracks == 1 ? "track" : "tracks")}."
                : "Nothing new to import.";
            if (upload.Warning is { Length: > 0 }) message = $"{message} {upload.Warning}";
            messageIsError = false;
            HideAccountPanel();
            await Load();
        }
        catch (Exception ex)
        {
            fileImportError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    // Which upload card is working, so its file input turns into feedback.
    private string? uploadingRoute;

    private Task ImportExportifyFile(InputFileChangeEventArgs e)
    {
        uploadingRoute = "exportify";
        return ImportUploadedFile(e).ContinueWith(_ => uploadingRoute = null);
    }

    private Task ImportTakeoutFile(InputFileChangeEventArgs e)
    {
        uploadingRoute = "takeout";
        return ImportUploadedFile(e).ContinueWith(_ => uploadingRoute = null);
    }

    public void Dispose() => refreshTimer?.Dispose();
}
