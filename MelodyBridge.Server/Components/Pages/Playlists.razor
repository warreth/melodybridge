                <button class="icon-button" title="Close" @onclick="ClosePublishPanel"><Icon Name="x" Size="18" /></button>
            </div>
            <div class="wizard-body">
                @if (!string.IsNullOrEmpty(publishError))
                {
                    <div class="result-box error">@publishError</div>
                }
                @if (playlists.Count == 0)
                {
                    <div class="hint-box">
                        No playlists saved yet. Add one first, then come back to publish it.
                    </div>
                }
                else if (publishablePlaylists.Count == 0)
                {
                    <div class="hint-box">
                        Every playlist already has a sync job. Manage them on the
                        <a href="/sync-jobs">Sync jobs</a> page.
                    </div>
                }
                else
                {
                    <div class="section-title-row">
                        <h3>Playlists</h3>
                        <button class="link-button" @onclick="ToggleAllPublishPlaylists">
                            @(AllPublishPlaylistsSelected ? "Clear" : "Select all")
                        </button>
                    </div>
                    <div class="publish-list">
                        @foreach (var playlist in publishablePlaylists)
                        {
                            var on = publishPlaylistIds.Contains(playlist.Id);
                            <label class="publish-option @(on ? "on" : null)">
                                <input type="checkbox" checked="@on"
                                       @onchange="e => TogglePublishPlaylist(playlist.Id, e)" />
                                <span class="publish-option-body">
                                    <strong>@playlist.Name</strong>
                                    <small>
                                        @(playlist.IsManualImport ? "Imported" : playlist.SourcePlatform.ToString())
                                        · @playlist.TrackCount track@(playlist.TrackCount == 1 ? "" : "s")
                                        @if (!string.IsNullOrEmpty(playlist.Owner))
                                        {
                                            <span> · by @playlist.Owner</span>
                                        }
                                    </small>
                                </span>
                            </label>
                        }
                    </div>
                    @if (alreadyPublishedCount > 0)
                    {
                        <p class="publish-option-note">
                            @alreadyPublishedCount playlist@(alreadyPublishedCount == 1 ? "" : "s")
                            already @(alreadyPublishedCount == 1 ? "has" : "have") a sync job and
                            @(alreadyPublishedCount == 1 ? "is" : "are") not listed again.
                        </p>
                    }
                    @if (publishProfiles.Count == 0)
                    {
                        <div class="hint-box">
                            No media server profiles yet. Create one under
                            <a href="/settings#media-servers">Settings, Media servers</a>,
                            or tick M3U file below to publish to disk only.
                        </div>
                    }
                    <div class="section-title-row">
                        <h3>Send to</h3>
                        <a class="link-button" href="/settings#media-servers">
                            <Icon Name="plus" Size="13" /> Add profile
                        </a>
                    </div>
                    <div class="publish-list">
                        <label class="publish-option @(publishM3uEnabled ? "on" : null)">
                            <input type="checkbox" checked="@publishM3uEnabled"
                                   @onchange="e => publishM3uEnabled = e.Value is true" />
                            <span class="publish-option-body">
                                <strong><Icon Name="list-music" Size="15" /> M3U file</strong>
                                <small>
                                    @if (string.IsNullOrWhiteSpace(publishM3uFolder))
                                    {
                                        <span class="sync-warn">Set the Playlist output folder in Settings first.</span>
                                    }
                                    else
                                    {
                                        <span>
                                            One .m3u per playlist in <span class="text-muted">@publishM3uFolder</span>.
                                            Names that collide get a numbered suffix.
                                        </span>
                                    }
                                </small>
                            </span>
                        </label>
                        @foreach (var profile in publishProfiles)
                        {
                            var on = publishProfileIds.Contains(profile.Id);
                            <label class="publish-option @(on ? "on" : null)">
                                <input type="checkbox" checked="@on"
                                       @onchange="e => TogglePublishProfile(profile.Id, e)" />
                                <span class="publish-option-body">
                                    <strong>@profile.Name</strong>
                                    <small>@profile.Kind <span class="text-muted">@profile.BaseUrl</span></small>
                                </span>
                            </label>
                        }
                    </div>
                    <div class="publish-schedule">
                        <SchedulePicker Label="Schedule for every job" @bind-Value="publishSchedule"
                                        LiveValidation="true"
                                        ValidityChanged="valid => publishScheduleValid = valid" />
                        @if (!publishScheduleValid)
                        {
                            <p class="publish-option-note sync-warn">
                                Enter a valid five-field cron expression before creating jobs.
                            </p>
                        }
                        <p class="publish-option-note">
                            Applies to every job created here. Change one later on the
                            <a href="/sync-jobs">Sync jobs</a> page.
                        </p>
                    </div>
                }
            </div>
            <div class="wizard-footer">
                <div class="flex-actions">
                    <button class="btn-modern ghost" @onclick="ClosePublishPanel">Cancel</button>
                </div>
                <div class="wizard-actions">
                    <button class="btn-modern primary" @onclick="CreatePublishJobs"
                            disabled="@(publishing || !CanPublish)">
                        @(publishing ? "Creating…" : PublishButtonLabel)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (confirmDeleteId is { } id)
