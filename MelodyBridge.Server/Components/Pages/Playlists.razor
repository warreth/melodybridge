@page "/playlists"

@using MelodyBridge.Infrastructure.Accounts
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Data
@using MelodyBridge.Infrastructure.Services
@inject PlaylistStore Store
@inject SettingsStore Settings
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SpotifyAccountProvider SpotifyAccount
@inject YouTubeAccountProvider YouTubeAccount
@inject Application.Services.DownloadCoordinator Coordinator
@implements IDisposable

<PageTitle>Playlists - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Your music</span>
        <h1>Playlists</h1>
        <p>Save a public Spotify or YouTube playlist here, or import from your account or an export file.</p>
    </div>
    <div class="topbar-actions">
        <button class="btn-modern ghost" @onclick="ShowAccountPanel">Import</button>
        <button class="btn-modern primary" @onclick="ShowAddForm">Add playlist</button>
    </div>
</section>

@if (!string.IsNullOrEmpty(message))
{
    <div class="result-box @(messageIsError ? "error" : "ok")">@message</div>
}

@if (loading)
{
    <div class="empty-state">Loading playlists…</div>
}
else if (playlists.Count == 0)
{
    <div class="empty-state">
        <strong>No playlists yet.</strong><br />
        Paste a public Spotify or YouTube playlist link to save its tracks locally.
    </div>
}
else
{
    <section class="content-grid three">
        @foreach (var playlist in playlists)
        {
            var (downloaded, failed, total, sizeBytes) = downloadStats.GetValueOrDefault(playlist.Id, (0, 0, 0, 0));
            var run = Coordinator.RunFor(playlist.Id);
            <div class="panel-card playlist-card">
                <a class="playlist-cover" href="/playlists/@playlist.Id" title="Open @playlist.Name">
                    @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                    {
                        <img src="@playlist.CoverImageUrl" alt="@playlist.Name" loading="lazy" />
                    }
                    else
                    {
                        <span class="playlist-cover-placeholder">♫</span>
                    }
                    @if (run is { State: Application.Services.DownloadRunState.Running })
                    {
                        <span class="cover-badge downloading" title="Downloading: @run.Done of @run.Total done">⬇ @run.Percent%</span>
                    }
                    else if (run is { State: Application.Services.DownloadRunState.Paused })
                    {
                        <span class="cover-badge paused" title="Download paused">⏸ paused</span>
                    }
                    else if (downloaded == total && total > 0)
                    {
                        <span class="cover-badge complete" title="All tracks downloaded">✓ complete</span>
                    }
                    else if (downloaded > 0)
                    {
                        <span class="cover-badge partial" title="@downloaded of @total downloaded">@downloaded/@total</span>
                    }
                </a>
                <div class="panel-header">
                    <div>
                        <span class="eyebrow">@playlist.SourcePlatform</span>
                        <h2><a href="/playlists/@playlist.Id">@playlist.Name</a></h2>
                    </div>
                </div>
                <p class="panel-description">
                    @playlist.TrackCount tracks
                    @if (!string.IsNullOrEmpty(playlist.Owner))
                    {
                        <span> · by @playlist.Owner</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(playlist.PreferredFormat) && playlist.PreferredFormat != "auto")
                    {
                        <span> · @QualityLabel(playlist.PreferredFormat)</span>
                    }
                    @if (sizeBytes > 0)
                    {
                        <span> · @TrackDisplay.Size(sizeBytes) on disk</span>
                    }
                </p>
                <small class="job-meta">
                    Last synced: @(playlist.LastSyncAt?.ToLocalTime().ToString("g") ?? "never")
                    @(playlist.AutoSyncEnabled
                        ? $" · auto-sync every {playlist.AutoSyncIntervalMinutes ?? 60} min"
                        : " · manual sync")
                </small>
            </div>
        }
    </section>
}

@if (showAddForm)
{
    <div class="wizard-overlay" @onclick="CloseAddForm">
        <div class="wizard-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">New source</span>
                    <h2>Add playlist</h2>
                </div>
                <button class="icon-button" @onclick="HideAddForm">&times;</button>
            </div>
            <div class="wizard-body">
                <div class="form-grid single">
                    <label>
                        Playlist link
                        <input @bind="newUrl" placeholder="https://open.spotify.com/playlist/… or youtube.com/playlist?list=…" />
                    </label>
                    <label>
                        Download folder (optional)
                        <input @bind="newTargetDirectory" placeholder="@resolvedDefaultMusicPath" />
                        <small class="text-muted">Leave empty to use the default music path (currently @resolvedDefaultMusicPath).</small>
                    </label>
                    <label class="quality-field">
                        Audio quality
                        <QualityPicker @bind-Value="newQuality" />
                    </label>
                    <label>
                        Auto-sync schedule
                        <select @bind="newAutoSync">
                            <option value="@false">Manual only</option>
                            <option value="@true">Every N minutes</option>
                        </select>
                    </label>
                    @if (newAutoSync)
                    {
                        <label>
                            Minutes between checks
                            <input type="number" min="5" step="5" @bind="newIntervalMinutes" />
                        </label>
                    }
                    <label>
                        Sync mode
                        <select @bind="newSyncMode">
                            <option value="@PlaylistSyncMode.Additive">Additive: keep removed tracks as history</option>
                            <option value="@PlaylistSyncMode.Mirror">Mirror: remove tracks deleted from source</option>
                        </select>
                    </label>
                </div>
                @if (!string.IsNullOrEmpty(addError))
                {
                    <div class="result-box error">@addError</div>
                }
                <div class="hint-box">
                    Public Spotify and YouTube playlists, no account needed.
                    Quality defaults to <strong>@DefaultQualityLabel()</strong> — change the default in Settings.
                </div>
            </div>
            <div class="wizard-footer">
                <button class="btn-modern" @onclick="HideAddForm">Cancel</button>
                <span></span>
                <button class="btn-modern primary" @onclick="Add" disabled="@busy">@(busy ? "Fetching…" : "Fetch & save")</button>
            </div>
        </div>
    </div>
}

@if (showAccountPanel)
{
    <div class="wizard-overlay" @onclick="CloseAccountPanel">
        <div class="wizard-modal wide" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">Import</span>
                    <h2>Import your music</h2>
                </div>
                <button class="icon-button" @onclick="HideAccountPanel">&times;</button>
            </div>
            <div class="wizard-body">
                <h3>Spotify</h3>
                <div class="account-grid">
                    @foreach (var entry in accountPanels)
                    {
                        <div class="account-card">
                            <strong>@entry.Name</strong>
                            @if (entry.Connected)
                            {
                                <span class="pill ok">connected</span>
                                <button class="btn-modern" @onclick="() => ImportLiked(entry.Name)" disabled="@busy">
                                    @(LikedAlreadySaved(entry.Name) ? "Update liked songs" : "Import liked songs")
                                </button>
                                <button class="btn-modern" @onclick="() => LoadAccountPlaylists(entry.Name)" disabled="@busy">
                                    Show my playlists
                                </button>
                            }
                            else
                            {
                                <span class="pill neutral">not connected</span>
                                <span class="text-muted">Connect it in Settings → Accounts.</span>
                            }
                        </div>
                    }
                </div>
                <p class="text-muted">
                    The account method uses Spotify's official API and needs a
                    <strong>Spotify Premium</strong> account — Spotify requires Premium from
                    the owner of a developer app. No Premium? Use one of the file imports
                    below instead: they work with a free account.
                </p>

                <h3>From a file — works with a free account</h3>
                <div class="account-grid">
                    <div class="account-card">
                        <strong>Exportify CSV</strong>
                        <span class="pill ok">recommended</span>
                        <p class="text-muted">
                            The easiest way to get your liked songs out of Spotify.
                            Go to <a href="https://exportify.net" target="_blank" rel="noopener">exportify.net</a>,
                            log in, click <em>Export Liked Songs</em> (or any playlist),
                            and upload the downloaded CSV here.
                        </p>
                        <InputFile OnChange="ImportExportifyFile" accept=".csv,text/csv" class="btn-modern" disabled="@busy" />
                    </div>
                    <div class="account-card">
                        <strong>Spotify data export</strong>
                        <span class="pill neutral">manual, no API</span>
                        <p class="text-muted">
                            Always manual, never automatic: request <em>Download your data</em>
                            at <a href="https://www.spotify.com/account/privacy" target="_blank" rel="noopener">spotify.com/account/privacy</a>,
                            wait for Spotify's email (up to a few days), unzip it and upload
                            <code>YourLibrary.json</code> (liked songs) or
                            <code>Playlist1.json</code> (all playlists) here.
                        </p>
                        <InputFile OnChange="ImportTakeoutFile" accept=".json,application/json" class="btn-modern" disabled="@busy" />
                    </div>
                </div>
                @if (fileImportError is not null)
                {
                    <div class="result-box error">@fileImportError</div>
                }

                @if (accountPlaylists is not null)
                {
                    <div class="table-wrap">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Playlist</th>
                                    <th>Owner</th>
                                    <th>Tracks</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pl in accountPlaylists)
                                {
                                    var saved = savedAccountIds.Contains(pl.Id);
                                    <tr>
                                        <td><strong>@pl.Name</strong></td>
                                        <td class="text-muted">@(pl.Owner ?? "-")</td>
                                        <td class="text-muted">@pl.TrackCount</td>
                                        <td>
                                            @if (saved)
                                            {
                                                <span class="pill ok" title="Already saved locally; importing again updates it">saved</span>
                                            }
                                            else
                                            {
                                                <span class="pill neutral">new</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn-modern" @onclick="() => ImportAccountPlaylist(pl)" disabled="@busy">
                                                @(busy && importingId == pl.Id
                                                    ? "Importing…"
                                                    : saved ? "Update" : "Import")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (accountError is not null)
                {
                    <div class="result-box error">@accountError</div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<PlaylistEntity> playlists = new();
    private Dictionary<string, (int downloaded, int failed, int total, long sizeBytes)> downloadStats = new();
    private bool loading = true;
    private bool busy;
    private bool showAddForm;
    private bool showAccountPanel;

    private string newUrl = string.Empty;
    private string newTargetDirectory = string.Empty;
    private string resolvedDefaultMusicPath = "/music";
    private string newQuality = "auto";
    private bool newAutoSync;
    private int newIntervalMinutes = 60;
    private PlaylistSyncMode newSyncMode = PlaylistSyncMode.Additive;

    private string message = string.Empty;
    private bool messageIsError;
    private string addError = string.Empty;

    private List<UserPlaylist>? accountPlaylists;
    private string accountListProvider = string.Empty;
    private string? importingId;
    private string? accountError;
    private string? fileImportError;
    private List<(string Name, bool Connected)> accountPanels = new();
    private HashSet<string> savedAccountIds = new();
    private HashSet<string> savedSpotifyIds = new();
    private HashSet<string> savedYouTubeIds = new();

    private Timer? refreshTimer;

    /// <summary>Quality presets shared with the settings page: one list, one truth.</summary>
    private static string QualityLabel(string preferredFormat)
        => preferredFormat.Contains(':')
            ? preferredFormat.Replace(":", " · ")
            : preferredFormat;

    private string DefaultQualityLabel()
        => QualityLabel(newQuality);

    protected override async Task OnInitializedAsync()
    {
        await Load();
        await LoadDefaultQualityAsync();
        resolvedDefaultMusicPath = await Settings.GetAsync("music_path", "/music");
        // Live badge refresh while any run is active.
        refreshTimer = new Timer(_ => InvokeAsync(async () =>
        {
            downloadStats = await Store.GetDownloadStatsAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task LoadDefaultQualityAsync()
    {
        var raw = await Settings.GetAsync("default_quality", "auto");
        if (PlaylistStore.IsValidFormat(raw))
            newQuality = raw;
    }

    private async Task Load()
    {
        loading = true;
        playlists = await Store.GetAllAsync();
        downloadStats = await Store.GetDownloadStatsAsync();
        loading = false;
    }

    private void ShowAddForm()
    {
        newUrl = string.Empty;
        newTargetDirectory = string.Empty;
        newAutoSync = false;
        newIntervalMinutes = 60;
        newSyncMode = PlaylistSyncMode.Additive;
        addError = string.Empty;
        showAddForm = true;
    }

    private void HideAddForm() => showAddForm = false;

    private void CloseAddForm(EventArgs e) => showAddForm = false;

    private void ShowAccountPanel()
    {
        showAccountPanel = true;
        accountError = null;
        accountPlaylists = null;
        _ = LoadAccountStatusAsync();
    }

    private void HideAccountPanel() => showAccountPanel = false;

    private void CloseAccountPanel(EventArgs e) => showAccountPanel = false;

    private async Task LoadAccountStatusAsync()
    {
        accountPanels = new List<(string, bool)>
        {
            (SpotifyAccountProvider.ProviderName, await SpotifyAccount.IsConnectedAsync()),
            (YouTubeAccountProvider.ProviderName, await YouTubeAccount.IsConnectedAsync()),
        };
        // One lookup per platform: liked songs are saved under their own
        // external id ("spotify-liked", "LL"), so the import button can
        // say Update instead of Import when they are already here.
        savedSpotifyIds = await Store.GetSavedExternalIdsAsync(Platform.Spotify);
        savedYouTubeIds = await Store.GetSavedExternalIdsAsync(Platform.YouTubeMusic);
        StateHasChanged();
    }

    private async Task LoadAccountPlaylists(string providerName)
    {
        busy = true;
        accountError = null;
        try
        {
            var account = providerName == SpotifyAccountProvider.ProviderName
                ? SpotifyAccount : (IAccountSourceProvider)YouTubeAccount;
            accountPlaylists = (await account.GetUserPlaylistsAsync()).ToList();
            accountListProvider = providerName;
            // Already-saved playlists get their pill and an Update label;
            // the same platform + external id pair a re-import updates.
            savedAccountIds = await Store.GetSavedExternalIdsAsync(
                providerName == SpotifyAccountProvider.ProviderName
                    ? Platform.Spotify
                    : Platform.YouTubeMusic);
        }
        catch (Exception ex)
        {
            accountError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task ImportLiked(string providerName)
    {
        busy = true;
        accountError = null;
        try
        {
            var added = await Store.AddOrRefreshLikedAsync(providerName, TargetOrNull());
            Navigation.NavigateTo($"/playlists/{added.Id}");
        }
        catch (Exception ex)
        {
            accountError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task ImportAccountPlaylist(UserPlaylist playlist)
    {
        busy = true;
        importingId = playlist.Id;
        accountError = null;
        try
        {
            // Both platforms can import through the plain add flow: the
            // store prefers the account when one is connected, and private
            // playlists then work too.
            var url = accountListProvider == SpotifyAccountProvider.ProviderName
                ? $"https://open.spotify.com/playlist/{playlist.Id}"
                : $"https://www.youtube.com/playlist?list={playlist.Id}";
            var (added, newlySaved) = await Store.AddOrRefreshDetailedAsync(url, TargetOrNull());
            message = newlySaved
                ? $"Saved '{added.Name}' with {added.TrackCount} tracks."
                : $"'{added.Name}' was already saved; updated it ({added.TrackCount} tracks).";
            Navigation.NavigateTo($"/playlists/{added.Id}");
        }
        catch (Exception ex)
        {
            accountError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private string? TargetOrNull()
        => string.IsNullOrWhiteSpace(newTargetDirectory) ? null : newTargetDirectory;

    /// <summary>Liked songs are saved under their own external id per platform.</summary>
    private bool LikedAlreadySaved(string providerName)
        => providerName == SpotifyAccountProvider.ProviderName
            ? savedSpotifyIds.Contains("spotify-liked")
            : savedYouTubeIds.Contains("LL");

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(newUrl))
        {
            addError = "Paste a playlist URL first.";
            return;
        }
        busy = true;
        addError = string.Empty;
        try
        {
            var target = TargetOrNull();
            var (playlist, newlySaved) = await Store.AddOrRefreshDetailedAsync(newUrl.Trim(), target);
            await Store.UpdateSettingsAsync(playlist.Id, null, newAutoSync, newIntervalMinutes, target, newSyncMode, newQuality);
            showAddForm = false;
            message = newlySaved
                ? $"Saved '{playlist.Name}' with {playlist.TrackCount} tracks."
                : $"'{playlist.Name}' was already saved; updated it ({playlist.TrackCount} tracks).";
            messageIsError = false;
            await Load();
        }
        catch (Exception ex)
        {
            addError = ex.Message;
        }
        finally { busy = false; }
    }

    private void Open(PlaylistEntity playlist) => Navigation.NavigateTo($"/playlists/{playlist.Id}");

    /// <summary>
    /// Shared path for both file imports (Exportify CSV, Spotify data
    /// export): read the upload, parse it, persist through the store.
    /// The parser decides the flavor; the message names it.
    /// </summary>
    private async Task ImportUploadedFile(InputFileChangeEventArgs e)
    {
        fileImportError = null;
        busy = true;
        try
        {
            string content;
            using (var stream = e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024))
            using (var reader = new System.IO.StreamReader(stream))
                content = await reader.ReadToEndAsync();

            var file = PlaylistFileImporter.Parse(e.File.Name, content)
                ?? throw new InvalidOperationException(
                    "Could not read that file. Expected an Exportify CSV or a Spotify data export (YourLibrary.json / Playlist1.json).");

            var (playlists, tracks) = await Store.ImportFileAsync(file, TargetOrNull());
            message = playlists > 0
                ? $"Imported {playlists} playlist(s), {tracks} tracks."
                : "Nothing new to import.";
            messageIsError = false;
            HideAccountPanel();
            await Load();
        }
        catch (Exception ex)
        {
            fileImportError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private Task ImportExportifyFile(InputFileChangeEventArgs e) => ImportUploadedFile(e);
    private Task ImportTakeoutFile(InputFileChangeEventArgs e) => ImportUploadedFile(e);

    public void Dispose() => refreshTimer?.Dispose();
}
