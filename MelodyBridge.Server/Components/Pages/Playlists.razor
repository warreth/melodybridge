@if (showPublishPanel)
{
    <div class="wizard-overlay" @onclick="ClosePublishPanel">
        <div class="wizard-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div>
                    <span class="eyebrow">Quick publish</span>
                    <h2>Send playlists to your servers</h2>
                    <p class="text-muted">
                        The quick path: each playlist gets its own sync job with the same
                        name, schedule and targets. Open a job afterwards for path remaps
