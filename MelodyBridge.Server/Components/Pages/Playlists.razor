    private bool playlistFolders = true;
    private string resolvedDefaultMusicPath = "/music";
    private string newQuality = "auto";
    private ScanSchedule newSchedule = ScanSchedule.Manual;
    private bool addScheduleValid = true;
    private PlaylistSyncMode newSyncMode = PlaylistSyncMode.Additive;
    private bool newStrictQuality = true;
    private bool newAllowContainerChange = true;

    private string message = string.Empty;
    private bool messageIsError;
    private string addError = string.Empty;

    private List<UserPlaylist>? accountPlaylists;
    private string accountListProvider = string.Empty;
    private string? accountError;
    private string? fileImportError;
    private readonly HashSet<string> accountSelection = new(StringComparer.Ordinal);
    private bool showImportResult;
    private List<ImportedPlaylistResult> importResults = new();
    private List<string> importFailures = new();

    /// <summary>The import modal's two halves: connected accounts, or files.</summary>
    private static readonly TabStrip.Tab[] ImportTabs =
    [
        new("accounts", "Accounts"),
        new("files", "Files"),
    ];
    private string importTab = "accounts";
    /// <summary>Advanced mode reveals the longer unofficial-cookie risk note.</summary>
    private bool advancedMode;
    private List<(string Name, bool Connected, bool Unofficial)> accountPanels = new();
    private HashSet<string> savedAccountIds = new();
    private HashSet<string> savedSpotifyIds = new();
    private HashSet<string> savedYouTubeIds = new();

    private Timer? refreshTimer;
    /// <summary>The store stamp the badge refresh last saw, so an idle tick skips its query.</summary>

    // Quick publish: one sync job per ticked playlist, named after it,
    // with the ticked schedule and targets. Playlists that already have a
    // job are hidden, so the list does not offer the same playlist again;
    // creation re-reads both lists for changes made meanwhile.
    private bool showPublishPanel;
    private bool publishing;
    private string publishMessage = string.Empty;
    private string publishError = string.Empty;
    private List<MediaServerProfile> publishProfiles = new();
    private readonly HashSet<string> publishPlaylistIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> publishProfileIds = new(StringComparer.Ordinal);
    private HashSet<string> jobPlaylistIds = new(StringComparer.Ordinal);
    private bool publishM3uEnabled;
    private string publishM3uFolder = "/app/playlists";
    private ScanSchedule publishSchedule = ScanSchedule.Manual;
    private bool publishScheduleValid = true;

    private List<PlaylistEntity> publishablePlaylists
        => playlists.Where(p => !jobPlaylistIds.Contains(p.Id)).ToList();

    private int alreadyPublishedCount => playlists.Count - publishablePlaylists.Count;

    private bool AllPublishPlaylistsSelected =>
        publishablePlaylists.Count > 0
        && publishablePlaylists.All(p => publishPlaylistIds.Contains(p.Id));

    private bool AllAccountPlaylistsSelected =>
        accountPlaylists is { Count: > 0 }
        && accountPlaylists.All(p => accountSelection.Contains(p.Id));

    private bool AllSelected =>
        visiblePlaylists.Count > 0 && visiblePlaylists.All(p => selectedPlaylistIds.Contains(p.Id));

    private bool CanPublish => publishPlaylistIds.Count > 0
        && (publishProfileIds.Count > 0 || publishM3uEnabled)
        && (!publishM3uEnabled || !string.IsNullOrWhiteSpace(publishM3uFolder))
        && publishScheduleValid;

    private string PublishButtonLabel => publishPlaylistIds.Count switch
    {
        0 => "Create sync jobs",
        1 => "Create 1 sync job",
        var n => $"Create {n} sync jobs",
    };

    private async Task ShowPublishPanelAsync()
    {
        publishMessage = string.Empty;
        publishError = string.Empty;
        publishPlaylistIds.Clear();
        publishProfileIds.Clear();
        publishing = false;
        publishM3uEnabled = false;
        publishSchedule = ScanSchedule.Manual;
        publishScheduleValid = true;
        publishM3uFolder = await Settings.GetAsync("playlist_path", "/app/playlists");
        publishProfiles = (await ServerProfiles.GetAllAsync()).ToList();
        jobPlaylistIds = await QuickSyncJobs.PlaylistsWithJobAsync(DbFactory);
        showPublishPanel = true;
    }

    private void ClosePublishPanel()
    {
        publishError = string.Empty;
        showPublishPanel = false;
    }

    private void TogglePublishPlaylist(string playlistId, ChangeEventArgs e)
    {
        if (e.Value is true) publishPlaylistIds.Add(playlistId);
        else publishPlaylistIds.Remove(playlistId);
    }

    private void TogglePublishProfile(string profileId, ChangeEventArgs e)
    {
        if (e.Value is true) publishProfileIds.Add(profileId);
        else publishProfileIds.Remove(profileId);
    }

    private void ToggleAllPublishPlaylists()
    {
        if (AllPublishPlaylistsSelected)
        {
            publishPlaylistIds.Clear();
            return;
        }
        foreach (var playlist in publishablePlaylists)
            publishPlaylistIds.Add(playlist.Id);
    }

    private async Task CreatePublishJobs()
    {
        if (!publishScheduleValid)
        {
            publishError = "Enter a valid five-field cron expression before creating jobs.";
            return;
        }
        if (!CanPublish) return;
        publishing = true;
        publishError = string.Empty;
        try
        {
            // A profile can be deleted under Settings while this dialog is
            // open. Refresh before creating: a job must never store a dead
            // target, and the user must see which selection changed.
            publishProfiles = (await ServerProfiles.GetAllAsync()).ToList();
            var currentIds = publishProfiles.Select(p => p.Id).ToHashSet(StringComparer.Ordinal);
            var removed = publishProfileIds.RemoveWhere(id => !currentIds.Contains(id));
            if (publishProfileIds.Count == 0 && !publishM3uEnabled)
            {
                publishError = publishProfiles.Count == 0
                    ? "Select at least one target: an M3U file, or a media server profile."
                    : "The selected media server profile no longer exists. Pick another one or tick M3U file.";
                return;
            }
            if (removed > 0)
            {
                publishError = removed == 1
                    ? "A selected media server profile no longer exists and was removed from the selection. Create again when the rest is right."
                    : $"{removed} selected media server profiles no longer exist and were removed. Create again when the rest is right.";
                return;
            }

            jobPlaylistIds = await QuickSyncJobs.PlaylistsWithJobAsync(DbFactory);
            var selected = playlists
                .Where(p => publishPlaylistIds.Contains(p.Id))
                .Select(p => (p.Id, p.Name))
                .ToList();
            var options = new QuickSyncOptions(publishSchedule, publishM3uEnabled, publishM3uFolder);
            var result = await QuickSyncJobs.CreateAsync(
                DbFactory, ServerProfiles, selected, publishProfileIds.ToList(), options);

            var message = result.Created.Count switch
            {
                0 => "Nothing to create",
                1 => $"Created the sync job '{result.Created[0].Name}'",
                _ => $"Created {result.Created.Count} sync jobs, one per playlist",
            };
            if (publishSchedule.Mode != ScanScheduleMode.Manual && result.Created.Count > 0)
                message += $" with a {publishSchedule.Describe()} schedule";
            if (publishM3uEnabled && result.Created.Count > 0)
                message += " including an M3U file";
            if (result.Skipped.Count > 0)
            {
                message += ". Skipped: " + string.Join("; ",
                    result.Skipped.Select(s => $"{s.Playlist}: {s.Reason}"));
            }
            publishMessage = message + ".";
            showPublishPanel = false;
            jobPlaylistIds = await QuickSyncJobs.PlaylistsWithJobAsync(DbFactory);
        }
        finally
        {
            publishing = false;
        }
    }

    // Delete flow: the card asks, the dialog confirms.
    private string? confirmDeleteId;
    private string confirmDeleteName = string.Empty;
    private bool deleteFilesWithPlaylist;
    private int deleteFileCount;
    private long deleteFileSizeBytes;
    private string? suppressMenuFocusForPlaylist;

    /// <summary>The Remove item opens a dialog that owns focus. Mark this
    /// playlist's menu so Close hands the trigger to the modal close path
    /// instead of taking focus back from the dialog. Every other item
    /// keeps the normal focus return.</summary>
    private bool ShouldReturnMenuFocus(string playlistId)
    {
        if (suppressMenuFocusForPlaylist != playlistId) return true;
        suppressMenuFocusForPlaylist = null;
        return false;
    }

    /// <summary>Offered as a card action: remove the list, files optional.
    /// The dialog counts the existing primary and archive files.</summary>
    private async Task AskDelete(PlaylistEntity playlist)
    {
        suppressMenuFocusForPlaylist = playlist.Id;
        confirmDeleteId = playlist.Id;
        confirmDeleteName = playlist.Name;
        deleteFilesWithPlaylist = false;
        var impact = await Store.GetDeleteImpactAsync(playlist.Id);
        deleteFileCount = impact.Files;
        deleteFileSizeBytes = impact.Bytes;
    }

    private void CancelDelete()
    {
        confirmDeleteId = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (confirmDeleteId is not { } id) return;
        busy = true;
        try
        {
            await Store.DeleteAsync(id, deleteFilesWithPlaylist);
            message = deleteFilesWithPlaylist
                ? $"Removed '{confirmDeleteName}' and its files."
                : $"Removed '{confirmDeleteName}'. The music files stay on disk.";
            messageIsError = false;
            confirmDeleteId = null;
            await Load(showSkeleton: false);
        }
        finally { busy = false; }
    }

    /// <summary>Quality presets shared with the settings page: one list, one truth.</summary>
    private static string QualityLabel(string preferredFormat) => QualityPresets.LabelFor(preferredFormat);

    /// <summary>The page order; pinned playlists stay above every sort
    /// order, then the toolbar choice applies. The filter narrows the
    /// same list so the count, empty state and bulk select all agree.</summary>
    private List<PlaylistEntity> sortedPlaylists => playlistSort switch
    {
        "name" => playlists
            .OrderByDescending(p => p.IsPinned)
            .ThenBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList(),
        "tracks" => playlists
            .OrderByDescending(p => p.IsPinned)
            .ThenByDescending(p => p.TrackCount)
            .ThenBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList(),
        _ => playlists
            .OrderByDescending(p => p.IsPinned)
            .ThenByDescending(p => p.LastSyncAt ?? DateTime.MinValue)
            .ThenBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList(),
    };

    private List<PlaylistEntity> visiblePlaylists => needsAttentionOnly
        ? sortedPlaylists.Where(NeedsAttention).ToList()
        : sortedPlaylists;

    private int NeedsAttentionCount => playlists.Count(NeedsAttention);

    /// <summary>
    /// A playlist needs attention when the last source sync failed or was
    /// incomplete, or when importing left failed tracks behind. Pending
    /// downloads are normal work, not a problem.
    /// </summary>
    private bool NeedsAttention(PlaylistEntity playlist)
    {
        if (playlist.LastSyncStatus is SyncStatus.Failed or SyncStatus.CompletedWithWarning)
            return true;
        if (!string.IsNullOrWhiteSpace(playlist.SyncWarning))
            return true;
        var stats = downloadStats.GetValueOrDefault(playlist.Id, (0, 0, 0, 0, 0));
        return stats.attention > 0;
    }

    private void ToggleNeedsAttention()
    {
        needsAttentionOnly = !needsAttentionOnly;
        if (needsAttentionOnly && selectedPlaylistIds.Count > 0)
            selectedPlaylistIds.Clear();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "recent";
        playlistSort = value is "name" or "tracks" ? value : "recent";
        await Settings.SetAsync("playlists_sort", playlistSort);
    }

    private void EnterSelection()
    {
        selectionMode = true;
        selectedPlaylistIds.Clear();
    }

    private void ExitSelection()
    {
        selectionMode = false;
        selectedPlaylistIds.Clear();
    }

    private void ToggleSelectionIfSelecting(string playlistId)
    {
        if (selectionMode && !busy) ToggleSelection(playlistId);
    }

    /// <summary>A card cover or title acts as a selection button in
    /// selection mode, so keyboard users can toggle it too.</summary>
    private void OnSelectionKeyDown(KeyboardEventArgs e, string playlistId)
    {
        if (!selectionMode || busy) return;
        if (e.Key is "Enter" or " " or "Spacebar")
            ToggleSelection(playlistId);
    }

    private void ToggleSelection(string playlistId)
    {
        if (busy) return;
        if (!selectedPlaylistIds.Remove(playlistId))
            selectedPlaylistIds.Add(playlistId);
    }

    private void ToggleSelection(string playlistId, ChangeEventArgs e)
    {
        if (busy) return;
        if (e.Value is true) selectedPlaylistIds.Add(playlistId);
        else selectedPlaylistIds.Remove(playlistId);
    }

    /// <summary>
    /// A runtime status change can remove a playlist from the attention
    /// filter while it is selected. Drop hidden ids so the count, visible
    /// cards and bulk actions never disagree.
    /// </summary>
    private void ReconcileSelectionWithVisible()
    {
        if (!selectionMode || !needsAttentionOnly || selectedPlaylistIds.Count == 0) return;
        var visibleIds = visiblePlaylists.Select(p => p.Id).ToHashSet(StringComparer.Ordinal);
        selectedPlaylistIds.RemoveWhere(id => !visibleIds.Contains(id));
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (busy) return;
        if (e.Value is true)
        {
            foreach (var playlist in visiblePlaylists)
                selectedPlaylistIds.Add(playlist.Id);
        }
        else
        {
            selectedPlaylistIds.Clear();
        }
    }

    /// <summary>The card and row menu: pin, the everyday actions, then Remove.</summary>
    private RenderFragment PlaylistMenu(PlaylistEntity playlist) => @<text>
        <button title="@(playlist.IsPinned ? "Send this playlist back to the normal sort order" : "Keep this playlist above the others")"
                @onclick="() => TogglePin(playlist)">
            <Icon Name="pin" Size="14" /> @(playlist.IsPinned ? "Unpin" : "Pin to top")
        </button>
        <div class="card-menu-sep"></div>
        <button title="@(playlist.IsManualImport ? "Imported playlists update by re-uploading their file" : "Fetch the latest track list from the source")"
                disabled="@(busy || playlist.IsManualImport)"
                @onclick="() => RefreshPlaylist(playlist)">
            <Icon Name="refresh" Size="14" /> Refresh
        </button>
        <button title="Start a download run for every track without a local file"
                disabled="@busy" @onclick="() => DownloadMissing(playlist)">
            <Icon Name="download" Size="14" /> Download missing
        </button>
        <button title="Download this playlist's track list as CSV"
                disabled="@busy" @onclick="() => ExportPlaylist(playlist)">
            <Icon Name="file-down" Size="14" /> Export CSV
        </button>
        <div class="card-menu-sep"></div>
        <button class="danger" title="Remove this playlist"
                disabled="@busy" @onclick="() => AskDelete(playlist)">
            <Icon Name="trash" Size="14" /> Remove
        </button>
    </text>;

    private async Task TogglePin(PlaylistEntity playlist)
    {
        var pinned = !playlist.IsPinned;
        playlist.IsPinned = pinned;
        StateHasChanged();
        try
        {
            await Store.SetPinnedAsync(playlist.Id, pinned);
            Notifications.Success(pinned
                ? $"Pinned '{playlist.Name}' to the top."
                : $"Unpinned '{playlist.Name}'.");
        }
        catch (Exception ex)
        {
            playlist.IsPinned = !pinned;
            Notifications.Error($"Could not update the pin for '{playlist.Name}': {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task RefreshPlaylist(PlaylistEntity playlist)
    {
        if (busy || playlist.IsManualImport) return;
        if (Coordinator.IsActive(playlist.Id))
        {
            Notifications.Warn($"'{playlist.Name}' is downloading; refresh it after the run finishes.");
            return;
        }
        busy = true;
        Notifications.Info($"Refreshing '{playlist.Name}'…");
        StateHasChanged();
        try
        {
            await Store.RefreshAsync(playlist.Id);
            await Load(showSkeleton: false);
            Notifications.Success($"Refreshed '{playlist.Name}'.");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Could not refresh '{playlist.Name}': {ex.Message}");
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task DownloadMissing(PlaylistEntity playlist)
    {
        if (Coordinator.IsActive(playlist.Id))
        {
            Notifications.Info($"'{playlist.Name}' is already downloading.");
            return;
        }
        if (!await Coordinator.HasPendingWorkAsync(playlist.Id))
        {
            Notifications.Success($"'{playlist.Name}' has nothing left to download.");
            return;
        }
        Coordinator.Start(playlist.Id);
        Notifications.Success($"Downloading missing tracks for '{playlist.Name}'.");
        StateHasChanged();
    }

    private async Task ExportPlaylist(PlaylistEntity playlist)
    {
        busy = true;
        StateHasChanged();
        try
        {
            await DownloadCsvAsync(playlist);
            Notifications.Success($"Exported '{playlist.Name}'.");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Could not export '{playlist.Name}': {ex.Message}");
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task DownloadCsvAsync(PlaylistEntity playlist)
    {
        var bytes = await Store.ExportCsvAsync(playlist.Id);
        var safeName = Csv.SafeFileName(playlist.Name);
        await JS.InvokeVoidAsync("melody.downloadFile", $"{safeName}.csv", "text/csv", bytes);
    }

    private async Task RefreshSelected()
    {
        var selected = playlists.Where(p => selectedPlaylistIds.Contains(p.Id)).ToList();
        if (selected.Count == 0 || busy) return;
        busy = true;
        message = string.Empty;
        messageIsError = false;
        StateHasChanged();
        var refreshed = 0;
        var skipped = 0;
        var downloading = 0;
        var failed = 0;
        var failures = new List<string>();
        Notifications.Info($"Refreshing {selected.Count} playlist{(selected.Count == 1 ? "" : "s")}…");
        try
        {
            foreach (var playlist in selected)
            {
                if (playlist.IsManualImport)
                {
                    skipped++;
                    continue;
                }
                if (Coordinator.IsActive(playlist.Id))
                {
                    downloading++;
                    continue;
                }
                try
                {
                    await Store.RefreshAsync(playlist.Id);
                    refreshed++;
                }
                catch (Exception ex)
                {
                    failed++;
                    failures.Add($"{playlist.Name}: {ex.Message}");
                }
            }
            await Load(showSkeleton: false);
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
        var summary = $"Refreshed {refreshed} playlist{(refreshed == 1 ? "" : "s")}";
        if (skipped > 0) summary += $"; {skipped} import{(skipped == 1 ? "" : "s")} skipped";
        if (downloading > 0) summary += $"; {downloading} downloading skipped";
        if (failed > 0) summary += $"; {failed} failed";
        if (failed > 0)
        {
            var details = string.Join("; ", failures.Take(3));
            if (failures.Count > 3) details += $"; and {failures.Count - 3} more";
            message = summary + ". " + details;
            messageIsError = true;
            Notifications.Warn(summary + ".");
        }
        else
        {
            Notifications.Success(summary + ".");
        }
    }

    private async Task DownloadMissingSelected()
    {
        var selected = playlists.Where(p => selectedPlaylistIds.Contains(p.Id)).ToList();
        if (selected.Count == 0 || busy) return;
        busy = true;
        message = string.Empty;
        messageIsError = false;
        StateHasChanged();
        var started = 0;
        var empty = 0;
        var active = 0;
        try
        {
            foreach (var playlist in selected)
            {
                if (Coordinator.IsActive(playlist.Id))
                {
                    active++;
                    continue;
                }
                if (!await Coordinator.HasPendingWorkAsync(playlist.Id))
                {
                    empty++;
                    continue;
                }
                Coordinator.Start(playlist.Id);
                started++;
            }
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
        var summary = $"Started downloads for {started} playlist{(started == 1 ? "" : "s")}";
        if (empty > 0) summary += $"; {empty} had nothing missing";
        if (active > 0) summary += $"; {active} already running";
        if (started > 0) Notifications.Success(summary + ".");
        else Notifications.Info(summary + ".");
    }

    private async Task ExportSelected()
    {
        var selected = playlists.Where(p => selectedPlaylistIds.Contains(p.Id)).ToList();
        if (selected.Count == 0 || busy) return;
        busy = true;
        message = string.Empty;
        messageIsError = false;
        StateHasChanged();
        try
        {
            if (selected.Count == 1)
            {
                await DownloadCsvAsync(selected[0]);
                Notifications.Success($"Exported '{selected[0].Name}'.");
            }
            else
            {
                var bytes = await Store.ExportCsvZipAsync(selected.Select(p => p.Id));
                await JS.InvokeVoidAsync("melody.downloadFile", "playlists-csv.zip", "application/zip", bytes);
                Notifications.Success($"Exported {selected.Count} playlists as a zip.");
            }
        }
        catch (Exception ex)
        {
            var what = selected.Count == 1 ? $"'{selected[0].Name}'" : $"{selected.Count} playlists";
            message = $"Could not export {what}: {ex.Message}";
            messageIsError = true;
            Notifications.Error("Export failed. See the message above the list.");
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private List<string>? bulkDeleteIds;

    private void AskBulkDelete()
    {
        if (selectedPlaylistIds.Count == 0) return;
        bulkDeleteIds = playlists
            .Where(p => selectedPlaylistIds.Contains(p.Id))
            .Select(p => p.Id)
            .ToList();
    }

    private void CancelBulkDelete()
    {
        bulkDeleteIds = null;
        StateHasChanged();
    }

    private async Task ConfirmBulkDelete()
    {
        if (bulkDeleteIds is not { Count: > 0 } ids) return;
        busy = true;
        try
        {
            foreach (var id in ids)
                await Store.DeleteAsync(id, deleteFiles: false);
            Notifications.Success($"Removed {ids.Count} playlist{(ids.Count == 1 ? "" : "s")}. The music files stay on disk.");
            bulkDeleteIds = null;
            ExitSelection();
            await Load(showSkeleton: false);
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    /// <summary>The default from Settings, fixed once at load: the hint
    /// must not rewrite itself while the user changes the picker.</summary>
    private string savedDefaultQualityLabel = "auto";

    /// <summary>
    /// The import dialog's order: the account's own playlists first, then
    /// alphabetical. Public for the ordering test.
    /// </summary>
    public static IEnumerable<UserPlaylist> OrderImportList(IEnumerable<UserPlaylist> playlists)
        => playlists
            .OrderByDescending(p => p.IsOwned)
            .ThenBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase);

    /// <summary>What an empty download folder resolves to for a new playlist.</summary>
    private string newFolderHint => playlistFolders
        ? $"Leave empty to use the default music path; this playlist gets its own folder there ({resolvedDefaultMusicPath}/playlist name)."
        : $"Leave empty to drop the files directly in the default music path ({resolvedDefaultMusicPath}).";

    private async Task SetPlaylistsView(string view)
    {
        if (playlistsView == view) return;
        playlistsView = view;
        await Settings.SetAsync("playlists_view", view);
    }

    protected override async Task OnInitializedAsync()
    {
        // The counters and the store stamp they were read at. The stamp
        // is read before the counters, so a write that lands during the
        // read sends the next tick back to the store.
        statsRefresher = new Application.Services.DownloadStatsRefresher(
            () => Store.GetDownloadStatsAsync(),
            () => Store.DataVersion);

        // The page needs six settings before it can render its controls.
        // Read them in one query while the playlist list loads instead of
        // opening six contexts and seven sequential connections.
        var settingsTask = Settings.GetManyAsync(new[]
        {
            "default_quality", "music_path", "playlist_folders", "playlists_view", "playlists_sort",
            MelodyBridge.Server.Services.DevPanelService.AdvancedSettingKey,
        });
        await Load();
        var settings = await settingsTask;

        var defaultQuality = settings.GetValueOrDefault("default_quality", "auto");
        if (PlaylistStore.IsValidFormat(defaultQuality))
        {
            newQuality = defaultQuality;
            savedDefaultQualityLabel = QualityLabel(defaultQuality);
        }
        resolvedDefaultMusicPath = settings.GetValueOrDefault("music_path", "/music");
        playlistFolders = SettingsStore.ParseBool(settings.GetValueOrDefault("playlist_folders"), true);
        playlistsView = settings.GetValueOrDefault("playlists_view", "cards");
        if (playlistsView is not ("cards" or "rows")) playlistsView = "cards";
        playlistSort = settings.GetValueOrDefault("playlists_sort", "recent");
        if (playlistSort is not ("recent" or "name" or "tracks")) playlistSort = "recent";
        advancedMode = SettingsStore.ParseBool(
            settings.GetValueOrDefault(MelodyBridge.Server.Services.DevPanelService.AdvancedSettingKey), false);

        // Live badge refresh while any run is active. Idle ticks do no
        // database work unless a write actually moved the store stamp.
        refreshTimer = new Timer(_ => InvokeAsync(async () =>
        {
            var active = Coordinator.Snapshot()
                .Any(r => r.State is not Application.Services.DownloadRunState.Finished);
            if (!statsRefresher.ShouldReload(active)) return;
            await statsRefresher.RefreshAsync();
            ReconcileSelectionWithVisible();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task Load(bool showSkeleton = true)
    {
        if (showSkeleton) loading = true;
        playlists = await Store.GetAllAsync();
        await statsRefresher.RefreshAsync();
        // A playlist deleted in another tab must not stay selected.
        if (selectedPlaylistIds.Count > 0)
        {
            var liveIds = playlists.Select(p => p.Id).ToHashSet(StringComparer.Ordinal);
            selectedPlaylistIds.RemoveWhere(id => !liveIds.Contains(id));
        }
        if (playlists.Count == 0) needsAttentionOnly = false;
        ReconcileSelectionWithVisible();
        if (showSkeleton) loading = false;
    }

    private void ShowAddForm()
    {
        newUrl = string.Empty;
        newTargetDirectory = string.Empty;
        newSchedule = ScanSchedule.Manual;
        addScheduleValid = true;
        newSyncMode = PlaylistSyncMode.Additive;
        newStrictQuality = true;
        newAllowContainerChange = true;
        addError = string.Empty;
        showAddForm = true;
    }

    private void HideAddForm() => showAddForm = false;

    private void CloseAddForm(EventArgs e) => showAddForm = false;

    private void ShowAccountPanel()
    {
        showAccountPanel = true;
        accountError = null;
        accountPlaylists = null;
        accountSelection.Clear();
        importTab = "accounts";
        _ = LoadAccountStatusAsync();
    }

    private void HideAccountPanel() => showAccountPanel = false;

    private void CloseAccountPanel(EventArgs e) => showAccountPanel = false;

    private async Task LoadAccountStatusAsync()
    {
        accountPanels = new List<(string, bool, bool)>
        {
            (SpotifyAccountProvider.ProviderName, await SpotifyAccount.IsConnectedAsync(), false),
            (SpotifyUnofficialAccountProvider.ProviderName, await SpotifyWeb.IsConnectedAsync(), true),
            (YouTubeAccountProvider.ProviderName, await YouTubeAccount.IsConnectedAsync(), false),
        };
        // One lookup per platform: liked songs are saved under their own
        // external id ("spotify-liked", "LL"), so the import button can
        // say Update instead of Import when they are already here.
        savedSpotifyIds = await Store.GetSavedExternalIdsAsync(Platform.Spotify);
        savedYouTubeIds = await Store.GetSavedExternalIdsAsync(Platform.YouTubeMusic);
        StateHasChanged();
    }

    private async Task LoadAccountPlaylists(string providerName)
    {
        busy = true;
        accountError = null;
        accountSelection.Clear();
        try
        {
            var account = providerName switch
            {
                SpotifyAccountProvider.ProviderName => (IAccountSourceProvider)SpotifyAccount,
                SpotifyUnofficialAccountProvider.ProviderName => SpotifyWeb,
                _ => YouTubeAccount,
            };
            accountPlaylists = OrderImportList(await account.GetUserPlaylistsAsync()).ToList();
            accountListProvider = providerName;
            // Already-saved playlists get their pill and an Update label;
            // the same platform + external id pair a re-import updates.
            savedAccountIds = await Store.GetSavedExternalIdsAsync(
                providerName == YouTubeAccountProvider.ProviderName
                    ? Platform.YouTubeMusic
                    : Platform.Spotify);
        }
        catch (Exception ex)
        {
            accountError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private void ToggleAccountPlaylist(string playlistId, ChangeEventArgs e)
    {
        if (e.Value is true) accountSelection.Add(playlistId);
        else accountSelection.Remove(playlistId);
    }

    private void ToggleAllAccountPlaylists(ChangeEventArgs e)
    {
        accountSelection.Clear();
        if (e.Value is true && accountPlaylists is not null)
        {
            foreach (var playlist in accountPlaylists)
                accountSelection.Add(playlist.Id);
        }
    }

    private async Task ImportLiked(string providerName)
    {
        busy = true;
        accountError = null;
        importFailures.Clear();
        try
        {
            var wasSaved = LikedAlreadySaved(providerName);
            var added = await Store.AddOrRefreshLikedAsync(providerName, TargetOrNull());
            importResults =
            [
                new ImportedPlaylistResult(added.Id, added.Name, added.TrackCount, !wasSaved),
            ];
            showAccountPanel = false;
            showImportResult = true;
            await Load(showSkeleton: false);
        }
        catch (Exception ex)
        {
            accountError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    /// <summary>The public URL for one account playlist, shared by batch
    /// import so Spotify and YouTube never drift apart.</summary>
    public static string AccountSourceUrl(string accountProvider, string playlistId)
        => accountProvider == YouTubeAccountProvider.ProviderName
            ? $"https://www.youtube.com/playlist?list={playlistId}"
            : $"https://open.spotify.com/playlist/{playlistId}";

    /// <summary>
    /// Import every ticked account playlist in one pass. Each result keeps
    /// its id so the success dialog can offer an Edit link; a failed
    /// playlist is reported without stopping the rest.
    /// </summary>
    private async Task ImportSelectedAccountPlaylists()
    {
        if (accountPlaylists is null || accountSelection.Count == 0 || busy) return;
        var selected = accountPlaylists
            .Where(p => accountSelection.Contains(p.Id))
            .ToList();
        busy = true;
        accountError = null;
        importFailures.Clear();
        importResults = new List<ImportedPlaylistResult>();
        try
        {
            foreach (var playlist in selected)
            {
                // Both Spotify connections can import through the plain add
                // flow: the store prefers the account when one is connected,
                // and private playlists then work too.
                var url = AccountSourceUrl(accountListProvider, playlist.Id);
                try
                {
                    var (added, newlySaved) = await Store.AddOrRefreshDetailedAsync(url, TargetOrNull());
                    importResults.Add(new ImportedPlaylistResult(
                        added.Id, added.Name, added.TrackCount, newlySaved));
                }
                catch (Exception ex)
                {
                    importFailures.Add($"{playlist.Name}: {ex.Message}");
                }
            }

            savedAccountIds = await Store.GetSavedExternalIdsAsync(
                accountListProvider == YouTubeAccountProvider.ProviderName
                    ? Platform.YouTubeMusic
                    : Platform.Spotify);
            accountSelection.Clear();
            await Load(showSkeleton: false);

            if (importResults.Count > 0)
            {
                showAccountPanel = false;
                showImportResult = true;
            }
            else if (importFailures.Count > 0)
            {
                accountError = string.Join(" ", importFailures);
            }
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private void CloseImportResult()
    {
        showImportResult = false;
        importResults = new List<ImportedPlaylistResult>();
        importFailures.Clear();
    }

    private string? TargetOrNull()
        => string.IsNullOrWhiteSpace(newTargetDirectory) ? null : newTargetDirectory;

    /// <summary>Liked songs are saved under their own external id per provider.</summary>
    private bool LikedAlreadySaved(string providerName)
        => providerName switch
        {
            SpotifyAccountProvider.ProviderName => savedSpotifyIds.Contains("spotify-liked"),
            SpotifyUnofficialAccountProvider.ProviderName =>
                savedSpotifyIds.Contains(SpotifyUnofficialAccountProvider.LikedId),
            _ => savedYouTubeIds.Contains("LL"),
        };

    /// <summary>The playlist's schedule, legacy rows included (interval kept working).</summary>
    private static ScanSchedule ScheduleOf(PlaylistEntity playlist)
        => playlist.ScheduleCron is { Length: > 0 }
            ? ScanSchedule.Parse(playlist.ScheduleCron)
            : playlist.AutoSyncEnabled
                ? ScanSchedule.FromInterval(playlist.AutoSyncIntervalMinutes ?? 60)
                : ScanSchedule.Manual;

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(newUrl))
        {
            addError = "Paste a playlist URL first.";
            return;
        }
        if (!addScheduleValid)
        {
            addError = "Enter a valid five-field cron expression before saving.";
            return;
        }
        busy = true;
        addError = string.Empty;
        try
        {
            var target = TargetOrNull();
            var (playlist, newlySaved) = await Store.AddOrRefreshDetailedAsync(newUrl.Trim(), target);
            await Store.UpdateScheduleAsync(playlist.Id, null, newSchedule, target, newSyncMode, newQuality,
                strictQuality: newStrictQuality, allowContainerChange: newAllowContainerChange);
            showAddForm = false;
            message = newlySaved
                ? $"Saved '{playlist.Name}' with {playlist.TrackCount} tracks."
                : $"'{playlist.Name}' was already saved; updated it ({playlist.TrackCount} tracks).";
            messageIsError = false;
            await Load();
        }
        catch (Exception ex)
        {
            addError = ex.Message;
        }
        finally { busy = false; }
    }

    /// <summary>
    /// Shared path for both file imports (Exportify CSV, Spotify data
    /// export): read the upload, parse it, persist through the store.
    /// The parser decides the flavor; the message names it.
    /// </summary>
    private async Task ImportUploadedFile(InputFileChangeEventArgs e)
    {
        fileImportError = null;
        busy = true;
        try
        {
            ParsedUpload upload;
            using (var stream = e.File.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024))
                upload = await PlaylistFileImporter.ParseStreamAsync(e.File.Name, stream);

            if (upload.Files.Count == 0)
                throw new InvalidOperationException(
                    "Could not read that file. Expected an Exportify CSV, a Spotify data export (YourLibrary.json / Playlist1.json), or a zip of either.");

            var (playlists, tracks) = await Store.ImportFilesAsync(upload.Files, TargetOrNull());
            message = playlists > 0
                ? $"Imported {playlists} {(playlists == 1 ? "playlist" : "playlists")}, {tracks} {(tracks == 1 ? "track" : "tracks")}."
                : "Nothing new to import.";
            if (upload.Warning is { Length: > 0 }) message = $"{message} {upload.Warning}";
            messageIsError = false;
            HideAccountPanel();
            await Load();
        }
        catch (Exception ex)
        {
            fileImportError = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    // Which upload card is working, so its file input turns into feedback.
    private string? uploadingRoute;

    private async Task ImportExportifyFile(InputFileChangeEventArgs e)
    {
        uploadingRoute = "exportify";
        // The pill and the disabled input exist only after a render: the
        // first await would swallow the change otherwise, and with the
        // input still enabled a second upload could start mid-parse.
        StateHasChanged();
        try
        {
            await ImportUploadedFile(e);
        }
        finally
        {
            uploadingRoute = null;
            StateHasChanged();
        }
    }

    private async Task ImportTakeoutFile(InputFileChangeEventArgs e)
    {
        uploadingRoute = "takeout";
        StateHasChanged();
        try
        {
            await ImportUploadedFile(e);
        }
        finally
        {
            uploadingRoute = null;
            StateHasChanged();
        }
    }

    public void Dispose() => refreshTimer?.Dispose();
