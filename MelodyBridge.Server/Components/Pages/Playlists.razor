@code {
    private List<PlaylistEntity> playlists = new();
    private Application.Services.DownloadStatsRefresher statsRefresher = null!;
    private Dictionary<string, (int downloaded, int failed, int total, long sizeBytes, int attention)> downloadStats => statsRefresher.Stats;
    private bool loading = true;
    private bool busy;
    private bool showAddForm;
    private bool showAccountPanel;

    private string newUrl = string.Empty;
    private string newTargetDirectory = string.Empty;
    /// <summary>Card grid or compact rows, kept in settings across visits.</summary>
