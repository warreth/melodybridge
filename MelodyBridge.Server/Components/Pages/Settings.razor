@page "/settings"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Accounts
@using MelodyBridge.Infrastructure.Audio
@using MelodyBridge.Infrastructure.Cloudflare
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Services
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject LogExporter Exporter
@inject NavigationManager Nav
@inject SpotifyAccountProvider SpotifyAccount
@inject SpotifyUnofficialAccountProvider SpotifyWeb
@inject YouTubeAccountProvider YouTubeAccount
@inject MediaServerProfileStore ServerProfiles
@inject LibraryPathMover PathMover
@inject SettingsStore TourReset
@inject DatabaseBackupService DbBackup
@inject NtfyNotifier Ntfy
@inject UpdateCheckService UpdateCheck
@inject NotificationService Notifications
@inject IMediaServerDirectoryFactory DirectoryFactory
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Settings - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Configuration</span>
        <div class="title-with-help">
            <h1>Settings</h1>
            <HelpTip Path="reference#settings" Text="Accounts, paths, quality, network and notifications. Power knobs live on the Advanced page." />
        </div>
        <p>Accounts, paths, downloads and notifications. Power knobs live on Advanced.</p>
    </div>
    <div class="topbar-actions">
        @if (dirty)
        {
            <span class="save-state pending">Unsaved changes</span>
        }
        <button class="btn-modern primary" @onclick="SaveAll" disabled="@saving">@(saving ? "Saving…" : "Save settings")</button>
    </div>
</section>

<div class="settings-search">
    <Icon Name="search" Size="16" Class="settings-search-icon" />
    <input class="settings-search-input" type="search"
           placeholder="Search settings, for example theme, ntfy or Jellyfin"
           aria-label="Search settings"
           @bind="settingsSearch" @bind:event="oninput" />
    @if (SearchMatches.Count > 0)
    {
        <div class="settings-search-results" role="listbox" aria-label="Matching settings">
            @foreach (var hit in SearchMatches)
            {
                <button type="button" class="settings-search-result" role="option"
                        @onclick="() => JumpToSetting(hit)">
                    <span>
                        <strong>@hit.Label</strong>
                        <small>@hit.Detail</small>
                    </span>
                    <span class="settings-search-tab">@hit.TabLabel</span>
                </button>
            }
        </div>
    }
    else if (settingsSearch.Trim().Length >= 2)
    {
        <div class="settings-search-empty">No setting matches "@settingsSearch.Trim()".</div>
    }
</div>

<TabStrip Tabs="TabStripTabs" ActiveId="@activeTab"
           OnSelect="SelectTab" AriaLabel="Settings sections" />

@if (activeTab == "accounts")
{
    <section class="settings-card">
        <div class="settings-head">
            <div><span class="eyebrow">Accounts</span>
                <div class="title-with-help">
                    <h2>Spotify &amp; YouTube</h2>
                    <HelpTip Path="accounts" Text="Both logins are read-only. For private playlists and liked songs on a free account, use the unofficial web session or import an export file." />
                </div>
            </div>
        </div>
        <div class="settings-section">
            <div class="hint-box">
                Connect your accounts to import private playlists and your liked
                songs. MelodyBridge only asks for read access: it never changes
                anything on your account.
            </div>

            <div class="account-grid">
                <div class="account-card">
                    <div class="account-head">
                        <strong>Spotify</strong>
                        <StatusPill Variant="@(_spotifyConnected ? "connected" : "neutral")">
                            @(_spotifyConnected ? "connected" : "not connected")
                        </StatusPill>
                        @if (_spotifyConnected)
                        {
                            <button class="btn-modern subtle small" @onclick="() => Logout(SpotifyAccount)">Disconnect</button>
                        }
                    </div>
                    @if (_spotifyConnected)
                    {
                        <p class="account-note">
                            Private playlists and liked songs import through this
                            login. Disconnect to revoke it.
                        </p>
                    }
                    else
                    {
                        <details class="oauth-steps">
                            <summary>How to create a Spotify app</summary>
                            <ol>
                                <li>
                                    Open <a href="https://developer.spotify.com/dashboard" target="_blank" rel="noopener">developer.spotify.com/dashboard</a>
                                    and click <em>Create app</em>. Any name works. When Spotify asks
                                    <em>which APIs you are planning to use</em>, pick <strong>Web API</strong>,
                                    not Ads API, Web Playback SDK, iOS or Android. Web API is the one that
                                    can read your playlists and liked songs.
                                </li>
                                <li>
                                    In the app settings (top-right <em>Settings</em>), add this exact redirect URI:
                                    <div class="hint-box redirect-row">
                                        <code>@SpotifyRedirectUrl</code>
                                        <button class="btn-modern ghost small" type="button" @onclick="CopySpotifyRedirect">Copy</button>
                                    </div>
                                    @if (copyHintFor == "spotify")
                                    {
                                        <small class="text-muted">@copyHint</small>
                                    }
                                </li>
                                <li>Copy the <em>Client ID</em> from the same settings page, paste it below and click Connect.</li>
                            </ol>
                        </details>
                        <p class="account-note">
                            New Spotify apps start in <em>development mode</em>: that is fine for
                            personal use: you are the owner. Your Spotify account must have
                            Premium while the app stays in development mode, and the login only
                            works for you and anyone you explicitly allowlist in the app's
                            Settings, then Users Management.
                        </p>
                        <div class="account-connect">
                            <label>
                                Client ID (from developer.spotify.com)
                                <input @bind="spotifyClientId" @bind:after="MarkDirty" placeholder="Spotify app Client ID" />
                            </label>
                            <button class="btn-modern primary" @onclick="ConnectSpotify">Connect Spotify</button>
                        </div>
                    }
                </div>

                <div class="account-card">
                    <div class="account-head">
                        <strong>Spotify (unofficial)</strong>
                        <span class="account-badges">
                            <StatusPill Variant="warn">unofficial</StatusPill>
                            <StatusPill Variant="@(_spotifyWebConnected ? "connected" : "neutral")">
                                @(_spotifyWebConnected ? "connected" : "not connected")
                            </StatusPill>
                        </span>
                        @if (_spotifyWebConnected)
                        {
                            <button class="btn-modern subtle small" @onclick="DisconnectSpotifyWeb">Disconnect</button>
                        }
                    </div>
                    @if (_spotifyWebConnected)
                    {
                        <p class="account-note">
                            Liked songs and playlists import through your own Spotify web
                            session, so a free account works and no developer app is needed.
                            It stays on until you disconnect.
                        </p>
                        <div class="flex-actions">
                            <button class="btn-modern secondary" @onclick="TestSpotifyWeb" disabled="@testingSpotifyWeb">
                                @(testingSpotifyWeb ? "Testing…" : "Test session")
                            </button>
                            <span class="text-muted">@spotifyWebMessage</span>
                        </div>
                    }
                    else
                    {
                        <p class="account-note">
                            Imports liked songs and playlists on a free account, fully automatic,
                            by reusing your own Spotify web session. The <code>sp_dc</code> cookie
                            you paste is a live credential of your account: it is stored in this
                            server's database in plain text, anyone who reads it can act as you, and
                            Spotify can break this route without notice. A burner account removes
                            most of that risk. Prefer no risk? The <em>Files</em> tab imports an
                            Exportify CSV instead.
                        </p>
                        <div class="account-connect">
                            <label>
                                Spotify session cookie (sp_dc value)
                                <input @bind="spotifyWebCookie" type="password" placeholder="sp_dc=..." />
                            </label>
                            <label class="toggle-switch wide">
                                <input type="checkbox" @bind="spotifyWebAcknowledged" />
                                <span class="toggle-slider"></span>
                                <span>I understand this is unofficial, unsafe for a real account and may break</span>
                            </label>
                            <details class="oauth-steps">
                                <summary>Where to find the cookie, and when to change the secrets URL</summary>
                                <ol>
                                    <li>
                                        Log in at
                                        <a href="https://open.spotify.com" target="_blank" rel="noopener">open.spotify.com</a>
                                        in a browser.
                                    </li>
                                    <li>
                                        Open developer tools (F12), then Application or Storage, then
                                        Cookies for <code>open.spotify.com</code>.
                                    </li>
                                    <li>Copy the value of the cookie named <code>sp_dc</code> and paste it above.</li>
                                    <li>
                                        The cookie stops working when the browser session ends, or
                                        when Spotify rotates its TOTP secrets. Paste a fresh value,
                                        or point the secrets URL at a newer list, if imports stop.
                                    </li>
                                </ol>
                                <label>
                                    TOTP secrets URL
                                    <input @bind="spotifyWebSecretsUrl" placeholder="@SpotifyWebSession.DefaultSecretsUrl" />
                                </label>
                            </details>
                            <button class="btn-modern primary" @onclick="EnableSpotifyWeb"
                                    disabled="@(!spotifyWebAcknowledged || enablingSpotifyWeb)">
                                @(enablingSpotifyWeb ? "Testing…" : "Enable and test")
                            </button>
                        </div>
                    }
                    @if (spotifyWebError is not null)
                    {
                        <div class="result-box error">@spotifyWebError</div>
                    }
                </div>

                <div class="account-card">
                    <div class="account-head">
                        <strong>YouTube</strong>
                        <StatusPill Variant="@(_youtubeConnected ? "connected" : "neutral")">
                            @(_youtubeConnected ? "connected" : "not connected")
                        </StatusPill>
                        @if (_youtubeConnected)
                        {
                            <button class="btn-modern subtle small" @onclick="() => Logout(YouTubeAccount)">Disconnect</button>
                        }
                    </div>
                    @if (_youtubeConnected)
                    {
                        <p class="account-note">
                            Private playlists and liked songs import through this
                            login. Disconnect to revoke it.
                        </p>
                    }
                    else
                    {
                        <details class="oauth-steps">
                            <summary>How to create a YouTube app</summary>
                            <ol>
                                <li>
                                    Open <a href="https://console.cloud.google.com" target="_blank" rel="noopener">console.cloud.google.com</a>,
                                    create a project, enable the <em>YouTube Data API v3</em>
                                    (APIs &amp; Services, Library), then create OAuth credentials of type
                                    <em>Web application</em> (APIs &amp; Services, Credentials).
                                </li>
                                <li>
                                    Add this exact redirect URI to the OAuth client:
                                    <div class="hint-box redirect-row">
                                        <code>@YouTubeRedirectUrl</code>
                                        <button class="btn-modern ghost small" type="button" @onclick="CopyYouTubeRedirect">Copy</button>
                                    </div>
                                    @if (copyHintFor == "youtube")
                                    {
                                        <small class="text-muted">@copyHint</small>
                                    }
                                </li>
                                <li>Paste the client ID and secret here and click Connect.</li>
                            </ol>
                        </details>
                        <p class="account-note">
                            Before the first login, open the OAuth consent screen
                            (APIs &amp; Services, OAuth consent screen) and add your own Google
                            account as a <em>Test user</em>: unverified personal apps only work
                            for their test users. You will see an "unverified app" warning: that
                            is expected for a self-hosted personal app; choose
                            <em>Continue to project</em>.
                        </p>
                        <div class="account-connect">
                            <label>
                                Client ID (Google Cloud Console, OAuth Web application)
                                <input @bind="youtubeClientId" @bind:after="MarkDirty" placeholder="OAuth client ID" />
                            </label>
                            <label>
                                Client secret
                                <input @bind="youtubeClientSecret" @bind:after="MarkDirty" type="password" placeholder="OAuth client secret" />
                            </label>
                            <button class="btn-modern primary" @onclick="ConnectYouTube">Connect YouTube</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}
else if (activeTab == "media-servers")
{
    <section class="settings-card">
        <div class="settings-head">
            <div>
                <span class="eyebrow">Connections</span>
                <div class="title-with-help">
                    <h2>Media server profiles</h2>
                    <HelpTip Path="reference#media-servers" Text="Profiles are shortcuts for sync jobs. Mark one as the app default so jobs without their own profile fall back to it." />
                </div>
            </div>
            <button class="btn-modern secondary small" @onclick="StartNewProfile">Add profile</button>
        </div>
        <div class="settings-section">
            <div class="hint-box">
                Named server profiles several sync jobs can share. Marking one
                profile as the app default gives sync jobs that do not pick a
                profile themselves a connection to fall back on.
            </div>
            @if (migratedFromOldSettings)
            {
                <div class="hint-box">
                    Your old single-server Jellyfin settings moved into a profile
                    named "Default". Edit it here from now on.
                </div>
            }
            @if (profiles.Count == 0)
            {
                <div class="empty-state">No profiles yet. Add one to reuse a server across sync jobs.</div>
            }
            else
            {
                <div class="profile-list">
                    @foreach (var profile in profiles)
                    {
                        <div class="profile-row">
                            <div class="profile-main">
                                <strong>@profile.Name</strong>
                                <StatusPill Variant="neutral">@profile.Kind</StatusPill>
                                @if (IsAppDefault(profile))
                                {
                                    <StatusPill Variant="ok">default</StatusPill>
                                }
                                @if (profileTestStatus.TryGetValue(profile.Id, out var st) && st is not null)
                                {
                                    <StatusPill Variant="@(st == "ok" ? "ok" : "err")">@(st == "ok" ? "connected" : "not connected")</StatusPill>
                                }
                                <span class="profile-url">@profile.BaseUrl</span>
                            </div>
                            <div class="flex-actions">
                                <button class="btn-modern ghost small" @onclick="() => EditProfile(profile)">Edit</button>
                                <button class="btn-modern ghost small" @onclick="() => AskDeleteProfile(profile)">Delete</button>
                                <button class="btn-modern secondary small" @onclick="() => MakeAppDefault(profile)">Use as app default</button>
                                <button class="btn-modern secondary small" disabled="@(testingProfile == profile.Id)" @onclick="() => TestProfile(profile)">
                                    @(testingProfile == profile.Id ? "Testing..." : "Test")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    @if (deleteProfileId is { } doomedProfileId)
    {
        <ConfirmDialog Show="true"
                       Eyebrow="Delete profile"
                       Title=@($"Delete '{deleteProfileName}'?")
                       Message="Sync jobs that use this profile need a new server picked in their settings. If it is the app default, the default is cleared too."
                       ConfirmLabel="Delete profile"
                       OnConfirm=@(() => DeleteProfile(doomedProfileId))
                       OnCancel="CancelDeleteProfile" />
    }

    @if (editingProfile is not null)
    {
        <section class="settings-card">
            <div class="settings-head">
                <div>
                    <span class="eyebrow">Edit</span>
                    <h2>@(editingIsNew ? "New profile" : editingProfile.Name)</h2>
                </div>
            </div>
            <div class="settings-section">
                <div class="form-grid single">
                    <label>Name (required) <input @bind="editingProfile.Name" placeholder="Living room Jellyfin" /></label>
                    <label>Kind
                        <select @bind="editingProfile.Kind">
                            <option value="Jellyfin">Jellyfin</option>
                            <option value="Plex">Plex</option>
                            <option value="Subsonic">Subsonic (Navidrome, gonic, Airsonic, ...)</option>
                            <option value="Navidrome">Navidrome (same API as Subsonic)</option>
                        </select>
                    </label>
                    <label>Base URL (required) <input @bind="editingProfile.BaseUrl"
                           placeholder="@(editingProfile.Kind == "Plex" ? "http://plex:32400" : MediaServerKinds.IsSubsonic(editingProfile.Kind) ? "http://navidrome:4533" : "http://jellyfin:8096")" /></label>
                    @if (MediaServerKinds.IsSubsonic(editingProfile.Kind))
                    {
                        <label>Username <input @bind="editingProfile.Username" placeholder="admin" /></label>
                        <label class="hint-text">Subsonic servers have no API key: username and password are the credentials. Navidrome, gonic, Airsonic, Ampache, Funkwhale and Nextcloud Music all speak this API.</label>
                    }
                    @if (editingProfile.Kind == "Jellyfin")
                    {
                        <JellyfinConnect ServerUrl="@editingProfile.BaseUrl"
                                         Username="@editingProfile.Username"
                                         UsernameChanged="@(name => editingProfile.Username = name ?? "")"
                                         Connected="OnProfileConnected" />
                        <label class="hint-text">
                            Jellyfin playlists belong to a user, so connect: the app keeps the
                            session token and the sync uses it.
                        </label>
                    }
                    else
                    {
                        <label>@(MediaServerKinds.IsSubsonic(editingProfile.Kind) ? "Password" : "Plex token")
                            <input @bind="editingProfile.ApiKey" type="password" placeholder="@(MediaServerKinds.IsSubsonic(editingProfile.Kind) ? "password" : "X-Plex-Token")" />
                        </label>
                    }
                </div>
                <div class="flex-actions">
                    <button class="btn-modern ghost" @onclick="CancelProfileEdit">Cancel</button>
                    <button class="btn-modern primary" @onclick="SaveProfile">Save profile</button>
                    @if (profileError is { Length: > 0 })
                    {
                        <span class="validation-message">@profileError</span>
                    }
                </div>
            </div>
        </section>
    }
}
else if (activeTab == "paths")
{
    <section class="settings-card">
        <div class="settings-head">
            <div><span class="eyebrow">Library</span>
                <div class="title-with-help">
                    <h2>Default paths</h2>
                    <HelpTip Path="docker#volumes-and-paths" Text="These are paths inside the container, not on your host: /music and /app/playlists in Docker." />
                </div>
            </div>
        </div>
        <div class="settings-section">
            <div class="form-grid single">
                <label>
                    Music path
                    <span class="path-field">
                        <input @bind="musicPath" @bind:after="ValidatePaths"
                               aria-invalid="@(musicPathWarning is { Length: > 0 } ? "true" : null)"
                               aria-describedby="@(musicPathWarning is { Length: > 0 } ? "music-path-warning" : null)" />
                        @if (playlistFolders)
                        {
                            <span class="path-suffix" title="Added to every playlist's own folder name">{playlist}</span>
                        }
                    </span>
                    @if (musicPathWarning is { Length: > 0 })
                    {
                        <small class="text-warn" id="music-path-warning">@musicPathWarning</small>
                    }
                    <small class="text-muted">
                        Downloads land here. Changing this path moves the whole library
                        to the new folder when you save.
                    </small>
                </label>
                <div class="toggle-with-help">
                    <label class="toggle-switch wide">
                        <input type="checkbox" @bind="playlistFolders" @bind:after="MarkDirty" />
                        <span class="toggle-slider"></span>
                        <span>Sort downloads into a folder per playlist</span>
                    </label>
                    <HelpTip Path="reference#settings" Text="On: every playlist gets its own folder under the music path, which keeps dedup links and archive copies apart. Off: all downloads land directly in the music path." />
                </div>
                <small class="text-muted">@PlaylistFoldersHint</small>
                <label>
                    Playlist output folder
                    <input @bind="playlistPath" @bind:after="ValidatePaths"
                           aria-invalid="@(playlistPathWarning is { Length: > 0 } ? "true" : null)"
                           aria-describedby="@(playlistPathWarning is { Length: > 0 } ? "playlist-path-warning" : null)" />
                    @if (playlistPathWarning is { Length: > 0 })
                    {
                        <small class="text-warn" id="playlist-path-warning">@playlistPathWarning</small>
                    }
                </label>
            </div>
        </div>
        <div class="settings-section">
            <div class="section-head">
                <span class="eyebrow">Archive</span>
                <div class="title-with-help">
                    <h3>Archive copy</h3>
                    <HelpTip Path="concepts#archive-copies" Text="A second copy in another folder and format, converted locally from the same download." />
                </div>
            </div>
            <div class="hint-box">
                Optional second home for every download. Each track is fetched
                once; the archive copy is a local conversion with ffmpeg, so
                the second library never costs another internet download.
            </div>
            <div class="form-grid single">
                <label>
                    Archive path
                    <span class="path-field">
                        <input @bind="archivePath" @bind:after="ValidatePaths" placeholder="/archive-music"
                               aria-invalid="@(archivePathWarning is { Length: > 0 } ? "true" : null)"
                               aria-describedby="@(archivePathWarning is { Length: > 0 } ? "archive-path-warning" : null)" />
                        @if (playlistFolders && !string.IsNullOrWhiteSpace(archivePath))
                        {
                            <span class="path-suffix" title="Added to every playlist's own archive folder name">{playlist}</span>
                        }
                    </span>
                    @if (archivePathWarning is { Length: > 0 })
                    {
                        <small class="text-warn" id="archive-path-warning">@archivePathWarning</small>
                    }
                    <small class="text-muted">
                        Leave empty for no archive copy. Playlists can set their own path on
                        their page. Changing this path moves the existing archive copies
                        when you save.
                    </small>
                </label>
                <label>
                    Archive format
                    <select @bind="archiveFormat" @bind:after="MarkDirty">
                        <option value="auto">Auto: copy the downloaded file as-is</option>
                        <option value="opus">Opus: small and efficient (128k)</option>
                        <option value="flac">FLAC: lossless (level 5)</option>
                        <option value="mp3">MP3: widely compatible (256k)</option>
                        <option value="aac">AAC: small and modern (192k)</option>
                    </select>
                </label>
            </div>
            <MountWarning />
            <div class="hint-box">
                New downloads land under the music path, M3U files go to the
                playlist output folder. Archive copies follow the archive
                path above. Changing the music or archive path moves the
                files you already have along with it.
            </div>
        </div>
    </section>
}
else if (activeTab == "quality")
{
    <section class="settings-card">
        <div class="settings-head">
            <div>
                <span class="eyebrow">Quality</span>
                <div class="title-with-help">
                    <h2>Default audio quality</h2>
                    <HelpTip Path="reference#quality" Text="Space Saver caps at 160 kbps, High Quality at 320, Lossless asks for real FLAC. Every playlist can allow stepping down to a lower quality." />
                </div>
            </div>
        </div>
        <div class="settings-section">
            <div class="hint-box">
                New playlists start with this setting. Every playlist can override
                it on its own page.
            </div>
            <QualityPicker @bind-Value="defaultQuality" @bind-Value:after="MarkDirty" />
        </div>
        <div class="settings-section">
            <div class="section-head">
                <span class="eyebrow">Verification</span>
                <div class="title-with-help">
                    <h3>Real quality check</h3>
                    <HelpTip Path="concepts#the-quality-review" Text="Downloaded files are measured: a wrong length or an inflated bitrate is kept and flagged on the track row, and you choose Keep or Retry for each one. This panel sets how strict the checks are." />
                </div>
            </div>
            <div class="hint-box">
                A download whose length differs from the source playlist, or whose
                bandwidth says the declared bitrate is inflated, stays in your
                library and gets flagged. You then choose <strong>Keep</strong> (it is
                fine) or <strong>Retry</strong> (download again, avoiding the provider
                that delivered it). Broken, unreadable bytes are still deleted and
                retried automatically.
            </div>
            <div class="form-grid">
                <label>
                    Spectrum check
                    <select @bind="spectrumMode" @bind:after="MarkDirty">
                        <option value="Off">Off: trust the file</option>
                        <option value="Fast">Fast: check the first minute (recommended)</option>
                        <option value="Thorough">Thorough: check the whole file (up to 15 min)</option>
                    </select>
                </label>
                <label>
                    Spectrum strictness
                    <select @bind="spectrumClassGap" @bind:after="MarkDirty" disabled="@(spectrumMode == "Off")">
                        <option value="1">Strict: flag one class below</option>
                        <option value="2">Balanced: flag two classes below (recommended)</option>
                        <option value="3">Lenient: flag three classes below</option>
                    </select>
                    <small class="text-muted">A file counts as inflated when its real bandwidth sits this many bitrate classes (96/128/160/192/256/320) below the declared one.</small>
                </label>
            </div>
            <div class="form-grid">
                <label>
                    Length tolerance (seconds)
                    <input @bind="lengthToleranceSeconds" @bind:after="MarkDirty" type="number" min="0" max="600" step="5" />
                </label>
                <label>
                    Length tolerance (percent)
                    <input @bind="lengthTolerancePercent" @bind:after="MarkDirty" type="number" min="0" max="100" step="1" />
                </label>
            </div>
            <small class="text-muted">
                A file whose length is off by more than the larger of the two
                tolerances is flagged for your decision, not deleted. The default
                (30 seconds, 10%) catches a radio edit without nagging about a
                slightly different cut.
            </small>
        </div>
    </section>
}
else if (activeTab == "network")
{
    <section class="settings-card">
        <div class="settings-head">
            <div>
                <span class="eyebrow">Network</span>
