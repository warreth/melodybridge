@page "/settings"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Accounts
@using MelodyBridge.Infrastructure.Audio
@using MelodyBridge.Infrastructure.Cloudflare
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Services
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject LogExporter Exporter
@inject NavigationManager Nav
@inject SpotifyAccountProvider SpotifyAccount
@inject YouTubeAccountProvider YouTubeAccount
@inject MediaServerProfileStore ServerProfiles
@inject SettingsStore TourReset
@inject DatabaseBackupService DbBackup
@inject UpdateCheckService UpdateCheck
@inject NotificationService Notifications
@inject IMediaServerDirectory JellyfinDirectory
@inject IEnumerable<IMediaServerDirectory> Directories
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Settings - MelodyBridge</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Configuration</span>
        <div class="title-with-help">
            <h1>Settings</h1>
            <HelpTip Path="reference#settings" Text="Accounts, paths, quality and network. Power knobs live on the Advanced page." />
        </div>
        <p>Accounts, paths and download behaviour. Power knobs live on the Advanced page.</p>
    </div>
    <div class="topbar-actions">
        @if (dirty)
        {
            <span class="save-state pending">Unsaved changes</span>
        }
        <button class="btn-modern primary" @onclick="SaveAll" disabled="@saving">@(saving ? "Saving…" : "Save settings")</button>
    </div>
</section>

<TabStrip Tabs="TabStripTabs" ActiveId="@activeTab"
           OnSelect="SelectTab" AriaLabel="Settings sections" />

@if (activeTab == "accounts")
{
    <section class="panel-card">
        <div class="panel-header">
            <div><span class="eyebrow">Accounts</span>
                <div class="title-with-help">
                    <h2>Spotify &amp; YouTube</h2>
                    <HelpTip Path="accounts" Text="Both logins are read-only. For private playlists and liked songs, connect here or import an export file." />
                </div>
            </div>
        </div>
        <div class="hint-box">
            Connect your accounts to import private playlists and your liked
            songs. MelodyBridge only asks for read access: it never changes
            anything on your account.
        </div>

        <div class="account-grid">
            <div class="account-card">
                <strong>Spotify</strong>
                <StatusPill Variant="@(_spotifyConnected ? "connected" : "neutral")">
                    @(_spotifyConnected ? "connected" : "not connected")
                </StatusPill>
                @if (_spotifyConnected)
                {
                    <button class="btn-modern subtle" @onclick="() => Logout(SpotifyAccount)">Disconnect</button>
                }
                else
                {
                    <div class="oauth-steps">
                    <ol>
                        <li>
                            Open <a href="https://developer.spotify.com/dashboard" target="_blank" rel="noopener">developer.spotify.com/dashboard</a>
                            and click <em>Create app</em>. Any name works. When Spotify asks
                            <em>which APIs you are planning to use</em>, pick <strong>Web API</strong>,
                            not Ads API, Web Playback SDK, iOS or Android. Web API is the one that
                            can read your playlists and liked songs.
                        </li>
                        <li>
                            In the app settings (top-right <em>Settings</em>), add this exact redirect URI:
                            <div class="hint-box">
                                <code>@SpotifyRedirectUrl</code>
                                <div class="flex-actions">
                                    <button class="btn-modern ghost small" type="button" @onclick="CopySpotifyRedirect">Copy</button>
                                    @if (copyHintFor == "spotify")
                                    {
                                        <span class="text-muted">@copyHint</span>
                                    }
                                </div>
                            </div>
                        </li>
                        <li>Copy the <em>Client ID</em> from the same settings page, paste it below and click Connect.</li>
                    </ol>
                    </div>
                    <p class="text-muted">
                        New Spotify apps start in <em>development mode</em>: that is fine for
                        personal use: you are the owner. Your Spotify account must have
                        Premium while the app stays in development mode, and the login only
                        works for you and anyone you explicitly allowlist in the app's
                        Settings, then Users Management.
                    </p>
                    <label>
                        Client ID (from developer.spotify.com)
                        <input @bind="spotifyClientId" @bind:after="MarkDirty" placeholder="Spotify app Client ID" />
                    </label>
                    <button class="btn-modern primary" @onclick="ConnectSpotify">Connect Spotify</button>
                }
            </div>

            <div class="account-card">
                <strong>YouTube</strong>
                <StatusPill Variant="@(_youtubeConnected ? "connected" : "neutral")">
                    @(_youtubeConnected ? "connected" : "not connected")
                </StatusPill>
                @if (_youtubeConnected)
                {
                    <button class="btn-modern subtle" @onclick="() => Logout(YouTubeAccount)">Disconnect</button>
                }
                else
                {
                    <div class="oauth-steps">
                    <ol>
                        <li>
                            Open <a href="https://console.cloud.google.com" target="_blank" rel="noopener">console.cloud.google.com</a>,
                            create a project, enable the <em>YouTube Data API v3</em>
                            (APIs &amp; Services, Library), then create OAuth credentials of type
                            <em>Web application</em> (APIs &amp; Services, Credentials).
                        </li>
                        <li>
                            Add this exact redirect URI to the OAuth client:
                            <div class="hint-box">
                                <code>@YouTubeRedirectUrl</code>
                                <div class="flex-actions">
                                    <button class="btn-modern ghost small" type="button" @onclick="CopyYouTubeRedirect">Copy</button>
                                    @if (copyHintFor == "youtube")
                                    {
                                        <span class="text-muted">@copyHint</span>
                                    }
                                </div>
                            </div>
                        </li>
                        <li>Paste the client ID and secret here and click Connect.</li>
                    </ol>
                    </div>
                    <p class="text-muted">
                        Before the first login, open the OAuth consent screen
                        (APIs &amp; Services, OAuth consent screen) and add your own Google
                        account as a <em>Test user</em>: unverified personal apps only work
                        for their test users. You will see an "unverified app" warning: that
                        is expected for a self-hosted personal app; choose
                        <em>Continue to project</em>.
                    </p>
                    <label>
                        Client ID (Google Cloud Console, OAuth Web application)
                        <input @bind="youtubeClientId" @bind:after="MarkDirty" placeholder="OAuth client ID" />
                    </label>
                    <label>
                        Client secret
                        <input @bind="youtubeClientSecret" @bind:after="MarkDirty" type="password" placeholder="OAuth client secret" />
                    </label>
                    <button class="btn-modern primary" @onclick="ConnectYouTube">Connect YouTube</button>
                }
            </div>
        </div>
    </section>
}
else if (activeTab == "media-servers")
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Connections</span>
                <div class="title-with-help">
                    <h2>Media server profiles</h2>
                    <HelpTip Path="reference#media-servers" Text="Profiles are shortcuts for sync jobs. Mark one as the app default to feed the liked songs sync." />
                </div>
            </div>
            <button class="btn-modern secondary small" @onclick="StartNewProfile">Add profile</button>
        </div>
        <div class="hint-box">
            Named server profiles several sync jobs can share. Marking one
            profile as the app default feeds the liked-songs sync.
        </div>
        @if (migratedFromOldSettings)
        {
            <div class="hint-box">
                Your old single-server Jellyfin settings moved into a profile
                named "Default". Edit it here from now on.
            </div>
        }
        @if (profiles.Count == 0)
        {
            <div class="empty-state">No profiles yet. Add one to reuse a server across sync jobs.</div>
        }
        else
        {
            <div class="profile-list">
                @foreach (var profile in profiles)
                {
                    <div class="profile-row">
                        <div class="profile-main">
                            <strong>@profile.Name</strong>
                            <StatusPill Variant="neutral">@profile.Kind</StatusPill>
                            @if (IsAppDefault(profile))
                            {
                                <StatusPill Variant="ok">default</StatusPill>
                            }
                            @if (profileTestStatus.TryGetValue(profile.Id, out var st) && st is not null)
                            {
                                <StatusPill Variant="@(st == "ok" ? "ok" : "err")">@(st == "ok" ? "connected" : "not connected")</StatusPill>
                            }
                            <span class="profile-url">@profile.BaseUrl</span>
                        </div>
                        <div class="flex-actions">
                            <button class="btn-modern ghost small" @onclick="() => EditProfile(profile)">Edit</button>
                            <button class="btn-modern ghost small" @onclick="() => AskDeleteProfile(profile)">Delete</button>
                            <button class="btn-modern secondary small" @onclick="() => MakeAppDefault(profile)">Use as app default</button>
                            <button class="btn-modern secondary small" disabled="@(testingProfile == profile.Id)" @onclick="() => TestProfile(profile)">
                                @(testingProfile == profile.Id ? "Testing..." : "Test")
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @if (deleteProfileId is { } doomedProfileId)
    {
        <ConfirmDialog Show="true"
                       Eyebrow="Delete profile"
                       Title=@($"Delete '{deleteProfileName}'?")
                       Message="Sync jobs that use this profile need a new server picked in their settings. If it is the app default, the default is cleared too."
                       ConfirmLabel="Delete profile"
                       OnConfirm=@(() => DeleteProfile(doomedProfileId))
                       OnCancel="CancelDeleteProfile" />
    }

    @if (editingProfile is not null)
    {
        <section class="panel-card">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Edit</span>
                    <h2>@(editingIsNew ? "New profile" : editingProfile.Name)</h2>
                </div>
            </div>
            <div class="form-grid single">
                <label>Name (required) <input @bind="editingProfile.Name" placeholder="Living room Jellyfin" /></label>
                <label>Kind
                    <select @bind="editingProfile.Kind">
                        <option value="Jellyfin">Jellyfin</option>
                        <option value="Plex">Plex</option>
                        <option value="Navidrome">Navidrome</option>
                    </select>
                </label>
                <label>Base URL (required) <input @bind="editingProfile.BaseUrl"
                       placeholder="@(editingProfile.Kind == "Plex" ? "http://plex:32400" : editingProfile.Kind == "Navidrome" ? "http://navidrome:4533" : "http://jellyfin:8096")" /></label>
                @if (editingProfile.Kind == "Navidrome")
                {
                    <label>Username <input @bind="editingProfile.Username" placeholder="admin" /></label>
                    <label class="hint-text">Navidrome has no API key: username and password are the credentials.</label>
                }
                @if (editingProfile.Kind == "Jellyfin")
                {
                    <JellyfinConnect ServerUrl="@editingProfile.BaseUrl"
                                     Username="@editingProfile.Username"
                                     UsernameChanged="@(name => editingProfile.Username = name ?? "")"
                                     Connected="OnProfileConnected" />
                    <label class="hint-text">
                        Jellyfin playlists belong to a user, so connect: the app keeps the
                        session token and the sync uses it.
                    </label>
                }
                else
                {
                    <label>@(editingProfile.Kind == "Navidrome" ? "Password" : "Plex token")
                        <input @bind="editingProfile.ApiKey" type="password" placeholder="@(editingProfile.Kind == "Navidrome" ? "password" : "X-Plex-Token")" />
                    </label>
                }
            </div>
            <div class="flex-actions">
                <button class="btn-modern ghost" @onclick="CancelProfileEdit">Cancel</button>
                <button class="btn-modern primary" @onclick="SaveProfile">Save profile</button>
                @if (profileError is { Length: > 0 })
                {
                    <span class="validation-message">@profileError</span>
                }
            </div>
        </section>
    }
}
else if (activeTab == "paths")
{
    <section class="panel-card">
        <div class="panel-header">
            <div><span class="eyebrow">Library</span>
                <div class="title-with-help">
                    <h2>Default paths</h2>
                    <HelpTip Path="docker#volumes-and-paths" Text="These are paths inside the container, not on your host: /music and /app/playlists in Docker." />
                </div>
            </div>
        </div>
        <div class="form-grid single">
            <label>
                Music path
                <input @bind="musicPath" @bind:after="ValidatePaths"
                       aria-invalid="@(musicPathWarning is { Length: > 0 } ? "true" : null)"
                       aria-describedby="@(musicPathWarning is { Length: > 0 } ? "music-path-warning" : null)" />
                @if (musicPathWarning is { Length: > 0 })
                {
                    <small class="text-warn" id="music-path-warning">@musicPathWarning</small>
                }
            </label>
            <label>
                Playlist output folder
                <input @bind="playlistPath" @bind:after="ValidatePaths"
                       aria-invalid="@(playlistPathWarning is { Length: > 0 } ? "true" : null)"
                       aria-describedby="@(playlistPathWarning is { Length: > 0 } ? "playlist-path-warning" : null)" />
                @if (playlistPathWarning is { Length: > 0 })
                {
                    <small class="text-warn" id="playlist-path-warning">@playlistPathWarning</small>
                }
            </label>
        </div>
        <div class="panel-header">
            <div>
                <span class="eyebrow">Archive</span>
                <div class="title-with-help">
                    <h2>Archive copy</h2>
                    <HelpTip Path="concepts#archive-copies" Text="A second copy in another folder and format, converted locally from the same download." />
                </div>
            </div>
        </div>
        <div class="hint-box">
            Optional second home for every download. Each track is fetched
            once; the archive copy is a local conversion with ffmpeg, so
            the second library never costs another internet download.
        </div>
        <div class="form-grid single">
            <label>
                Archive path
                <input @bind="archivePath" @bind:after="ValidatePaths" placeholder="/archive-music"
                       aria-invalid="@(archivePathWarning is { Length: > 0 } ? "true" : null)"
                       aria-describedby="@(archivePathWarning is { Length: > 0 } ? "archive-path-warning" : null)" />
                @if (archivePathWarning is { Length: > 0 })
                {
                    <small class="text-warn" id="archive-path-warning">@archivePathWarning</small>
                }
                <small class="text-muted">Leave empty for no archive copy. Playlists can set their own path on their page.</small>
            </label>
            <label>
                Archive format
                <select @bind="archiveFormat" @bind:after="MarkDirty">
                    <option value="auto">Auto: copy the downloaded file as-is</option>
                    <option value="opus">Opus: small and efficient (128k)</option>
                    <option value="flac">FLAC: lossless (level 5)</option>
                    <option value="mp3">MP3: widely compatible (256k)</option>
                    <option value="aac">AAC: small and modern (192k)</option>
                </select>
            </label>
        </div>
        <MountWarning />
        <div class="hint-box">
            New downloads land under the music path; M3U files go to the
            playlist output folder. Archive copies follow the archive
            path above.
        </div>
    </section>
}
else if (activeTab == "quality")
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Quality</span>
                <div class="title-with-help">
                    <h2>Default audio quality</h2>
                    <HelpTip Path="reference#quality" Text="Space Saver caps at 160 kbps, High Quality at 320, Lossless asks for real FLAC. Every playlist can allow stepping down to a lower quality." />
                </div>
            </div>
        </div>
        <div class="hint-box">
            New playlists start with this setting. Every playlist can override
            it on its own page.
        </div>
        <QualityPicker @bind-Value="defaultQuality" @bind-Value:after="MarkDirty" />
        <div class="panel-header">
            <div>
                <span class="eyebrow">Verification</span>
                <div class="title-with-help">
                    <h2>Real quality check</h2>
                    <HelpTip Path="concepts#the-spectrum-check" Text="Measures the file's real audio bandwidth and warns when it falls well short of the declared bitrate. It never deletes anything." />
                </div>
            </div>
        </div>
        <div class="hint-box">
            Some sites hand out files that claim 320 kbps but hold far less.
            The spectrum check measures the file's real audio bandwidth and
            warns you next to the track when it falls well short of the
            declared bitrate.
        </div>
        <div class="form-grid single">
            <label>
                Spectrum check
                <select @bind="spectrumMode" @bind:after="MarkDirty">
                    <option value="Off">Off: trust the file</option>
                    <option value="Fast">Fast: check the first minute (recommended)</option>
                    <option value="Thorough">Thorough: check the whole file</option>
                </select>
            </label>
        </div>
    </section>
}
else if (activeTab == "network")
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Network</span>
                <div class="title-with-help">
                    <h2>FlareSolverr (Cloudflare)</h2>
                    <HelpTip Path="lucida" Text="auto finds the solver container on the Docker network; off disables the Lucida plugin." />
                </div>
            </div>
            <StatusPill Variant="@(flareStatus is "ok" ? "ok" : flareStatus is null or "off" ? "neutral" : "err")">
                @(flareStatus is null ? "not tested" : flareStatus is "ok" ? "reachable" : flareStatus is "off" ? "off" : "unreachable")
            </StatusPill>
        </div>
        <div class="hint-box">
            Lucida sits behind a Cloudflare challenge. FlareSolverr is a small
            companion container that solves it: the compose file ships one.
            With "auto" the app looks for that container on the Docker network
            by itself, so compose users leave this untouched. Enter the URL
            yourself only outside compose, or "off" to disable.
        </div>
        <div class="form-grid single">
            <label>
                FlareSolverr URL
                <input @bind="flaresolverrUrl" @bind:after="MarkDirty" placeholder="auto, http://flaresolverr:8191 or off" />
            </label>
        </div>
        <div class="flex-actions">
            <button class="btn-modern secondary" @onclick="TestFlareSolverr" disabled="@testingFlare">
                @(testingFlare ? "Testing..." : "Test connection")
            </button>
            <span class="text-muted">@flareMessage</span>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Network</span>
                <div class="title-with-help">
                    <h2>Spotify web session</h2>
                    <HelpTip Path="reference#network" Text="Only needed when public playlist scraping starts failing." />
                </div>
            </div>
        </div>
        <div class="hint-box">
            Public playlists and liked songs work without this. Paste a
            Spotify web cookie (the sp_dc value from a logged-in browser
            session) only if public scraping starts failing for you: the
            app then sends it along as a fallback. The cookie is stored in
            the database, not an environment variable.
        </div>
        <div class="form-grid single">
            <label>
                Spotify cookie (optional)
                <input @bind="spotifyCookie" @bind:after="MarkDirty" type="password" placeholder="sp_dc=..." />
            </label>
        </div>
    </section>

}
else if (activeTab == "about")
{
    <section class="panel-card about-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">About</span>
                <h2>MelodyBridge @AppInfo.Version</h2>
            </div>
        </div>
        <div class="flex-actions">
            <button class="btn-modern secondary" @onclick="CheckForUpdates" disabled="@checkingUpdate">
                @(checkingUpdate ? "Checking..." : "Check for updates")
            </button>
            @if (updateResult is { } u)
            {
                @if (u.Succeeded && UpdateCheckService.IsNewer(u.LatestVersion!, AppInfo.Version))
                {
                    <StatusPill Variant="ok">Update available: v@(u.LatestVersion)</StatusPill>
                    <a class="hint" href="@u.ReleaseUrl" target="_blank" rel="noopener">Release notes <Icon Name="external" Size="12" /></a>
                }
                else if (u.Succeeded)
                {
                    <StatusPill Variant="neutral">You are up to date</StatusPill>
                }
                else
                {
                    <StatusPill Variant="err" Title="@u.Error">Check failed</StatusPill>
                }
            }
        </div>
        <div class="hint-box">
            Self-hosted and open source. Docs live at
            <a href="https://docs.melodybridge.app" target="_blank" rel="noopener">docs.melodybridge.app</a>:
            quick start, accounts, Lucida and the Docker guide.
        </div>
        <div class="flex-actions">
            <button class="btn-modern ghost" @onclick="RestartTour">Show the guided tour again</button>
            <button class="btn-modern ghost" @onclick="RestartChecklist">Show the setup checklist again</button>
        </div>
    </section>

    <section class="panel-card about-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Appearance</span>
                <h2>Accent color</h2>
            </div>
        </div>
        <p class="panel-description">
            Colors the active tab, buttons and highlights across the whole
            app, the guided tour included. Saved in this browser only.
        </p>
        <div class="accent-picker" role="radiogroup" aria-label="Accent color">
            @foreach (var accent in AccentOptions)
            {
                var active = accent == _activeAccent;
                <button type="button"
                        class="accent-swatch accent-@(accent) @(active ? "active" : "")"
                        role="radio"
                        aria-checked="@(active ? "true" : "false")"
                        title="@(char.ToUpperInvariant(accent[0]) + accent[1..])"
                        @onclick="() => PickAccent(accent)">
                    <span class="visually-hidden">@(char.ToUpperInvariant(accent[0]) + accent[1..])</span>
                </button>
            }
        </div>
    </section>

    <section class="panel-card about-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Diagnostics</span>
                <h2>Logs</h2>
            </div>
        </div>
        <p class="panel-description">
            Export the most recent application logs (up to 1000 entries)
            as a plain-text file for debugging or sharing.
        </p>
        <button class="btn-modern primary-outline" @onclick="ExportLogs">
            <Icon Name="download" Size="16" Class="btn-icon" /> Export logs
        </button>
    </section>

    <section class="panel-card about-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Backup</span>
                <div class="title-with-help">
                    <h2>Database</h2>
                    <HelpTip Path="reference#about" Text="Export snapshots the database as a zip; importing replaces it and needs a restart afterwards." />
                </div>
            </div>
        </div>
        <div class="hint-box">
            The zip contains a consistent snapshot (playlists, tracks,
            settings). Import replaces the current database and parks the
            old one next to it as .preimport.bak: restart after
            importing so the app lets go of the old file.
        </div>
        <div class="flex-actions">
            <button class="btn-modern secondary" @onclick="ExportDatabase">Export zip</button>
            <InputFile OnChange="ImportDatabase" accept=".zip" class="btn-modern ghost" />
        </div>
        @if (!string.IsNullOrWhiteSpace(dbMessage))
        {
            <div class="hint-box">@dbMessage</div>
        }
    </section>
}

@code {
    // Tab ids double as URL fragments: /settings#accounts opens Accounts.
    private static readonly (string Id, string Label)[] Tabs =
    [
        ("accounts", "Accounts"),
        ("media-servers", "Media servers"),
        ("paths", "Default paths"),
        ("quality", "Quality"),
        ("network", "Network"),
        ("about", "About"),
    ];

    /// <summary>The same list as TabStrip.Tab records for the component.</summary>
    private static readonly TabStrip.Tab[] TabStripTabs =
        [.. Tabs.Select(t => new TabStrip.Tab(t.Id, t.Label))];

    // Accent palette ids, matching the app.css palettes and app.js ACCENTS.
    private static readonly string[] AccentOptions = ["teal", "blue", "violet", "rose", "amber"];
    private string _activeAccent = "teal";

    private void PickAccent(string accent)
    {
        if (!AccentOptions.Contains(accent)) return;
        _activeAccent = accent;
        _ = JS.InvokeVoidAsync("melody.setAccent", accent);
    }

    // Sync the swatch with the browser's stored accent once JS is
    // available. Unhandled in tests, InvokeAsync returns null and the
    // null check keeps the default teal.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<string>("melody.getAccent");
        if (AccentOptions.Contains(stored)) _activeAccent = stored;
    }

    private string activeTab = "accounts";
    private string musicPath = "/music";
    private string playlistPath = "/app/playlists";
    private string archivePath = "";
    private string archiveFormat = "auto";
    private string defaultQuality = "auto";
    private string spectrumMode = "Fast";
    private string flaresolverrUrl = "off";
    private string? flareStatus;
    private string flareMessage = string.Empty;
    private bool testingFlare;

    // Inline path checks: advisory, they never block a save.
    private string musicPathWarning = string.Empty;
    private string playlistPathWarning = string.Empty;
    private string archivePathWarning = string.Empty;

    // Unsaved-changes state for the floating save bar.
    private bool dirty;
    private bool saving;

    // Connections tab
    private List<MediaServerProfile> profiles = [];
    private MediaServerProfile? editingProfile;
