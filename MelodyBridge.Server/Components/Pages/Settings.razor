    /// <summary>
    /// Accepts the pasted value in either shape: the bare cookie or the
    /// "sp_dc=..." pair a browser's cookie list shows.
    /// </summary>
    internal static string NormalizeCookie(string? pasted)
    {
        var value = (pasted ?? string.Empty).Trim();
        if (value.StartsWith("sp_dc=", StringComparison.OrdinalIgnoreCase))
            value = value["sp_dc=".Length..].Trim();
        return value.Trim('"');
    }

