        {
            // The helper falls back to the selection trick on plain-http
            // hosts, where navigator.clipboard does not exist.
            copied = await JS.InvokeAsync<bool>("melody.copyText", uri);
        }
        catch (JSException)
        {
            copied = false;
        }
        copyHintFor = provider;
        copyHint = copied ? "Copied" : "Copy failed: select it manually";
        // The hint belongs to the button that was used and fades quickly.
        var providerAtClick = provider;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2500);
            if (copyHintFor == providerAtClick)
            {
                copyHintFor = null;
                copyHint = string.Empty;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

