    /// <summary>Which copy button last reported, so only its own hint says Copied.</summary>
    private string? copyHintFor;
    private string copyHint = string.Empty;

    /// <summary>Inline error for the profile form, next to the fields it belongs to.</summary>
    private string? profileError;

    /// <summary>The redirect URI for one provider, as registered in its
    /// app settings. The provider marker tells the callback page which
    /// account to finish; Spotify requires the URI to match exactly, so
    /// the same string is used at login start and at token exchange.
    /// Spotify also rejects "localhost" (April 2025 rule), so loopback
    /// requests are shown and sent with the 127.0.0.1 literal instead.</summary>
    private string RedirectUrlFor(string provider)
        => LoopbackUri(Nav.ToAbsoluteUri($"auth/callback?provider={provider}"));

    private string SpotifyRedirectUrl => RedirectUrlFor("spotify");
    private string YouTubeRedirectUrl => RedirectUrlFor("youtube");

    /// <summary>Replaces a "localhost" host with 127.0.0.1; anything else stays.
    /// The AuthCallback page reuses this so the URI exchanged at token time
    /// matches the one the login started with.</summary>
    internal static string LoopbackUri(Uri uri)
    {
        if (!uri.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase))
            return uri.ToString();
        var builder = new UriBuilder(uri) { Host = "127.0.0.1" };
        return builder.Uri.ToString();
    }

    private async Task CopyRedirectToClipboard(string provider, string uri)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", uri);
            copyHintFor = provider;
            copyHint = "Copied";
        }
        catch (JSException)
        {
            copyHintFor = provider;
            copyHint = "Copy failed: select it manually";
        }
        // The hint belongs to the button that was used and fades quickly.
        var providerAtClick = provider;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2500);
            if (copyHintFor == providerAtClick)
            {
                copyHintFor = null;
                copyHint = string.Empty;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private Task CopySpotifyRedirect() => CopyRedirectToClipboard("spotify", SpotifyRedirectUrl);
    private Task CopyYouTubeRedirect() => CopyRedirectToClipboard("youtube", YouTubeRedirectUrl);

    private async Task Connect(IAccountSourceProvider provider, string redirectUrl, string? clientId = null)
    {
        try
        {
            if (clientId is not null)
            {
                // The typed client id is saved first: BeginLogin needs it.
                var value = clientId.Trim();
                if (value.Length == 0)
                    throw new InvalidOperationException("Paste the Client ID first.");
                await provider.SaveSettingAsync("client_id", value);
            }
            var loginUrl = await provider.BeginLoginAsync(redirectUrl);
            // The login URL is another origin (accounts.spotify.com, ...).
            // NavigateTo with forceLoad tears the circuit down mid-call on
            // exactly these cross-origin jumps (a known Blazor Server race),
            // so the browser location is assigned directly instead.
            await JS.InvokeVoidAsync("window.location.assign", loginUrl);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex.Message);
        }
    }

    private Task ConnectSpotify() => Connect(SpotifyAccount, SpotifyRedirectUrl, spotifyClientId);

    private async Task ConnectYouTube()
    {
        if (youtubeClientId.Trim().Length == 0 || youtubeClientSecret.Trim().Length == 0)
        {
            Notifications.Warn("Paste both the YouTube client id and secret first.");
            return;
        }
        await YouTubeAccount.SaveSettingAsync("client_id", youtubeClientId.Trim());
        await YouTubeAccount.SaveSettingAsync("client_secret", youtubeClientSecret.Trim());
        await Connect(YouTubeAccount, YouTubeRedirectUrl);
    }

    private async Task Logout(IAccountSourceProvider provider)
    {
        await provider.LogoutAsync();
        _spotifyConnected = await SpotifyAccount.IsConnectedAsync();
        _youtubeConnected = await YouTubeAccount.IsConnectedAsync();
        Notifications.Info("Account disconnected");
    }

    private static string FindSetting(List<DownloaderSettingEntity> settings, string key, string fallback)
        => settings.FirstOrDefault(s => s.Key == key)?.Value ?? fallback;

    private async Task TestFlareSolverr()
    {
        testingFlare = true;
        flareMessage = string.Empty;
        try
        {
            var url = flaresolverrUrl.Trim();
            if (url.Length == 0 || url.Equals("off", StringComparison.OrdinalIgnoreCase))
            {
                flareStatus = "off";
                flareMessage = "Solver is off: Lucida stays unavailable.";
                return;
            }
            if (url.Equals("auto", StringComparison.OrdinalIgnoreCase))
            {
                // Same sweep the solver runs: first /health that answers
                // 200 wins, so the report matches what Lucida will use.
                using var http = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(2) };
                foreach (var candidate in MelodyBridge.Infrastructure.Cloudflare.FlareSolverrSolver.AutoDetectCandidates)
                {
                    try
                    {
                        using var response = await http.GetAsync($"{candidate}/health");
                        if (response.IsSuccessStatusCode)
                        {
                            flareStatus = "ok";
                            flareMessage = $"FlareSolverr answered at {candidate}: Lucida can use it.";
                            return;
                        }
                    }
                    catch (Exception)
                    {
                        // Unreachable candidate: fall through to the next one.
                    }
                }
                flareStatus = "err";
                flareMessage = "No FlareSolverr answered on the Docker network. Check the container.";
                return;
            }
            using var http2 = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(8) };
            var response2 = await http2.PostAsJsonAsync($"{url.TrimEnd('/')}/v1",
                new { cmd = "sessions.list" });
            flareStatus = response2.IsSuccessStatusCode ? "ok" : $"http {(int)response2.StatusCode}";
            flareMessage = response2.IsSuccessStatusCode
                ? "FlareSolverr answered: Lucida can use it."
                : "It responded but not with OK. Check the URL and container logs.";
        }
        catch (Exception ex)
        {
            flareStatus = "err";
            flareMessage = $"Could not reach it: {ex.Message}";
        }
        finally
        {
            testingFlare = false;
            StateHasChanged();
        }
    }

    private async Task SaveAll()
    {
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await Upsert(db, "music_path", musicPath);
            await Upsert(db, "playlist_path", playlistPath);
            await Upsert(db, "archive_path", archivePath);
            await Upsert(db, "archive_format", archiveFormat);
            await Upsert(db, "default_quality", defaultQuality);
            await Upsert(db, "spectrum_mode", spectrumMode);
            await Upsert(db, "flaresolverr_url", flaresolverrUrl);
            await Upsert(db, "spotify_cookie", spotifyCookie);
            await db.SaveChangesAsync();
            PlaylistStore.SpectrumVerification = () => SpectrumModeValue(spectrumMode);
            FlareSolverrSolver.Url = flaresolverrUrl;
            MelodyBridge.Infrastructure.Services.SpotifySourceProvider.WebCookie = spotifyCookie;

            // The account credential fields save here too: they are as much
            // part of the page as the paths, and losing them silently on a
            // reload made the Connect buttons look like the only way in.
            await SpotifyAccount.SaveSettingAsync("client_id", spotifyClientId.Trim());
            await YouTubeAccount.SaveSettingAsync("client_id", youtubeClientId.Trim());
            await YouTubeAccount.SaveSettingAsync("client_secret", youtubeClientSecret.Trim());

            dirty = false;
            Notifications.Success("Settings saved.");
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>An edit landed: the floating save bar appears.</summary>
    private void MarkDirty() => dirty = true;

    /// <summary>Advisory path checks: warnings, never a blocked save.</summary>
    private void ValidatePaths()
    {
        MarkDirty();
        musicPathWarning = musicPath.Trim().Length == 0
            ? "New downloads need a folder here."
            : Directory.Exists(musicPath.Trim()) ? "" : "That folder does not exist from the app's point of view.";
        playlistPathWarning = playlistPath.Trim().Length == 0
            ? "M3U exports need a folder here."
            : Directory.Exists(playlistPath.Trim()) ? "" : "That folder does not exist from the app's point of view.";
        archivePathWarning = archivePath.Trim().Length == 0 || Directory.Exists(archivePath.Trim())
            ? ""
            : "That folder does not exist from the app's point of view.";
    }

    /// <summary>Browser back/forward moves the fragment: keep the shown tab in step.</summary>
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var fragment = Nav.ToAbsoluteUri(e.Location).Fragment.TrimStart('#');
        if (fragment == "connections") fragment = "media-servers";
        if (Tabs.Any(t => t.Id == fragment) && fragment != activeTab)
        {
            activeTab = fragment;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private static async Task Upsert(MelodyBridgeDbContext db, string key, string value)
    {
        var existing = await db.DownloaderSettings.FirstOrDefaultAsync(s => s.Key == key);
        if (existing != null) existing.Value = value;
        else db.DownloaderSettings.Add(new DownloaderSettingEntity { Key = key, Value = value });
    }

    private void ExportLogs() => Nav.NavigateTo("/api/logs/export", true);

