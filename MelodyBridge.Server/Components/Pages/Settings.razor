@page "/settings"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Accounts
@using MelodyBridge.Infrastructure.Audio
@using MelodyBridge.Infrastructure.Cloudflare
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Services
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject LogExporter Exporter
@inject NavigationManager Nav
@inject SpotifyAccountProvider SpotifyAccount
@inject YouTubeAccountProvider YouTubeAccount
@implements IDisposable

<PageTitle>Settings</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Configuration</span>
        <h1>Settings</h1>
        <p>Accounts, paths and download behaviour. Power knobs live on the Advanced page.</p>
    </div>
    <button class="btn-modern primary" @onclick="SaveAll">Save settings</button>
</section>

<nav class="tab-nav">
    @foreach (var tab in new[] { ("accounts", "Accounts"), ("jellyfin", "Jellyfin"), ("paths", "Paths"), ("quality", "Quality"), ("network", "Network") })
    {
        <button class="tab-link @(activeTab == tab.Item1 ? "active" : "")"
                @onclick="() => activeTab = tab.Item1">@tab.Item2</button>
    }
</nav>

@if (!string.IsNullOrWhiteSpace(savedMessage))
{
    <div class="toast-preview">@savedMessage</div>
}

@if (activeTab == "accounts")
{
    <section class="panel-card">
        <div class="panel-header">
            <div><span class="eyebrow">Accounts</span>
                <h2>Spotify &amp; YouTube</h2>
            </div>
        </div>
        <div class="hint-box">
            Connect your accounts to import private playlists and your liked
            songs. MelodyBridge only asks for read access: it never changes
            anything on your account. The redirect URI to register is
            <code>@RedirectUrl</code>.
        </div>

        <div class="account-grid">
            <div class="account-card">
                <strong>Spotify</strong>
                <span class="pill @(_spotifyConnected ? "ok" : "neutral")">
                    @(_spotifyConnected ? "connected" : "not connected")
                </span>
                @if (_spotifyConnected)
                {
                    <button class="btn-modern subtle" @onclick="() => Logout(SpotifyAccount)">Disconnect</button>
                }
                else
                {
                    <label>
                        Client ID (from developer.spotify.com)
                        <input @bind="spotifyClientId" placeholder="Spotify app Client ID" />
                    </label>
                    <span class="text-muted">Create a free app at developer.spotify.com,
                        add @RedirectUrl as redirect URI, paste the Client ID here.</span>
                    <button class="btn-modern primary" @onclick="ConnectSpotify">Connect Spotify</button>
                }
            </div>

            <div class="account-card">
                <strong>YouTube</strong>
                <span class="pill @(_youtubeConnected ? "ok" : "neutral")">
                    @(_youtubeConnected ? "connected" : "not connected")
                </span>
                @if (_youtubeConnected)
                {
                    <button class="btn-modern subtle" @onclick="() => Logout(YouTubeAccount)">Disconnect</button>
                }
                else
                {
                    <label>
                        Client ID (Google Cloud Console, OAuth Web application)
                        <input @bind="youtubeClientId" placeholder="OAuth client ID" />
                    </label>
                    <label>
                        Client secret
                        <input @bind="youtubeClientSecret" type="password" placeholder="OAuth client secret" />
                    </label>
                    <button class="btn-modern primary" @onclick="ConnectYouTube">Connect YouTube</button>
                }
            </div>
        </div>
        @if (accountMessage is not null)
        {
            <div class="toast-preview">@accountMessage</div>
        }
    </section>
}
else if (activeTab == "jellyfin")
{
    <section class="panel-card">
        <div class="panel-header">
            <div><span class="eyebrow">Media server</span>
                <h2>Jellyfin</h2>
            </div>
        </div>
        <div class="form-grid single">
            <label>Base URL <input @bind="jellyfinUrl" /></label>
            <label>API key <input @bind="jellyfinApiKey" type="password" /></label>
            <label>Default user ID <input @bind="jellyfinUserId" placeholder="optional" /></label>
        </div>
        <div class="hint-box">Docker default uses <code>http://host.docker.internal:8096</code>. Make sure Jellyfin is
            reachable.</div>
    </section>
}
else if (activeTab == "paths")
{
    <section class="panel-card">
        <div class="panel-header">
            <div><span class="eyebrow">Library</span>
                <h2>Paths</h2>
            </div>
        </div>
        <div class="form-grid single">
            <label>Music path <input @bind="musicPath" /></label>
            <label>Playlist output folder <input @bind="playlistPath" /></label>
        </div>
    </section>
}
else if (activeTab == "quality")
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Quality</span>
                <h2>Default audio quality</h2>
            </div>
        </div>
        <div class="hint-box">
            New playlists start with this setting. Every playlist can override
            it on its own page.
        </div>
        <div class="form-grid single">
            <label>
                Preset
                <select @bind="defaultQuality">
                    @foreach (var preset in Playlists.QualityPresets)
                    {
                        <option value="@preset.Value">@preset.Label</option>
                    }
                </select>
            </label>
        </div>
        <div class="panel-header">
            <div>
                <span class="eyebrow">Verification</span>
                <h2>Real quality check</h2>
            </div>
        </div>
        <div class="hint-box">
            Some sites hand out files that pretend to be 320 kbps but hold
            far less. The spectrum check measures what a file really
            contains and warns you next to the track when it looks inflated.
        </div>
        <div class="form-grid single">
            <label>
                Spectrum check
                <select @bind="spectrumMode">
                    <option value="Off">Off: trust the file</option>
                    <option value="Fast">Fast: check the first minute (recommended)</option>
                    <option value="Thorough">Thorough: check the whole file</option>
                </select>
            </label>
        </div>
    </section>
}
else if (activeTab == "network")
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Network</span>
                <h2>FlareSolverr (Cloudflare)</h2>
            </div>
            <span class="pill @(flareStatus is "ok" ? "ok" : flareStatus is null ? "neutral" : "err")">
                @(flareStatus is null ? "not tested" : flareStatus is "ok" ? "reachable" : "unreachable")
            </span>
        </div>
        <div class="hint-box">
            Lucida sits behind a Cloudflare challenge. FlareSolverr is a small
            companion container that solves it — the compose file ships one.
            Point this at it and test the connection; leave "off" to disable.
        </div>
        <div class="form-grid single">
            <label>
                FlareSolverr URL
                <input @bind="flaresolverrUrl" placeholder="http://flaresolverr:8191 or off" />
            </label>
        </div>
        <div class="flex-actions">
            <button class="btn-modern secondary" @onclick="TestFlareSolverr" disabled="@testingFlare">
                @(testingFlare ? "Testing…" : "Test connection")
            </button>
            <span class="text-muted">@flareMessage</span>
        </div>
    </section>

    <section class="panel-card about-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Diagnostics</span>
                <h2>Logs</h2>
            </div>
        </div>
        <p class="panel-description">
            Export the most recent application logs (up to 1000 entries)
            as a plain-text file for debugging or sharing.
        </p>
        <button class="btn-modern primary-outline" @onclick="ExportLogs">
            <span class="btn-icon">📥</span> Export logs
        </button>
    </section>
}

@code {
    private string activeTab = "accounts";
    private string jellyfinUrl = "http://host.docker.internal:8096";
    private string jellyfinApiKey = "";
    private string jellyfinUserId = "";
    private string musicPath = "/music";
    private string playlistPath = "/app/playlists";
    private string defaultQuality = "auto";
    private string spectrumMode = "Fast";
    private string flaresolverrUrl = "off";
    private string? flareStatus;
    private string flareMessage = string.Empty;
    private bool testingFlare;
    private string? savedMessage;

    [Inject] private IConfiguration Config { get; set; } = default!;

    private static SpectrumMode SpectrumModeValue(string mode) => mode switch
    {
        "Off" => SpectrumMode.Off,
        "Thorough" => SpectrumMode.Thorough,
        _ => SpectrumMode.Fast,
    };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.DownloaderSettings.ToListAsync();
        jellyfinUrl = FindSetting(settings, "jellyfin_url", "http://host.docker.internal:8096");
        jellyfinApiKey = FindSetting(settings, "jellyfin_key", "");
        jellyfinUserId = FindSetting(settings, "jellyfin_user", "");
        musicPath = FindSetting(settings, "music_path", "/music");
        playlistPath = FindSetting(settings, "playlist_path", "/app/playlists");
        defaultQuality = FindSetting(settings, "default_quality", "auto");
        if (!PlaylistStore.IsValidFormat(defaultQuality)) defaultQuality = "auto";
        spectrumMode = FindSetting(settings, "spectrum_mode", Config?["SpectrumAnalysis:Mode"] ?? "Fast");
        flaresolverrUrl = FindSetting(settings, "flaresolverr_url", Config?["FlareSolverr:Url"] ?? "off");

        _spotifyConnected = await SpotifyAccount.IsConnectedAsync();
        _youtubeConnected = await YouTubeAccount.IsConnectedAsync();
        spotifyClientId = await SpotifyAccount.GetSettingAsync("client_id") ?? string.Empty;
        youtubeClientId = await YouTubeAccount.GetSettingAsync("client_id") ?? string.Empty;
        youtubeClientSecret = await YouTubeAccount.GetSettingAsync("client_secret") ?? string.Empty;
    }

    private bool _spotifyConnected;
    private bool _youtubeConnected;
    private string? accountMessage;
    private string spotifyClientId = string.Empty;
    private string youtubeClientId = string.Empty;
    private string youtubeClientSecret = string.Empty;

    /// <summary>The page's own URL, as registered as the OAuth redirect.</summary>
    private string RedirectUrl => Nav.ToAbsoluteUri("auth/callback").ToString();

    private async Task Connect(IAccountSourceProvider provider, string? clientId = null)
    {
        try
        {
            accountMessage = null;
            if (clientId is not null)
            {
                // The typed client id is saved first: BeginLogin needs it.
                var value = clientId.Trim();
                if (value.Length == 0)
                    throw new InvalidOperationException("Paste the Client ID first.");
                await provider.SaveSettingAsync("client_id", value);
            }
            var loginUrl = await provider.BeginLoginAsync(RedirectUrl);
            Nav.NavigateTo(loginUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            accountMessage = ex.Message;
        }
    }

    private Task ConnectSpotify() => Connect(SpotifyAccount, spotifyClientId);

    private async Task ConnectYouTube()
    {
        if (youtubeClientId.Trim().Length == 0 || youtubeClientSecret.Trim().Length == 0)
        {
            accountMessage = "Paste both the YouTube client id and secret first.";
            return;
        }
        await YouTubeAccount.SaveSettingAsync("client_id", youtubeClientId.Trim());
        await YouTubeAccount.SaveSettingAsync("client_secret", youtubeClientSecret.Trim());
        await Connect(YouTubeAccount);
    }

    private async Task Logout(IAccountSourceProvider provider)
    {
        await provider.LogoutAsync();
        _spotifyConnected = await SpotifyAccount.IsConnectedAsync();
        _youtubeConnected = await YouTubeAccount.IsConnectedAsync();
        accountMessage = "Account disconnected";
    }

    private static string FindSetting(List<DownloaderSettingEntity> settings, string key, string fallback)
        => settings.FirstOrDefault(s => s.Key == key)?.Value ?? fallback;

    private async Task TestFlareSolverr()
    {
        testingFlare = true;
        flareMessage = string.Empty;
        try
        {
            var url = flaresolverrUrl.Trim();
            if (url.Length == 0 || url.Equals("off", StringComparison.OrdinalIgnoreCase))
            {
                flareStatus = "off";
                flareMessage = "Solver is off: Lucida stays unavailable.";
                return;
            }
            using var http = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(8) };
            var response = await http.PostAsJsonAsync($"{url.TrimEnd('/')}/v1",
                new { cmd = "sessions.list" });
            flareStatus = response.IsSuccessStatusCode ? "ok" : $"http {(int)response.StatusCode}";
            flareMessage = response.IsSuccessStatusCode
                ? "FlareSolverr answered: Lucida can use it."
                : "It responded but not with OK. Check the URL and container logs.";
        }
        catch (Exception ex)
        {
            flareStatus = "err";
            flareMessage = $"Could not reach it: {ex.Message}";
        }
        finally
        {
            testingFlare = false;
            StateHasChanged();
        }
    }

    private async Task SaveAll()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Upsert(db, "jellyfin_url", jellyfinUrl);
        await Upsert(db, "jellyfin_key", jellyfinApiKey);
        await Upsert(db, "jellyfin_user", jellyfinUserId);
        await Upsert(db, "music_path", musicPath);
        await Upsert(db, "playlist_path", playlistPath);
        await Upsert(db, "default_quality", defaultQuality);
        await Upsert(db, "spectrum_mode", spectrumMode);
        await Upsert(db, "flaresolverr_url", flaresolverrUrl);
        await db.SaveChangesAsync();
        PlaylistStore.SpectrumVerification = () => SpectrumModeValue(spectrumMode);
        FlareSolverrSolver.Url = flaresolverrUrl;
        savedMessage = "Settings saved.";
    }

    private static async Task Upsert(MelodyBridgeDbContext db, string key, string value)
    {
        var existing = await db.DownloaderSettings.FirstOrDefaultAsync(s => s.Key == key);
        if (existing != null) existing.Value = value;
        else db.DownloaderSettings.Add(new DownloaderSettingEntity { Key = key, Value = value });
    }

    private void ExportLogs() => Nav.NavigateTo("/api/logs/export", true);

    public void Dispose() { }
}
