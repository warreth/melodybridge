    private async Task TestFlareSolverr()
    {
        testingFlare = true;
        flareMessage = string.Empty;
        try
        {
            var url = flaresolverrUrl.Trim();
            if (url.Length == 0 || url.Equals("off", StringComparison.OrdinalIgnoreCase))
            {
                flareStatus = "off";
                flareMessage = "Solver is off: Lucida stays unavailable.";
                return;
            }
            if (url.Equals("auto", StringComparison.OrdinalIgnoreCase))
            {
                // Same sweep the solver runs: first /health that answers
                // 200 wins, so the report matches what Lucida will use.
                using var http = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(2) };
                foreach (var candidate in MelodyBridge.Infrastructure.Cloudflare.FlareSolverrSolver.AutoDetectCandidates)
                {
                    try
                    {
                        using var response = await http.GetAsync($"{candidate}/health");
                        if (response.IsSuccessStatusCode)
                        {
                            flareStatus = "ok";
                            flareMessage = $"FlareSolverr answered at {candidate}: Lucida can use it.";
                            return;
                        }
                    }
                    catch (Exception)
                    {
                        // Unreachable candidate: fall through to the next one.
                    }
                }
                flareStatus = "err";
                flareMessage = "No FlareSolverr answered on the Docker network. Check the container.";
                return;
            }
            using var http2 = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(8) };
            var response2 = await http2.PostAsJsonAsync($"{url.TrimEnd('/')}/v1",
                new { cmd = "sessions.list" });
            flareStatus = response2.IsSuccessStatusCode ? "ok" : $"http {(int)response2.StatusCode}";
            flareMessage = response2.IsSuccessStatusCode
                ? "FlareSolverr answered: Lucida can use it."
                : "It responded but not with OK. Check the URL and container logs.";
        }
        catch (Exception ex)
        {
            flareStatus = "err";
            flareMessage = $"Could not reach it: {ex.Message}";
        }
        finally
        {
            testingFlare = false;
            StateHasChanged();
        }
    }

    private async Task SaveAll()
    {
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            // Stored trimmed: a stray trailing space would otherwise land
            // inside a path the downloader uses verbatim.
            musicPath = musicPath.Trim();
            playlistPath = playlistPath.Trim();
            archivePath = archivePath.Trim();
            await Upsert(db, "music_path", musicPath);
            await Upsert(db, "playlist_path", playlistPath);
            await Upsert(db, "archive_path", archivePath);
            await Upsert(db, "playlist_folders", playlistFolders ? "true" : "false");
            await Upsert(db, "archive_format", archiveFormat);
            await Upsert(db, "default_quality", defaultQuality);
            await Upsert(db, "spectrum_mode", spectrumMode);
            await Upsert(db, "spectrum_class_gap", spectrumClassGap);
            await Upsert(db, "quality_length_tolerance_seconds", lengthToleranceSeconds);
            await Upsert(db, "quality_length_tolerance_percent", lengthTolerancePercent);
            await Upsert(db, "flaresolverr_url", flaresolverrUrl);
            await Upsert(db, "spotify_cookie", spotifyCookie);
            await db.SaveChangesAsync();
            PlaylistStore.Verification = () => VerificationOptions.FromSettings(
                spectrumMode, spectrumClassGap, lengthToleranceSeconds, lengthTolerancePercent);
            FlareSolverrSolver.Url = flaresolverrUrl;
            MelodyBridge.Infrastructure.Services.SpotifySourceProvider.WebCookie = spotifyCookie;

            // The account credential fields save here too: they are as much
            // part of the page as the paths, and losing them silently on a
            // reload made the Connect buttons look like the only way in.
            await SpotifyAccount.SaveSettingAsync("client_id", spotifyClientId.Trim());
            await YouTubeAccount.SaveSettingAsync("client_id", youtubeClientId.Trim());
            await YouTubeAccount.SaveSettingAsync("client_secret", youtubeClientSecret.Trim());

            // Notifications: the toast gates and the ntfy push block.
            await TourReset.SetAsync("notify_downloads", notifyDownloads ? "true" : "false");
            await TourReset.SetAsync("notify_failures", notifyFailures ? "true" : "false");
            await SaveNtfyAsync();

            // Path changes move the library: playlists, scan locations and
            // the files themselves follow the new root. The remembered
            // root only advances on a real value: clearing the field then
            // filling in a new root later still moves the old files.
            var newMusicPath = musicPath;
            var newArchivePath = archivePath;
            var move = await PathMover.MoveAsync(
                savedMusicPath, newMusicPath, savedArchivePath, newArchivePath);
            if (newMusicPath.Length > 0) savedMusicPath = newMusicPath;
            if (newArchivePath.Length > 0) savedArchivePath = newArchivePath;
            await LoadInitSettingsAsync(); // the default pill reads fresh rows

            dirty = false;
            if (move.FailedFiles > 0)
            {
                Notifications.Warn(
                    $"Settings saved. Moved {move.Files} file(s); {move.FailedFiles} kept their old path because the destination was taken.");
            }
            else if (move.MusicMoveRefused || move.ArchiveMoveRefused)
            {
                // The hint promises the library moves; when the new root
                // sits inside the old one, nothing can move. Say so.
                Notifications.Warn(move.Files > 0
                    ? $"Settings saved. Moved {move.Files} file(s), but the rest was not moved: the new folder sits inside the old one (or the other way around). Pick a folder outside the current one; existing playlists keep using their current folder."
                    : "Settings saved, but the library was not moved: the new folder sits inside the old one (or the other way around). Pick a folder outside the current one to move the library; existing playlists keep using their current folder.");
            }
            else if (move.MovedAnything)
            {
                Notifications.Success(
                    $"Settings saved. Moved {move.Files} file(s) into the new path.");
            }
            else
            {
                Notifications.Success("Settings saved.");
            }
        }
        finally
        {
            saving = false;
        }
    }

