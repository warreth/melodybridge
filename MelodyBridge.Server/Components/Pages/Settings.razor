@code {
    // Tab ids double as URL fragments: /settings#accounts opens Accounts.
    private static readonly (string Id, string Label)[] Tabs =
    [
        ("accounts", "Accounts"),
        ("media-servers", "Media servers"),
        ("paths", "Default paths"),
        ("quality", "Quality"),
        ("network", "Network"),
        ("notifications", "Notifications"),
        ("about", "About"),
    ];

    /// <summary>The same list as TabStrip.Tab records for the component.</summary>
    private static readonly TabStrip.Tab[] TabStripTabs =
        [.. Tabs.Select(t => new TabStrip.Tab(t.Id, t.Label))];

    // Accent palette ids, matching the app.css palettes and app.js ACCENTS.
    private static readonly string[] AccentOptions = ["teal", "blue", "violet", "rose", "amber"];
    private string _activeAccent = "teal";

    private static readonly (string Id, string Label, string Icon)[] ThemeModes =
    [
        ("light", "Light", "sun"),
        ("dark", "Dark", "moon"),
        ("auto", "Auto", "monitor"),
    ];
    private string _themePreference = "auto";

    private void PickTheme(string mode)
    {
        if (!ThemeModes.Any(option => option.Id == mode)) return;
        _themePreference = mode;
        _ = JS.InvokeVoidAsync("melody.setTheme", mode);
    }

    private string settingsSearch = "";

    private sealed record SettingsSearchHit(
        string Label, string Tab, string Detail, string Keywords)
    {
        public string TabLabel => Tabs.FirstOrDefault(tab => tab.Id == Tab).Label ?? Tab;
    }

    // A curated index: the Settings page is too large to full-text filter
    // from a component, so the search jumps to the tab that owns a field.
    private static readonly SettingsSearchHit[] SearchIndex =
    [
        new("Spotify account", "accounts", "Connect, disconnect and private playlists", "spotify login oauth client id"),
        new("Spotify web session", "accounts", "Unofficial cookie login for free accounts", "spotify cookie unofficial web session"),
        new("YouTube account", "accounts", "Connect or disconnect the Google login", "youtube google oauth client secret"),
        new("Jellyfin server", "media-servers", "URL, API key and user", "jellyfin media server connection"),
        new("Plex server", "media-servers", "URL and token", "plex media server token"),
        new("Subsonic or Navidrome", "media-servers", "URL, user and password", "subsonic navidrome server"),
        new("Music folder", "paths", "Where downloads and the library live", "music path download folder"),
        new("Playlist folders", "paths", "One folder per playlist or a flat folder", "playlist folder layout"),
        new("Archive folder", "paths", "Where archive copies are written", "archive folder format copy"),
        new("Default quality", "quality", "Space Saver, High Quality, Lossless or no filter", "quality mp3 flac lossless bitrate"),
        new("FlareSolverr", "network", "Cloudflare solver for Lucida", "flaresolverr cloudflare lucida solver"),
        new("Notifications", "notifications", "Toast rules for downloads and failures", "toast notification download failure"),
        new("ntfy push", "notifications", "Topic, server and token for phone alerts", "ntfy push phone alert topic token"),
        new("Theme", "about", "Light, Dark or Auto", "theme dark light auto appearance"),
        new("Accent color", "about", "Teal, blue, violet, rose or amber", "accent color theme"),
        new("Export logs", "about", "Download the recent log buffer", "logs export diagnostics"),
        new("Database backup", "about", "Export or import the SQLite database", "database backup export import restore"),
        new("Update check", "about", "Release channel and version", "update version release beta"),
        new("Guided tour", "about", "Show the dashboard tour again", "tour help intro"),
        new("Setup checklist", "about", "Show the first-run checklist again", "setup checklist intro getting started"),
    ];

    private IReadOnlyList<SettingsSearchHit> SearchMatches
    {
        get
        {
            var query = settingsSearch.Trim();
            if (query.Length < 2) return Array.Empty<SettingsSearchHit>();
            return SearchIndex
                .Where(hit => hit.Label.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || hit.Detail.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || hit.Keywords.Contains(query, StringComparison.OrdinalIgnoreCase))
                .OrderBy(hit => hit.Label, StringComparer.OrdinalIgnoreCase)
                .Take(8)
                .ToList();
        }
    }

    private void JumpToSetting(SettingsSearchHit hit)
    {
        settingsSearch = "";
        SelectTab(hit.Tab);
    }

    private void PickAccent(string accent)
    {
        if (!AccentOptions.Contains(accent)) return;
        _activeAccent = accent;
        _ = JS.InvokeVoidAsync("melody.setAccent", accent);
    }

    // Sync the swatch with the browser's stored accent once JS is
    // available. A direct /settings#about load renders the About panel
    // before this runs, so re-render when a stored value was found.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var changed = false;

        try
        {
            var stored = await JS.InvokeAsync<string>("melody.getAccent");
            if (AccentOptions.Contains(stored) && stored != _activeAccent)
            {
                _activeAccent = stored;
                changed = true;
            }
        }
        catch (JSException)
        {
            // Interop unavailable (tests, static render): keep the default.
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; nothing to update.
        }
        catch (InvalidOperationException)
        {
            // No JS runtime in a static render.
        }

        try
        {
            var theme = await JS.InvokeAsync<string>("melody.getThemePreference");
            if (ThemeModes.Any(option => option.Id == theme) && theme != _themePreference)
            {
                _themePreference = theme;
                changed = true;
            }
        }
        catch (JSException)
        {
            // Interop unavailable (tests, static render): keep Auto.
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; nothing to update.
        }
        catch (InvalidOperationException)
        {
            // No JS runtime in a static render.
        }

        if (changed) StateHasChanged();
    }

