    private async Task ImportDatabase(InputFileChangeEventArgs e)
    {
        if (e.FileCount == 0) return;
        dbMessage = "Importing...";
        try
        {
            await using var stream = e.File.OpenReadStream(200_000_000);
            await DbBackup.ImportZipAsync(stream);
            pendingRestore = true;
            dbMessage = "Database imported. Restart MelodyBridge to apply it.";
            Notifications.Warn("Database imported: restart to apply.");
        }
        catch (Exception ex)
        {
            dbMessage = $"Import failed: {ex.Message}";
            Notifications.Error($"Import failed: {ex.Message}");
        }
        StateHasChanged();
    }

    /// <summary>
    /// Throws a staged import away. The live database was never touched,
    /// so the app keeps running on the data it has.
    /// </summary>
    private async Task DiscardPendingImport()
    {
        try
        {
            if (await DbBackup.DiscardPendingRestoreAsync())
            {
                pendingRestore = false;
                dbMessage = "The staged import was discarded.";
                Notifications.Info("The staged database import was discarded.");
            }
        }
        catch (Exception ex)
        {
            Notifications.Error($"Could not discard the staged import: {ex.Message}");
        }
        StateHasChanged();
    }

