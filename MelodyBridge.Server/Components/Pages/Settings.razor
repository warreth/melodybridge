    private async Task Connect(IAccountSourceProvider provider, string redirectUrl, string? clientId = null)
    {
        try
        {
            if (clientId is not null)
            {
                // The typed client id is saved first: BeginLogin needs it.
                var value = clientId.Trim();
                if (value.Length == 0)
                    throw new InvalidOperationException("Paste the Client ID first.");
                await provider.SaveSettingAsync("client_id", value);
            }
            var loginUrl = await provider.BeginLoginAsync(redirectUrl);
            // The login URL is another origin (accounts.spotify.com, ...).
            // NavigateTo with forceLoad tears the circuit down mid-call on
            // exactly these cross-origin jumps (a known Blazor Server race),
            // so the browser location is assigned directly instead.
            await JS.InvokeVoidAsync("window.location.assign", loginUrl);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex.Message);
        }
    }

