@page "/settings"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Accounts
@using MelodyBridge.Infrastructure.Audio
@using MelodyBridge.Infrastructure.Cloudflare
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Services
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject LogExporter Exporter
@inject NavigationManager Nav
@inject SpotifyAccountProvider SpotifyAccount
@inject YouTubeAccountProvider YouTubeAccount
@inject MediaServerProfileStore ServerProfiles
@inject SettingsStore TourReset
@inject DatabaseBackupService DbBackup
@inject UpdateCheckService UpdateCheck
@inject NotificationService Notifications
@inject IJellyfinUserDirectory JellyfinDirectory
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Settings</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Configuration</span>
        <h1>Settings</h1>
        <p>Accounts, paths and download behaviour. Power knobs live on the Advanced page.</p>
    </div>
    <button class="btn-modern primary" @onclick="SaveAll">Save settings</button>
</section>

<nav class="tab-nav">
    @foreach (var (id, label) in Tabs)
    {
        <button class="tab-link @(activeTab == id ? "active" : "")"
                @onclick="() => SelectTab(id)">@label</button>
    }
</nav>

@if (!string.IsNullOrWhiteSpace(savedMessage))
{
    <div class="toast-preview">@savedMessage</div>
}

@if (activeTab == "accounts")
{
    <section class="panel-card">
        <div class="panel-header">
            <div><span class="eyebrow">Accounts</span>
                <h2>Spotify &amp; YouTube</h2>
            </div>
        </div>
        <div class="hint-box">
            Connect your accounts to import private playlists and your liked
            songs. MelodyBridge only asks for read access: it never changes
            anything on your account.
        </div>

        <div class="account-grid">
            <div class="account-card">
                <strong>Spotify</strong>
                <span class="pill @(_spotifyConnected ? "ok" : "neutral")">
                    @(_spotifyConnected ? "connected" : "not connected")
                </span>
                @if (_spotifyConnected)
                {
                    <button class="btn-modern subtle" @onclick="() => Logout(SpotifyAccount)">Disconnect</button>
                }
                else
                {
                    <ol>
                        <li>
                            Open <a href="https://developer.spotify.com/dashboard" target="_blank" rel="noopener">developer.spotify.com/dashboard</a>
                            and click <em>Create app</em>. Any name works. When Spotify asks
                            <em>which APIs you are planning to use</em>, pick <strong>Web API</strong> —
                            not Ads API, Web Playback SDK, iOS or Android. Web API is the one that
                            can read your playlists and liked songs.
                        </li>
                        <li>
                            In the app settings (top-right <em>Settings</em>), add this exact redirect URI:
                            <div class="hint-box">
                                <code>@SpotifyRedirectUrl</code>
                                <div class="flex-actions">
                                    <button class="btn-modern ghost small" type="button" @onclick="CopySpotifyRedirect">Copy</button>
                                    <span class="text-muted">@copyHint</span>
                                </div>
                            </div>
                        </li>
                        <li>Copy the <em>Client ID</em> from the same settings page, paste it below and click Connect.</li>
                    </ol>
                    <p class="text-muted">
                        New Spotify apps start in <em>development mode</em>: that is fine for
                        personal use — you are the owner. Your Spotify account must have
                        Premium while the app stays in development mode, and the login only
                        works for you and anyone you explicitly allowlist in the app's
                        Settings → Users Management.
                    </p>
                    <label>
                        Client ID (from developer.spotify.com)
                        <input @bind="spotifyClientId" placeholder="Spotify app Client ID" />
                    </label>
                    <button class="btn-modern primary" @onclick="ConnectSpotify">Connect Spotify</button>
                }
            </div>

            <div class="account-card">
                <strong>YouTube</strong>
                <span class="pill @(_youtubeConnected ? "ok" : "neutral")">
                    @(_youtubeConnected ? "connected" : "not connected")
                </span>
                @if (_youtubeConnected)
                {
                    <button class="btn-modern subtle" @onclick="() => Logout(YouTubeAccount)">Disconnect</button>
                }
                else
                {
                    <ol>
                        <li>
                            Open <a href="https://console.cloud.google.com" target="_blank" rel="noopener">console.cloud.google.com</a>,
                            create a project, enable the <em>YouTube Data API v3</em>
                            (APIs &amp; Services → Library), then create OAuth credentials of type
                            <em>Web application</em> (APIs &amp; Services → Credentials).
                        </li>
                        <li>
                            Add this exact redirect URI to the OAuth client:
                            <div class="hint-box">
                                <code>@YouTubeRedirectUrl</code>
                                <div class="flex-actions">
                                    <button class="btn-modern ghost small" type="button" @onclick="CopyYouTubeRedirect">Copy</button>
                                    <span class="text-muted">@copyHint</span>
                                </div>
                            </div>
                        </li>
                        <li>Paste the client ID and secret here and click Connect.</li>
                    </ol>
                    <p class="text-muted">
                        Before the first login, open the OAuth consent screen
                        (APIs &amp; Services → OAuth consent screen) and add your own Google
                        account as a <em>Test user</em> — unverified personal apps only work
                        for their test users. You will see an "unverified app" warning: that
                        is expected for a self-hosted personal app; choose
                        <em>Continue to project</em>.
                    </p>
                    <label>
                        Client ID (Google Cloud Console, OAuth Web application)
                        <input @bind="youtubeClientId" placeholder="OAuth client ID" />
                    </label>
                    <label>
                        Client secret
                        <input @bind="youtubeClientSecret" type="password" placeholder="OAuth client secret" />
                    </label>
                    <button class="btn-modern primary" @onclick="ConnectYouTube">Connect YouTube</button>
                }
            </div>
        </div>
        @if (accountMessage is not null)
        {
            <div class="toast-preview">@accountMessage</div>
        }
    </section>
}
else if (activeTab == "connections")
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Connections</span>
                <h2>Media server profiles</h2>
            </div>
            <button class="btn-modern secondary small" @onclick="StartNewProfile">Add profile</button>
        </div>
        <div class="hint-box">
            Named server profiles several sync jobs can share. Marking one
            profile as the app default feeds the liked-songs sync.
        </div>
        @if (migratedFromOldSettings)
        {
            <div class="hint-box">
                Your old single-server Jellyfin settings moved into a profile
                named "Default". Edit it here from now on.
            </div>
        }
        @if (profiles.Count == 0)
        {
            <div class="empty-state">No profiles yet. Add one to reuse a server across sync jobs.</div>
        }
        else
        {
            <div class="profile-list">
                @foreach (var profile in profiles)
                {
                    <div class="profile-row">
                        <div style="flex:1; min-width:0;">
                            <strong>@profile.Name</strong>
                            <span class="pill neutral">@profile.Kind</span>
                            @if (IsAppDefault(profile))
                            {
                                <span class="pill ok">default</span>
                            }
                            @if (profileTestStatus.TryGetValue(profile.Id, out var st) && st is not null)
                            {
                                <span class="pill @(st == "ok" ? "ok" : "err")">@(st == "ok" ? "reachable" : "unreachable")</span>
                            }
                            <div class="text-muted" style="font-size:.85rem">@profile.BaseUrl</div>
                        </div>
                        <div class="flex-actions">
                            <button class="btn-modern ghost small" @onclick="() => EditProfile(profile)">Edit</button>
                            <button class="btn-modern ghost small" @onclick="() => AskDeleteProfile(profile)">Delete</button>
                            <button class="btn-modern secondary small" @onclick="() => MakeAppDefault(profile)">Use as app default</button>
                            <button class="btn-modern secondary small" disabled="@(testingProfile == profile.Id)" @onclick="() => TestProfile(profile)">
                                @(testingProfile == profile.Id ? "Testing…" : "Test")
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @if (deleteProfileId is { } doomedProfileId)
    {
        <ConfirmDialog Show="true"
                       Eyebrow="Delete profile"
                       Title=@($"Delete '{deleteProfileName}'?")
                       Message="Sync jobs that use this profile need a new server picked in their settings."
                       ConfirmLabel="Delete profile"
                       OnConfirm=@(() => DeleteProfile(doomedProfileId))
                       OnCancel="CancelDeleteProfile" />
    }

    @if (editingProfile is not null)
    {
        <section class="panel-card">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Edit</span>
                    <h2>@(editingIsNew ? "New profile" : editingProfile.Name)</h2>
                </div>
            </div>
            <div class="form-grid single">
                <label>Name <input @bind="editingProfile.Name" placeholder="Living room Jellyfin" /></label>
                <label>Kind
                    <select @bind="editingProfile.Kind">
                        <option value="Jellyfin">Jellyfin</option>
                        <option value="Plex">Plex (when supported)</option>
                    </select>
                </label>
                <label>Base URL <input @bind="editingProfile.BaseUrl" placeholder="http://jellyfin:8096" /></label>
                <label>API key <input @bind="editingProfile.ApiKey" type="password" placeholder="API key" /></label>
            </div>
            <div class="flex-actions">
                <button class="btn-modern ghost" @onclick="CancelProfileEdit">Cancel</button>
                <button class="btn-modern primary" @onclick="SaveProfile">Save profile</button>
            </div>
        </section>
    }
}
else if (activeTab == "paths")
{
    <section class="panel-card">
        <div class="panel-header">
            <div><span class="eyebrow">Library</span>
                <h2>Paths</h2>
            </div>
        </div>
        <div class="form-grid single">
            <label>Music path <input @bind="musicPath" /></label>
            <label>Playlist output folder <input @bind="playlistPath" /></label>
        </div>
        <div class="hint-box">
            Enter paths as the server sees them. Inside Docker that is the
            container path (for example <code>/music</code>), not the host
            path — check what the volume is mounted as in your
            <code>compose.yml</code>. New downloads land under the music
            path; M3U files go to the playlist output folder.
        </div>
    </section>
}
else if (activeTab == "quality")
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Quality</span>
                <h2>Default audio quality</h2>
            </div>
        </div>
        <div class="hint-box">
            New playlists start with this setting. Every playlist can override
            it on its own page.
        </div>
        <QualityPicker @bind-Value="defaultQuality" />
        <div class="panel-header">
            <div>
                <span class="eyebrow">Verification</span>
                <h2>Real quality check</h2>
            </div>
        </div>
        <div class="hint-box">
            Some sites hand out files that pretend to be 320 kbps but hold
            far less. The spectrum check measures what a file really
            contains and warns you next to the track when it looks inflated.
        </div>
        <div class="form-grid single">
            <label>
                Spectrum check
                <select @bind="spectrumMode">
                    <option value="Off">Off: trust the file</option>
                    <option value="Fast">Fast: check the first minute (recommended)</option>
                    <option value="Thorough">Thorough: check the whole file</option>
                </select>
            </label>
        </div>
    </section>
}
else if (activeTab == "network")
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Network</span>
                <h2>FlareSolverr (Cloudflare)</h2>
            </div>
            <span class="pill @(flareStatus is "ok" ? "ok" : flareStatus is null ? "neutral" : "err")">
                @(flareStatus is null ? "not tested" : flareStatus is "ok" ? "reachable" : "unreachable")
            </span>
        </div>
        <div class="hint-box">
            Lucida sits behind a Cloudflare challenge. FlareSolverr is a small
            companion container that solves it — the compose file ships one.
            Point this at it and test the connection; leave "off" to disable.
        </div>
        <div class="form-grid single">
            <label>
                FlareSolverr URL
                <input @bind="flaresolverrUrl" placeholder="http://flaresolverr:8191 or off" />
            </label>
        </div>
        <div class="flex-actions">
            <button class="btn-modern secondary" @onclick="TestFlareSolverr" disabled="@testingFlare">
                @(testingFlare ? "Testing…" : "Test connection")
            </button>
            <span class="text-muted">@flareMessage</span>
        </div>
    </section>

}
else if (activeTab == "about")
{
    <section class="panel-card about-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">About</span>
                <h2>MelodyBridge @AppInfo.Version</h2>
            </div>
        </div>
        <div class="flex-actions">
            <button class="btn-modern secondary" @onclick="CheckForUpdates" disabled="@checkingUpdate">
                @(checkingUpdate ? "Checking…" : "Check for updates")
            </button>
            @if (updateResult is { } u)
            {
                @if (u.Succeeded && UpdateCheckService.IsNewer(u.LatestVersion!, AppInfo.Version))
                {
                    <span class="pill ok">Update available: v@(u.LatestVersion)</span>
                    <a class="hint" href="@u.ReleaseUrl" target="_blank" rel="noopener">Release notes ↗</a>
                }
                else if (u.Succeeded)
                {
                    <span class="pill neutral">You are up to date</span>
                }
                else
                {
                    <span class="pill err" title="@u.Error">Check failed</span>
                }
            }
        </div>
        <div class="hint-box">
            Self-hosted and open source. Docs live at
            <a href="https://docs.melodybridge.app" target="_blank" rel="noopener">docs.melodybridge.app</a> —
            quick start, accounts, Lucida and the Docker guide.
        </div>
        <div class="flex-actions">
            <button class="btn-modern ghost" @onclick="RestartTour">Show the guided tour again</button>
        </div>
    </section>

    <section class="panel-card about-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Diagnostics</span>
                <h2>Logs</h2>
            </div>
        </div>
        <p class="panel-description">
            Export the most recent application logs (up to 1000 entries)
            as a plain-text file for debugging or sharing.
        </p>
        <button class="btn-modern primary-outline" @onclick="ExportLogs">
            <span class="btn-icon">📥</span> Export logs
        </button>
    </section>

    <section class="panel-card about-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Backup</span>
                <h2>Database</h2>
            </div>
        </div>
        <div class="hint-box">
            The zip contains a consistent snapshot (playlists, tracks,
            settings). Import replaces the current database and parks the
            old one next to it as .preimport.bak — restart after
            importing so the app lets go of the old file.
        </div>
        <div class="flex-actions">
            <button class="btn-modern secondary" @onclick="ExportDatabase">Export zip</button>
            <InputFile OnChange="ImportDatabase" accept=".zip" class="btn-modern ghost" />
        </div>
        @if (!string.IsNullOrWhiteSpace(dbMessage))
        {
            <div class="hint-box">@dbMessage</div>
        }
    </section>
}

@code {
    // Tab ids double as URL fragments: /settings#accounts opens Accounts.
    private static readonly (string Id, string Label)[] Tabs =
    [
        ("accounts", "Accounts"),
        ("connections", "Media servers"),
        ("paths", "Paths"),
        ("quality", "Quality"),
        ("network", "Network"),
        ("about", "About"),
    ];

    private string activeTab = "accounts";
    private string musicPath = "/music";
    private string playlistPath = "/app/playlists";
    private string defaultQuality = "auto";
    private string spectrumMode = "Fast";
    private string flaresolverrUrl = "off";
    private string? flareStatus;
    private string flareMessage = string.Empty;
    private bool testingFlare;
    private string? savedMessage;

    // Connections tab
    private List<MediaServerProfile> profiles = [];
    private MediaServerProfile? editingProfile;
    private bool editingIsNew;
    private bool migratedFromOldSettings;
    private readonly Dictionary<string, string?> profileTestStatus = [];
    private string? testingProfile;

    // About tab
    private UpdateCheckResult? updateResult;
    private bool checkingUpdate;
    private string? dbMessage;

    [Inject] private IConfiguration Config { get; set; } = default!;

    private static SpectrumMode SpectrumModeValue(string mode) => mode switch
    {
        "Off" => SpectrumMode.Off,
        "Thorough" => SpectrumMode.Thorough,
        _ => SpectrumMode.Fast,
    };

    protected override async Task OnInitializedAsync()
    {
        // /settings#accounts, #connections, ... opens that tab directly:
        // the auth callback and the dashboard link here with a fragment.
        var fragment = Nav.ToAbsoluteUri(Nav.Uri).Fragment.TrimStart('#');
        if (Tabs.Any(t => t.Id == fragment)) activeTab = fragment;

        profiles = (await ServerProfiles.GetAllAsync()).ToList();

        // Migration: the old single-server settings become one profile.
        if (profiles.Count == 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var oldUrl = await db.DownloaderSettings
                .Where(s => s.Key == "jellyfin_url" && s.Value != "")
                .Select(s => s.Value)
                .FirstOrDefaultAsync();
            if (oldUrl is not null)
            {
                var oldKey = await db.DownloaderSettings
                    .Where(s => s.Key == "jellyfin_key").Select(s => s.Value)
                    .FirstOrDefaultAsync() ?? "";
                await ServerProfiles.SaveAsync(new MediaServerProfile
                {
                    Name = "Default",
                    Kind = "Jellyfin",
                    BaseUrl = oldUrl,
                    ApiKey = oldKey,
                });
                profiles = (await ServerProfiles.GetAllAsync()).ToList();
                migratedFromOldSettings = true;
            }
        }

        await LoadInitSettingsAsync();
        var settings = _initSettings!;
        musicPath = FindSetting(settings, "music_path", "/music");
        playlistPath = FindSetting(settings, "playlist_path", "/app/playlists");
        defaultQuality = FindSetting(settings, "default_quality", "auto");
        if (!PlaylistStore.IsValidFormat(defaultQuality)) defaultQuality = "auto";
        spectrumMode = FindSetting(settings, "spectrum_mode", Config?["SpectrumAnalysis:Mode"] ?? "Fast");
        flaresolverrUrl = FindSetting(settings, "flaresolverr_url", Config?["FlareSolverr:Url"] ?? "off");

        _spotifyConnected = await SpotifyAccount.IsConnectedAsync();
        _youtubeConnected = await YouTubeAccount.IsConnectedAsync();
        spotifyClientId = await SpotifyAccount.GetSettingAsync("client_id") ?? string.Empty;
        youtubeClientId = await YouTubeAccount.GetSettingAsync("client_id") ?? string.Empty;
        youtubeClientSecret = await YouTubeAccount.GetSettingAsync("client_secret") ?? string.Empty;
    }

    private bool _spotifyConnected;
    private bool _youtubeConnected;
    private string? accountMessage;
    private string spotifyClientId = string.Empty;
    private string youtubeClientId = string.Empty;
    private string youtubeClientSecret = string.Empty;
    private string copyHint = string.Empty;

    /// <summary>The redirect URI for one provider, as registered in its
    /// app settings. The provider marker tells the callback page which
    /// account to finish; Spotify requires the URI to match exactly, so
    /// the same string is used at login start and at token exchange.
    /// Spotify also rejects "localhost" (April 2025 rule), so loopback
    /// requests are shown and sent with the 127.0.0.1 literal instead.</summary>
    private string RedirectUrlFor(string provider)
        => LoopbackUri(Nav.ToAbsoluteUri($"auth/callback?provider={provider}"));

    private string SpotifyRedirectUrl => RedirectUrlFor("spotify");
    private string YouTubeRedirectUrl => RedirectUrlFor("youtube");

    /// <summary>Replaces a "localhost" host with 127.0.0.1; anything else stays.
    /// The AuthCallback page reuses this so the URI exchanged at token time
    /// matches the one the login started with.</summary>
    internal static string LoopbackUri(Uri uri)
    {
        if (!uri.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase))
            return uri.ToString();
        var builder = new UriBuilder(uri) { Host = "127.0.0.1" };
        return builder.Uri.ToString();
    }

    private async Task CopyRedirectToClipboard(string uri)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", uri);
            copyHint = "Copied";
        }
        catch (JSException)
        {
            copyHint = "Copy failed — select it manually";
        }
    }

    private Task CopySpotifyRedirect() => CopyRedirectToClipboard(SpotifyRedirectUrl);
    private Task CopyYouTubeRedirect() => CopyRedirectToClipboard(YouTubeRedirectUrl);

    private async Task Connect(IAccountSourceProvider provider, string redirectUrl, string? clientId = null)
    {
        try
        {
            accountMessage = null;
            if (clientId is not null)
            {
                // The typed client id is saved first: BeginLogin needs it.
                var value = clientId.Trim();
                if (value.Length == 0)
                    throw new InvalidOperationException("Paste the Client ID first.");
                await provider.SaveSettingAsync("client_id", value);
            }
            var loginUrl = await provider.BeginLoginAsync(redirectUrl);
            // The login URL is another origin (accounts.spotify.com, ...).
            // NavigateTo with forceLoad tears the circuit down mid-call on
            // exactly these cross-origin jumps (a known Blazor Server race),
            // so the browser location is assigned directly instead.
            await JS.InvokeVoidAsync("window.location.assign", loginUrl);
        }
        catch (Exception ex)
        {
            accountMessage = ex.Message;
        }
    }

    private Task ConnectSpotify() => Connect(SpotifyAccount, SpotifyRedirectUrl, spotifyClientId);

    private async Task ConnectYouTube()
    {
        if (youtubeClientId.Trim().Length == 0 || youtubeClientSecret.Trim().Length == 0)
        {
            accountMessage = "Paste both the YouTube client id and secret first.";
            return;
        }
        await YouTubeAccount.SaveSettingAsync("client_id", youtubeClientId.Trim());
        await YouTubeAccount.SaveSettingAsync("client_secret", youtubeClientSecret.Trim());
        await Connect(YouTubeAccount, YouTubeRedirectUrl);
    }

    private async Task Logout(IAccountSourceProvider provider)
    {
        await provider.LogoutAsync();
        _spotifyConnected = await SpotifyAccount.IsConnectedAsync();
        _youtubeConnected = await YouTubeAccount.IsConnectedAsync();
        accountMessage = "Account disconnected";
    }

    private static string FindSetting(List<DownloaderSettingEntity> settings, string key, string fallback)
        => settings.FirstOrDefault(s => s.Key == key)?.Value ?? fallback;

    private async Task TestFlareSolverr()
    {
        testingFlare = true;
        flareMessage = string.Empty;
        try
        {
            var url = flaresolverrUrl.Trim();
            if (url.Length == 0 || url.Equals("off", StringComparison.OrdinalIgnoreCase))
            {
                flareStatus = "off";
                flareMessage = "Solver is off: Lucida stays unavailable.";
                return;
            }
            using var http = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(8) };
            var response = await http.PostAsJsonAsync($"{url.TrimEnd('/')}/v1",
                new { cmd = "sessions.list" });
            flareStatus = response.IsSuccessStatusCode ? "ok" : $"http {(int)response.StatusCode}";
            flareMessage = response.IsSuccessStatusCode
                ? "FlareSolverr answered: Lucida can use it."
                : "It responded but not with OK. Check the URL and container logs.";
        }
        catch (Exception ex)
        {
            flareStatus = "err";
            flareMessage = $"Could not reach it: {ex.Message}";
        }
        finally
        {
            testingFlare = false;
            StateHasChanged();
        }
    }

    private async Task SaveAll()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Upsert(db, "music_path", musicPath);
        await Upsert(db, "playlist_path", playlistPath);
        await Upsert(db, "default_quality", defaultQuality);
        await Upsert(db, "spectrum_mode", spectrumMode);
        await Upsert(db, "flaresolverr_url", flaresolverrUrl);
        await db.SaveChangesAsync();
        PlaylistStore.SpectrumVerification = () => SpectrumModeValue(spectrumMode);
        FlareSolverrSolver.Url = flaresolverrUrl;
        savedMessage = "Settings saved.";
    }

    private static async Task Upsert(MelodyBridgeDbContext db, string key, string value)
    {
        var existing = await db.DownloaderSettings.FirstOrDefaultAsync(s => s.Key == key);
        if (existing != null) existing.Value = value;
        else db.DownloaderSettings.Add(new DownloaderSettingEntity { Key = key, Value = value });
    }

    private void ExportLogs() => Nav.NavigateTo("/api/logs/export", true);

    // ── Media servers tab ──────────────────────────────────────────

    /// <summary>True when this profile's values are the app-wide jellyfin_* rows.</summary>
    private bool IsAppDefault(MediaServerProfile profile)
    {
        var url = FindLiveSetting("jellyfin_url");
        return url is not null && url.TrimEnd('/') == profile.BaseUrl.TrimEnd('/');
    }

    private string? FindLiveSetting(string key)
    {
        // Cached at init: good enough for the pill, avoids a DB hit per row.
        return _initSettings?.FirstOrDefault(s => s.Key == key)?.Value;
    }

    private List<DownloaderSettingEntity>? _initSettings;

    /// <summary>Writes this profile's values into the app-wide jellyfin_* rows.
    /// Profiles carry no user id, so an existing jellyfin_user row is kept.</summary>
    private async Task MakeAppDefault(MediaServerProfile profile)
    {
        await TourReset.SetAsync("jellyfin_url", profile.BaseUrl);
        await TourReset.SetAsync("jellyfin_key", profile.ApiKey);
        await LoadInitSettingsAsync(); // refresh the default pill
        Notifications.Success($"'{profile.Name}' is now the app default.");
        StateHasChanged();
    }

    private async Task LoadInitSettingsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _initSettings = await db.DownloaderSettings.AsNoTracking().ToListAsync();
    }

    private async Task TestProfile(MediaServerProfile profile)
    {
        testingProfile = profile.Id;
        try
        {
            var ok = await JellyfinDirectory.TestConnectionAsync(profile.BaseUrl, profile.ApiKey);
            profileTestStatus[profile.Id] = ok ? "ok" : "err";
        }
        catch
        {
            profileTestStatus[profile.Id] = "err";
        }
        finally
        {
            testingProfile = null;
            StateHasChanged();
        }
    }

    private void StartNewProfile()
    {
        editingProfile = new MediaServerProfile { Name = "", BaseUrl = "", Kind = "Jellyfin" };
        editingIsNew = true;
    }

    private void EditProfile(MediaServerProfile profile)
    {
        editingProfile = profile.Clone();
        editingIsNew = false;
    }

    private async Task SaveProfile()
    {
        if (editingProfile is null) return;
        if (string.IsNullOrWhiteSpace(editingProfile.Name)
            || string.IsNullOrWhiteSpace(editingProfile.BaseUrl))
        {
            Notifications.Warn("Profile needs at least a name and a base URL.");
            return;
        }
        await ServerProfiles.SaveAsync(editingProfile);
        profiles = (await ServerProfiles.GetAllAsync()).ToList();
        editingProfile = null;
        Notifications.Success("Profile saved.");
    }

    private void CancelProfileEdit() => editingProfile = null;

    // Delete flow: the row asks, the dialog confirms.
    private string? deleteProfileId;
    private string deleteProfileName = "";

    private void AskDeleteProfile(MediaServerProfile profile)
    {
        deleteProfileId = profile.Id;
        deleteProfileName = profile.Name;
    }

    /// <summary>Switching tabs rewrites the fragment, so refresh and
    /// back keep the tab the user was on.</summary>
    private void SelectTab(string id)
    {
        activeTab = id;
        Nav.NavigateTo($"/settings#{id}", new NavigationOptions { ForceLoad = false });
    }

    private void CancelDeleteProfile()
    {
        deleteProfileId = null;
        StateHasChanged();
    }

    private async Task DeleteProfile(string profileId)
    {
        if (await ServerProfiles.DeleteAsync(profileId))
        {
            profiles = (await ServerProfiles.GetAllAsync()).ToList();
            Notifications.Info($"Deleted profile '{deleteProfileName}'.");
        }
        deleteProfileId = null;
    }

    // ── About tab ──────────────────────────────────────────────────

    private async Task CheckForUpdates()
    {
        checkingUpdate = true;
        try
        {
            updateResult = await UpdateCheck.CheckAsync();
        }
        finally
        {
            checkingUpdate = false;
            StateHasChanged();
        }
    }

    private async Task RestartTour()
    {
        await TourReset.SetAsync("tour_dismissed", "false");
        Notifications.Success("The tour shows again on the dashboard.");
    }

    private async Task ExportDatabase()
    {
        try
        {
            var zip = await DbBackup.ExportZipAsync();
            await JS.InvokeVoidAsync("melody.downloadFile",
                $"melodybridge_{DateTime.UtcNow:yyyyMMdd_HHmmss}.zip",
                "application/zip", zip);
            Notifications.Success("Database exported.");
        }
        catch (Exception ex)
        {
            Notifications.Error($"Export failed: {ex.Message}");
        }
    }

    private async Task ImportDatabase(InputFileChangeEventArgs e)
    {
        if (e.FileCount == 0) return;
        dbMessage = "Importing…";
        try
        {
            await using var stream = e.File.OpenReadStream(200_000_000);
            await DbBackup.ImportZipAsync(stream);
            dbMessage = "Database restored. Restart MelodyBridge to use it.";
            Notifications.Warn("Database imported — restart to apply.");
        }
        catch (Exception ex)
        {
            dbMessage = $"Import failed: {ex.Message}";
            Notifications.Error($"Import failed: {ex.Message}");
        }
        StateHasChanged();
    }

    public void Dispose() { }
}
