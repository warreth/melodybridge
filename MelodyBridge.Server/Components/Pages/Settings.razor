    /// <summary>True when this profile's values are the app-wide jellyfin_* rows.</summary>
    /// <summary>Settings keys each server kind reads (url row first).</summary>
    private static (string UrlKey, string SecretKey) KindKeys(string kind) => kind switch
    {
        "Plex" => ("plex_url", "plex_key"),
        "Navidrome" => ("navidrome_url", "navidrome_password"),
        _ => ("jellyfin_url", "jellyfin_key"),
    };

    private bool IsAppDefault(MediaServerProfile profile)
    {
        var url = FindLiveSetting(KindKeys(profile.Kind).UrlKey);
        return url is not null && url.TrimEnd('/') == profile.BaseUrl.TrimEnd('/');
    }

    private string? FindLiveSetting(string key)
    {
        // Cached at init: good enough for the pill, avoids a DB hit per row.
        return _initSettings?.FirstOrDefault(s => s.Key == key)?.Value;
    }

    private List<DownloaderSettingEntity>? _initSettings;

    /// <summary>Writes this profile's values into the app-wide rows of its
    /// kind (jellyfin_*, plex_*, navidrome_*). Profiles carry no Jellyfin
    /// user id, so an existing jellyfin_user row is kept; a Navidrome
    /// profile does carry its username, which its sync authenticates with.</summary>
    private async Task MakeAppDefault(MediaServerProfile profile)
    {
        var (urlKey, secretKey) = KindKeys(profile.Kind);
        await TourReset.SetAsync(urlKey, profile.BaseUrl);
        await TourReset.SetAsync(secretKey, profile.ApiKey);
        if (string.Equals(profile.Kind, "Navidrome", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(profile.Username))
        {
            await TourReset.SetAsync("navidrome_user", profile.Username!);
        }
        await LoadInitSettingsAsync(); // refresh the default pill
        Notifications.Success($"'{profile.Name}' is now the app default.");
        StateHasChanged();
    }

    private async Task LoadInitSettingsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _initSettings = await db.DownloaderSettings.AsNoTracking().ToListAsync();
    }

    private async Task TestProfile(MediaServerProfile profile)
    {
        testingProfile = profile.Id;
        try
        {
            var directory = Directories.FirstOrDefault(d =>
                string.Equals(d.Kind, profile.Kind, StringComparison.OrdinalIgnoreCase));
            var connection = new MediaServerConnection(profile.BaseUrl, profile.ApiKey, profile.Username);
            var ok = await (directory ?? JellyfinDirectory).TestConnectionAsync(connection);
            profileTestStatus[profile.Id] = ok ? "ok" : "err";
        }
        catch
        {
            profileTestStatus[profile.Id] = "err";
        }
        finally
        {
            testingProfile = null;
            StateHasChanged();
        }
    }

    private void StartNewProfile()
    {
        editingProfile = new MediaServerProfile { Name = "", BaseUrl = "", Kind = "Jellyfin" };
        editingIsNew = true;
        profileError = null;
    }

    private void EditProfile(MediaServerProfile profile)
    {
        editingProfile = profile.Clone();
        editingIsNew = false;
        profileError = null;
    }

    /// <summary>The connect component hands over the Jellyfin session token.</summary>
    private void OnProfileConnected(JellyfinLoginResult result)
    {
        if (editingProfile is null || !result.Succeeded) return;
        editingProfile.ApiKey = result.Token!;
    }

    private async Task SaveProfile()
    {
        if (editingProfile is null) return;
        if (string.IsNullOrWhiteSpace(editingProfile.Name)
            || string.IsNullOrWhiteSpace(editingProfile.BaseUrl))
        {
            profileError = "A profile needs a name and a base URL.";
            return;
        }
        profileError = null;
        await ServerProfiles.SaveAsync(editingProfile);
        profiles = (await ServerProfiles.GetAllAsync()).ToList();
        editingProfile = null;
        Notifications.Success("Profile saved.");
    }

    private void CancelProfileEdit()
    {
        editingProfile = null;
        profileError = null;
    }

    // Delete flow: the row asks, the dialog confirms.
    private string? deleteProfileId;
    private string deleteProfileName = "";

    private void AskDeleteProfile(MediaServerProfile profile)
    {
        deleteProfileId = profile.Id;
        deleteProfileName = profile.Name;
    }

    /// <summary>Switching tabs rewrites the fragment, so refresh and
    /// back keep the tab the user was on.</summary>
    private void SelectTab(string id)
    {
        activeTab = id;
        Nav.NavigateTo($"/settings#{id}", new NavigationOptions { ForceLoad = false });
    }

    private void CancelDeleteProfile()
    {
        deleteProfileId = null;
        StateHasChanged();
    }

    private async Task DeleteProfile(string profileId)
    {
        var profile = profiles.FirstOrDefault(p => p.Id == profileId);
        var wasAppDefault = profile is not null && IsAppDefault(profile);
        if (await ServerProfiles.DeleteAsync(profileId))
        {
            // A deleted profile must not stay the app default: the stale
            // url kept pointing at a server nobody can edit anymore.
            if (wasAppDefault && profile is not null)
            {
                var (urlKey, secretKey) = KindKeys(profile.Kind);
                await TourReset.SetAsync(urlKey, "");
                await TourReset.SetAsync(secretKey, "");
                if (string.Equals(profile.Kind, "Navidrome", StringComparison.OrdinalIgnoreCase))
                    await TourReset.SetAsync("navidrome_user", "");
                await LoadInitSettingsAsync();
                Notifications.Warn($"Deleted '{deleteProfileName}': it was the app default, which is now cleared.");
            }
            else
            {
                Notifications.Info($"Deleted profile '{deleteProfileName}'.");
            }
            profiles = (await ServerProfiles.GetAllAsync()).ToList();
        }
        deleteProfileId = null;
    }

