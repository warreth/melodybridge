    private string? spotifyWebError;

    /// <summary>
    /// Stores the pasted session cookie, turns the connection on and proves
    /// it works before the user leaves the page: a silent enable that fails
    /// on the first import is worse than an honest error here.
    /// </summary>
    private async Task EnableSpotifyWeb()
    {
        spotifyWebError = null;
        spotifyWebMessage = string.Empty;
        enablingSpotifyWeb = true;
        try
        {
            var cookie = NormalizeCookie(spotifyWebCookie);
            if (cookie.Length == 0)
                throw new InvalidOperationException("Paste the sp_dc cookie value first.");

            await SpotifyWeb.SaveSettingAsync("cookie", cookie);
            var secretsUrl = spotifyWebSecretsUrl.Trim();
            if (secretsUrl.Length > 0)
                await SpotifyWeb.SaveSettingAsync("secrets_url", secretsUrl);
            await SpotifyWeb.SetEnabledAsync(true);

            spotifyWebMessage = await SpotifyWeb.TestAsync();
            _spotifyWebConnected = true;
            spotifyWebCookie = string.Empty; // never echo the secret back into the page
            Notifications.Success(spotifyWebMessage);
        }
        catch (Exception ex)
        {
            // A cookie that does not work must not look enabled.
            await SpotifyWeb.SetEnabledAsync(false);
            _spotifyWebConnected = false;
            spotifyWebError = ex.Message;
        }
        finally
        {
            enablingSpotifyWeb = false;
        }
    }

