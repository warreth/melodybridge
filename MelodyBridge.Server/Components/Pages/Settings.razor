    /// <summary>The redirect URI for one provider, as registered in its
    /// app settings. The provider marker tells the callback page which
    /// account to finish; Spotify requires the URI to match exactly, so
    /// the same string is used at login start and at token exchange.
    /// Spotify also rejects "localhost" (April 2025 rule), so loopback
    /// requests are shown and sent with the 127.0.0.1 literal instead.</summary>
    private string RedirectUrlFor(string provider)
        => LoopbackUri(Nav.ToAbsoluteUri($"auth/callback?provider={provider}"));

    private string SpotifyRedirectUrl => RedirectUrlFor("spotify");
    private string YouTubeRedirectUrl => RedirectUrlFor("youtube");

    /// <summary>Replaces a "localhost" host with 127.0.0.1; anything else stays.
    /// The AuthCallback page reuses this so the URI exchanged at token time
    /// matches the one the login started with.</summary>
    internal static string LoopbackUri(Uri uri)
    {
        if (!uri.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase))
            return uri.ToString();
        var builder = new UriBuilder(uri) { Host = "127.0.0.1" };
        return builder.Uri.ToString();
    }

    private async Task CopyRedirectToClipboard(string provider, string uri)
    {
        bool copied;
