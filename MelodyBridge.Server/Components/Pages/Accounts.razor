@page "/accounts"
@inject IMusicSourceManager SourceMgr

<PageTitle>Accounts</PageTitle>

<section class="page-title">
    <div>
        <span class="eyebrow">Connections</span>
        <h1>Accounts & sources</h1>
        <p>Manage playlist sources — YouTube channels/playlists and other music provider connections.</p>
    </div>
    <button class="btn-modern primary" @onclick="ShowAddForm">Add source</button>
</section>

<section class="content-grid three">
    @foreach (var source in sources)
    {
        var platInfo = PlatformDisplay(source.Platform);
        <div class="panel-card account-card">
            <div class="provider-icon">
                @platInfo.Icon
            </div>
            <div>
                <h2>@source.Name</h2>
                <p>@platInfo.Label@(string.IsNullOrWhiteSpace(source.SourceUrl) ? "" : " · playlist")</p>
            </div>
            <div class="account-meta">
                <span class="pill @(source.AutoSyncEnabled ? "ok" : "neutral")">
                    @(source.AutoSyncEnabled ? "Auto-sync" : "Manual")
                </span>
                <button class="btn-modern ghost" @onclick="() => DeleteSource(source.Id)">Remove</button>
            </div>
        </div>
    }
</section>

@if (sources.Count == 0)
{
    <div class="empty-state">
        No sources yet. Click <strong>Add source</strong> to connect a YouTube playlist or other provider.
    </div>
}

@if (showForm)
{
    <div class="wizard-overlay">
        <div class="wizard-modal" style="max-width:480px;">
            <div class="wizard-header">
                <span class="eyebrow">New source</span>
                <h2>Add a music source</h2>
                <button class="icon-button" @onclick="() => showForm = false">&times;</button>
            </div>
            <div class="wizard-body">
                <div class="form-grid single">
                    <label>
                        Source name
                        <input @bind="newName" placeholder="e.g. My Favorites" />
                    </label>
                    <label>
                        Platform
                        <select @bind="newPlatform">
                            <option>YouTube</option>
                            <option>Spotify</option>
                            <option>Jellyfin</option>
                        </select>
                    </label>
                    <label>
                        Playlist URL / ID
                        <input @bind="newUrl" placeholder="https://youtube.com/playlist?list=..." />
                    </label>
                    <label>
                        Target download directory
                        <input @bind="newTargetDir" placeholder="/music" />
                    </label>
                    <label class="toggle-switch" style="display:flex; gap:.75rem; align-items:center; width:auto;">
                        <input type="checkbox" @bind="newAutoSync" />
                        <span class="toggle-slider"></span>
                        Auto-sync
                    </label>
                </div>
            </div>
            <div class="wizard-footer">
                <button class="btn-modern" @onclick="() => showForm = false">Cancel</button>
                <button class="btn-modern primary" @onclick="SaveSource" disabled="@saving">
                    @(saving ? "Saving..." : "Add source")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<MusicSource> sources = new();
    private bool showForm;
    private bool saving;
    private string newName = "";
    private string newPlatform = "YouTube";
    private string newUrl = "";
    private string newTargetDir = "/music";
    private bool newAutoSync;

    protected override async Task OnInitializedAsync()
    {
        await LoadSourcesAsync();
    }

    private async Task LoadSourcesAsync()
    {
        sources = (await SourceMgr.GetAllSourcesAsync()).OrderBy(s => s.Name).ToList();
    }

    private void ShowAddForm()
    {
        newName = "";
        newPlatform = "YouTube";
        newUrl = "";
        newTargetDir = "/music";
        newAutoSync = false;
        showForm = true;
    }

    private async Task SaveSource()
    {
        saving = true;
        try
        {
            var source = new MusicSource
            {
                Name = newName,
                Platform = newPlatform switch
                {
                    "YouTube" => Platform.YouTubeMusic,
                    "Spotify" => Platform.Spotify,
                    _ => Platform.Unknown,
                },
                SourceUrl = newUrl,
                TargetDirectory = newTargetDir,
                AutoSyncEnabled = newAutoSync,
            };
            await SourceMgr.AddSourceAsync(source);
            showForm = false;
            await LoadSourcesAsync();
        }
        finally { saving = false; }
    }

    private async Task DeleteSource(string id)
    {
        await SourceMgr.RemoveSourceAsync(id);
        await LoadSourcesAsync();
    }

    private static (string Icon, string Label) PlatformDisplay(Platform p)
        => p switch
        {
            Platform.Spotify => ("🔀", "Spotify"),
            Platform.YouTubeMusic => ("🎬", "YouTube"),
            _ => ("🔌", p.ToString()),
        };
}
