@page "/playlists/{PlaylistId}"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Data
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Components.Shared
@inject PlaylistStore Store
@inject NavigationManager Navigation
@inject Application.Services.DownloadCoordinator Coordinator
@inject SettingsStore Settings
@inject MelodyBridge.Server.Services.NotificationService Notifications
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(playlist?.Name ?? "Playlist") - MelodyBridge</PageTitle>

@if (loading)
{
    <Skeleton Kind="table" Rows="6" />
}
else if (playlist == null)
{
    <section class="page-title">
        <div>
            <span class="eyebrow">Error</span>
            <h1>Playlist not found</h1>
            <p>It may have been deleted.</p>
        </div>
        <a class="btn-modern secondary" href="playlists">Back to playlists</a>
    </section>
}
else
{
    <PlaylistActionsHeader Eyebrow="@HeaderEyebrow"
                            Name="@playlist.Name"
                            CoverUrl="@playlist.CoverImageUrl"
                            ShowRefresh="@(!playlist.IsManualImport)"
                            ShowDownloadGroup="@DownloadGroupVisible"
                            DownloadState="@CurrentRunState"
                            Busy="@busy"
                            OnRefresh="Refresh"
                            OnStart="StartDownload"
                            OnPause="PauseDownload"
                            OnResume="ResumeDownload"
                            OnCancel="CancelDownload"
                            OnExport="ExportCsv"
                            OnDelete="AskDelete"
                            FailedCount="@FailedCount"
                            Retrying="@retryingFailed"
                            OnRetryFailed="() => RetryAllFailedAsync(avoidLastProvider: false)"
                            OnRetryElsewhere="() => RetryAllFailedAsync(avoidLastProvider: true)">
        <MetaLine>
            @playlist.TrackCount @(playlist.TrackCount == 1 ? "track" : "tracks")
            @if (!string.IsNullOrEmpty(playlist.Owner))
            {
                <span> · by @playlist.Owner</span>
            }
            <span> · last synced @(playlist.LastSyncAt?.ToLocalTime().ToString("g") ?? "never")</span>
            @if (!string.IsNullOrEmpty(playlist.SyncWarning))
            {
                <span> · <span class="sync-warn" title="@playlist.SyncWarning">partial sync</span></span>
            }
            @if (!string.IsNullOrWhiteSpace(playlist.PreferredFormat) && playlist.PreferredFormat != "auto")
            {
                <span> · @QualityLabel(playlist.PreferredFormat)</span>
            }
            @if (!playlist.IsManualImport && IsWebSource(playlist.SourceUrl))
            {
                <a href="@playlist.SourceUrl" target="_blank" rel="noopener" class="hint">
                    Open source <Icon Name="external" Size="12" />
                </a>
            }
        </MetaLine>
    </PlaylistActionsHeader>

    @if (retryingFailed)
    {
        <section class="panel-card bulk-retry-live">
            <div class="download-live-head">
                <strong>Retrying failed tracks</strong>
                <span>@bulkRetryDone of @bulkRetryTotal</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width:@BulkRetryPercent%"></div>
            </div>
        </section>
    }

    @if (confirmDelete)
    {
        <ConfirmDialog Show="true"
                       Eyebrow="Remove playlist"
                       Title=@($"Remove '{playlist.Name}'?")
                       Message="The playlist and its track list leave MelodyBridge. Your account and other playlists are not touched."
                       ConfirmLabel="Remove playlist"
                       Busy="busy"
                       OnConfirm="ConfirmDelete"
                       OnCancel="CancelDelete">
            @if (deleteFileCount > 0)
            {
                <label class="toggle-switch wide">
                    <input type="checkbox" @bind="deleteFilesWithPlaylist" />
                    <span class="toggle-slider"></span>
                    <span>Delete the downloaded music files too, archive copies included (@deleteFileCount @(deleteFileCount == 1 ? "file" : "files"), @TrackDisplay.Size(deleteFileSizeBytes))</span>
                </label>
            }
        </ConfirmDialog>
    }

    @if (run is { } active && active.State is not Application.Services.DownloadRunState.Finished)
    {
        <section class="panel-card download-live">
            <div class="download-live-head">
                <strong>
                    @(run.State == Application.Services.DownloadRunState.Paused
                        ? "Paused"
                        : "Downloading"):
                    @run.Done of @run.Total
                </strong>
                <span>@run.Failed failed · @LivePercent%</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width:@LivePercent%"></div>
            </div>
            @if (!string.IsNullOrEmpty(run.CurrentTrack))
            {
                <div class="qi-meta">Now: @run.CurrentTrack</div>
            }
            @if (run.State == Application.Services.DownloadRunState.Running && run.EtaUtc is { } eta)
            {
                <div class="qi-meta text-muted">ETA @eta.ToLocalTime().ToString("t") · @run.QueueLength in queue</div>
            }
        </section>
    }

    <section class="content-grid two">
        <div class="settings-card">
            <div class="settings-head">
                <div>
                    <span class="eyebrow">Settings</span>
                    <div class="title-with-help">
                        <h2>Sync configuration</h2>
                        <HelpTip Path="reference#playlist-options" Text="Quality, archive copy, auto-sync schedule and sync mode for this playlist. Changes save themselves." />
                    </div>
                </div>
                @if (saveState != SaveState.Idle)
                {
                    <span class="save-state @saveState.ToString().ToLowerInvariant()">
                        @(saveState switch
                        {
                            SaveState.Saving => "Saving…",
                            SaveState.Saved => "Saved",
                            _ => "Failed to save"
                        })
                    </span>
                }
            </div>
            <div class="settings-section">
                <span class="eyebrow">Basics</span>
                <div class="form-grid single">
                    <label>
                        Name
                        <input value="@editName" @oninput="OnNameInput" />
                    </label>
                    <label>
                        Download folder
                        <span class="path-field">
                            <input value="@editTargetDirectory" @oninput="OnFolderInput" placeholder="@resolvedDefaultMusicPath" />
                            @if (playlistFolders && string.IsNullOrWhiteSpace(editTargetDirectory))
                            {
                                <span class="path-suffix" title="Added to the music path">{playlist name}</span>
                            }
                        </span>
                        <small class="text-muted">@DownloadFolderHint</small>
                    </label>
                </div>
            </div>
            <div class="settings-section">
                <span class="eyebrow">Quality</span>
                <div class="form-grid single">
                    <div class="quality-field">
                        <QualityPicker @bind-Value="editQuality" @bind-Value:after="SaveNow" />
                    </div>
                </div>
                <div class="toggle-with-help">
                    <label class="toggle-switch wide">
                        <input type="checkbox" @bind="editStrictQuality" @bind:after="SaveNow" />
                        <span class="toggle-slider"></span>
                        <span>Strict quality</span>
                    </label>
                    <HelpTip Path="concepts#strict-quality" Text="On: only the exact quality above is accepted; a track no source can deliver fails with the reason. Off: the download steps down to the best lower quality the enabled plugins declare, until one delivers." />
                </div>
                @if (!editStrictQuality)
                {
                    <div class="toggle-with-help">
                        <label class="toggle-switch wide">
                            <input type="checkbox" @bind="editAllowContainerChange" @bind:after="SaveNow" />
                            <span class="toggle-slider"></span>
                            <span>Allow container changes while stepping down</span>
                        </label>
                        <HelpTip Path="concepts#strict-quality" Text="Off: a fallback stays in the chosen container, so an FLAC request fails when no lossless source exists. On: it may land on the best lossy file." />
                    </div>
                }
            </div>
            <div class="settings-section archive-section">
                <span class="eyebrow">Archive copy</span>
                <div class="toggle-with-help">
                    <label class="toggle-switch wide">
                        <input type="checkbox" @bind="editArchiveEnabled" @bind:after="SaveNow" />
                        <span class="toggle-slider"></span>
                        <span>Keep a second copy of every download</span>
                    </label>
                    <HelpTip Path="concepts#archive-copies" Text="A second copy in another folder and format, converted locally from the same download. Off means this playlist makes no archive copy at all, even when a default archive path is set." />
                </div>
                @if (editArchiveEnabled)
                {
                    <div class="form-grid single">
                        <label>
                            Archive folder
                            <span class="path-field">
                                <input value="@editArchiveDirectory" @oninput="OnArchiveFolderInput"
                                       placeholder="@archiveFolderPlaceholder" />
                                @if (playlistFolders && string.IsNullOrWhiteSpace(editArchiveDirectory))
                                {
                                    <span class="path-suffix" title="Added to the archive path">{playlist name}</span>
                                }
                            </span>
                            <small class="text-muted">@archiveFolderHint</small>
                        </label>
                        @if (HasArchiveTarget)
                        {
                            <label>
                                Archive format
                                <select value="@editArchiveFormat" @onchange="OnArchiveFormatChanged">
                                    <option value="default">App default (@ArchiveFormatLabel(resolvedDefaultArchiveFormat))</option>
                                    <option value="auto">Copy the downloaded file as-is</option>
                                    <option value="opus">Opus: small and efficient (128k)</option>
                                    <option value="flac">FLAC: lossless (level 5)</option>
                                    <option value="mp3">MP3: widely compatible (256k)</option>
                                    <option value="aac">AAC: small and modern (192k)</option>
                                </select>
                                <small class="text-muted">Fetched once from the source, converted locally with ffmpeg.</small>
                            </label>
                        }
                    </div>
                }
            </div>
            <div class="settings-section">
                <span class="eyebrow">Sync</span>
                @if (!playlist.IsManualImport)
                {
                    <SchedulePicker Label="Auto-sync schedule" @bind-Value="editSchedule" @bind-Value:after="SaveNow" />
                    <div class="toggle-with-help">
                        <label class="toggle-switch wide">
                            <input type="checkbox" @bind="editAutoDownload" @bind:after="SaveNow" />
                            <span class="toggle-slider"></span>
                            <span>Download new tracks after auto-sync</span>
                        </label>
                        <HelpTip Path="concepts#playlists-are-snapshots" Text="After the scheduled refresh, start a download run when there is pending work; failed tracks are retried every interval." />
                    </div>
                }
                <div class="form-grid single">
                    <label>
                        Sync mode
                        <select value="@editSyncMode" @onchange="OnSyncModeChanged">
                            <option value="@PlaylistSyncMode.Additive">Additive: keep removed tracks as history</option>
                            <option value="@PlaylistSyncMode.Mirror">Mirror: remove tracks deleted from source</option>
                        </select>
                    </label>
                </div>
                @if (playlist.IsManualImport)
                {
                    <span class="text-muted">Imported snapshot: re-import the file to update the track list.</span>
                }
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Library</span>
                    <h2>Track status</h2>
                </div>
            </div>
            <div class="settings-section">
                <div class="stat-grid two">
                    <div class="stat-card">
                        <Icon Name="music" Size="20" Class="stat-icon" />
                        <label>Tracks</label>
                        <strong>@playlist.Tracks.Count</strong>
                    </div>
                    <div class="stat-card">
                        <Icon Name="download" Size="20" Class="stat-icon" />
                        <label>Downloaded</label>
                        <strong>@downloadedCount / @playlist.Tracks.Count</strong>
                    </div>
                </div>
                @if (downloadedCount > 0 && reviewCount > 0)
                {
                    <div class="hint-box">
                        <Icon Name="alert" Size="16" Class="inline-icon" />
                        @reviewSummaryLead a quality decision: the length differs from the playlist, or the bitrate looks inflated. Use <strong>Keep</strong> on the row to accept the file, or <strong>Retry</strong> to download it from another provider.
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Tracks</span>
                <h2>Tracks (@playlist.Tracks.Count)</h2>
            </div>
            <div class="track-filters">
                <input type="search" class="search-input" placeholder="Filter tracks…"
                       value="@trackFilter" @oninput="OnFilterChanged" />
                @if (attentionCount > 0)
                {
                    <button class="filter-chip @(attentionOnly ? "active" : "")"
                            @onclick="ToggleAttentionOnly"
                            aria-pressed="@(attentionOnly ? "true" : "false")"
                            title="Only failed tracks and tracks waiting for a quality or dedup decision">
                        Needs attention (@attentionCount)
                    </button>
                }
            </div>
        </div>
        @if (playlist.Tracks.Count == 0)
        {
            <div class="empty-state">No tracks in this snapshot. Refresh the playlist.</div>
        }
        else
        {
            <TrackTable Tracks="@TrackRows"
                        ShowFilenameColumn="@showFilenameColumn"
                        ShowArchiveState="@(editArchiveEnabled && HasArchiveTarget)"
                        ArchiveStates="@archiveStates"
                        Busy="@busy"
                        QueueLabel="@TrackQueueLabel"
                        OnRetry="RetryTrack"
                        OnChooseSource="OpenSourcePicker"
                        OnResolveReview="ResolveDedupReview"
                        OnQualityReview="ResolveQualityReview"
                        OnRemove="RemoveTrack"
                        OnArchiveAction="OpenArchiveDialog"
                        OnWarning="OpenArchiveDialog" />
        }
    </section>

    <SourcePicker Request="pickerRequest" OnClose="CloseSourcePicker" />

    @if (archiveTrack is { } archive)
    {
        <div class="wizard-overlay" @onclick="CloseArchiveDialog">
            <div class="wizard-modal confirm-modal" @onclick:stopPropagation="true">
                <div class="wizard-header">
                    <div>
                        <span class="eyebrow">Track file</span>
                        <h2>@(archive.Title ?? "Track")</h2>
                        <span class="text-muted">@(archive.Artist ?? "Unknown artist")</span>
                    </div>
                    <button class="icon-button" title="Close" @onclick="CloseArchiveDialog"><Icon Name="x" Size="18" /></button>
                </div>
                <div class="wizard-body">
                    <div class="archive-state-card">
                        <Icon Name="archive" Size="18" Class="archive-state-icon" />
                        <div>
                            <strong>@ArchiveDialogHeadline(archive)</strong>
                            <p>@ArchiveDialogDetail(archive)</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(archive.Warning))
                    {
                        <div class="hint-box archive-warning">
                            <Icon Name="alert" Size="14" Class="inline-icon" />
                            @archive.Warning
                        </div>
                    }
                    @if (!HasArchiveTarget)
                    {
                        <div class="hint-box">
                            This playlist has no archive folder. Turn the archive copy on and
                            set a folder in the settings on the left, then try again.
                        </div>
                    }
                </div>
                <div class="wizard-footer">
                    <button class="btn-modern secondary" @onclick="CloseArchiveDialog">Close</button>
                    <span></span>
                    <button class="btn-modern primary" @onclick="RetryArchive"
                            disabled="@(busy || !HasArchiveTarget)">
                        <Icon Name="archive" Size="14" /> @ArchiveDialogAction(archive)
                    </button>
                </div>
            </div>
        </div>
    }

    @if (hardlinkTrack is { } link)
    {
        <ConfirmDialog Show="true"
                       Eyebrow="Hardlink existing"
                       Title=@($"Link another playlist's copy of '{link.Title}'?")
                       Message="@HardlinkConfirmMessage(link)"
                       ConfirmLabel="Hardlink existing"
                       OnConfirm="ConfirmHardlink"
                       OnCancel="() => hardlinkTrack = null" />
    }

    @if (removeTrack is { } doomed)
    {
        <ConfirmDialog Show="true"
                       Eyebrow="Track options"
                       Title=@($"What should happen to '{doomed.Title}'?")
                       Message="Choose what happens to the track and its downloaded file."
                       ConfirmLabel="@RemoveConfirmLabel"
                       Busy="busy"
                       OnConfirm="ConfirmRemoveTrack"
                       OnCancel="CancelRemoveTrack">
            <div class="choice-list">
                <label class="choice-row">
                    <input type="radio" name="remove-file-choice"
                           checked="@(removeChoice == RemoveChoice.KeepFile)"
                           @onchange="() => removeChoice = RemoveChoice.KeepFile" />
                    <span>
                        <strong>Remove from the playlist</strong>
                        <small>The track disappears from this playlist; the music file stays where it is.</small>
                    </span>
                </label>
                <label class="choice-row">
                    <input type="radio" name="remove-file-choice"
                           checked="@(removeChoice == RemoveChoice.DeleteFile)"
                           @onchange="() => removeChoice = RemoveChoice.DeleteFile" />
                    <span>
                        <strong>Delete the file, keep the track</strong>
                        <small>
                            The file and its archive copy go; the track stays in the playlist and can be
                            downloaded again later.
                        </small>
                    </span>
                </label>
                <label class="choice-row">
                    <input type="radio" name="remove-file-choice"
                           checked="@(removeChoice == RemoveChoice.DeleteFilesAndTrack)"
                           @onchange="() => removeChoice = RemoveChoice.DeleteFilesAndTrack" />
                    <span>
                        <strong>Delete the file and remove the track</strong>
                        <small>
                            Both go. A file another playlist still uses through a hard link survives there.
                        </small>
                    </span>
                </label>
            </div>
        </ConfirmDialog>
    }
}

@code {
    [Parameter] public string PlaylistId { get; set; } = string.Empty;
    /// <summary>Deep link from a failed-download toast: retry this track on load.</summary>
    [SupplyParameterFromQuery(Name = "retryTrack")] public int? RetryTrackId { get; set; }

    private PlaylistEntity? playlist;
    private bool loading = true;
    private bool busy;
    private string trackFilter = string.Empty;
    private bool attentionOnly;
    private bool showFilenameColumn;

    private string editName = string.Empty;
    private string editTargetDirectory = string.Empty;
    private string editQuality = "auto";
    private string editArchiveDirectory = string.Empty;
    private string editArchiveFormat = "default";
    private bool editArchiveEnabled = true;
    private ScanSchedule editSchedule = ScanSchedule.Manual;
    private PlaylistSyncMode editSyncMode = PlaylistSyncMode.Additive;
    /// <summary>Opt-in: download new tracks right after an auto-sync refresh.</summary>
    private bool editAutoDownload;
    /// <summary>Strict: only the requested quality may be delivered.</summary>
    private bool editStrictQuality = true;
    /// <summary>Non-strict only: may a fallback step change the container.</summary>
    private bool editAllowContainerChange = true;

    /// <summary>The auto-save machinery replaces the Save settings button.</summary>
    private enum SaveState { Idle, Saving, Saved, Failed }

    private SaveState saveState = SaveState.Idle;
    /// <summary>True once the first Load finished: before it, nothing saves.</summary>
    private bool formReady;
    /// <summary>Snapshot of the last values known to be persisted; rollback source.</summary>
    private (string name, string dir, string quality, string archiveDir, string archiveFormat, ScanSchedule schedule, PlaylistSyncMode mode, bool autoDownload, bool strict, bool allowContainerChange, bool archiveEnabled) persisted;
    /// <summary>Debounce timer for text inputs; a fresh keystroke cancels it.</summary>
    private CancellationTokenSource? debounceCts;
    private CancellationTokenSource? savedPillCts;
    private bool saveInFlight;
    private bool dirtyAfterSave;

    private int downloadedCount;
    private long downloadedSizeBytes;
    /// <summary>What the delete dialog would remove: existing primary and
    /// archive files, counted when the dialog opens.</summary>
    private int deleteFileCount;
    private long deleteFileSizeBytes;
    private readonly HashSet<int> retryingTrackIds = new();
    private bool retryingFailed;
    private int bulkRetryDone;
    private int bulkRetryTotal;
    private bool handlingRetryTrack;
    private int reviewCount;
    private bool confirmDelete;
    private bool deleteFilesWithPlaylist;
    /// <summary>The track waiting in the remove/replace dialog.</summary>
    private TrackEntity? removeTrack;

    /// <summary>What the dialog will do with the track and its files.</summary>
    private enum RemoveChoice { KeepFile, DeleteFile, DeleteFilesAndTrack }
    private RemoveChoice removeChoice = RemoveChoice.KeepFile;
    private string resolvedDefaultMusicPath = "/music";
    /// <summary>One folder per playlist under the music path (default on).</summary>
    private bool playlistFolders = true;
    /// <summary>Global archive default, shown as the placeholder hint.</summary>
    private string resolvedDefaultArchivePath = "";
    /// <summary>Global archive format default, shown in the format select.</summary>
    private string resolvedDefaultArchiveFormat = "auto";
    private Timer? refreshTimer;
    private Application.Services.DownloadRun? observedRun;
    /// <summary>The store's write stamp the last reload observed.</summary>
    private long observedVersion;
    /// <summary>Queue title -> first index, rebuilt per tick instead of scanning per row.</summary>
    private Dictionary<string, int> queuePositions = new(StringComparer.Ordinal);

    /// <summary>The coordinator's run for this playlist, kept current by the poll.</summary>
    private Application.Services.DownloadRun? run => observedRun;

    /// <summary>Header label: imports are snapshots, everything else names its platform.</summary>
    private string HeaderEyebrow => playlist!.IsManualImport
        ? "Imported"
        : $"{playlist.SourcePlatform} playlist";

    /// <summary>The Pause/Cancel pair replaces Download missing while a run is live.</summary>
    private bool DownloadGroupVisible => run is { State: not Application.Services.DownloadRunState.Finished };

    private Application.Services.DownloadRunState CurrentRunState
        => run?.State ?? Application.Services.DownloadRunState.Finished;

    protected override async Task OnInitializedAsync()
    {
        await Load();

        // Poll the coordinator for the progress bar and the store's write
        // stamp for everything else: a download this page did not start,
        // a background reconcile or another circuit's retry moves the
        // stamp, and the rows reload when it moved. An idle tick changes
        // nothing, so a thousand-row table is not re-rendered every
        // second while nothing happens.
        refreshTimer = new Timer(_ => InvokeAsync(async () =>
        {
            var observed = Coordinator.RunFor(PlaylistId);
            // Reload while a run is active, and once more when it just
            // finished: the final status write can land between two ticks.
            var justFinished = observedRun is { State: not Application.Services.DownloadRunState.Finished }
                && observed is null or { State: Application.Services.DownloadRunState.Finished };
            var active = observed is { State: not Application.Services.DownloadRunState.Finished };
            observedRun = observed;
            UpdateQueuePositions();
            var version = Store.DataVersion;
            var reload = active || justFinished || version != observedVersion;
            if (reload)
            {
                await ReloadTracksAsync();
                observedVersion = Store.DataVersion;
            }
            if (reload || active)
                StateHasChanged();
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    /// <summary>
    /// The failed-download toast links back with retryTrack. Consume the
    /// query with a replace navigation before the attempt, so a refresh
    /// cannot replay an old retry, while a later toast can still link to
    /// the same track id and start a fresh attempt.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (RetryTrackId is not { } retryId || handlingRetryTrack) return;
        handlingRetryTrack = true;
        Navigation.NavigateTo($"/playlists/{PlaylistId}", replace: true);
        try
        {
            if ((playlist?.Tracks ?? new List<TrackEntity>())
                .FirstOrDefault(track => track.Id == retryId) is { } track)
                await RetryTrack(track);
        }
        finally
        {
            handlingRetryTrack = false;
        }
    }

    private async Task Load()
    {
        loading = true;
        showFilenameColumn = await Settings.GetBoolAsync("show_filename", fallback: false);
        resolvedDefaultMusicPath = await Settings.GetAsync("music_path", "/music");
        playlistFolders = await Settings.GetBoolAsync("playlist_folders", true);
        resolvedDefaultArchivePath = await Settings.GetAsync("archive_path", "");
        resolvedDefaultArchiveFormat = await Settings.GetAsync("archive_format", "auto");
        playlist = await Store.GetByIdAsync(PlaylistId);
        if (playlist is not null)
        {
            editName = playlist.Name;
            // A stored path equal to the app-wide default is not an explicit
            // choice: show the field empty so the placeholder names the
            // effective per-playlist folder (a later save normalizes the row).
            editTargetDirectory = playlist.TargetDirectory is { } storedDir
                && !PlaylistStore.PathsEqual(storedDir, resolvedDefaultMusicPath)
                    ? storedDir
                    : string.Empty;
            editQuality = PlaylistStore.IsValidFormat(playlist.PreferredFormat) ? playlist.PreferredFormat : "auto";
            editArchiveDirectory = playlist.ArchiveDirectory is { } storedArchive
                && !PlaylistStore.PathsEqual(storedArchive, resolvedDefaultArchivePath)
                    ? storedArchive
                    : string.Empty;
            editArchiveFormat = string.IsNullOrWhiteSpace(playlist.ArchiveFormat) ? "default" : playlist.ArchiveFormat;
            editArchiveEnabled = playlist.ArchiveEnabled;
            editSchedule = playlist.ScheduleCron is { Length: > 0 }
                ? ScanSchedule.Parse(playlist.ScheduleCron)
                : playlist.AutoSyncEnabled
                    ? ScanSchedule.FromInterval(playlist.AutoSyncIntervalMinutes ?? 60)
                    : ScanSchedule.Manual;
            editSyncMode = Enum.TryParse<PlaylistSyncMode>(playlist.SyncMode, out var mode)
                ? mode : PlaylistSyncMode.Additive;
            editAutoDownload = playlist.AutoDownloadEnabled;
            editStrictQuality = playlist.StrictQuality;
            editAllowContainerChange = playlist.AllowContainerChange;
            ApplyCounts();
            StartArchiveProbe();
            filteredCache = null;
        }
        persisted = (editName, editTargetDirectory, editQuality, editArchiveDirectory, editArchiveFormat, editSchedule, editSyncMode, editAutoDownload, editStrictQuality, editAllowContainerChange, editArchiveEnabled);
        formReady = true;
        observedRun = Coordinator.RunFor(PlaylistId);
        observedVersion = Store.DataVersion;
        UpdateQueuePositions();
        loading = false;
    }

    /// <summary>
    /// One re-query of the playlist after the store reported a change:
    /// the rows and the download stats both come from the freshly loaded
    /// list, so nothing is materialized twice.
    /// </summary>
    private async Task ReloadTracksAsync()
    {
        playlist = await Store.GetByIdAsync(PlaylistId);
        if (playlist is null) return;
        ApplyCounts();
        StartArchiveProbe();
        filteredCache = null;
    }

    /// <summary>The stat cards and the review hint, from the loaded rows.</summary>
    private void ApplyCounts()
    {
        downloadedCount = 0;
        downloadedSizeBytes = 0;
        reviewCount = 0;
        foreach (var track in playlist?.Tracks ?? Enumerable.Empty<TrackEntity>())
        {
            if (track.DownloadStatus != "downloaded") continue;
            downloadedCount++;
            downloadedSizeBytes += track.FileSizeBytes ?? 0;
            if (track.ReviewKind is not null) reviewCount++;
        }
    }

    // ── Archive checks, off the render path ────────────────────────

    /// <summary>Archive-file existence per path, checked by a background task.</summary>
    private Dictionary<string, bool> archiveStates = new(StringComparer.Ordinal);
    private bool archiveProbeRunning;
    private DateTime archiveProbedAtUtc = DateTime.MinValue;
    private bool disposed;

    /// <summary>
    /// Checks the distinct archive paths of the downloaded rows on a
    /// background task and re-renders when the verdicts are in. The table
    /// must never stat a thousand files while it renders: on a network
    /// mount that is what made opening the page take seconds.
    /// </summary>
    private void StartArchiveProbe()
    {
        var paths = (playlist?.Tracks ?? Enumerable.Empty<TrackEntity>())
            .Where(t => t.DownloadStatus == "downloaded" && !string.IsNullOrWhiteSpace(t.ArchivePath))
            .Select(t => t.ArchivePath!)
            .Distinct(StringComparer.Ordinal)
            .ToList();
        if (paths.Count == 0)
        {
            archiveStates.Clear();
            return;
        }

        // Debounce: a running download reloads the rows per track, and a
        // stat sweep on every reload would just busy the mount. A verdict
        // stays valid for a short window, then the next reload re-checks.
        if (archiveProbeRunning
            || (DateTime.UtcNow - archiveProbedAtUtc < TimeSpan.FromSeconds(15)
                && paths.All(archiveStates.ContainsKey)))
        {
            return;
        }

        archiveProbeRunning = true;
        _ = Task.Run(async () =>
        {
            try
            {
                var fresh = new Dictionary<string, bool>(StringComparer.Ordinal);
                foreach (var path in paths)
                    fresh[path] = File.Exists(path);
                await InvokeAsync(() =>
                {
                    archiveProbeRunning = false;
                    if (disposed) return;
                    archiveStates = fresh;
                    archiveProbedAtUtc = DateTime.UtcNow;
                    StateHasChanged();
                });
            }
            catch
            {
                archiveProbeRunning = false;
            }
        });
    }

    /// <summary>
    /// The run's progress bar counts playlist tracks that are no longer in
    /// the queue. The coordinator's own Percent adds failures to the done
    /// count, which showed a full bar while the last track was still
    /// downloading.
    /// </summary>
    private int LivePercent
    {
        get
        {
            if (run is null || run.Total <= 0) return 0;
            var remaining = Math.Min(run.QueueLength, run.Total);
            return Math.Clamp(100 * (run.Total - remaining) / run.Total, 0, 100);
        }
    }

    private async Task Refresh()
    {
        busy = true;
        try
        {
            await Store.RefreshAsync(PlaylistId);
            await Load();
        }
        finally { busy = false; }
    }

