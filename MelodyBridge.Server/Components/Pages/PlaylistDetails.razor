@page "/playlists/{PlaylistId}"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Data
@using MelodyBridge.Infrastructure.Services
@inject IPlaylistService PlaylistService
@inject NavigationManager Navigation

<PageTitle>@(playlist?.Name ?? "Playlist Details") - MelodyBridge</PageTitle>

<div class="container-fluid p-4">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (playlist == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> Playlist not found.
        </div>
        <button class="btn btn-secondary" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back to Playlists
        </button>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-start mb-4">
            <button class="btn btn-outline-secondary" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i> Back
            </button>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                {
                    <img src="@playlist.CoverImageUrl" class="img-fluid rounded shadow" alt="@playlist.Name">
                }
                else
                {
                    <div class="bg-secondary rounded shadow d-flex align-items-center justify-content-center" style="aspect-ratio: 1/1;">
                        <i class="bi bi-music-note-list" style="font-size: 5rem; color: white;"></i>
                    </div>
                }
            </div>
            <div class="col-md-9">
                <h1 class="h2">@playlist.Name</h1>
                @if (!string.IsNullOrEmpty(playlist.Owner))
                {
                    <p class="text-muted">By @playlist.Owner</p>
                }
                @if (!string.IsNullOrEmpty(playlist.Description))
                {
                    <p class="mt-3">@playlist.Description</p>
                }
                <div class="d-flex gap-3 align-items-center mt-3">
                    <span class="badge bg-primary">@playlist.TrackCount tracks</span>
                    <span class="badge bg-@GetStatusBadgeClass(playlist.LastSyncStatus)">@playlist.LastSyncStatus</span>
                    @if (playlist.LastSyncAt.HasValue)
                    {
                        <small class="text-muted">
                            Last synced: @playlist.LastSyncAt.Value.ToLocalTime().ToString("g")
                        </small>
                    }
                </div>
                <div class="mt-3">
                    <a href="@playlist.SourceUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-box-arrow-up-right"></i> Open in @playlist.SourcePlatform
                    </a>
                </div>
            </div>
        </div>

        @if (playlist.Tracks.Count == 0)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No tracks in this playlist. Try syncing it.
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Tracks (@playlist.Tracks.Count)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Title</th>
                                    <th>Artist</th>
                                    <th style="width: 100px;">Duration</th>
                                    <th style="width: 120px;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (track, index) in playlist.Tracks.Select((t, i) => (t, i + 1)))
                                {
                                    <tr>
                                        <td class="text-muted">@index</td>
                                        <td>
                                            <strong>@(track.Title ?? "Unknown")</strong>
                                        </td>
                                        <td>@(track.Artist ?? "Unknown Artist")</td>
                                        <td class="text-muted">
                                            @if (!string.IsNullOrEmpty(track.CurrentPath))
                                            {
                                                <i class="bi bi-check-circle text-success" title="Downloaded"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-dash-circle text-secondary" title="Not downloaded"></i>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(track.CurrentPath))
                                            {
                                                <span class="badge bg-success">Downloaded</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Not synced</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string PlaylistId { get; set; } = string.Empty;

    private PlaylistEntity? playlist;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlaylist();
    }

    private async Task LoadPlaylist()
    {
        isLoading = true;
        playlist = await PlaylistService.GetPlaylistByIdAsync(PlaylistId);
        isLoading = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/playlists");
    }

    private string GetStatusBadgeClass(SyncStatus status)
    {
        return status switch
        {
            SyncStatus.Completed => "success",
            SyncStatus.Failed => "danger",
            SyncStatus.InProgress => "warning",
            _ => "secondary"
        };
    }
}
