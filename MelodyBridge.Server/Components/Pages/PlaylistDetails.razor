@page "/playlists/{PlaylistId}"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Data
@inject PlaylistStore Store
@inject NavigationManager Navigation
@inject IDbContextFactory<MelodyBridgeDbContext> DbFactory
@inject IDownloadManager DownloadMgr

<PageTitle>@(playlist?.Name ?? "Playlist") - MelodyBridge</PageTitle>

@if (loading)
{
    <div class="empty-state">Loading playlist…</div>
}
else if (playlist == null)
{
    <section class="page-title">
        <div>
            <span class="eyebrow">Error</span>
            <h1>Playlist not found</h1>
            <p>It may have been deleted.</p>
        </div>
        <a class="btn-modern" href="playlists">Back to playlists</a>
    </section>
}
else
{
    <section class="page-title">
        <div class="playlist-header">
            <div class="playlist-cover small">
                @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                {
                    <img src="@playlist.CoverImageUrl" alt="@playlist.Name" />
                }
                else
                {
                    <span class="playlist-cover-placeholder">♫</span>
                }
            </div>
            <div>
                <span class="eyebrow">@playlist.SourcePlatform playlist</span>
                <h1>@playlist.Name</h1>
                <p>
                    @playlist.TrackCount tracks
                    @if (!string.IsNullOrEmpty(playlist.Owner))
                    {
                        <span> · by @playlist.Owner</span>
                    }
                    <span> · last synced @(playlist.LastSyncAt?.ToLocalTime().ToString("g") ?? "never")</span>
                </p>
            </div>
        </div>
        <div class="topbar-actions">
            <button class="btn-modern primary" @onclick="Refresh" disabled="@busy">@(busy ? "Fetching…" : "Refresh")</button>
            <button class="btn-modern secondary" @onclick="DownloadMissing" disabled="@(busy || downloading)">
                @(downloading ? $"Downloading… ({downloadProgress.done + downloadProgress.failed}/{downloadProgress.total})" : "Download missing")
            </button>
            <button class="btn-modern ghost" @onclick="SaveSettings" disabled="@busy">Save settings</button>
            <a class="btn-modern ghost" href="playlists">Back</a>
        </div>
    </section>

    <section class="content-grid two">
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Settings</span>
                    <h2>Sync configuration</h2>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="hint-box">@message</div>
            }
            <div class="form-grid single">
                <label>
                    Name
                    <input @bind="editName" />
                </label>
                <label>
                    Download folder
                    <input @bind="editTargetDirectory" placeholder="/music/downloads" />
                </label>
                <label class="toggle-row">
                    <input type="checkbox" @bind="editAutoSync" />
                    <span>Auto-sync this playlist</span>
                </label>
                @if (editAutoSync)
                {
                    <label>
                        Check interval (minutes)
                        <input type="number" min="5" step="5" @bind="editInterval" />
                    </label>
                }
                <label>
                    Sync mode
                    <select @bind="editSyncMode">
                        <option value="@PlaylistSyncMode.Additive">Additive — keep removed tracks as history</option>
                        <option value="@PlaylistSyncMode.Mirror">Mirror — remove tracks deleted from source</option>
                    </select>
                </label>
                <a href="@playlist.SourceUrl" target="_blank" rel="noopener" class="hint-box">
                    @playlist.SourceUrl ↗
                </a>
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Library</span>
                    <h2>Track status</h2>
                </div>
            </div>
            <div class="stat-grid two">
                <div class="stat-card">
                    <span class="stat-icon">♫</span>
                    <label>Tracks</label>
                    <strong>@playlist.TrackCount</strong>
                </div>
                <div class="stat-card">
                    <span class="stat-icon">↓</span>
                    <label>Downloaded</label>
                    <strong>@downloadedCount / @playlist.Tracks.Count</strong>
                </div>
            </div>
            @if (downloading)
            {
                <div class="download-live">
                    <div class="download-live-head">
                        <strong>Downloading…</strong>
                        <span>@doneCount + @failedCount of @downloadProgress.total</span>
                    </div>
                    <div class="progress-track">
                        <div class="progress-fill" style="width:@ProgressPercent%"></div>
                    </div>
                    @if (currentActivity is not null)
                    {
                        <div class="qi-meta">@currentActivity</div>
                    }
                </div>
            }
            else if (lastDownloadSummary is not null)
            {
                <div class="hint-box">@lastDownloadSummary</div>
            }
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Snapshot</span>
                <h2>Tracks (@playlist.Tracks.Count)</h2>
            </div>
            <input class="search-input" placeholder="Filter tracks…"
                   value="@trackFilter" @oninput="OnFilterChanged" />
        </div>
        @if (playlist.Tracks.Count == 0)
        {
            <div class="empty-state">No tracks in this snapshot. Refresh the playlist.</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Artist</th>
                            <th>Duration</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var track in FilteredTracks())
                        {
                            <tr>
                                <td class="text-muted">@(track.Position + 1)</td>
                                <td><strong>@(track.Title ?? "Unknown")</strong></td>
                                <td>@(track.Artist ?? "Unknown artist")</td>
                                <td class="text-muted">@FormatDuration(track.DurationMs)</td>
                                <td>
                                    <span class="pill @(DownloadStatusClass(track.DownloadStatus))">
                                        @(track.DownloadStatus ?? "pending")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter] public string PlaylistId { get; set; } = string.Empty;

    private PlaylistEntity? playlist;
    private bool loading = true;
    private bool busy;
    private string message = string.Empty;
    private string trackFilter = string.Empty;

    private string editName = string.Empty;
    private string editTargetDirectory = string.Empty;
    private bool editAutoSync;
    private int editInterval = 60;
    private PlaylistSyncMode editSyncMode = PlaylistSyncMode.Additive;
    private int downloadedCount;
    private bool downloading;
    private (int total, int done, int failed) downloadProgress;
    private string? lastDownloadSummary;
    private Timer? progressTimer;
    private int doneCount;
    private int failedCount;
    private string? currentActivity;

    private int ProgressPercent => downloadProgress.total == 0
        ? 0
        : Math.Min(100, (doneCount + failedCount) * 100 / downloadProgress.total);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        playlist = await Store.GetByIdAsync(PlaylistId);
        if (playlist is not null)
        {
            editName = playlist.Name;
            editTargetDirectory = playlist.TargetDirectory ?? string.Empty;
            editAutoSync = playlist.AutoSyncEnabled;
            editInterval = playlist.AutoSyncIntervalMinutes ?? 60;
            editSyncMode = Enum.TryParse<PlaylistSyncMode>(playlist.SyncMode, out var mode)
                ? mode : PlaylistSyncMode.Additive;
            downloadedCount = playlist.Tracks.Count(t => t.DownloadStatus == "downloaded");
        }
        loading = false;
    }

    private async Task Refresh()
    {
        busy = true;
        try
        {
            var target = string.IsNullOrWhiteSpace(editTargetDirectory) ? null : editTargetDirectory;
            playlist = string.IsNullOrWhiteSpace(target)
                ? await Store.RefreshAsync(PlaylistId)
                : await Store.RefreshAsync(PlaylistId, target);
            await Load();
        }
        finally { busy = false; }
    }

    private async Task SaveSettings()
    {
        var target = string.IsNullOrWhiteSpace(editTargetDirectory) ? null : editTargetDirectory;
        await Store.UpdateSettingsAsync(PlaylistId, editName, editAutoSync, editInterval, target, editSyncMode);
        message = "Settings saved.";
        await Load();
    }

    private async Task DownloadMissing()
    {
        downloading = true;
        doneCount = 0;
        failedCount = 0;
        currentActivity = null;
        downloadProgress = (playlist?.Tracks.Count ?? 0, 0, 0);

        progressTimer = new Timer(_ => InvokeAsync(async () => await PollProgressAsync()), null, 800, 800);
        try
        {
            var result = await Store.DownloadMissingAsync(PlaylistId);
            lastDownloadSummary = result.downloaded == 0 && result.failed == 0
                ? "Nothing to download — all tracks already have files."
                : $"Downloaded {result.downloaded}, failed {result.failed}.";
            await Load();
        }
        catch (Exception ex)
        {
            lastDownloadSummary = $"Download failed: {ex.Message}";
        }
        finally
        {
            progressTimer?.Dispose();
            progressTimer = null;
            downloading = false;
        }
    }

    /// <summary>Pulls live counts from the download manager + the DB while a run is active.</summary>
    private async Task PollProgressAsync()
    {
        if (!downloading) return;
        try
        {
            var inFlight = DownloadMgr.SnapshotProgress().ToList();
            var activity = inFlight.LastOrDefault(p => p.Status is "searching" or "downloading");
            currentActivity = activity is null
                ? null
                : activity.Plugin is null
                    ? $"{activity.Status} · {activity.Title}"
                    : $"{activity.Status} · {activity.Title} · {activity.Plugin}";

            // Live counts straight from the database (fresh context every poll).
            await using var db = await DbFactory.CreateDbContextAsync();

            var pl = await db.Playlists.Include(p => p.Tracks)
                .AsNoTracking()
                .FirstOrDefaultAsync(p => p.Id == PlaylistId);
            if (pl is not null)
            {
                doneCount = pl.Tracks.Count(t => t.DownloadStatus == "downloaded");
                failedCount = pl.Tracks.Count(t => t.DownloadStatus == "failed");
                downloadProgress = (pl.Tracks.Count, 0, 0);
            }
            StateHasChanged();
        }
        catch { /* polling must never break the run */ }
    }

    private void OnFilterChanged(ChangeEventArgs e) => trackFilter = e.Value?.ToString() ?? string.Empty;

    private IEnumerable<TrackEntity> FilteredTracks()
    {
        var source = playlist?.Tracks ?? Enumerable.Empty<TrackEntity>();
        if (string.IsNullOrWhiteSpace(trackFilter)) return source;
        return source.Where(t =>
            (t.Title ?? "").Contains(trackFilter, StringComparison.OrdinalIgnoreCase) ||
            (t.Artist ?? "").Contains(trackFilter, StringComparison.OrdinalIgnoreCase));
    }

    private static string FormatDuration(long? ms)
        => ms is > 0
            ? TimeSpan.FromMilliseconds(ms.Value).ToString(@"mm\:ss")
            : "—";

    private static string DownloadStatusClass(string? status) => status switch
    {
        "downloaded" => "ok",
        "failed" => "err",
        "queued" or "in_progress" => "warn",
        _ => "neutral"
    };
}
