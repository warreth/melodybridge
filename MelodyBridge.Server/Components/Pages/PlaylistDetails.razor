    /// <summary>Makes a header click show immediately, without waiting for the poll tick.</summary>
    private void OnRunStateChanged()
    {
        observedRun = Coordinator.RunFor(PlaylistId);
        UpdateQueuePositions();
        StateHasChanged();
    }

    /// <summary>The queue label lookup: title -> first queue index, once per tick.</summary>
    private void UpdateQueuePositions()
    {
        if (run is null || run.State is not (Application.Services.DownloadRunState.Running
            or Application.Services.DownloadRunState.Paused))
        {
            queuePositions = new Dictionary<string, int>(StringComparer.Ordinal);
            return;
        }
        var positions = new Dictionary<string, int>(StringComparer.Ordinal);
        var queue = Coordinator.QueueFor(PlaylistId);
        for (var i = 0; i < queue.Count; i++)
            positions.TryAdd(queue[i], i);
        queuePositions = positions;
    }

    private async Task ExportCsv()
    {
        if (playlist is null) return;
        busy = true;
        try
        {
            var bytes = await Store.ExportCsvAsync(PlaylistId);
            var safeName = string.Concat(playlist.Name.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c));
            await JS.InvokeVoidAsync("melody.downloadFile", $"{safeName}.csv", "text/csv", bytes);
            Notifications.Success("CSV exported.");
        }
        finally { busy = false; }
    }

    /// <summary>
    /// Downloads exactly this track: the full-run coordinator stays
    /// untouched, so the click never kicks off the rest of the playlist.
    /// The row shows a live "downloading" pill while the attempt runs and
    /// the outcome lands as a toast.
    /// </summary>
    private async Task RetryTrack(TrackEntity track)
    {
        busy = true;
        retryingTrackIds.Add(track.Id);
        StateHasChanged();
        try
        {
            var result = await Store.DownloadTrackAsync(track.Id);
            await Load();
            switch (result)
            {
                case "downloaded":
                    Notifications.Success($"Downloaded '{track.Title}'.");
                    break;
                case "claimed-by-another-run":
                    Notifications.Info("This track is already being downloaded by a running batch.");
                    break;
                default:
                    Notifications.Warn($"Download failed for '{track.Title}'.");
                    break;
            }
        }
        finally
        {
            retryingTrackIds.Remove(track.Id);
            busy = false;
        }
    }

    /// <summary>
    /// Resolves a paused dedup conflict for one track: the hardlink half
    /// asks for confirmation first (what gets linked and that the quality
    /// is the other file's), "download new" queues immediately.
    /// </summary>
    private Task ResolveDedupReview((TrackEntity Track, bool HardlinkExisting) choice)
    {
        if (!choice.HardlinkExisting)
            return ResolveDedupNow(choice.Track, hardlinkExisting: false);

        hardlinkTrack = choice.Track;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>The track whose hardlink confirmation dialog is open.</summary>
    private TrackEntity? hardlinkTrack;

    // ── Archive copy dialog ────────────────────────────────────────
    // Opened from the archive pill (no copy yet, missing from disk) and
    // from the warning pill: it shows the state and lets the copy be
    // created or rebuilt from the primary file.

    /// <summary>The track whose archive dialog is open.</summary>
    private TrackEntity? archiveTrack;

    private void OpenArchiveDialog(TrackEntity track)
    {
        archiveTrack = track;
        StateHasChanged();
    }

    private void CloseArchiveDialog() => archiveTrack = null;

    /// <summary>Headline per state: present, gone, or never made.</summary>
    private static string ArchiveDialogHeadline(TrackEntity track)
    {
        if (string.IsNullOrWhiteSpace(track.ArchivePath)) return "No archive copy yet";
        return track.ArchivePath is { } path && File.Exists(path)
            ? "Archive copy present"
            : "Archive copy missing from disk";
    }

    /// <summary>What the state means, and what the button will do.</summary>
    private static string ArchiveDialogDetail(TrackEntity track)
    {
        if (string.IsNullOrWhiteSpace(track.ArchivePath))
        {
            return "This track has no archive copy. Creating one copies the downloaded file "
                + "into the playlist's archive folder, converted to the configured format when one is set.";
        }
        return File.Exists(track.ArchivePath)
            ? $"The copy exists at {track.ArchivePath}. Recreating it rebuilds the file from the current download."
            : $"The copy is recorded at {track.ArchivePath}, but the file is gone from disk. "
                + "Recreating it copies the current music file again.";
    }

    private string ArchiveDialogAction(TrackEntity track)
        => string.IsNullOrWhiteSpace(track.ArchivePath) ? "Create archive copy" : "Recreate archive copy";

    /// <summary>
    /// Rebuilds the archive copy and reports the outcome: on success the
    /// dialog closes, on failure it stays open with the real reason (the
    /// fresh warning is on the row after the reload).
    /// </summary>
    private async Task RetryArchive()
    {
        if (archiveTrack is not { } track) return;
        busy = true;
        try
        {
            var (ok, reason) = await Store.RetryArchiveAsync(track.Id);
            await Load();
            if (ok)
            {
                archiveTrack = null;
                Notifications.Success($"Archive copy created for '{track.Title}'.");
            }
            else
            {
                archiveTrack = playlist?.Tracks.FirstOrDefault(t => t.Id == track.Id) ?? track;
                Notifications.Warn($"Could not create the archive copy for '{track.Title}': {reason}");
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmHardlink()
    {
        if (hardlinkTrack is not { } track) return;
        hardlinkTrack = null;
        await ResolveDedupNow(track, hardlinkExisting: true);
    }

    /// <summary>What the confirmation explains: the warning already names
    /// the quality difference, so the dialog adds what linking does.</summary>
    private static string HardlinkConfirmMessage(TrackEntity track)
    {
        // The dedup warning carries the quality difference; strip its
        // "dedup conflict:" label and its own "Choose ... or ..." tail:
        // this dialog is that choice, it does not need to repeat it.
        var detail = track.Warning ?? "";
        if (detail.StartsWith("dedup conflict: ", StringComparison.Ordinal))
            detail = detail["dedup conflict: ".Length..];
        var tail = detail.IndexOf(". Choose ", StringComparison.Ordinal);
        if (tail > 0) detail = detail[..tail];
        var what = detail.Length > 0
            ? $"{char.ToUpper(detail[0])}{detail[1..]}. "
            : "Another playlist already has this track. ";
        return what
            + "Hardlinking points both playlists at the same bytes on disk: no new download runs, the file keeps its current quality, and deleting one playlist's copy leaves the other in place.";
    }

    private async Task ResolveDedupNow(TrackEntity track, bool hardlinkExisting)
    {
        busy = true;
        try
        {
            if (await Store.ResolveReviewAsync(track.Id, hardlinkExisting))
            {
                Notifications.Success(hardlinkExisting
                    ? $"Linked the existing file for '{track.Title}'."
                    : $"Queued '{track.Title}' for a fresh download.");
                if (!hardlinkExisting)
                    await Store.DownloadTrackAsync(track.Id);
            }
            else
            {
                Notifications.Warn($"Could not resolve '{track.Title}': the other playlist's file is gone, or it is still waiting for a quality decision. Retry the download.");
            }
            await Load();
        }
        finally { busy = false; }
    }

    /// <summary>
    /// The track the source picker is open for, the candidates every
    /// plugin offered and whether a pick is downloading.
    /// </summary>
    private TrackEntity? chooseSourceTrack;
    private IReadOnlyList<DownloadCandidate> sourceCandidates = Array.Empty<DownloadCandidate>();
    private bool searchingSources;
    private bool downloadingCandidate;
    /// <summary>The candidate URL currently downloading, so only its row
    /// shows the progress state.</summary>
    private string? downloadingCandidateUrl;
    /// <summary>Seconds the current pick has been running, ticked while
    /// the dialog waits so the UI never looks frozen.</summary>
    private int downloadElapsedSeconds;
    private CancellationTokenSource? downloadTicker;
    /// <summary>Per-candidate failure text after a pick did not deliver.</summary>
    private readonly Dictionary<string, string> sourceFailures = new(StringComparer.Ordinal);
    /// <summary>
    /// Exact source facts per candidate URL, filled in as each plugin's
    /// probe answers. <see cref="probedCandidateUrls"/> marks a URL whose
    /// probe finished, so "still checking" is distinguishable from "the
    /// plugin cannot tell".
    /// </summary>
    private readonly Dictionary<string, CandidateAudioQuality> candidateQualities = new(StringComparer.Ordinal);
    private readonly HashSet<string> probedCandidateUrls = new(StringComparer.Ordinal);
    private readonly HashSet<string> probingCandidateUrls = new(StringComparer.Ordinal);
    /// <summary>The quality this playlist asks for, shown in the picker
    /// header and compared against every candidate.</summary>
    private DownloadQuality pickerTargetQuality = DownloadQuality.Any;
    /// <summary>
    /// A search can run for minutes (every plugin has its own budget) and
    /// the dialog can be closed or reopened for another track meanwhile:
    /// only the newest generation may write its result.
    /// </summary>
    private int sourceSearchGeneration;

    private async Task OpenSourcePicker(TrackEntity track)
    {
        chooseSourceTrack = track;
        sourceCandidates = Array.Empty<DownloadCandidate>();
        StateHasChanged();
        await SearchSourcesAsync();
    }

    private void CloseSourcePicker()
    {
        // A search still in flight must not write into a later dialog.
        sourceSearchGeneration++;
        downloadTicker?.Cancel();
        searchingSources = false;
        downloadingCandidate = false;
        downloadingCandidateUrl = null;
        sourceCandidates = Array.Empty<DownloadCandidate>();
        sourceFailures.Clear();
        candidateQualities.Clear();
        probedCandidateUrls.Clear();
        probingCandidateUrls.Clear();
        chooseSourceTrack = null;
    }

    private async Task SearchSourcesAgain() => await SearchSourcesAsync();

    private async Task SearchSourcesAsync()
    {
        if (chooseSourceTrack is not { } track) return;
        var generation = ++sourceSearchGeneration;
        var trackId = track.Id;
        searchingSources = true;
        sourceCandidates = Array.Empty<DownloadCandidate>();
        sourceFailures.Clear();
        candidateQualities.Clear();
        probedCandidateUrls.Clear();
        probingCandidateUrls.Clear();
        pickerTargetQuality = PlaylistStore.ParseQuality(editQuality);
        StateHasChanged();
        IReadOnlyList<DownloadCandidate>? candidates = null;
        try
        {
            // Providers run at the same time and each hit lands here the
            // moment its provider answers, so the list fills in instead of
            // staring at a spinner until the slowest plugin is done.
            candidates = await Store.SearchCandidatesAsync(trackId, candidate =>
            {
                if (generation != sourceSearchGeneration || chooseSourceTrack?.Id != trackId) return;
                _ = InvokeAsync(() =>
                {
                    if (generation != sourceSearchGeneration || chooseSourceTrack?.Id != trackId) return;
                    if (sourceCandidates.Any(c => c.SourceUrl == candidate.SourceUrl)) return;
                    sourceCandidates = sourceCandidates.Append(candidate).ToList();
                    StartCandidateProbe(candidate, generation, trackId);
                    StateHasChanged();
                });
            });
        }
        finally
        {
            // A stale search (dialog closed, another track opened, Search
            // again pressed) changes nothing: not the list, not the flag.
            if (generation == sourceSearchGeneration && chooseSourceTrack?.Id == trackId)
            {
                if (candidates is not null)
                {
                    sourceCandidates = candidates;
                    foreach (var candidate in candidates)
                        StartCandidateProbe(candidate, generation, trackId);
                }
                searchingSources = false;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Asks the candidate's plugin for the exact source facts, off the UI
    /// thread, and fills the row in when the answer lands. A probe that
    /// yields nothing leaves the row on the manifest line; the row never
    /// waits for it to enable Download.
    /// </summary>
    private void StartCandidateProbe(DownloadCandidate candidate, int generation, int trackId)
    {
        var url = candidate.SourceUrl;
        if (probingCandidateUrls.Contains(url) || probedCandidateUrls.Contains(url)) return;
        probingCandidateUrls.Add(url);
        _ = Task.Run(async () =>
        {
            CandidateAudioQuality? quality = null;
            try
            {
                quality = await Store.ProbeCandidateQualityAsync(candidate.PluginId, url);
            }
            catch
            {
                // A probe is best effort; the row falls back to the manifest.
            }
            await InvokeAsync(() =>
            {
                probingCandidateUrls.Remove(url);
                if (generation != sourceSearchGeneration || chooseSourceTrack?.Id != trackId) return;
                probedCandidateUrls.Add(url);
                if (quality is not null) candidateQualities[url] = quality;
                StateHasChanged();
            });
        });
    }

    /// <summary>
    /// What one candidate really is: the exact probe facts when they
    /// arrived, otherwise what the plugin declares it can deliver.
    /// </summary>
    private string CandidateQualityText(DownloadCandidate candidate)
    {
        if (candidateQualities.TryGetValue(candidate.SourceUrl, out var quality))
        {
            var parts = new List<string>();
            var codec = CodecLabel(quality.Codec);
            if (codec.Length > 0) parts.Add(codec);
            if (quality.BitDepth is { } depth) parts.Add($"{depth}-bit");
            if (quality.SampleRateHz is { } rate) parts.Add($"{rate / 1000.0:0.#} kHz");
            if (quality.BitrateKbps is { } kbps && !quality.Lossless) parts.Add($"{kbps} kbps");
            if (parts.Count == 0) parts.Add(quality.Lossless ? "lossless" : "unknown");
            var text = string.Join(" · ", parts);
            return quality.Note is { Length: > 0 } note ? $"{text} ({note})" : text;
        }

        var declared = candidate.DeclaredQuality;
        return declared is { Length: > 0 }
            ? $"{candidate.PluginName} delivers {declared}"
            : $"{candidate.PluginName} did not report its quality";
    }

    /// <summary>
    /// The target match pill for one candidate, or null while its probe
    /// still runs. With exact facts the verdict is a comparison; without
    /// them it reads the plugin's own declaration, never a guess.
    /// </summary>
    private (string Variant, string Label, string Title)? CandidateVerdict(DownloadCandidate candidate)
    {
        if (!pickerTargetQuality.HasConstraints) return null;
        var targetLabel = QualityLabel(editQuality);

        if (candidateQualities.TryGetValue(candidate.SourceUrl, out var quality))
        {
            if (QualityMatchesTarget(quality, pickerTargetQuality))
            {
                return ("ok", "matches target",
                    $"This source delivers {targetLabel}, the playlist's quality.");
            }
            return candidate.CanServeRequested
                ? ("warn", "off target",
                    $"This source does not deliver {targetLabel}. The pick is saved as-is.")
                : ("warn", "saved as-is",
                    $"{candidate.PluginName} cannot deliver {targetLabel}; the pick keeps its source quality instead of being re-encoded.");
        }

        if (!probedCandidateUrls.Contains(candidate.SourceUrl)) return null;
        return candidate.CanServeRequested
            ? ("ok", "target OK", $"{candidate.PluginName} declares it can deliver {targetLabel}.")
            : ("warn", "saved as-is",
                $"{candidate.PluginName} cannot deliver {targetLabel}; the pick keeps its source quality instead of being re-encoded.");
    }

    /// <summary>True when the probed facts satisfy the requested quality.</summary>
    private static bool QualityMatchesTarget(CandidateAudioQuality quality, DownloadQuality target)
    {
        if (target.Format == AudioFormat.Flac) return quality.Lossless;
        if (target.Format != AudioFormat.Auto && AudioFormatOf(quality.Codec) != target.Format)
            return false;
        // Unknown bitrates pass the pre-check: only the downloaded file can
        // prove the band, exactly like the waterfall's own gate.
        return target.IsWithinBand(quality.BitrateKbps);
    }

    /// <summary>The container a raw codec name stands for.</summary>
    private static AudioFormat AudioFormatOf(string? codec) => codec?.ToLowerInvariant() switch
    {
        "flac" => AudioFormat.Flac,
        "mp3" => AudioFormat.Mp3,
        "opus" => AudioFormat.Opus,
        var c when c is not null && (c.StartsWith("mp4a", StringComparison.Ordinal)
            || c.StartsWith("aac", StringComparison.Ordinal)) => AudioFormat.Aac,
        _ => AudioFormat.Auto,
    };

    /// <summary>Readable codec names; ffprobe/yt-dlp names are not.</summary>
    private static string CodecLabel(string? codec) => codec?.ToLowerInvariant() switch
    {
        null or "" or "none" => "",
        "flac" => "FLAC",
        "alac" => "ALAC",
        "mp3" => "MP3",
        "opus" => "Opus",
        "vorbis" => "Vorbis",
        var c when c.StartsWith("mp4a", StringComparison.Ordinal)
            || c.StartsWith("aac", StringComparison.Ordinal) => "AAC",
        var c when c.StartsWith("pcm", StringComparison.Ordinal) => "PCM",
        _ => codec?.ToUpperInvariant() ?? "",
    };

    /// <summary>
    /// Downloads the candidate the user picked; the row and the table
    /// refresh when it lands, and a failure says why instead of guessing.
    /// </summary>
    private async Task DownloadPickedCandidate(DownloadCandidate candidate)
    {
        if (chooseSourceTrack is not { } track) return;
        var trackId = track.Id;
        downloadingCandidate = true;
        downloadingCandidateUrl = candidate.SourceUrl;
        downloadElapsedSeconds = 0;
        retryingTrackIds.Add(trackId);
        var ticker = new CancellationTokenSource();
        downloadTicker = ticker;
        _ = TickDownloadProgressAsync(ticker.Token);
        try
        {
            var result = await Store.DownloadCandidateAsync(trackId, candidate);
            switch (result)
            {
                case "downloaded":
                    Notifications.Success($"Downloaded '{track.Title}' from {candidate.PluginName}.");
                    // Only close the dialog this pick came from: another
                    // track's picker may be open by now.
                    if (chooseSourceTrack?.Id == trackId) chooseSourceTrack = null;
                    break;
                case "claimed-by-another-run":
                    Notifications.Info("This track is already being downloaded by a running batch.");
                    break;
                default:
                    // Keep the dialog open with the real reason on that row:
                    // the next pick must be an informed one.
                    await Load();
                    var row = playlist?.Tracks?.FirstOrDefault(t => t.Id == trackId);
                    sourceFailures[candidate.SourceUrl] = row?.DownloadError is { Length: > 0 } error
                        ? error
                        : $"{candidate.PluginName} did not deliver this pick";
                    Notifications.Warn($"'{candidate.PluginName}' could not deliver '{track.Title}'. Try another result.");
                    break;
            }
            if (result == "downloaded") await Load();
        }
        finally
        {
            // Only this pick's ticker, and only this pick's state: a later
            // pick must keep running when an earlier one lands late. The
            // page may already have been disposed by navigating away, and
            // Cancel after Dispose throws.
            try { ticker.Cancel(); }
            catch (ObjectDisposedException) { /* the page disposed it first */ }
            ticker.Dispose();
            if (ReferenceEquals(downloadTicker, ticker)) downloadTicker = null;
            downloadingCandidateUrl = null;
            downloadingCandidate = false;
            retryingTrackIds.Remove(trackId);
        }
    }

    private async Task TickDownloadProgressAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(1000, ct);
                downloadElapsedSeconds++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // The pick landed or the page went away: nothing left to tick.
        }
    }

    /// <summary>
    /// The candidate length next to the original's: "same length" or the
    /// signed difference, so a preview or a longer edit stands out before
    /// the click. Empty when either side has no length.
    /// </summary>
    private static string LengthDelta(TrackEntity track, TimeSpan candidate)
    {
        if (track.DurationMs is not > 0) return "";
        var delta = (int)Math.Round(
            (candidate - TimeSpan.FromMilliseconds(track.DurationMs.Value)).TotalSeconds);
        if (Math.Abs(delta) < 5) return "same length";
        var abs = Math.Abs(delta);
        return $"{(delta > 0 ? "+" : "-")}{abs / 60}:{abs % 60:00}";
    }

    private async Task RemoveTrack(TrackEntity track)
    {
        // Tracks with a local file offer the choice (keep the file, delete
        // it but keep the track, or both go); tracks without one just
        // leave the playlist.
        if (track.DownloadStatus != "downloaded")
        {
            await RemoveTrackNow(track, RemoveChoice.KeepFile);
            return;
        }
        removeTrack = track;
        removeChoice = RemoveChoice.KeepFile; // safe default: never delete bytes unasked
        StateHasChanged();
    }

    private void CancelRemoveTrack()
    {
        removeTrack = null;
        StateHasChanged();
    }

    private Task ConfirmRemoveTrack()
    {
        if (removeTrack is not { } track) return Task.CompletedTask;
        var choice = removeChoice;
        removeTrack = null;
        return RemoveTrackNow(track, choice);
    }

    /// <summary>The confirm button names what it will do, not a generic "OK".</summary>
    private string RemoveConfirmLabel => removeChoice switch
    {
        RemoveChoice.DeleteFile => "Delete the file",
        RemoveChoice.DeleteFilesAndTrack => "Delete file and track",
        _ => "Remove from playlist",
    };

    private async Task RemoveTrackNow(TrackEntity track, RemoveChoice choice)
    {
        busy = true;
        try
        {
            if (choice == RemoveChoice.DeleteFile)
            {
                var outcome = await Store.DeleteTrackFilesAsync(PlaylistId, track.Id);
                if (outcome.Error is { } error)
                {
                    // The file is still on disk, so nothing was reset: say so
                    // instead of reporting a delete that did not happen.
                    Notifications.Warn($"Could not delete the file of '{track.Title}': {error}");
                }
                else if (outcome.Deleted)
                {
                    Notifications.Success($"Deleted the file of '{track.Title}'; download it again whenever you want.");
                }
                else
                {
                    Notifications.Info($"'{track.Title}' had no files to delete.");
                }
                await Load();
                return;
            }

            var deleteFile = choice == RemoveChoice.DeleteFilesAndTrack;
            if (await Store.RemoveTrackAsync(PlaylistId, track.Id, deleteFile))
            {
                Notifications.Success(deleteFile
                    ? $"Removed '{track.Title}' and deleted its files."
                    : $"Removed '{track.Title}' from the playlist.");
                await Load();
            }
        }
        finally { busy = false; }
    }

    /// <summary>
    /// Settles a flagged quality review for one track. Keep clears the
    /// flag and leaves the file alone. Retry replaces the file through
    /// the waterfall, with the provider that delivered the flagged file
    /// skipped for this attempt, and lands the outcome as a toast.
    /// </summary>
    private async Task ResolveQualityReview((TrackEntity Track, QualityReviewAction Action) choice)
    {
        busy = true;
        try
        {
            if (!await Store.ResolveQualityReviewAsync(choice.Track.Id, choice.Action))
            {
                // False has two causes now: the track changed under us, or
                // the flagged file could not be deleted (the retry refuses
                // then, on purpose). Say which one it is.
                await Load();
                var current = playlist?.Tracks.FirstOrDefault(t => t.Id == choice.Track.Id);
                Notifications.Warn(current is { DownloadStatus: "downloaded", ReviewKind: not null }
                    ? $"Could not replace '{choice.Track.Title}': its flagged file could not be deleted. Keep the file, or fix the file permissions and try again."
                    : $"Could not settle '{choice.Track.Title}': the track changed. Reload the page.");
                return;
            }

            if (choice.Action == QualityReviewAction.Keep)
            {
                Notifications.Success($"Kept '{choice.Track.Title}' as it is.");
                await Load();
                return;
            }

            Notifications.Info($"Retrying '{choice.Track.Title}' at another provider…");
            retryingTrackIds.Add(choice.Track.Id);
            await Load();
            StateHasChanged();
            var result = await Store.DownloadTrackAsync(choice.Track.Id);
            switch (result)
            {
                case "downloaded":
                    Notifications.Success($"Downloaded '{choice.Track.Title}'.");
                    break;
                case "claimed-by-another-run":
                    Notifications.Info("This track is already being downloaded by a running batch.");
                    break;
                default:
                    Notifications.Warn($"Retry failed for '{choice.Track.Title}'.");
                    break;
            }
            await Load();
        }
        finally
        {
            retryingTrackIds.Remove(choice.Track.Id);
            busy = false;
        }
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        trackFilter = e.Value?.ToString() ?? string.Empty;
        filteredCache = null;
    }

    // Delete flow: the topbar asks, the dialog confirms, files optional.
    private async Task AskDelete()
    {
        confirmDelete = true;
        deleteFilesWithPlaylist = false;
        var impact = await Store.GetDeleteImpactAsync(PlaylistId);
        deleteFileCount = impact.Files;
        deleteFileSizeBytes = impact.Bytes;
    }

    private void CancelDelete()
    {
        confirmDelete = false;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (playlist is null) return;
        busy = true;
        try
        {
            await Store.DeleteAsync(PlaylistId, deleteFilesWithPlaylist);
            Navigation.NavigateTo("/playlists");
        }
        finally { busy = false; }
    }

    /// <summary>
    /// The filtered rows, computed once per filter change or reload. The
    /// table keys its sort and its diff on the list reference, so handing
    /// it a fresh list on every render defeated both.
    /// </summary>
    private IReadOnlyList<TrackEntity>? filteredCache;

    private IReadOnlyList<TrackEntity> TrackRows => filteredCache ??= FilteredTracks().ToList();

    private IEnumerable<TrackEntity> FilteredTracks()
    {
        var source = playlist?.Tracks ?? Enumerable.Empty<TrackEntity>();
        if (attentionOnly)
            source = source.Where(NeedsAttention);
        if (string.IsNullOrWhiteSpace(trackFilter)) return source;
        return source.Where(t =>
            (t.Title ?? "").Contains(trackFilter, StringComparison.OrdinalIgnoreCase) ||
            (t.Artist ?? "").Contains(trackFilter, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Failed tracks, dedup conflicts and open quality reviews: the rows that need a human.</summary>
    private static bool NeedsAttention(TrackEntity t)
        => t.DownloadStatus is "failed" or "needs-review"
           || (t.DownloadStatus == "downloaded" && t.ReviewKind is not null);

    /// <summary>The sentence lead of the review hint box, singular or plural.</summary>
    private string reviewSummaryLead
        => reviewCount == 1 ? "1 downloaded track needs" : $"{reviewCount} downloaded tracks need";

    private int attentionCount => (playlist?.Tracks ?? new List<TrackEntity>()).Count(NeedsAttention);

    private void ToggleAttentionOnly()
    {
        attentionOnly = !attentionOnly;
        filteredCache = null;
    }

    public void Dispose()
    {
        disposed = true;
        refreshTimer?.Dispose();
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        savedPillCts?.Cancel();
        savedPillCts?.Dispose();
        // Cancel only: the pick's own finally disposes its source, so its
        // Cancel can never hit a disposed CancellationTokenSource.
        downloadTicker?.Cancel();
        downloadTicker = null;
    }

    /// <summary>True for a public source URL. Liked songs are stored under a
    /// marker ("spotify:liked", "youtube:liked"), not a link to open.</summary>
    private static bool IsWebSource(string? sourceUrl)
        => Uri.TryCreate(sourceUrl, UriKind.Absolute, out var uri)
           && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    /// <summary>The header's quality line: preset names read as words, raw strings as-is.</summary>
    private static string QualityLabel(string stored) => QualityPresets.LabelFor(stored);

    /// <summary>The folder an empty download folder field resolves to.</summary>
    private string resolvedDefaultPlaylistPath
        => PlaylistStore.EffectivePlaylistFolder(null, resolvedDefaultMusicPath, editName, playlistFolders);

    /// <summary>The hint under the download folder field, with the path it
    /// actually resolves to today.</summary>
    private string DownloadFolderHint => playlistFolders
        ? $"Leave empty to use the music path plus this playlist's own folder ({resolvedDefaultPlaylistPath}). A folder typed here is used as it is."
        : $"Leave empty to drop this playlist's files directly in the music path ({resolvedDefaultMusicPath}). A folder typed here is used as it is.";

    /// <summary>The archive folder an empty archive folder field resolves to.</summary>
    private string resolvedDefaultArchiveFolder
        => PlaylistStore.EffectiveArchiveFolder(null, resolvedDefaultArchivePath, editName, playlistFolders);

    private string archiveFolderPlaceholder
        => string.IsNullOrWhiteSpace(resolvedDefaultArchivePath)
            ? "/archive-music" : resolvedDefaultArchivePath;

    private string archiveFolderHint
    {
        get
        {
            if (string.IsNullOrWhiteSpace(resolvedDefaultArchivePath))
                return "Leave empty for no archive copy.";
            return playlistFolders
                ? $"Leave empty to use the archive path plus this playlist's own folder ({resolvedDefaultArchiveFolder})."
                : $"Leave empty to drop archive copies directly in the archive path ({resolvedDefaultArchivePath}).";
        }
    }

    /// <summary>True when an archive folder exists: the playlist's own or the app default.</summary>
    private bool HasArchiveTarget
        => !string.IsNullOrWhiteSpace(editArchiveDirectory) || !string.IsNullOrWhiteSpace(resolvedDefaultArchivePath);

    /// <summary>The archive format select shows what "app default" currently means.</summary>
    private static string ArchiveFormatLabel(string? format) => format?.Trim().ToLowerInvariant() switch
    {
        "opus" => "Opus",
        "flac" => "FLAC",
        "mp3" => "MP3",
        "aac" => "AAC",
        _ => "copy the file as-is",
    };

    /// <summary>
    /// Live queue label for a track while this playlist has an active run:
    /// "downloading" for the queue head while running, "in queue · #N"
    /// (Position order) for the rest. Null means the plain status pill.
    /// </summary>
    private string? TrackQueueLabel(TrackEntity track)
    {
        // A single-track retry shows a live pill from the click until the
        // attempt records its outcome.
        if (retryingTrackIds.Contains(track.Id)) return "downloading";
        if (run is null || run.State is not (Application.Services.DownloadRunState.Running
            or Application.Services.DownloadRunState.Paused)) return null;
        if (track.DownloadStatus is "downloaded" or "removed-from-source") return null;
        if (!queuePositions.TryGetValue(track.Title ?? "", out var index)) return null;
        return index == 0 && run.State == Application.Services.DownloadRunState.Running
            ? "downloading"
            : $"in queue · #{index + 1}";
    }
}
