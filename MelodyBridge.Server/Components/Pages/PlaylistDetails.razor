    /// <summary>
    /// Downloads exactly this track: the full-run coordinator stays
    /// untouched, so the click never kicks off the rest of the playlist.
    /// The row shows a live "downloading" pill while the attempt runs and
    /// the outcome lands as a toast.
    /// </summary>
    private async Task RetryTrack(TrackEntity track)
    {
        busy = true;
        retryingTrackIds.Add(track.Id);
        StateHasChanged();
        try
        {
            var result = await Store.DownloadTrackAsync(track.Id);
            await Load();
            var current = playlist?.Tracks.FirstOrDefault(row => row.Id == track.Id);
            switch (result)
            {
                case "downloaded":
                    Notifications.Success($"Downloaded '{track.Title}'.");
                    break;
                case "claimed-by-another-run" when current?.DownloadStatus == "downloaded":
                    Notifications.Info($"'{track.Title}' is already downloaded.");
                    break;
                case "claimed-by-another-run":
                    Notifications.Info("This track is already being downloaded by a running batch.");
                    break;
                case "needs-review":
                    Notifications.Info($"'{track.Title}' is waiting for a quality review.",
                        "Review", $"/playlists/{PlaylistId}");
                    break;
                case "not-found":
                    Notifications.Warn($"'{track.Title}' is no longer in this playlist.");
                    break;
                case "skipped":
                    Notifications.Warn($"'{track.Title}' could not be retried.");
                    break;
                default:
                    Notifications.Warn($"Download failed for '{track.Title}'.",
                        "Retry", $"/playlists/{PlaylistId}?retryTrack={track.Id}");
                    break;
            }
        }
        finally
        {
            retryingTrackIds.Remove(track.Id);
            busy = false;
        }
    }

    /// <summary>
    /// Retries every failed track in one pass. The normal version keeps
    /// the waterfall order; the "elsewhere" version also skips the
    /// provider that failed the track last time, so one dead source does
    /// not fail the whole batch again.
    /// </summary>
    private async Task RetryAllFailedAsync(bool avoidLastProvider)
    {
        if (playlist is null || retryingFailed) return;
        var failed = (playlist.Tracks ?? new List<TrackEntity>())
            .Where(track => track.DownloadStatus == "failed")
            .ToList();
        if (failed.Count == 0) return;

        retryingFailed = true;
        bulkRetryTotal = failed.Count;
        bulkRetryDone = 0;
        busy = true;
        StateHasChanged();

        var downloaded = 0;
        var unresolved = new Dictionary<string, int>(StringComparer.Ordinal);
        try
        {
            foreach (var track in failed)
            {
                retryingTrackIds.Add(track.Id);
                bulkRetryDone++;
                StateHasChanged();
                try
                {
                    var result = await Store.DownloadTrackAsync(
                        track.Id, avoidLastProvider: avoidLastProvider);
                    if (result == "downloaded")
                    {
                        downloaded++;
                    }
                    else
                    {
                        unresolved[result] = unresolved.GetValueOrDefault(result) + 1;
                    }
                }
                finally
                {
                    retryingTrackIds.Remove(track.Id);
                }
            }

            await Load();
            var unresolvedCount = failed.Count - downloaded;
            if (unresolvedCount == 0)
                Notifications.Success(
                    $"Retried {failed.Count} failed track{(failed.Count == 1 ? "" : "s")}: all downloaded.");
            else
                Notifications.Warn(
                    BulkRetrySummary(failed.Count, downloaded, unresolved),
                    "Open playlist", $"/playlists/{PlaylistId}");
        }
        finally
        {
            retryingFailed = false;
            busy = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// The final bulk-retry line. Every result other than "downloaded"
    /// stays visible: a dedup review, a row owned by another run and a
    /// deleted row are not successes.
    /// </summary>
    internal static string BulkRetrySummary(
        int total, int downloaded, IReadOnlyDictionary<string, int> unresolved)
    {
        var parts = new List<string>();
        void Add(string result, string label)
        {
            var count = unresolved.GetValueOrDefault(result);
            if (count > 0) parts.Add($"{count} {label}");
        }

        Add("failed", "still failed");
        Add("needs-review", "for review");
        Add("claimed-by-another-run", "already downloading");
        Add("not-found", "not found");
        Add("skipped", "not attempted");

        var described = parts.Count == 0
            ? 0
            : unresolved.Where(pair => pair.Key is "failed" or "needs-review"
                or "claimed-by-another-run" or "not-found" or "skipped")
                .Sum(pair => pair.Value);
        var other = unresolved.Values.Sum() - described;
        if (other > 0) parts.Add($"{other} unresolved");

        return $"Retried {total} failed track{(total == 1 ? "" : "s")}: "
            + $"{downloaded} downloaded, {string.Join(", ", parts)}.";
    }

    /// <summary>
    /// Resolves a paused dedup conflict for one track: the hardlink half
    /// asks for confirmation first (what gets linked and that the quality
    /// is the other file's), "download new" queues immediately.
    /// </summary>
    private Task ResolveDedupReview((TrackEntity Track, bool HardlinkExisting) choice)
    {
        if (!choice.HardlinkExisting)
            return ResolveDedupNow(choice.Track, hardlinkExisting: false);

        hardlinkTrack = choice.Track;
        StateHasChanged();
        return Task.CompletedTask;
    }

