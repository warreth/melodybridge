@page "/playlists/{PlaylistId}"
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Data
@using MelodyBridge.Infrastructure.Services
@using MelodyBridge.Server.Components.Shared
@inject PlaylistStore Store
@inject NavigationManager Navigation
@inject Application.Services.DownloadCoordinator Coordinator
@inject SettingsStore Settings
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(playlist?.Name ?? "Playlist") - MelodyBridge</PageTitle>

@if (loading)
{
    <div class="empty-state">Loading playlist…</div>
}
else if (playlist == null)
{
    <section class="page-title">
        <div>
            <span class="eyebrow">Error</span>
            <h1>Playlist not found</h1>
            <p>It may have been deleted.</p>
        </div>
        <a class="btn-modern" href="playlists">Back to playlists</a>
    </section>
}
else
{
    <section class="page-title">
        <div class="playlist-header">
            <div class="playlist-cover small">
                @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                {
                    <img src="@playlist.CoverImageUrl" alt="@playlist.Name" />
                }
                else
                {
                    <span class="playlist-cover-placeholder">♫</span>
                }
            </div>
            <div>
                <span class="eyebrow">@playlist.SourcePlatform playlist</span>
                <h1>@playlist.Name</h1>
                <p>
                    @playlist.TrackCount tracks
                    @if (!string.IsNullOrEmpty(playlist.Owner))
                    {
                        <span> · by @playlist.Owner</span>
                    }
                    <span> · last synced @(playlist.LastSyncAt?.ToLocalTime().ToString("g") ?? "never")</span>
                    @if (!string.IsNullOrWhiteSpace(playlist.PreferredFormat) && playlist.PreferredFormat != "auto")
                    {
                        <span> · @playlist.PreferredFormat.Replace(":", " · ")</span>
                    }
                </p>
            </div>
        </div>
        <div class="topbar-actions">
            <button class="btn-modern ghost" @onclick="Refresh" disabled="@busy">@(busy ? "Fetching…" : "Refresh")</button>
            @if (run is null or { State: Application.Services.DownloadRunState.Finished })
            {
                <button class="btn-modern primary" @onclick="StartDownload">Download missing</button>
            }
            else
            {
                @if (run!.State == Application.Services.DownloadRunState.Paused)
                {
                    <button class="btn-modern primary" @onclick="ResumeDownload">Resume</button>
                }
                else
                {
                    <button class="btn-modern secondary" @onclick="PauseDownload">Pause</button>
                }
                <button class="btn-modern ghost" @onclick="CancelDownload">Cancel</button>
            }
            <button class="btn-modern secondary" @onclick="ExportCsv" disabled="@busy">Export CSV</button>
            <button class="btn-modern ghost" @onclick="AskDelete" disabled="@busy">Delete playlist</button>
        </div>
    </section>

    @if (confirmDelete)
    {
        <ConfirmDialog Show="true"
                       Eyebrow="Delete playlist"
                       Title=@($"Delete '{playlist.Name}'?")
                       Message="The playlist and its track list leave MelodyBridge. You will land back on the playlists overview."
                       ConfirmLabel="Delete playlist"
                       Busy="busy"
                       OnConfirm="ConfirmDelete"
                       OnCancel="CancelDelete">
            <label class="toggle-switch wide">
                <input type="checkbox" @bind="deleteFilesWithPlaylist" />
                <span class="toggle-slider"></span>
                <span>Delete the downloaded music files too (@downloadedCount @(downloadedCount == 1 ? "file" : "files"))</span>
            </label>
        </ConfirmDialog>
    }

    @if (run is { } active && active.State is not Application.Services.DownloadRunState.Finished)
    {
        <section class="panel-card download-live">
            <div class="download-live-head">
                <strong>
                    @(run.State == Application.Services.DownloadRunState.Paused ? "Paused" : "Downloading")
                    — @run.Done of @run.Total
                </strong>
                <span>@run.Failed failed · @run.Percent%</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width:@run.Percent%"></div>
            </div>
            @if (!string.IsNullOrEmpty(run.CurrentTrack))
            {
                <div class="qi-meta">Now: @run.CurrentTrack</div>
            }
            @if (run.EtaUtc is { } eta)
            {
                <div class="qi-meta text-muted">ETA @eta.ToLocalTime().ToString("t") · @run.QueueLength in queue</div>
            }
        </section>
    }

    <section class="content-grid two">
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Settings</span>
                    <h2>Sync configuration</h2>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="hint-box">@message</div>
            }
            <div class="form-grid single">
                <label>
                    Name
                    <input @bind="editName" />
                </label>
                <label>
                    Download folder
                    <input @bind="editTargetDirectory" placeholder="@resolvedDefaultMusicPath" />
                    <small class="text-muted">Empty uses the default music path (currently @resolvedDefaultMusicPath).</small>
                </label>
                <label class="quality-field">
                    Audio quality
                    <QualityPicker @bind-Value="editQuality" />
                </label>
                <label class="wide">
                    Auto-sync schedule
                    <SchedulePicker @bind-Value="editSchedule" />
                </label>
                <label>
                    Sync mode
                    <select @bind="editSyncMode">
                        <option value="@PlaylistSyncMode.Additive">Additive: keep removed tracks as history</option>
                        <option value="@PlaylistSyncMode.Mirror">Mirror: remove tracks deleted from source</option>
                    </select>
                </label>
                <div class="flex-actions">
                    <button class="btn-modern primary" @onclick="SaveSettings" disabled="@busy">Save settings</button>
                    <a href="@playlist.SourceUrl" target="_blank" rel="noopener" class="hint">
                        Open source ↗
                    </a>
                </div>
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <span class="eyebrow">Library</span>
                    <h2>Track status</h2>
                </div>
            </div>
            <div class="stat-grid two">
                <div class="stat-card">
                    <span class="stat-icon">♫</span>
                    <label>Tracks</label>
                    <strong>@playlist.Tracks.Count</strong>
                </div>
                <div class="stat-card">
                    <span class="stat-icon">↓</span>
                    <label>Downloaded</label>
                    <strong>@downloadedCount / @playlist.Tracks.Count</strong>
                </div>
            </div>
            @if (downloadedCount > 0 && badQualityCount > 0)
            {
                <div class="hint-box">
                    ⚠ @badQualityCount downloaded track(s) look inflated (re-encoded from a
                    lower-quality source). Retry them after switching the playlist to
                    <strong>Auto</strong> or a lower cap.
                </div>
            }
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <span class="eyebrow">Tracks</span>
                <h2>Tracks (@playlist.Tracks.Count)</h2>
            </div>
            <input type="search" class="search-input" placeholder="Filter tracks…"
                   value="@trackFilter" @oninput="OnFilterChanged" />
        </div>
        @if (playlist.Tracks.Count == 0)
        {
            <div class="empty-state">No tracks in this snapshot. Refresh the playlist.</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="modern-table" style="min-width:760px">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Artist</th>
                            <th>Duration</th>
                            <th>Size</th>
                            <th>Bitrate</th>
                            <th>Rate</th>
                            <th>Format</th>
                            <th>Status</th>
                            @if (showFilenameColumn)
                            {
                                <th>File</th>
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var track in FilteredTracks())
                        {
                            <tr>
                                <td class="text-muted">@(track.Position + 1)</td>
                                <td>
                                    <strong>@(track.Title ?? "Unknown")</strong>
                                </td>
                                <td>@(track.Artist ?? "Unknown artist")</td>
                                <td class="text-muted">@TrackDisplay.Duration(track.DurationMs)</td>
                                <td class="text-muted">@TrackDisplay.Size(track)</td>
                                <td class="text-muted">
                                    @(track.DownloadStatus == "downloaded" ? TrackDisplay.BitrateLabel(track.Bitrate) : "-")
                                </td>
                                <td class="text-muted">
                                    @(track.DownloadStatus == "downloaded" ? TrackDisplay.RateLabel(track.SampleRateHz) : "-")
                                </td>
                                <td class="text-muted">
                                    @(track.DownloadStatus == "downloaded" ? TrackDisplay.FormatLabel(track.MediaType) : "-")
                                </td>
                                <td>
                                    @{ var queueLabel = TrackQueueLabel(track); }
                                    @if (queueLabel is not null)
                                    {
                                        <span class="pill @(queueLabel == "downloading" ? "warn" : DownloadStatusClass(track.DownloadStatus))"
                                              title="@(queueLabel == "downloading" ? "Currently downloading" : null)">
                                            @queueLabel
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pill @(DownloadStatusClass(track.DownloadStatus))"
                                              title="@(track.DownloadStatus == "failed" ? track.DownloadError : null)">
                                            @(track.DownloadStatus ?? "pending")
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(track.Warning))
                                    {
                                        <span class="pill warn" title="@track.Warning">⚠</span>
                                    }
                                </td>
                                @if (showFilenameColumn)
                                {
                                    <td class="text-muted">
                                        @if (!string.IsNullOrWhiteSpace(track.CurrentPath))
                                        {
                                            <span title="@track.CurrentPath">@Path.GetFileName(track.CurrentPath)</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                }
                                <td class="track-actions">
                                    @if (track.DownloadStatus is "failed" or null or "pending")
                                    {
                                        <button class="btn-modern small ghost" title="Download this track now"
                                                @onclick="() => RetryTrack(track)" disabled="@busy">
                                            ↻ Download
                                        </button>
                                    }
                                    @if (track.DownloadStatus is not null)
                                    {
                                        <button class="btn-modern small ghost" title="Remove from playlist (deletes the file)"
                                                @onclick="() => RemoveTrack(track)" disabled="@busy">
                                            ✕ Remove
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter] public string PlaylistId { get; set; } = string.Empty;

    private PlaylistEntity? playlist;
    private bool loading = true;
    private bool busy;
    private string message = string.Empty;
    private string trackFilter = string.Empty;
    private bool showFilenameColumn;

    private string editName = string.Empty;
    private string editTargetDirectory = string.Empty;
    private string editQuality = "auto";
    private ScanSchedule editSchedule = ScanSchedule.Manual;
    private PlaylistSyncMode editSyncMode = PlaylistSyncMode.Additive;

    private int downloadedCount;
    private int badQualityCount;
    private bool confirmDelete;
    private bool deleteFilesWithPlaylist;
    private string resolvedDefaultMusicPath = "/music";
    private Timer? refreshTimer;
    private Application.Services.DownloadRun? observedRun;

    /// <summary>The coordinator's run for this playlist, kept current by the poll.</summary>
    private Application.Services.DownloadRun? run => observedRun;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        // Poll the coordinator: the snapshot lives in the singleton, so the
        // bar survives navigation and never just "disappears".
        refreshTimer = new Timer(_ => InvokeAsync(async () =>
        {
            observedRun = Coordinator.RunFor(PlaylistId);
            if (observedRun is { State: not Application.Services.DownloadRunState.Finished })
            {
                await LoadCountsOnlyAsync();
            }
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task Load()
    {
        loading = true;
        showFilenameColumn = await Settings.GetBoolAsync("show_filename", fallback: false);
        resolvedDefaultMusicPath = await Settings.GetAsync("music_path", "/music");
        playlist = await Store.GetByIdAsync(PlaylistId);
        if (playlist is not null)
        {
            editName = playlist.Name;
            editTargetDirectory = playlist.TargetDirectory ?? string.Empty;
            editQuality = PlaylistStore.IsValidFormat(playlist.PreferredFormat) ? playlist.PreferredFormat : "auto";
            editSchedule = playlist.ScheduleCron is { Length: > 0 }
                ? ScanSchedule.Parse(playlist.ScheduleCron)
                : playlist.AutoSyncEnabled
                    ? ScanSchedule.FromInterval(playlist.AutoSyncIntervalMinutes ?? 60)
                    : ScanSchedule.Manual;
            editSyncMode = Enum.TryParse<PlaylistSyncMode>(playlist.SyncMode, out var mode)
                ? mode : PlaylistSyncMode.Additive;
            await LoadCountsOnlyAsync();
        }
        observedRun = Coordinator.RunFor(PlaylistId);
        loading = false;
    }

    private async Task LoadCountsOnlyAsync()
    {
        playlist = await Store.GetByIdAsync(PlaylistId);
        if (playlist is null) return;
        downloadedCount = playlist.Tracks.Count(t => t.DownloadStatus == "downloaded");
        badQualityCount = playlist.Tracks.Count(t =>
            t.DownloadStatus == "downloaded" && t.Warning?.Contains("inflated") == true);
    }

    private async Task Refresh()
    {
        busy = true;
        try
        {
            var target = string.IsNullOrWhiteSpace(editTargetDirectory) ? null : editTargetDirectory;
            await Store.RefreshAsync(PlaylistId);
            await Load();
        }
        finally { busy = false; }
    }

    private async Task SaveSettings()
    {
        var target = string.IsNullOrWhiteSpace(editTargetDirectory) ? null : editTargetDirectory;
        await Store.UpdateScheduleAsync(PlaylistId, editName, editSchedule, target, editSyncMode, editQuality);
        message = "Settings saved.";
        await Load();
    }

    private void StartDownload() => Coordinator.Start(PlaylistId);
    private void PauseDownload() => Coordinator.Pause(PlaylistId);
    private void ResumeDownload() => Coordinator.Start(PlaylistId);
    private void CancelDownload() => Coordinator.Cancel(PlaylistId);

    private async Task ExportCsv()
    {
        if (playlist is null) return;
        busy = true;
        try
        {
            var bytes = await Store.ExportCsvAsync(PlaylistId);
            var safeName = string.Concat(playlist.Name.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c));
            await JS.InvokeVoidAsync("melody.downloadFile", $"{safeName}.csv", "text/csv", bytes);
            message = "CSV exported.";
        }
        finally { busy = false; }
    }

    private async Task RetryTrack(TrackEntity track)
    {
        busy = true;
        try
        {
            await Store.RetryTrackAsync(track.Id);
            Coordinator.Start(PlaylistId);
        }
        finally { busy = false; }
    }

    private async Task RemoveTrack(TrackEntity track)
    {
        busy = true;
        try
        {
            if (await Store.RemoveTrackAsync(PlaylistId, track.Id, deleteFile: true))
            {
                message = $"Removed '{track.Title}'.";
                await Load();
            }
        }
        finally { busy = false; }
    }

    private void OnFilterChanged(ChangeEventArgs e) => trackFilter = e.Value?.ToString() ?? string.Empty;

    // Delete flow: the topbar asks, the dialog confirms, files optional.
    private void AskDelete()
    {
        confirmDelete = true;
        deleteFilesWithPlaylist = false;
    }

    private void CancelDelete()
    {
        confirmDelete = false;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (playlist is null) return;
        busy = true;
        try
        {
            await Store.DeleteAsync(PlaylistId, deleteFilesWithPlaylist);
            Navigation.NavigateTo("/playlists");
        }
        finally { busy = false; }
    }

    private IEnumerable<TrackEntity> FilteredTracks()
    {
        var source = playlist?.Tracks ?? Enumerable.Empty<TrackEntity>();
        if (string.IsNullOrWhiteSpace(trackFilter)) return source;
        return source.Where(t =>
            (t.Title ?? "").Contains(trackFilter, StringComparison.OrdinalIgnoreCase) ||
            (t.Artist ?? "").Contains(trackFilter, StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose() => refreshTimer?.Dispose();

    private static string DownloadStatusClass(string? status) => status switch
    {
        "downloaded" => "ok",
        "failed" => "err",
        "queued" or "in_progress" => "warn",
        _ => "neutral",
    };

    /// <summary>
    /// Live queue label for a track while this playlist has an active run:
    /// "downloading" for the queue head while running, "in queue · #N"
    /// (Position order) for the rest. Null means the plain status pill.
    /// </summary>
    private string? TrackQueueLabel(TrackEntity track)
    {
        if (run is null || run.State is not (Application.Services.DownloadRunState.Running
            or Application.Services.DownloadRunState.Paused)) return null;
        if (track.DownloadStatus is "downloaded" or "removed-from-source") return null;
        var queue = Coordinator.QueueFor(PlaylistId);
        var title = track.Title ?? "";
        var index = -1;
        for (var i = 0; i < queue.Count; i++)
        {
            if (queue[i] == title) { index = i; break; }
        }
        if (index < 0) return null;
        return index == 0 && run.State == Application.Services.DownloadRunState.Running
            ? "downloading"
            : $"in queue · #{index + 1}";
    }
}
