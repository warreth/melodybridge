@* One schedule editor shared by the playlist auto-sync, the library
   locations and anywhere else something runs on a schedule. Six named
   options everywhere, the same wording the sync job wizard uses; the
   custom option is a plain five-field cron expression. Emits a
   ScanSchedule; nothing else computes when things run. *@
<div class="form-grid">
    <label>
        Schedule
        <select @bind="Kind">
            <option value="@ScheduleKind.Manual">Manual</option>
            <option value="@ScheduleKind.Hourly">Hourly</option>
            <option value="@ScheduleKind.Daily">Daily</option>
            <option value="@ScheduleKind.Weekly">Weekly</option>
            <option value="@ScheduleKind.Monthly">Monthly</option>
            <option value="@ScheduleKind.Cron">Cron</option>
        </select>
    </label>
    @if (Kind == ScheduleKind.Cron)
    {
        <label class="wide">
            Cron expression (minute hour day-of-month month day-of-week)
            <input @bind="CronText" placeholder="30 4 * * *" />
        </label>
        <div class="hint-box wide">
            Five-field cron with minute precision, for example
            <code>0 3 * * *</code> runs at 03:00 every night,
            <code>*/30 * * * *</code> every half hour. Invalid text keeps
            the last valid schedule until it parses again.
        </div>
    }
</div>

@code {
    private enum ScheduleKind { Manual, Hourly, Daily, Weekly, Monthly, Cron }

    private ScheduleKind _kind = ScheduleKind.Manual;
    private string _cronText = "0 4 * * *";

    /// <summary>Current editor state as a schedule.</summary>
    [Parameter] public ScanSchedule Value { get; set; }

    [Parameter] public EventCallback<ScanSchedule> ValueChanged { get; set; }

    private ScheduleKind Kind
    {
        get => _kind;
        set { _kind = value; _ = PushAsync(); }
    }

    private string CronText
    {
        get => _cronText;
        set { _cronText = value; _ = PushAsync(); }
    }

    protected override void OnParametersSet()
    {
        // Seed the editor from the incoming value: a named preset selects
        // itself, an interval row (older data) presents itself as the
        // equivalent custom expression, everything else is custom text.
        var v = Value;
        if (v.Mode == ScanScheduleMode.Manual)
        {
            _kind = ScheduleKind.Manual;
        }
        else if (v.NamedPreset is { } preset
                 && Enum.TryParse<ScheduleKind>(preset, out var named))
        {
            _kind = named;
        }
        else
        {
            _kind = ScheduleKind.Cron;
            _cronText = v.Mode == ScanScheduleMode.Interval
                ? $"*/{v.IntervalMinutes} * * * *"
                : v.Cron ?? _cronText;
        }
    }

    private async Task PushAsync()
    {
        var schedule = Build();
        if (schedule is { } valid)
        {
            Value = valid;
            await ValueChanged.InvokeAsync(valid);
        }
    }

    private ScanSchedule? Build() => _kind switch
    {
        ScheduleKind.Manual => ScanSchedule.Manual,
        ScheduleKind.Hourly => ScanSchedule.FromCron("0 * * * *"),
        ScheduleKind.Daily => ScanSchedule.FromCron("0 3 * * *"),
        ScheduleKind.Weekly => ScanSchedule.FromCron("0 3 * * 1"),
        ScheduleKind.Monthly => ScanSchedule.FromCron("0 3 1 * *"),
        ScheduleKind.Cron =>
            ScanSchedule.TryParse(_cronText, out var s) && s.Mode == ScanScheduleMode.Cron ? s : null,
        _ => null,
    };
}
