@* Inline SVG icon set, lucide-style geometry. Zero JS, themeable
   via currentColor, no emoji glyphs anywhere. *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="2" stroke-linecap="round"
     stroke-linejoin="round" class="icon @Class" aria-hidden="true">
    @((MarkupString)Body)
</svg>

