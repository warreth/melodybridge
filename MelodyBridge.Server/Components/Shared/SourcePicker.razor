@using MelodyBridge.Application.Services
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Services
@inject NavigationManager Navigation
@inject PluginAuthMonitor AuthMonitor
@inject IDownloaderRegistry Registry
@inject MelodyBridge.Server.Services.NotificationService Notifications
@inject IJSRuntime JS
@implements IDisposable

@if (Request is { } request)
{
    <div class="wizard-overlay" @onclick="CloseAsync">
        <div class="wizard-modal source-picker-modal" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div class="source-picker-title">
                    <span class="eyebrow">Choose source</span>
                    <h2>@(request.Title.Length > 0 ? request.Title : "Track")</h2>
                    <p class="source-original">
                        <span>@(string.IsNullOrWhiteSpace(request.Artist) ? "Unknown artist" : request.Artist)</span>
                        @if (request.DurationMs is > 0)
                        {
                            <span class="source-length">Original @TrackDisplay.Duration(request.DurationMs.Value)</span>
                        }
                    </p>
                    <p class="text-muted">
                        @(request.Intro ?? "Compare the length, then pick the right recording. " +
                            "Best guess first; the automatic match refused all of these.")
                    </p>
                    <p class="source-target">
                        <span class="eyebrow">Target quality</span>
                        @if (request.TargetQuality.HasConstraints)
                        {
                            <strong>@request.TargetQualityLabel</strong>
                            <span class="text-muted">
                                Results below it keep their source quality unless the
                                plugin can convert them to your target.
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">No filter: any source quality is accepted.</span>
                        }
                    </p>
                </div>
                <button class="icon-button" title="Close" @onclick="CloseAsync">
                    <Icon Name="x" Size="18" />
                </button>
            </div>
            <div class="wizard-body source-results">
                @if (sourceAuthIssues.Count > 0)
                {
                    <div class="source-auth-note" role="status">
                        <Icon Name="alert" Size="17" />
                        <div class="source-auth-copy">
                            <strong>Some plugins are not searched because their login needs attention</strong>
                            @foreach (var issue in sourceAuthIssues)
                            {
                                <div class="source-note-row">
                                    <span><b>@issue.PluginName</b> @issue.Message</span>
                                    <button class="btn-modern small ghost"
                                            @onclick="() => OpenPluginSettings(issue.PluginId)">
                                        Fix
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (sourcePluginNotes.Count > 0)
                {
                    <div class="source-auth-note warning" role="status">
                        <Icon Name="info" Size="17" />
                        <div class="source-auth-copy">
                            <strong>Not searched right now</strong>
                            @foreach (var note in sourcePluginNotes)
                            {
                                <div class="source-note-row">
                                    <span><b>@note.Name</b> @note.Reason</span>
                                    <button class="btn-modern small ghost source-why"
                                            title="Why is this missing? Open the plugin card"
                                            aria-label="Why is this missing? Open the plugin card"
                                            @onclick="() => OpenPluginSettings(note.PluginId)">
                                        Why?
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (downloadingCandidate)
                {
                    <div class="source-progress" aria-hidden="true"><span></span></div>
                }
                @if (!searchingSources && sourceCandidates.Count > 0)
                {
                    <div class="source-filters">
                        <label>
                            <span>Plugin</span>
                            <select @bind="sourceFilterPlugin" aria-label="Filter by plugin">
                                <option value="all">All plugins</option>
                                @foreach (var option in SourcePluginOptions)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Match</span>
                            <select @bind="sourceFilterConfidence" aria-label="Filter by match confidence">
                                <option value="all">All matches</option>
                                <option value="high">Likely</option>
                                <option value="low">Unsure</option>
                            </select>
                        </label>
                        <label class="source-filter-check">
                            <input type="checkbox" @bind="sourceFilterCanServeOnly" />
                            <span>Can serve target</span>
                        </label>
                        <span class="source-filter-count">
                            @VisibleSourceCandidates.Count of @sourceCandidates.Count
                        </span>
                    </div>
                }
                @if (searchingSources)
                {
                    <div class="source-searching">
                        <span class="spinner"></span>
                        <span>
                            Searching every enabled plugin…
                            @if (sourceCandidates.Count > 0)
                            {
                                <span>@sourceCandidates.Count result@(sourceCandidates.Count == 1 ? "" : "s") so far</span>
                            }
                        </span>
                    </div>
                }
                else if (sourceCandidates.Count == 0)
                {
                    <div class="hint-box">
                        @if (searchError is { Length: > 0 } error)
                        {
                            <span>The search stopped: @error</span>
                        }
                        else
                        {
                            <span>
                                No plugin returned a result. Check the plugin settings
                                (tokens, tools) or try again later.
                            </span>
                        }
                    </div>
                    @if (sourceAuthIssues.Count > 0 || sourcePluginNotes.Count > 0)
                    {
                        <div class="source-empty-actions">
                            @foreach (var issue in sourceAuthIssues.Take(3))
                            {
                                <button class="btn-modern small ghost"
                                        @onclick="() => OpenPluginSettings(issue.PluginId)">
                                    Fix @issue.PluginName
                                </button>
                            }
                            @foreach (var note in sourcePluginNotes.Take(3))
                            {
                                <button class="btn-modern small ghost"
                                        @onclick="() => OpenPluginSettings(note.PluginId)">
                                    Open @note.Name
                                </button>
                            }
                        </div>
                    }
                }
                @if (!searchingSources && sourceCandidates.Count > 0 && VisibleSourceCandidates.Count == 0)
                {
                    <div class="hint-box">
                        No candidate matches these filters.
                        <button class="btn-modern small ghost" @onclick="ClearSourceFilters">Clear filters</button>
                    </div>
                }
                @foreach (var candidate in VisibleSourceCandidates)
                {
                    var busy = inFlightPicks.Contains(candidate.SourceUrl);
                    <div class="source-candidate @(busy ? "busy" : null)">
                        <div class="source-candidate-main">
                            <strong title="@candidate.Title">@candidate.Title</strong>
                            <small>
                                @(candidate.Artist ?? "Unknown artist")
                                @if (candidate.Duration is { } length)
                                {
                                    <span> · <span class="source-length">@TrackDisplay.Duration((long)length.TotalMilliseconds)</span></span>
                                    var delta = LengthDelta(request.DurationMs, length);
                                    @if (delta.Length > 0)
                                    {
                                        <span class="source-delta" title="Compared to the original length">@delta</span>
                                    }
                                }
                                @if (candidate.BitrateKbps is { } kbps)
                                {
                                    <span> · @kbps kbps</span>
                                }
                            </small>
                            <div class="source-quality">
                                @if (!probedCandidateUrls.Contains(candidate.SourceUrl))
                                {
                                    <span class="source-quality-checking">
                                        <span class="spinner"></span> checking exact quality…
                                    </span>
                                }
                                else
                                {
                                    <span class="source-quality-facts">@CandidateQualityText(candidate)</span>
                                    @if (CandidateVerdict(candidate, request.TargetQuality) is { } verdict)
                                    {
                                        <StatusPill Variant="@verdict.Variant" Class="pill-tight"
                                                    Title="@verdict.Title">@verdict.Label</StatusPill>
                                    }
                                }
                            </div>
                            @if (sourceFailures.TryGetValue(candidate.SourceUrl, out var failure))
                            {
                                <small class="source-failure">This source failed: @failure</small>
                            }
                        </div>
                        <StatusPill Variant="@(candidate.Confidence == MatchConfidence.High ? "ok" : "warn")"
                                    Class="pill-tight"
                                    Title="@(candidate.Confidence == MatchConfidence.High
                                        ? "The plugin is confident this is the requested track"
                                        : "The plugin is not sure; listen before you keep it")">
                            @(candidate.Confidence == MatchConfidence.High ? "likely" : "unsure")
                        </StatusPill>
                        <StatusPill Variant="neutral">@candidate.PluginName</StatusPill>
                        <div class="source-candidate-tools">
                            <button class="icon-button" title="Copy source URL"
                                    aria-label="Copy source URL from @candidate.PluginName"
                                    @onclick="() => CopySourceUrlAsync(candidate)">
                                <Icon Name="copy" Size="14" />
                            </button>
                            <button class="icon-button" title="Open @candidate.PluginName settings"
                                    aria-label="Open @candidate.PluginName settings"
                                    @onclick="() => OpenPluginSettings(candidate.PluginId)">
                                <Icon Name="sliders" Size="14" />
                            </button>
                        </div>
                        @if (busy)
                        {
                            <span class="source-downloading"><span class="spinner"></span> Downloading… @downloadElapsedSeconds s</span>
                        }
                        else
                        {
                            <button class="btn-modern small primary"
                                    disabled="@downloadingCandidate"
                                    @onclick="() => PickAsync(candidate)">
                                <Icon Name="download" Size="14" /> Download
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="wizard-footer">
                <div class="flex-actions">
                    <button class="btn-modern ghost" @onclick="CloseAsync">Close</button>
                </div>
                <div class="wizard-actions">
                    <button class="btn-modern secondary" @onclick="() => SearchAgainAsync()"
                            disabled="@searchingSources">
                        <Icon Name="refresh" Size="14" /> Search again
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Null closes the dialog; a different Key starts a new search.</summary>
    [Parameter] public SourcePickerRequest? Request { get; set; }

    /// <summary>The caller clears its request here. Keep this handler quick:
    /// the dialog closes when it returns, before any page reload.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private IReadOnlyList<DownloadCandidate> sourceCandidates = Array.Empty<DownloadCandidate>();
    private IReadOnlyList<PluginAuthIssue> sourceAuthIssues = Array.Empty<PluginAuthIssue>();
    private IReadOnlyList<SourceSearchProblem> sourceSearchProblems = Array.Empty<SourceSearchProblem>();
    private IReadOnlyList<SourcePluginNote> sourcePluginNotes = Array.Empty<SourcePluginNote>();
    private string sourceFilterPlugin = "all";
    private string sourceFilterConfidence = "all";
    private bool sourceFilterCanServeOnly;
    private bool searchingSources;
    /// <summary>The source urls with a pick in flight. A set, not one
    /// field, so a pick that lands late can only clear its own row and
    /// the same source cannot be started twice.</summary>
    private readonly HashSet<string> inFlightPicks = new(StringComparer.Ordinal);
    private bool downloadingCandidate => inFlightPicks.Count > 0;
    /// <summary>Which dialog the user is looking at. A pick remembers the
    /// generation that started it, so only that dialog can be closed by
    /// it, even when the page hands over a new request instance for the
    /// same key.</summary>
    private int dialogGeneration;
    private int downloadElapsedSeconds;
    private CancellationTokenSource? downloadTicker;
    private string? searchError;
    private readonly Dictionary<string, string> sourceFailures = new(StringComparer.Ordinal);
    private readonly Dictionary<string, CandidateAudioQuality> candidateQualities = new(StringComparer.Ordinal);
    private readonly HashSet<string> probedCandidateUrls = new(StringComparer.Ordinal);
    private readonly HashSet<string> probingCandidateUrls = new(StringComparer.Ordinal);

    /// <summary>A plugin the picker did not search, with the reason it gave.</summary>
    private sealed record SourcePluginNote(string PluginId, string Name, string Reason);

    private string? activeKey;
    private int sourceSearchGeneration;
    private bool closing;
    /// <summary>Stops the searches and probes belonging to the open dialog.</summary>
    private CancellationTokenSource? dialogCts;

    /// <summary>Distinct plugins in the current result list, for the filter.</summary>
    private IReadOnlyList<(string Id, string Name)> SourcePluginOptions => sourceCandidates
        .Select(candidate => (candidate.PluginId, candidate.PluginName))
        .Distinct()
        .OrderBy(option => option.PluginName, StringComparer.OrdinalIgnoreCase)
        .ToList();

    /// <summary>The candidates left after the plugin, confidence and target filters.</summary>
    private IReadOnlyList<DownloadCandidate> VisibleSourceCandidates => sourceCandidates
        .Where(candidate => sourceFilterPlugin == "all"
            || string.Equals(candidate.PluginId, sourceFilterPlugin, StringComparison.OrdinalIgnoreCase))
        .Where(candidate => sourceFilterConfidence switch
        {
            "high" => candidate.Confidence == MatchConfidence.High,
            "low" => candidate.Confidence == MatchConfidence.Low,
            _ => true,
        })
        .Where(candidate => !sourceFilterCanServeOnly || candidate.CanServeRequested)
        .ToList();

    protected override Task OnParametersSetAsync()
    {
        if (Request is not { } request)
        {
            if (activeKey is not null) ResetState();
            return Task.CompletedTask;
        }

        if (request.Key == activeKey) return Task.CompletedTask;
        ResetState();
        activeKey = request.Key;
        dialogCts = new CancellationTokenSource();
        // Start the search without awaiting it: the dialog must paint its
        // spinner first, and a plugin can take a long time to answer.
        _ = BeginSearchAsync(request, dialogCts.Token);
        return Task.CompletedTask;
    }

    private async Task BeginSearchAsync(SourcePickerRequest request, CancellationToken ct)
    {
        try
        {
            await SearchAsync(request, ct);
        }
        catch (OperationCanceledException)
        {
            // Closing the dialog or starting another search cancelled it.
        }
        catch (Exception ex)
        {
            if (activeKey != request.Key) return;
            searchingSources = false;
            searchError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SearchAgainAsync()
        => Request is { } request && dialogCts is { } cts
            ? SearchAsync(request, cts.Token)
            : Task.CompletedTask;

    private async Task SearchAsync(SourcePickerRequest? request, CancellationToken ct)
    {
        if (request is null || activeKey != request.Key || ct.IsCancellationRequested) return;
        var generation = ++sourceSearchGeneration;
        var key = request.Key;
        searchingSources = true;
        searchError = null;
        sourceCandidates = Array.Empty<DownloadCandidate>();
        sourceSearchProblems = Array.Empty<SourceSearchProblem>();
        sourcePluginNotes = Array.Empty<SourcePluginNote>();
        sourceFailures.Clear();
        candidateQualities.Clear();
        probedCandidateUrls.Clear();
        probingCandidateUrls.Clear();
        StateHasChanged();
        SourceSearchOutcome? outcome = null;
        try
        {
            // Providers run at the same time and each hit lands here the
            // moment its provider answers, so the list fills in instead of
            // staring at a spinner until the slowest plugin is done.
            outcome = await request.SearchAsync(candidate =>
            {
                if (generation != sourceSearchGeneration || activeKey != key) return;
                _ = InvokeAsync(() =>
                {
                    if (generation != sourceSearchGeneration || activeKey != key) return;
                    if (sourceCandidates.Any(c => c.SourceUrl == candidate.SourceUrl)) return;
                    sourceCandidates = sourceCandidates.Append(candidate).ToList();
                    StartCandidateProbe(candidate, request, generation, ct);
                    StateHasChanged();
                });
            }, ct);
        }
        finally
        {
            // A stale search (dialog closed, another request opened, Search
            // again pressed) changes nothing: not the list, not the flag.
            if (generation == sourceSearchGeneration && activeKey == key)
            {
                if (outcome is not null)
                {
                    sourceCandidates = outcome.Candidates;
                    sourceSearchProblems = outcome.Problems;
                    RefreshSourceAuthIssues();
                    sourcePluginNotes = UnavailableSourceNotes();
                    if (sourceFilterPlugin != "all"
                        && outcome.Candidates.All(candidate => !string.Equals(
                            candidate.PluginId, sourceFilterPlugin, StringComparison.OrdinalIgnoreCase)))
                        sourceFilterPlugin = "all";
                    foreach (var candidate in outcome.Candidates)
                        StartCandidateProbe(candidate, request, generation, ct);
                }
                searchingSources = false;
                StateHasChanged();
                _ = RestoreSourceScrollAsync(key);
            }
        }
    }

    /// <summary>
    /// Reads every enabled plugin's current login verdict after a search:
    /// a plugin can discover an expired token while its search runs, and
    /// the snapshot taken when the dialog opened would miss it.
    /// </summary>
    private void RefreshSourceAuthIssues()
    {
        foreach (var plugin in Registry.GetEnabled())
            AuthMonitor.Observe(plugin);
        sourceAuthIssues = AuthMonitor.Snapshot();
    }

    /// <summary>
    /// Why an enabled plugin is missing from the result list. A login
    /// problem already has its own red note; this covers a timeout, a
    /// thrown search and the tool or service being down, so a short list
    /// never looks like a silent bug.
    /// </summary>
    private IReadOnlyList<SourcePluginNote> UnavailableSourceNotes()
    {
        var authIds = sourceAuthIssues
            .Select(issue => issue.PluginId)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var candidateIds = sourceCandidates
            .Select(candidate => candidate.PluginId)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var notes = new Dictionary<string, SourcePluginNote>(StringComparer.OrdinalIgnoreCase);

        foreach (var problem in sourceSearchProblems)
            if (!authIds.Contains(problem.PluginId))
                notes[problem.PluginId] = new SourcePluginNote(
                    problem.PluginId, problem.PluginName, problem.Reason);

        foreach (var plugin in Registry.GetEnabled())
        {
            if (authIds.Contains(plugin.Id)
                || candidateIds.Contains(plugin.Id)
                || notes.ContainsKey(plugin.Id)
                || string.IsNullOrWhiteSpace(plugin.LastUnavailableReason))
                continue;
            notes[plugin.Id] = new SourcePluginNote(
                plugin.Id, plugin.Name, plugin.LastUnavailableReason);
        }

        return notes.Values
            .OrderBy(note => note.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>
    /// Asks the candidate's plugin for the exact source facts and fills the
    /// row in when the answer lands. The probe starts on the caller's
    /// context and yields at its first await, so a fast plugin updates the
    /// row without a thread hop and a slow one never blocks the dialog.
    /// The Download button is usable the whole time.
    /// </summary>
    private void StartCandidateProbe(
        DownloadCandidate candidate, SourcePickerRequest request, int generation,
        CancellationToken ct)
    {
        var url = candidate.SourceUrl;
        if (probingCandidateUrls.Contains(url) || probedCandidateUrls.Contains(url)) return;
        probingCandidateUrls.Add(url);
        _ = ProbeCandidateAsync(candidate, url, request, generation, ct);
    }

    private async Task ProbeCandidateAsync(
        DownloadCandidate candidate, string url, SourcePickerRequest request, int generation,
        CancellationToken ct)
    {
        CandidateAudioQuality? quality = null;
        try
        {
            quality = await request.ProbeAsync(candidate, ct);
        }
        catch
        {
            // A probe is best effort; the row falls back to the manifest.
        }
        await InvokeAsync(() =>
        {
            probingCandidateUrls.Remove(url);
            if (generation != sourceSearchGeneration || activeKey != request.Key) return;
            probedCandidateUrls.Add(url);
            if (quality is not null) candidateQualities[url] = quality;
            StateHasChanged();
        });
    }

    /// <summary>
    /// What one candidate really is: the exact probe facts when they
    /// arrived, otherwise what the plugin declares it can deliver.
    /// </summary>
    private string CandidateQualityText(DownloadCandidate candidate)
    {
        if (candidateQualities.TryGetValue(candidate.SourceUrl, out var quality))
        {
            // The delivered file is the lower of the track's own ceiling
            // (a catalog fact, Qobuz) and the configured tier (the probe).
            // Showing the track maximum alone overstated the pick when the
            // tier is lower.
            var depth = Lower(candidate.BitDepth, quality.BitDepth);
            var rate = Lower(candidate.SampleRateHz, quality.SampleRateHz);
            var parts = new List<string>();
            var codec = CodecLabel(quality.Codec);
            if (codec.Length > 0) parts.Add(codec);
            if (depth is { } bitDepth) parts.Add($"{bitDepth}-bit");
            if (rate is { } sampleRate) parts.Add($"{sampleRate / 1000.0:0.#} kHz");
            if (quality.BitrateKbps is { } kbps && !quality.Lossless) parts.Add($"{kbps} kbps");
            if (parts.Count == 0) parts.Add(quality.Lossless ? "lossless" : "unknown");
            var text = string.Join(" · ", parts);
            // The tier note only adds information when the track's own
            // rate is not known.
            var exactPerTrack = candidate.BitDepth is not null && candidate.SampleRateHz is not null;
            var note = exactPerTrack ? null : quality.Note;
            return note is { Length: > 0 } ? $"{text} ({note})" : text;
        }

        var declared = candidate.DeclaredQuality;
        return declared is { Length: > 0 }
            ? $"{candidate.PluginName} delivers {declared}"
            : $"{candidate.PluginName} did not report its quality";
    }

    /// <summary>The lower of two optional facts; null means unknown.</summary>
    private static int? Lower(int? first, int? second)
        => first is null ? second : second is null ? first : Math.Min(first.Value, second.Value);

    /// <summary>
    /// The target match pill for one candidate, or null while its probe
    /// still runs. With exact facts the verdict is a comparison; without
    /// them it reads the plugin's own declaration, never a guess.
    /// </summary>
    private (string Variant, string Label, string Title)? CandidateVerdict(
        DownloadCandidate candidate, DownloadQuality target)
    {
        if (!target.HasConstraints) return null;

        if (candidateQualities.TryGetValue(candidate.SourceUrl, out var quality))
        {
            if (QualityMatchesTarget(quality, target))
            {
                return ("ok", "matches target",
                    $"This source delivers the requested quality.");
            }
            if (!candidate.CanServeRequested)
            {
                return ("warn", "saved as-is",
                    $"{candidate.PluginName} cannot deliver the target; the pick keeps its source quality instead of being re-encoded.");
            }
            return target.Format == AudioFormat.Auto
                ? ("warn", "outside target",
                    $"This source sits outside the target; the pick keeps its source quality.")
                : ("warn", "off target",
                    $"This source does not deliver the target; the pick will be converted to it.");
        }

        if (!probedCandidateUrls.Contains(candidate.SourceUrl)) return null;
        return candidate.CanServeRequested
            ? ("ok", "target OK", $"{candidate.PluginName} declares it can deliver the target.")
            : ("warn", "saved as-is",
                $"{candidate.PluginName} cannot deliver the target; the pick keeps its source quality instead of being re-encoded.");
    }

    /// <summary>True when the probed facts satisfy the requested quality.</summary>
    private static bool QualityMatchesTarget(CandidateAudioQuality quality, DownloadQuality target)
    {
        if (target.Format == AudioFormat.Flac) return quality.Lossless;
        if (target.Format != AudioFormat.Auto && AudioFormatOf(quality.Codec) != target.Format)
            return false;
        // A band can only be called a match when the probe measured it: the
        // pick path does not re-check the band after download, so an
        // unknown bitrate must not be presented as matching the target.
        if (target.MinKbps is null && target.MaxKbps is null) return true;
        return quality.BitrateKbps is > 0 && target.IsWithinBand(quality.BitrateKbps);
    }

    /// <summary>The container a raw codec name stands for.</summary>
    private static AudioFormat AudioFormatOf(string? codec) => codec?.ToLowerInvariant() switch
    {
        "flac" => AudioFormat.Flac,
        "mp3" => AudioFormat.Mp3,
        "opus" => AudioFormat.Opus,
        var c when c is not null && (c.StartsWith("mp4a", StringComparison.Ordinal)
            || c.StartsWith("aac", StringComparison.Ordinal)) => AudioFormat.Aac,
        _ => AudioFormat.Auto,
    };

    /// <summary>Readable codec names; ffprobe/yt-dlp names are not.</summary>
    private static string CodecLabel(string? codec) => codec?.ToLowerInvariant() switch
    {
        null or "" or "none" => "",
        "flac" => "FLAC",
        "alac" => "ALAC",
        "mp3" => "MP3",
        "opus" => "Opus",
        "vorbis" => "Vorbis",
        var c when c.StartsWith("mp4a", StringComparison.Ordinal)
            || c.StartsWith("aac", StringComparison.Ordinal) => "AAC",
        var c when c.StartsWith("pcm", StringComparison.Ordinal) => "PCM",
        _ => codec?.ToUpperInvariant() ?? "",
    };

    /// <summary>
    /// Downloads the candidate the user picked. The caller's download
    /// callback does the work and decides what the outcome means; the
    /// dialog closes as soon as a pick lands, before any page reload.
    /// </summary>
    private async Task PickAsync(DownloadCandidate candidate)
    {
        // One pick at a time: two rows clicked before the busy render
        // lands must not start two downloads that then share the ticker
        // and the close path.
        if (Request is not { } request || downloadingCandidate) return;
        // The set still does its job for a pick from a previous dialog:
        // it refuses the same url and can only clear its own row.
        if (!inFlightPicks.Add(candidate.SourceUrl)) return;
        // The dialog that owns this pick. A pick can outlive it, and a page
        // can hand over a new request instance for the same key, so the
        // instance is not the identity: the generation is.
        var generation = dialogGeneration;
        downloadElapsedSeconds = 0;
        var ticker = new CancellationTokenSource();
        downloadTicker = ticker;
        _ = TickDownloadProgressAsync(ticker.Token);
        try
        {
            SourcePickResult result;
            try
            {
                result = await request.DownloadAsync(candidate);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                result = SourcePickResult.Failed(ex.Message);
            }

            switch (result.Status)
            {
                case SourcePickStatus.Downloaded:
                    Notifications.Success(result.Message
                        ?? $"Downloaded '{request.Title}' from {candidate.PluginName}.");
                    // A pick can outlive the dialog that started it: only
                    // the dialog it belongs to may be closed by it.
                    if (generation == dialogGeneration) await CloseAsync();
                    break;
                case SourcePickStatus.AlreadyRunning:
                    Notifications.Info("This is already being downloaded by a running batch.");
                    if (generation == dialogGeneration) await CloseAsync();
                    break;
                default:
                    // Keep the dialog open with the real reason on that row:
                    // the next pick must be an informed one.
                    sourceFailures[candidate.SourceUrl] = result.Failure is { Length: > 0 } failure
                        ? failure
                        : $"{candidate.PluginName} did not deliver this pick";
                    Notifications.Warn($"'{candidate.PluginName}' could not deliver '{request.Title}'. Try another result.");
                    break;
            }
        }
        finally
        {
            // Only this pick's ticker and row: a later pick must keep
            // running when an earlier one lands late. The dialog may
            // already be gone, and Cancel after Dispose throws.
            try { ticker.Cancel(); }
            catch (ObjectDisposedException) { /* the component disposed it first */ }
            ticker.Dispose();
            if (ReferenceEquals(downloadTicker, ticker)) downloadTicker = null;
            inFlightPicks.Remove(candidate.SourceUrl);
        }
    }

    private async Task TickDownloadProgressAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(1000, ct);
                downloadElapsedSeconds++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // The pick landed or the dialog went away: nothing left to tick.
        }
    }

    private void OpenPluginSettings(string pluginId)
        => Navigation.NavigateTo($"plugins#plugin-{pluginId}");

    private async Task CopySourceUrlAsync(DownloadCandidate candidate)
    {
        bool copied;
        try
        {
            copied = await JS.InvokeAsync<bool>("melody.copyText", candidate.SourceUrl);
        }
        catch
        {
            copied = false;
        }

        if (copied) Notifications.Success($"Source URL from {candidate.PluginName} copied.");
        else Notifications.Warn("The browser would not let the page copy the source URL.");
    }

    private void ClearSourceFilters()
    {
        sourceFilterPlugin = "all";
        sourceFilterConfidence = "all";
        sourceFilterCanServeOnly = false;
    }

    /// <summary>
    /// Close from the UI, from Escape-like paths or after a successful
    /// pick: tell the caller first so the dialog leaves the tree, then
    /// clean up the asynchronous work behind it.
    /// </summary>
    private async Task CloseAsync()
    {
        if (closing) return;
        closing = true;
        var key = Request?.Key;
        try
        {
            await OnClose.InvokeAsync();
            if (key is not null) _ = SaveSourceScrollAsync(key);
        }
        finally
        {
            ResetState();
            closing = false;
        }
    }

    private void ResetState()
    {
        activeKey = null;
        sourceSearchGeneration++;
        dialogGeneration++;
        dialogCts?.Cancel();
        dialogCts?.Dispose();
        dialogCts = null;
        downloadTicker?.Cancel();
        downloadTicker?.Dispose();
        downloadTicker = null;
        searchingSources = false;
        searchError = null;
        sourceCandidates = Array.Empty<DownloadCandidate>();
        sourceAuthIssues = Array.Empty<PluginAuthIssue>();
        sourceSearchProblems = Array.Empty<SourceSearchProblem>();
        sourcePluginNotes = Array.Empty<SourcePluginNote>();
        sourceFailures.Clear();
        candidateQualities.Clear();
        probedCandidateUrls.Clear();
        probingCandidateUrls.Clear();
        // Filters are a reader preference: the next dialog keeps the
        // confidence choice, and a plugin filter that no longer exists is
        // dropped after the next search.
    }

    private async Task SaveSourceScrollAsync(string key)
    {
        try
        {
            await JS.InvokeVoidAsync("melody.saveScroll", $"source-{key}", ".source-results");
        }
        catch
        {
            // Scroll memory is a convenience.
        }
    }

    private async Task RestoreSourceScrollAsync(string key)
    {
        try
        {
            await JS.InvokeVoidAsync("melody.restoreScroll", $"source-{key}", ".source-results");
        }
        catch
        {
            // Scroll memory is a convenience.
        }
    }

    /// <summary>
    /// The candidate length next to the original's: "same length" or the
    /// signed difference, so a preview or a longer edit stands out before
    /// the click. Empty when either side has no length.
    /// </summary>
    private static string LengthDelta(long? originalMs, TimeSpan candidate)
    {
        if (originalMs is not > 0) return "";
        var delta = (int)Math.Round(
            (candidate - TimeSpan.FromMilliseconds(originalMs.Value)).TotalSeconds);
        if (Math.Abs(delta) < 5) return "same length";
        var abs = Math.Abs(delta);
        return $"{(delta > 0 ? "+" : "-")}{abs / 60}:{abs % 60:00}";
    }

    public void Dispose()
    {
        sourceSearchGeneration++;
        try { dialogCts?.Cancel(); }
        catch (ObjectDisposedException) { /* already gone */ }
        dialogCts?.Dispose();
        dialogCts = null;
        try { downloadTicker?.Cancel(); }
        catch (ObjectDisposedException) { /* already gone */ }
        downloadTicker?.Dispose();
        downloadTicker = null;
    }
}
