@* Brand logos: real paths for Spotify and YouTube, monogram tiles for
   self-hosted servers. Sourced brand marks stay inline so no network
   fetch is needed on the dashboard. *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" class="brand-icon @Class"
     style="@BrandStyle" aria-hidden="true">
    @((MarkupString)Body)
</svg>

@code {
    /// <summary>Brand key: spotify, youtube, applemusic, jellyfin, plex, navidrome, flaresolverr.</summary>
    [Parameter] public string Name { get; set; } = "server";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }

    private string BrandStyle => Name.ToLowerInvariant() switch
    {
        "spotify" => "color:#1DB954",
        "youtube" => "color:#FF0000",
        "applemusic" => "color:#FA243C",
        "tidal" => "color:#0EA5E9",
        "qobuz" => "color:#0070F3",
        "deezer" => "color:#A238FF",
        "soundcloud" => "color:#FF5500",
        "listenbrainz" => "color:#EB743B",
        "jellyfin" => "color:#00A4DC",
        "plex" => "color:#E5A00D",
        "navidrome" => "color:#248FB9",
        "flaresolverr" => "color:#F85D2A",
        _ => "",
    };

    private string Body => Name.ToLowerInvariant() switch
    {
        "spotify" => """<path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.52-.699 16.301 1.92.541.3.721 1.021.42 1.561-.299.421-1.02.599-1.559.3z"/>""",
        "youtube" => """<path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-10.377.505A3.017 3.017 0 0 0 .498 6.186C0 8.07 0 12 0 12s0 3.93.498 5.819a3.017 3.017 0 0 0 2.125 2.135c2.872.505 10.377.505 10.377.505s7.505 0 10.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>""",
        "applemusic" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><path fill="#09090b" d="M15.5 5.5v8.2a3 3 0 1 1-1.4-2.5V8.1l-5 1.2v6.4a3 3 0 1 1-1.4-2.5V7.6l7.8-1.9z"/>""",
        "tidal" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="700" fill="#09090b" font-family="Inter, system-ui, sans-serif">T</text>""",
        "qobuz" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="700" fill="#09090b" font-family="Inter, system-ui, sans-serif">Q</text>""",
        "deezer" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="700" fill="#09090b" font-family="Inter, system-ui, sans-serif">D</text>""",
        "soundcloud" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="700" fill="#09090b" font-family="Inter, system-ui, sans-serif">S</text>""",
        "listenbrainz" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="700" fill="#09090b" font-family="Inter, system-ui, sans-serif">L</text>""",
        "jellyfin" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="700" fill="#09090b" font-family="Inter, system-ui, sans-serif">J</text>""",
        "plex" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="700" fill="#09090b" font-family="Inter, system-ui, sans-serif">P</text>""",
        "navidrome" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="700" fill="#09090b" font-family="Inter, system-ui, sans-serif">N</text>""",
        "flaresolverr" => """<rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="700" fill="#09090b" font-family="Inter, system-ui, sans-serif">F</text>""",
        _ => """<rect x="2" y="3" width="20" height="7" rx="2" fill="currentColor" opacity=".85"/><rect x="2" y="14" width="20" height="7" rx="2" fill="currentColor" opacity=".55"/>""",
    };
}