@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject IDownloaderRegistry Registry

@{
    var searchProviders = Services.GetService<ISearchProviderRegistry>();
    var providers = searchProviders?.GetAll() ?? Array.Empty<ISearchProvider>();
    var plugins = Registry.GetAll();
    var selfSearching = plugins
        .Where(p => p.SearchInfo.Mode == DownloaderSearchMode.Self)
        .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var urlOnly = plugins
        .Where(p => p.SearchInfo.Mode == DownloaderSearchMode.None)
        .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var orphaned = searchProviders is null
        ? new List<IDownloader>()
        : plugins
            .Where(p => p.SearchInfo.Mode == DownloaderSearchMode.Provider
                        && searchProviders.ForDownloader(p.Id) is null)
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    // A target with more than one provider is the only place a "primary"
    // badge means something; with one provider it would be noise on every
    // row.
    var contested = providers
        .SelectMany(p => p.Targets)
        .GroupBy(t => t.DownloaderId, StringComparer.OrdinalIgnoreCase)
        .Where(g => g.Count() > 1)
        .Select(g => g.Key)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
}

@if (searchProviders is not null)
{
    <details class="panel-card search-provider-map" aria-labelledby="search-provider-title">
        <summary class="search-provider-head">
            <div>
                <span class="eyebrow">Search routing</span>
                <h2 id="search-provider-title">How each source finds the track</h2>
                <p class="panel-description">
                    A search provider turns a track query into a download URL. Every
                    built-in source is provider-backed: the provider searches, the
                    source only downloads the URL. Third-party sources without a
                    provider can still search their own catalogue.
                </p>
            </div>
            <span class="search-provider-count">
                @providers.Count provider@(providers.Count == 1 ? "" : "s")
            </span>
            <Icon Name="chevron-down" Size="16" Class="search-provider-chevron" />
        </summary>

        <div class="search-provider-body">
        @if (providers.Count == 0)
        {
            <div class="hint-box">
                No search provider is registered. Only sources that declare their own
                search can find a track; URL-only sources need a link by hand.
            </div>
        }
        else
        {
            <div class="search-provider-list">
                @foreach (var provider in providers)
                {
                    <article class="search-provider" data-provider="@provider.Id">
                        <div class="search-provider-title">
                            <span class="search-provider-icon">
                                <Icon Name="search" Size="17" />
                            </span>
                            <div>
                                <strong>
                                    @provider.Name
                                    @if (provider.IsLegacy)
                                    {
                                        <span class="search-legacy-badge" title="The catalogue search still lives in the source plugin">legacy</span>
                                    }
                                    <span class="search-tier-badge @TierLabel(provider.Tier)"
                                          title="Where this provider sits in the official-first order">@TierLabel(provider.Tier)</span>
                                </strong>
                                <span>@provider.Description</span>
                            </div>
                        </div>
                        <div class="search-provider-reads">
                            <span class="search-data-label">Reads</span>
                            @foreach (var badge in DataBadges(provider.Data))
                            {
                                <span class="search-data-badge">@badge</span>
                            }
                        </div>
                        <div class="search-provider-targets">
                            <span class="search-data-label">Finds URLs for</span>
                            @if (provider.Targets.Count == 0)
                            {
                                <span class="text-muted small">No target source yet</span>
                            }
                            <div class="search-target-list">
                                @foreach (var target in provider.Targets)
                                {
                                    var downloader = Registry.Get(target.DownloaderId);
                                    var enabled = Registry.IsEnabled(target.DownloaderId);
                                    <a href="#plugin-@target.DownloaderId"
                                       class="search-target @(enabled ? "" : "is-disabled")"
                                       title="@(target.Note ?? $"Search {downloader?.Name ?? target.DownloaderId}")">
                                        <Icon Name="@(downloader?.IconName ?? "music")" Size="14" />
                                        <span class="search-target-name">@(downloader?.Name ?? target.DownloaderId)</span>
                                        <span class="search-target-data">@DataLabel(target.Data)</span>
                                        @if (downloader?.FallbackOnly == true)
                                        {
                                            <span class="search-fallback-badge"
                                                  title="Only runs after every other source">fallback</span>
                                        }
                                        @if (contested.Contains(target.DownloaderId)
                                             && ReferenceEquals(searchProviders.ForDownloader(target.DownloaderId), provider))
                                        {
                                            <span class="search-target-primary"
                                                  title="The router tries this provider first for this source">primary</span>
                                        }
                                        @if (!enabled)
                                        {
                                            <span class="search-target-off">off</span>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }

        @if (searchProviders.ValidationIssues.Count > 0)
        {
            <div class="hint-box danger search-provider-warning">
                <Icon Name="alert" Size="15" />
                <ul class="search-provider-issues">
                    @foreach (var issue in searchProviders.ValidationIssues)
                    {
                        <li>@issue</li>
                    }
                </ul>
            </div>
        }

        @if (selfSearching.Count > 0)
        {
            <div class="search-self-block">
                <div class="search-self-head">
                    <h3>Third-party sources that search themselves</h3>
                    <p>These have no external provider; their own catalogue search runs as part of the waterfall.</p>
                </div>
                <div class="search-self-list">
                    @foreach (var plugin in selfSearching)
                    {
                        <a href="#plugin-@plugin.Id" class="search-self-row">
                            <span class="search-self-name">
                                @plugin.Name
                                @if (plugin.FallbackOnly)
                                {
                                    <span class="search-fallback-badge" title="Only runs after every other source">fallback</span>
                                }
                            </span>
                            <span class="search-data-badge">@DataLabel(plugin.SearchInfo.Data)</span>
                            @if (!string.IsNullOrWhiteSpace(plugin.SearchInfo.Note))
                            {
                                <span class="search-self-note">@plugin.SearchInfo.Note</span>
                            }
                        </a>
                    }
                </div>
            </div>
        }

        @if (urlOnly.Count > 0)
        {
            <div class="search-self-block">
                <div class="search-self-head">
                    <h3>Direct URL only</h3>
                    <p>No search at all: these sources wait for a link from somewhere else.</p>
                </div>
                <div class="search-self-list">
                    @foreach (var plugin in urlOnly)
                    {
                        <a href="#plugin-@plugin.Id" class="search-self-row">
                            <span class="search-self-name">@plugin.Name</span>
                            <span class="search-data-badge">@DataLabel(plugin.SearchInfo.Data)</span>
                            @if (!string.IsNullOrWhiteSpace(plugin.SearchInfo.Note))
                            {
                                <span class="search-self-note">@plugin.SearchInfo.Note</span>
                            }
                        </a>
                    }
                </div>
            </div>
        }

        @if (orphaned.Count > 0)
        {
            <div class="hint-box danger search-provider-warning">
                <Icon Name="alert" Size="15" />
                <span>
                    @string.Join(", ", orphaned.Select(p => p.Name))
                    declare@(orphaned.Count == 1 ? "s" : "") a provider search, but no
                    registered provider targets @(orphaned.Count == 1 ? "it" : "them").
                </span>
            </div>
        }
        </div>
    </details>
}

@code {
    private static string TierLabel(SearchTier tier) => tier switch
    {
        SearchTier.Official => "official",
        SearchTier.Ripper => "ripper",
        SearchTier.UnofficialCatalog => "unofficial",
        SearchTier.SelfSearch => "self",
        _ => "search",
    };

    private static IReadOnlyList<string> DataBadges(SearchData data)
    {
        var badges = new List<string>();
        if (data.HasFlag(SearchData.Isrc)) badges.Add("ISRC");
        if (data.HasFlag(SearchData.Title) || data.HasFlag(SearchData.Artist))
            badges.Add("title + artist");
        if (data.HasFlag(SearchData.Url)) badges.Add("URL");
        if (data.HasFlag(SearchData.Duration)) badges.Add("length");
        if (badges.Count == 0) badges.Add("nothing");
        return badges;
    }

    private static string DataLabel(SearchData data)
    {
        var badges = DataBadges(data);
        return string.Join(" + ", badges);
    }
}
