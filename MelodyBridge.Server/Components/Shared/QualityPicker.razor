@* One quality picker everywhere: a Target Quality dropdown with the
   shared presets, and an Advanced section (collapsed by default) that
   keeps the three container/floor/ceiling selectors for power users.
   Both views write the single PreferredFormat string the store
   validates and persists ("preset:saver", "auto", "mp3:192-320", ...). *@
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Services

<div class="quality-picker">
    <label class="wide">
        Target quality
        <select value="@PresetChoice" @onchange="OnPresetChanged">
            @foreach (var preset in PresetOptions)
            {
                <option value="@preset.Value">@preset.Label — @preset.Blurb</option>
            }
            <option value="@AdvancedValue">Advanced filters…</option>
        </select>
    </label>

    @if (PresetChoice == AdvancedValue)
    {
        <details class="advanced-quality" open>
            <summary>Advanced quality filters</summary>
            <div class="hint-box">
                Note: MelodyBridge does not transcode. Strict filters may
                cause downloads to fail if the source plugins cannot provide
                the exact format.
            </div>
            <div class="form-grid">
                <label>
                    Container
                    <select value="@Container" @onchange="OnContainerChanged">
                        @foreach (var f in Containers)
                        {
                            <option value="@f.Value">@f.Label</option>
                        }
                    </select>
                </label>
                <label>
                    Bitrate floor
                    <select value="@MinBitrate" @onchange="OnMinChanged" disabled="@BandsLocked">
                        @foreach (var b in FloorOptions)
                        {
                            <option value="@b.Value">@b.Label</option>
                        }
                    </select>
                </label>
                <label>
                    Bitrate ceiling
                    <select value="@MaxBitrate" @onchange="OnMaxChanged" disabled="@BandsLocked">
                        @foreach (var b in CeilingOptions)
                        {
                            <option value="@b.Value">@b.Label</option>
                        }
                    </select>
                </label>
            </div>
            <p class="panel-description">@Guidance</p>
        </details>
    }
    else
    {
        <p class="panel-description">@PresetBlurb</p>
    }
</div>

@code {
    private const string AdvancedValue = "__advanced__";

    /// <summary>Combined quality value: "preset:saver", "auto", "mp3:320", "mp3:192-"...</summary>
    [Parameter] public string Value { get; set; } = "auto";
    /// <summary>Raised with the new combined value after any select changes.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private static readonly (string Value, string Label, string Blurb)[] PresetOptions =
        QualityPresets.All.Select(p => (p.Stored, p.Label, p.Blurb)).ToArray();

    private static readonly (string Value, string Label)[] Containers =
    {
        ("auto", "Auto (best available)"),
        ("mp3", "MP3"),
        ("flac", "FLAC (lossless)"),
        ("opus", "Opus"),
        ("aac", "AAC (m4a)"),
    };

    /// <summary>Bitrate values offered per container. FLAC is lossless and
    /// Auto has no knob, so both lock with a single "not applicable" option.</summary>
    private static readonly Dictionary<string, string[]> BandTable = new()
    {
        ["auto"] = [],
        ["flac"] = [],
        ["mp3"] = ["96", "128", "160", "192", "256", "320"],
        ["opus"] = ["96", "128", "160", "192", "256"],
        ["aac"] = ["96", "128", "160", "192", "256", "320"],
    };

    private string PresetChoice { get; set; } = "auto";
    private string Container { get; set; } = "auto";
    private string MinBitrate { get; set; } = "";
    private string MaxBitrate { get; set; } = "";

    /// <summary>True when the container has no meaningful bitrate choice.</summary>
    private bool BandsLocked => BandValues.Length == 0;

    private string[] BandValues =>
        BandTable.TryGetValue(Container, out var list) ? list : [];

    private string PresetBlurb =>
        Value == "preset:saver" ? "Any format up to 160 kbps. Small files that sound fine; made for massive playlists."
        : Value == "preset:high" ? "Any lossy format up to 320 kbps. Full quality without lossless file sizes."
        : Value == "preset:lossless" ? "FLAC or WAV when a source has it; otherwise the best lossy file up to 320 kbps."
        : "Takes whatever the sources give, no filter at all.";

    private IEnumerable<(string Value, string Label)> FloorOptions
    {
        get
        {
            if (BandsLocked) { yield return ("", "Lossless/Not applicable"); yield break; }
            yield return ("", "No minimum");
            foreach (var b in BandValues)
                yield return (b, $"{b} kbps");
        }
    }

    private IEnumerable<(string Value, string Label)> CeilingOptions
    {
        get
        {
            if (BandsLocked) { yield return ("", "Lossless/Not applicable"); yield break; }
            yield return ("", "No maximum");
            foreach (var b in BandValues)
                yield return (b, $"{b} kbps");
        }
    }

    protected override void OnParametersSet()
    {
        // A preset (or plain auto) selects itself; anything else is the
        // advanced path and opens the accordion seeded from the value.
        if (QualityPresets.IsPreset(Value))
        {
            PresetChoice = Value;
            return;
        }
        PresetChoice = AdvancedValue;
        ParseAdvanced(Value);
    }

    private void ParseAdvanced(string value)
    {
        var parts = (value ?? "auto").Split(':', 2);
        Container = parts[0].ToLowerInvariant();
        if (!BandTable.ContainsKey(Container)) Container = "auto";
        MinBitrate = "";
        MaxBitrate = "";
        if (parts.Length < 2) return;

        // "192" is a cap; "min-max", "-max" and "min-" are bands.
        var range = parts[1].Split('-', 2);
        if (range.Length == 2 && int.TryParse(range[0], out var lo) && lo > 0)
            MinBitrate = range[0];
        var rawMax = range.Length == 2 ? range[1] : range[0];
        if (int.TryParse(rawMax, out var hi) && hi > 0)
            MaxBitrate = rawMax;
        if (Container is "auto" or "flac")
        {
            MinBitrate = "";
            MaxBitrate = "";
        }
    }

    private Task OnPresetChanged(ChangeEventArgs e)
    {
        PresetChoice = e.Value?.ToString() ?? "auto";
        return PresetChoice == AdvancedValue
            ? EmitAdvanced()
            : ValueChanged.InvokeAsync(PresetChoice);
    }

    private Task OnContainerChanged(ChangeEventArgs e)
    {
        Container = e.Value?.ToString() ?? "auto";
        MinBitrate = ""; // each container has its own sensible band
        MaxBitrate = "";
        return EmitAdvanced();
    }

    private Task OnMinChanged(ChangeEventArgs e)
    {
        MinBitrate = e.Value?.ToString() ?? "";
        // Raising the floor above the ceiling raises the ceiling too.
        if (int.TryParse(MinBitrate, out var min) && int.TryParse(MaxBitrate, out var max) && min > max)
            MaxBitrate = MinBitrate;
        return EmitAdvanced();
    }

    private Task OnMaxChanged(ChangeEventArgs e)
    {
        MaxBitrate = e.Value?.ToString() ?? "";
        // Lowering the ceiling below the floor lowers the floor too.
        if (int.TryParse(MinBitrate, out var min) && int.TryParse(MaxBitrate, out var max) && max < min)
            MinBitrate = MaxBitrate;
        return EmitAdvanced();
    }

    private Task EmitAdvanced()
    {
        var hasMin = !string.IsNullOrEmpty(MinBitrate);
        var hasMax = !string.IsNullOrEmpty(MaxBitrate);
        var band = (hasMin, hasMax) switch
        {
            (true, true) => $"{MinBitrate}-{MaxBitrate}",
            (true, false) => $"{MinBitrate}-",
            (false, true) => MaxBitrate,
            _ => "",
        };
        return ValueChanged.InvokeAsync(string.IsNullOrEmpty(band) ? Container : $"{Container}:{band}");
    }

    private string Guidance => Container switch
    {
        "flac" => "FLAC keeps the full original quality. Files are big, roughly 25 to 40 MB per song. Best for a home media server with plenty of disk space.",
        "opus" => "Opus sounds best at low bitrates. 128 kbps is transparent for most ears, 160 kbps is a safe ceiling. Smallest files for a given quality.",
        "aac" => "AAC (m4a) works everywhere Apple. 256 kbps is a good pick for phones, 192 kbps saves space with little audible loss.",
        "mp3" => "MP3 plays on literally everything. The floor rejects junk rips below the minimum; the ceiling caps how much space each file takes.",
        _ => "Auto picks the best format each source offers. Recommended when you do not want to think about it.",
    };
}
