@* The track table of the playlist details page: sortable columns, stable
   widths, status pills and per-row actions. Sorting lives here so every
   consumer gets identical header behavior. *@
@using MelodyBridge.Core
@using MelodyBridge.Infrastructure.Data

<div class="table-wrap">
    <table class="modern-table track-table">
        <colgroup>
            <col class="col-pos" />
            <col class="col-title" />
            <col class="col-artist" />
            <col class="col-num col-duration" />
            <col class="col-num col-size" />
            <col class="col-num col-bitrate" />
            <col class="col-num col-rate" />
            <col class="col-format" />
            <col class="col-status" />
            @if (ShowFilenameColumn)
            {
                <col class="col-file" />
            }
            <col class="col-actions" />
        </colgroup>
        <thead>
            <tr>
                @foreach (var column in Columns)
                {
                    <th class="@($"col-{column.Key.ToLowerInvariant()}{(column.Align == TrackColumnAlign.Right ? " num" : "")}")"
                        aria-sort="@(SortKey == column.Key ? (SortDescending ? "descending" : "ascending") : "none")">
                        @if (column.Sortable)
                        {
                            <button class="th-sort" type="button"
                                    @onclick="() => ToggleSort(column.Key)"
                                    title="Sort by @column.Label.ToLowerInvariant()">
                                @column.Label
                                @if (SortKey == column.Key)
                                {
                                    <span class="sort-arrow" aria-hidden="true">@(SortDescending ? "▾" : "▴")</span>
                                }
                            </button>
                        }
                        else
                        {
                            @column.Label
                        }
                    </th>
                }
                @if (ShowFilenameColumn)
                {
                    <th class="col-file">File</th>
                }
                <th class="col-actions"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @if (SortedTracks.Count == 0)
            {
                <tr><td class="empty-row" colspan="@(Columns.Length + (ShowFilenameColumn ? 2 : 1))">No tracks match the filter.</td></tr>
            }
            @foreach (var track in SortedTracks)
            {
                <tr @key="RowKey(track)">
                    <td class="text-muted col-position">@(track.Position + 1)</td>
                    <td class="cell-title col-title"><strong title="@(track.Title ?? "Unknown")">@(track.Title ?? "Unknown")</strong></td>
                    <td class="cell-artist col-artist" title="@(track.Artist ?? "Unknown artist")">@(track.Artist ?? "Unknown artist")</td>
                    <td class="text-muted num col-duration">@TrackDisplay.Duration(track.DurationMs)</td>
                    <td class="text-muted num col-size">@TrackDisplay.Size(track)</td>
                    <td class="text-muted num col-bitrate">@(track.DownloadStatus == "downloaded" ? TrackDisplay.BitrateLabel(track.Bitrate) : "-")</td>
                    <td class="text-muted num col-rate">@(track.DownloadStatus == "downloaded" ? TrackDisplay.RateLabel(track.SampleRateHz) : "-")</td>
                    <td class="text-muted col-format">@(track.DownloadStatus == "downloaded" ? TrackDisplay.FormatLabel(track.MediaType) : "-")</td>
                    <td class="cell-status col-status">
                        @{ var queueLabel = QueueLabel?.Invoke(track); }
                        @if (queueLabel is "downloading")
                        {
                            <StatusPill Variant="in_progress" Pulse="true" Title="Currently downloading">downloading</StatusPill>
                        }
                        else if (queueLabel is not null)
                        {
                            <StatusPill Variant="info">@queueLabel</StatusPill>
                        }
                        else
                        {
                            <StatusPill Variant="@(track.DownloadStatus switch
                                { "downloaded" => "ok", "failed" => "err", "needs-review" => "warn", _ => "neutral" })"
                                Title="@(track.DownloadStatus == "needs-review" ? track.Warning : track.DownloadStatus == "failed" ? track.DownloadError : null)">
                                @(track.DownloadStatus == "needs-review" ? "needs review" : track.DownloadStatus ?? "pending")
                            </StatusPill>
                            @if (track.DownloadStatus == "failed" && !string.IsNullOrWhiteSpace(track.DownloadError))
                            {
                                <StatusPill Variant="err" Class="pill-tight" Title="@track.DownloadError">!</StatusPill>
                            }
                        }
                        @{ var warnTitle = WarnTitle(track); }
                        @if (!string.IsNullOrWhiteSpace(warnTitle))
                        {
                            <StatusPill Variant="warn" Title="@warnTitle" Class="pill-tight">!</StatusPill>
                        }
                        @if (ShowArchiveState && track.DownloadStatus == "downloaded")
                        {
                            // The tiny archive check: a green check when the
                            // copy exists, a calm note when this track has
                            // none yet, a warning when the recorded copy
                            // vanished from disk. Existence comes from the
                            // page (checked off the render path): the table
                            // must never stat the disk while it renders.
                            var hasArchivePath = !string.IsNullOrWhiteSpace(track.ArchivePath);
                            if (!hasArchivePath)
                            {
                                <StatusPill Variant="neutral" Class="pill-tight"
                                            Title="No archive copy for this track yet">
                                    <Icon Name="minus" Size="12" />
                                </StatusPill>
                            }
                            else if (ArchiveStates is not null
                                && ArchiveStates.TryGetValue(track.ArchivePath!, out var archiveExists))
                            {
                                <StatusPill Variant="@(archiveExists ? "ok" : "warn")" Class="pill-tight"
                                            Title="@(archiveExists
                                                ? $"Archive copy present: {track.ArchivePath}"
                                                : $"Archive copy missing from disk: {track.ArchivePath}")">
                                    <Icon Name="@(archiveExists ? "check" : "alert")" Size="12" />
                                </StatusPill>
                            }
                            @* Unknown (still being checked): render nothing
                               rather than a state that may be wrong a moment
                               later. *@
                        }
                    </td>
                    @if (ShowFilenameColumn)
                    {
                        <td class="text-muted cell-file col-file">
                            @if (!string.IsNullOrWhiteSpace(track.CurrentPath))
                            {
                                <span title="@track.CurrentPath">@System.IO.Path.GetFileName(track.CurrentPath)</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(track.ArchivePath))
                            {
                                <span class="archive-chip" title="@track.ArchivePath">
                                    archive: @System.IO.Path.GetFileName(track.ArchivePath)
                                </span>
                            }
                        </td>
                    }
                    <td class="track-actions col-actions">
                        <div class="btn-group">
                            @if (OnChooseSource.HasDelegate)
                            {
                                <button class="btn-modern small ghost" aria-label="Choose source"
                                        title="Search every plugin by hand and pick the source yourself"
                                        @onclick="() => OnChooseSource.InvokeAsync(track)" disabled="@Busy">
                                    <Icon Name="search" Size="14" /> <span class="btn-label">Choose source</span>
                                </button>
                            }
                            @if (track.DownloadStatus == "needs-review")
                            {
                                <button class="btn-modern small ghost" aria-label="Download new" title="Download a fresh file in this playlist's quality"
                                        @onclick="() => OnResolveReview.InvokeAsync((track, false))" disabled="@Busy">
                                    <Icon Name="download" Size="14" /> <span class="btn-label">Download new</span>
                                </button>
                                <button class="btn-modern small ghost" aria-label="Hardlink existing" title="Link the file another playlist already has (keeps its quality)"
                                        @onclick="() => OnResolveReview.InvokeAsync((track, true))" disabled="@Busy">
                                    <Icon Name="hard-drive" Size="14" /> <span class="btn-label">Hardlink existing</span>
                                </button>
                            }
                            else if (track.DownloadStatus == "downloaded" && track.ReviewKind is not null)
                            {
                                <button class="btn-modern small ghost" title="@($"Keep this file as it is ({track.ReviewText})")"
                                        @onclick="() => OnQualityReview.InvokeAsync((track, QualityReviewAction.Keep))" disabled="@Busy">
                                    <Icon Name="check" Size="14" /> <span class="btn-label">Keep</span>
                                </button>
                                <button class="btn-modern small ghost" title="@RetryTitle(track)"
                                        @onclick="() => OnQualityReview.InvokeAsync((track, QualityReviewAction.Retry))" disabled="@Busy">
                                    <Icon Name="refresh" Size="14" /> <span class="btn-label">Retry</span>
                                </button>
                            }
                            else if (track.DownloadStatus is "failed" or null or "pending")
                            {
                                <button class="btn-modern small ghost" title="Download this track now"
                                        @onclick="() => OnRetry.InvokeAsync(track)" disabled="@Busy">
                                    <Icon Name="refresh" Size="14" /> <span class="btn-label">Download</span>
                                </button>
                            }
                            @if (track.DownloadStatus is not null)
                            {
                                <button class="btn-modern small ghost" aria-label="Remove"
                                        title="@(track.DownloadStatus == "downloaded"
                                            ? "Remove the track or delete its file: choose in the dialog"
                                            : "Remove from the playlist")"
                                        @onclick="() => OnRemove.InvokeAsync(track)" disabled="@Busy">
                                    <Icon Name="x" Size="14" /> <span class="btn-label">Remove</span>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    /// <summary>Tracks to show, already filtered by the page.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TrackEntity> Tracks { get; set; } = Array.Empty<TrackEntity>();
    /// <summary>True when a page-level action is running: row buttons disable.</summary>
    [Parameter] public bool Busy { get; set; }
    /// <summary>The File column appears when the user opted in.</summary>
    [Parameter] public bool ShowFilenameColumn { get; set; }
    /// <summary>Shows the archive check next to the status pill (downloaded rows only).</summary>
    [Parameter] public bool ShowArchiveState { get; set; }
    /// <summary>
    /// Archive-file existence per path, checked by the page off the render
    /// path. A path that is absent is still being checked: no pill yet.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, bool>? ArchiveStates { get; set; }
    /// <summary>Live queue label for a track while a run is active; null means the plain pill.</summary>
    [Parameter] public Func<TrackEntity, string?>? QueueLabel { get; set; }
    /// <summary>Download this one track.</summary>
    [Parameter] public EventCallback<TrackEntity> OnRetry { get; set; }
    /// <summary>
    /// Resolve a paused dedup conflict: true hardlinks the existing
    /// file, false downloads a fresh copy in this playlist's quality.
    /// </summary>
    [Parameter] public EventCallback<(TrackEntity Track, bool HardlinkExisting)> OnResolveReview { get; set; }
    /// <summary>
    /// Settle a flagged quality review: Keep the file as it is, or Retry
    /// it (a fresh download that avoids the provider that delivered it).
    /// </summary>
    [Parameter] public EventCallback<(TrackEntity Track, QualityReviewAction Action)> OnQualityReview { get; set; }
    /// <summary>Remove this track (and its file) from the playlist.</summary>
    [Parameter] public EventCallback<TrackEntity> OnRemove { get; set; }
    /// <summary>
    /// Search every plugin by hand and pick the source for this track: the
    /// honest fallback when the automatic match is wrong or missing.
    /// </summary>
    [Parameter] public EventCallback<TrackEntity> OnChooseSource { get; set; }
    /// <summary>Raised whenever the sort changes, so the page can keep the state.</summary>
    [Parameter] public EventCallback OnSortChanged { get; set; }

    /// <summary>
    /// The archive check's existence cache is owned by the page now: the
    /// page stats the distinct archive paths on a background task and
    /// passes the verdicts in, so rendering a thousand rows never touches
    /// the disk (a stat per row on a network mount made the table crawl).
    /// </summary>

    /// <summary>Sort key shared with the page so tests can drive it.</summary>
    public enum TrackSortColumn { Position, Title, Artist, Duration, Size, Status }
    public enum TrackColumnAlign { Left, Right }

    private sealed record ColumnSpec(string Key, string Label, bool Sortable, TrackColumnAlign Align);

    private static readonly ColumnSpec[] Columns =
    {
        new("Position", "#", true, TrackColumnAlign.Left),
        new("Title", "Title", true, TrackColumnAlign.Left),
        new("Artist", "Artist", true, TrackColumnAlign.Left),
        new("Duration", "Length", true, TrackColumnAlign.Right),
        new("Size", "Size", true, TrackColumnAlign.Right),
        new("Bitrate", "Bitrate", false, TrackColumnAlign.Right),
        new("Rate", "Rate", false, TrackColumnAlign.Right),
        new("Format", "Format", false, TrackColumnAlign.Left),
        new("Status", "Status", true, TrackColumnAlign.Left),
    };

    private TrackSortColumn sortColumn = TrackSortColumn.Position;
    private bool sortDescending;

    /// <summary>
    /// The sorted rows, computed once per parameter set or sort change:
    /// the page re-renders during a run, and sorting a thousand rows on
    /// every markup access was measurable work.
    /// </summary>
    private IReadOnlyList<TrackEntity>? sortedCache;
    private IReadOnlyList<TrackEntity>? sortedCacheTracks;
    private TrackSortColumn sortedCacheColumn;
    private bool sortedCacheDescending;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(sortedCacheTracks, Tracks)
            || sortedCacheColumn != sortColumn
            || sortedCacheDescending != sortDescending)
        {
            sortedCacheTracks = Tracks;
            sortedCacheColumn = sortColumn;
            sortedCacheDescending = sortDescending;
            sortedCache = SortTracks();
        }
    }

    /// <summary>Current sort key, exposed for tests and the page.</summary>
    public string SortKey => sortColumn.ToString();
    public bool SortDescending => sortDescending;

    private void ToggleSort(string key)
    {
        if (!Enum.TryParse<TrackSortColumn>(key, out var column)) return;
        if (sortColumn == column) sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        sortedCache = null; // the next render re-sorts once
        OnSortChanged.InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<TrackEntity> SortedTracks => sortedCache ??= SortTracks();

    /// <summary>
    /// Stable row identity for the diff: the database id for stored rows,
    /// the instance itself for unsaved ones (tests, previews), so the key
    /// is always unique.
    /// </summary>
    private static object RowKey(TrackEntity track) => track.Id != 0 ? track.Id : track;

    private IReadOnlyList<TrackEntity> SortTracks()
    {
        Func<TrackEntity, object?> key = sortColumn switch
        {
            TrackSortColumn.Title => t => t.Title ?? "",
            TrackSortColumn.Artist => t => t.Artist ?? "",
            TrackSortColumn.Duration => t => t.DurationMs ?? 0,
            TrackSortColumn.Size => t => t.FileSizeBytes ?? 0,
            TrackSortColumn.Status => t => StatusOrder(t),
            _ => t => t.Position ?? 0,
        };
        // Position is the stable tiebreak in both directions, so rows
        // with equal sort keys never shuffle between renders.
        var sorted = sortDescending
            ? Tracks.OrderByDescending(key, KeyComparer)
            : Tracks.OrderBy(key, KeyComparer);
        return sorted.ThenBy(t => t.Position ?? 0).ToList();
    }

    /// <summary>Compares the boxed sort keys: strings ignore case, the rest compare natively.</summary>
    private static readonly IComparer<object?> KeyComparer = Comparer<object?>.Create((a, b) => (a, b) switch
    {
        (string x, string y) => string.Compare(x, y, StringComparison.OrdinalIgnoreCase),
        (IComparable x, IComparable y) => x.CompareTo(y),
        _ => 0,
    });

    /// <summary>Pill-visual order so Status sorting groups pills like a user reads them.</summary>
    private static int StatusOrder(TrackEntity t) => t.DownloadStatus switch
    {
        "failed" => 0,
        "needs-review" => 1, // a paused dedup conflict outranks plain progress
        "in_progress" or "downloading" => 2,
        "queued" => 3,
        "pending" or null => 4,
        "downloaded" => 5,
        _ => 6,
    };

    /// <summary>
    /// The tooltip of the "!" pill: the open review reason first, an
    /// informational warning after it.
    /// </summary>
    private static string? WarnTitle(TrackEntity track)
        => (track.ReviewText, track.Warning) switch
        {
            ({ Length: > 0 } review, { Length: > 0 } warning) => $"{review} · {warning}",
            ({ Length: > 0 } review, _) => review,
            (_, { Length: > 0 } warning) => warning,
            _ => null,
        };

    private static string RetryTitle(TrackEntity track)
        => track.SourcePluginId is { Length: > 0 }
            ? "Download again, avoiding the provider that delivered this file"
            : "Download again and hope for a better source";
}
