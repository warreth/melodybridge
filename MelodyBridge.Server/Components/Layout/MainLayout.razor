@inherits LayoutComponentBase
@using MelodyBridge.Core
@using MelodyBridge.Server.Services
@inject DevPanelService DevPanel
@inject NotificationService Notifications
@implements IDisposable

<div class="app-shell">
    <aside class="app-sidebar">
        <a class="brand-block" href="">
            <img class="brand-logo" src="logo.svg" alt="" />
            <span class="brand-text">Melody<strong>Bridge</strong></span>
        </a>
        <NavMenu />
        <div class="sidebar-footer">
            <button class="theme-toggle" @onclick="ToggleTheme" title="Toggle theme">
                <span class="theme-icon">@(_isDark ? "☾" : "☀")</span>
            </button>
            <span class="version-badge" title="MelodyBridge version">v@AppInfo.Version</span>
        </div>
    </aside>
    <div class="app-main">
        <header class="app-topbar">
            <div class="topbar-title">@PageTitleText</div>
            <div class="topbar-actions">
                @* The sidebar is always visible: no duplicate nav buttons here. *@
            </div>
        </header>
        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@if (_toasts.Count > 0)
{
    <div class="toast-stack">
        @foreach (var toast in _toasts)
        {
            <div class="toast-item @toast.Level">
                <span>@toast.Message</span>
                <button class="toast-close" @onclick="() => DismissToast(toast)"><Icon Name="x" Size="14" /></button>
            </div>
        }
    </div>
}

@code {
    private bool _isDark = true;
    private List<AppNotification> _toasts = [];

    private string PageTitleText
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
            if (string.IsNullOrWhiteSpace(path)) return "Dashboard";
            var segments = path.Split('/');
            var last = segments[^1];
            if (Guid.TryParse(segments[^1], out _)) last = segments.Length > 1 ? segments[^2] : last;
            return char.ToUpperInvariant(last[0]) + last[1..].Replace('-', ' ');
        }
    }

    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override void OnInitialized()
        => Notifications.Changed += RefreshToasts;

    private void RefreshToasts()
    {
        _toasts = Notifications.Snapshot().Take(4).ToList();
        _ = InvokeAsync(StateHasChanged);
    }

    private void DismissToast(AppNotification toast) => Notifications.Dismiss(toast);

    private void ToggleTheme()
    {
        _isDark = !_isDark;
        _ = JS.InvokeVoidAsync("melody.setTheme", _isDark ? "dark" : "light");
    }

    public void Dispose() => Notifications.Changed -= RefreshToasts;
}
