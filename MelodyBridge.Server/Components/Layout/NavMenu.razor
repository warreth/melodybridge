@inject DevPanelService DevPanel
@inject MelodyBridge.Infrastructure.Services.PluginAuthMonitor AuthMonitor
@implements IDisposable

@* NavLink, not plain anchors: the router marks the current page's
   link with .active, and the sidebar CSS paints it in the accent
   palette. Dashboard needs All so "/" only lights up on an exact
   match, not on every child route. *@
<nav class="app-nav">
    <div class="nav-section">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="home" Class="nav-icon" /> Dashboard</NavLink>
    </div>
    <div class="nav-section">
        <div class="nav-section-header">Your music</div>
        <NavLink class="nav-link" href="/playlists"><Icon Name="list-music" Class="nav-icon" /> Playlists</NavLink>
        <NavLink class="nav-link" href="/downloads"><Icon Name="download" Class="nav-icon" /> Downloads</NavLink>
        <NavLink class="nav-link" href="/plugins">
            <Icon Name="package" Class="nav-icon" /> Plugins
            @if (authIssueCount > 0)
            {
                <span class="nav-auth-flag" title="@AuthAlertTitle"
                      aria-label="@AuthAlertTitle">!</span>
            }
        </NavLink>
        <NavLink class="nav-link" href="/library"><Icon Name="library" Class="nav-icon" /> Library</NavLink>
    </div>
    <div class="nav-section">
        <div class="nav-section-header">Publishing</div>
        <NavLink class="nav-link" href="/sync-jobs"><Icon Name="refresh" Class="nav-icon" /> Sync jobs</NavLink>
    </div>
    <div class="nav-section">
        <div class="nav-section-header">System</div>
        <NavLink class="nav-link" href="/settings"><Icon Name="sliders" Class="nav-icon" /> Settings</NavLink>
        <NavLink class="nav-link" href="/advanced"><Icon Name="flag" Class="nav-icon" /> Advanced</NavLink>
        <NavLink class="nav-link" href="/logs"><Icon Name="terminal" Class="nav-icon" /> Logs</NavLink>
        @if (DevPanel.Enabled)
        {
            <NavLink class="nav-link" href="/dev"><Icon Name="zap" Class="nav-icon" /> Dev panel</NavLink>
        }
    </div>
</nav>

@code {
    private int authIssueCount;
    private string AuthAlertTitle => authIssueCount == 1
        ? "1 plugin needs your login"
        : $"{authIssueCount} plugins need your login";

    protected override void OnInitialized()
    {
        AuthMonitor.Changed += OnAuthChanged;
        DevPanel.Changed += OnDevPanelChanged;
        RefreshAuthCount();
    }

    private void OnDevPanelChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnAuthChanged() => _ = InvokeAsync(() =>
    {
        RefreshAuthCount();
        StateHasChanged();
    });

    private void RefreshAuthCount() => authIssueCount = AuthMonitor.Snapshot().Count;

    public void Dispose()
    {
        AuthMonitor.Changed -= OnAuthChanged;
        DevPanel.Changed -= OnDevPanelChanged;
    }
}