@inject MelodyBridge.Server.Services.DevPanelService DevPanel

<div class="brand-block">
    <div class="brand-logo">M</div>
    <div>
        <strong>MelodyBridge</strong>
        <span>Sync studio</span>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<nav class="app-nav" aria-label="Primary navigation">
    <div class="nav-section">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><i class="bi bi-house-door"></i> Dashboard</NavLink>
    </div>
    <div class="nav-section">
        <h6 class="nav-section-header">Library</h6>
        <NavLink class="nav-link" href="playlists"><i class="bi bi-music-note-list"></i> Playlists</NavLink>
        <NavLink class="nav-link" href="library"><i class="bi bi-collection"></i> Tracks</NavLink>
        <NavLink class="nav-link" href="downloads"><i class="bi bi-download"></i> Downloads</NavLink>
    </div>
    <div class="nav-section">
        <h6 class="nav-section-header">Automation</h6>
        <NavLink class="nav-link" href="sync-jobs"><i class="bi bi-arrow-repeat"></i> Sync Jobs</NavLink>
        <NavLink class="nav-link" href="accounts"><i class="bi bi-people"></i> Accounts</NavLink>
    </div>
    <div class="nav-section">
        <h6 class="nav-section-header">System</h6>
        <NavLink class="nav-link" href="settings"><i class="bi bi-gear"></i> Settings</NavLink>
        @if (DevPanel.Enabled)
        {
            <NavLink class="nav-link" href="dev"><i class="bi bi-tools"></i> Dev Panel</NavLink>
        }
    </div>
</nav>

<div class="sidebar-footer">
    <span class="status-dot online"></span>
    <div>
        <strong>Runtime ready</strong>
        <small>Docker compose</small>
    </div>
</div>

