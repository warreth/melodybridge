# Copy to .env and fill in. The Settings page in the app can also
# configure all of this; saved settings win over these values.

# Jellyfin (running on your host is reachable as host.docker.internal)
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=
# Optional: the user whose favorites receive liked songs
JELLYFIN_USER_ID=
